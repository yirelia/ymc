model S03_logic_rel_if
  type E = enumeration(one, two, three);
  constant E ce = E.two;
  parameter E pe = E.one;
  Real x;
  Boolean b;
  Boolean l01 = true and b;
  Boolean l02 = b and true;
  Boolean l03 = false and b;
  Boolean l04 = b and false;
  Boolean l05 = true or b;
  Boolean l06 = b or false;
  Boolean l07 = not true;
  Boolean l08 = not (not b);
  Boolean l09 = b and b;
  Boolean l10 = b or not b;
  Boolean l11 = true and false or true;
  Boolean r01 = 1 < 2;
  Boolean r02 = 2.5 >= 3;
  Boolean r03 = 1 == 1;
  Boolean r04 = "a" < "b";
  Boolean r05 = "abc" == "abc";
  Boolean r06 = true > false;
  Boolean r07 = E.one < E.two;
  Boolean r08 = ce == E.two;
  Boolean r09 = pe == E.one;
  Boolean r10 = x > 1 + 2;
  Boolean r11 = x < x;
  Boolean r12 = 1 <> 2;
  Real i01 = if true then x else 2 * x;
  Real i02 = if false then x else 2 * x;
  Real i03 = if 1 < 2 then 1 else 2;
  Real i04 = if b then x else x;
  Boolean i05 = if b then true else false;
  Boolean i06 = if b then false else true;
  Real i07 = if b then 1 + 2 else 3 * 4;
  Real i08 = if x > 0 then (if true then 1 else 2) else 3;
  Real i09 = if ce == E.two then x else -x;
  Real i10 = if pe == E.one then x else -x;
  Real i11 = if b then 1 elseif false then 2 else 3;
  Real i12 = if b then 1 elseif true then 2 else 3;
equation
  x = time;
  b = x > 0.5;
end S03_logic_rel_if;
