class P04_types
  Real r.x;
  Integer r.n = 1;
  enumeration(one, two) r.e = Pkg.E.one;
  Real nn.r.x;
  Integer nn.r.n = 1;
  enumeration(one, two) nn.r.e = Pkg.E.one;
  Real nn.z[1];
  Real nn.z[2];
  Real ra[1].x;
  Integer ra[1].n = 1;
  enumeration(one, two) ra[1].e = Pkg.E.one;
  Real ra[2].x;
  Integer ra[2].n = 1;
  enumeration(one, two) ra[2].e = Pkg.E.one;
  Real m.x "inner comment";
  final parameter Integer m.n = 2;
  Real m.a[1] "array comment";
  Real m.a[2] "array comment";
  Real ma[1].x "inner comment";
  final parameter Integer ma[1].n = 2;
  Real ma[1].a[1] "array comment";
  Real ma[1].a[2] "array comment";
  Real ma[2].x "inner comment";
  final parameter Integer ma[2].n = 2;
  Real ma[2].a[1] "array comment";
  Real ma[2].a[2] "array comment";
  Real mat[1,1] "matrix";
  Real mat[1,2] "matrix";
  Real mat[1,3] "matrix";
  Real mat[2,1] "matrix";
  Real mat[2,2] "matrix";
  Real mat[2,3] "matrix";
  enumeration(one, two) ee(start = Pkg.E.two) "enum var";
  Real x = 1.0 "bound";
  Real y;
  parameter Real p[1] = 1.0;
  parameter Real p[2] = 2.0;
  parameter Real q[1,1] = 1.0;
  parameter Real q[1,2] = 2.0;
  parameter Real q[2,1] = 3.0;
  parameter Real q[2,2] = 4.0;
  Boolean bb[1](start = true);
  Boolean bb[2](start = true);
  Real st[1](start = 1.0, fixed = true);
  Real st[2](start = 2.0, fixed = true);
  Real st[3](start = 3.0, fixed = true);
equation
  r.x = 1.0;
  nn.r.x = 2.0;
  nn.z[1] = 1.0;
  nn.z[2] = 2.0;
  ra[1].x = 1.0;
  ra[2].x = 2.0;
  m.x = 1.0;
  m.a[1] = 1.0;
  m.a[2] = 2.0;
  ma[1].x = 1.0;
  ma[2].x = 1.0;
  ma[1].a[1] = 1.0;
  ma[1].a[2] = 2.0;
  ma[2].a[1] = 3.0;
  ma[2].a[2] = 4.0;
  mat[1,1] = 1.0;
  mat[1,2] = 2.0;
  mat[1,3] = 3.0;
  mat[2,1] = 4.0;
  mat[2,2] = 5.0;
  mat[2,3] = 6.0;
  ee = Pkg.E.one;
  y = 2.0;
  bb[1] = true;
  bb[2] = false;
  st[1] = 1.0;
  st[2] = 1.0;
  st[3] = 1.0;
end P04_types;
