  m[2,1] = pm[2,1] * x + pm[1,2];
  m[2,2] = pm[2,2] * x + pm[2,2] - 1.0;
  e1 = if x > 0.5 then E.a else E.c;
  e2 = E.b;
  b1 = e1 == E.a and e2 < E.c;
  b2 = pre(b1) or edge(b1) or change(b1) or initial() or terminal();
  b3 = sample(0.0, 0.1);
  b4 = b1 <> b2;
  s1 = "a\"b\\c
  d	e?%'" + String(i1, 0, true) + String(x, 3, 0, true) + String(b1, 0, true) + String(e1, 0, true);
  s2 = String(x, "%g");
  s3 = if b1 then "yes" else "no";
