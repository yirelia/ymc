  r9 = v[1] * w[1] + v[2] * w[2] + v[3] * w[3] + /*Real*/(sum(i for i in 1:np)) + max(v) + min(x, 2.0) + v[1] * v[2] * v[3];
  v[1] = x;
  v[2] = 2.0 * x;
  v[3] = 3.0 * x;
