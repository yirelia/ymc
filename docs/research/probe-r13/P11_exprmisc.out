function P11_exprmisc.fn
  input Real x;
  input Real k = 2.0;
  input String s = "d";
  output Real y;
algorithm
  y := k * x;
end P11_exprmisc.fn;

function P11_exprmisc.fv
  input Real[:] v;
  output Real y;
algorithm
  y := sum(v);
end P11_exprmisc.fv;

class P11_exprmisc
