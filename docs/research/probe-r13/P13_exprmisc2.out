function P13_exprmisc2.g
  input Integer[:] iv;
  input Integer n0;
  input Integer n1;
  input Real[:] a;
  input Real[:] b;
  output Real y;
  protected Real[size(a, 1)] t;
  protected Integer k;
algorithm
  y := P13_exprmisc2.rsum(/*Real[:]*/(iv));
  for i in n0 + 1:n1 - 1 loop
    y := y + /*Real*/(i);
  end for;
  for i in n1:-1:n0 loop
    y := y + /*Real*/(i);
  end for;
  for i in 1:2 * n0:n1 loop
    y := y + /*Real*/(i);
  end for;
  t := (a + b) * 2.0 - a .* b + a / 2.0;
  y := y + a * b + t[size(a, 1)] + a[size(a, 1) - 1];
  k := if n0 > 1 then n0 else -n0;
  y := y + /*Real*/((if k > 0 then 1 else 2) * 3);
  y := y + P13_exprmisc2.rsum(if k > 0 then a else b);
  y := y + P13_exprmisc2.rsum(array(a[i] ^ 2.0 for i in 1:size(a, 1)));
  y := y + P13_exprmisc2.rsum(a[2:size(a, 1)]) + P13_exprmisc2.rsum(a[:]);
  k := -k;
  k := -(k + 1);
  k := k * -1;
  y := -y;
  y := -(y + 1.0) * 2.0;
  y := 1.0 - y * 2.0;
  y := (-y) * 2.0;
  y := 2.0 * (-y);
  y := 2.0 + y;
  y := -y ^ 2.0;
  y := (-y) ^ 2.0;
  y := y ^ (-2.0);
  y := (y + 1.0) ^ 2.0;
  y := (y * 2.0) ^ 2.0;
  y := 2.0 ^ y + 1.0;
end P13_exprmisc2.g;

function P13_exprmisc2.rsum
  input Real[:] v;
  output Real y;
algorithm
  y := sum(v);
end P13_exprmisc2.rsum;

class P13_exprmisc2
  Real y = P13_exprmisc2.g({1, 2}, 1, 3, {time, 1.0}, {2.0, time});
  parameter Real pf[1] = 1.0;
  parameter Real pf[2] = 2.0;
  Real z[1];
  Real z[2];
  String s = "tab	raw, nl:
  second line, bs:\\ q:\" bell:\a end";
equation
  z = {time, 2.0 * time};
end P13_exprmisc2;
