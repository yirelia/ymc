model P12b_parse_error
  Real a, b, c, d;
  Real y[40];
  Boolean p, q, r;
  Boolean z[12];
equation
  a = time; b = 2 * time; c = 3 * time; d = 4 * time;
  p = time > 1; q = time > 2; r = time > 3;
  y[1] = a + b + c;
  y[2] = a + (b + c);
  y[3] = a - b - c;
  y[4] = a - (b - c);
  y[5] = a - (b + c);
  y[6] = a * b * c;
  y[7] = a * (b * c);
  y[8] = a / b / c;
  y[9] = a / (b / c);
  y[10] = a / (b * c);
  y[11] = a * b / c;
  y[12] = a * (b / c);
  y[13] = (a + b) * c;
  y[14] = a + b * c;
  y[15] = a ^ b ^ c;
  y[16] = (a ^ b) ^ c;
  y[17] = a ^ (b ^ c);
  y[18] = (-a) ^ 2;
  y[19] = -a ^ 2;
  y[20] = -(a + b);
  y[21] = -a + b;
  y[22] = a + (-b);
  y[23] = a - (-b);
  y[24] = a * (-b);
  y[25] = -a * b;
  y[26] = -(a * b);
  y[27] = (a + b) / (c + d);
  y[28] = a ^ (b + c);
  y[29] = (a * b) ^ c;
  y[30] = 2 ^ (-a);
  y[31] = if p then a else b;
  y[32] = (if p then a else b) + c;
  y[33] = if p then a elseif q then b else c;
  y[34] = a + (if p then a else b);
  y[35] = a * (-2);
  y[36] = a - (-2.5);
  y[37] = +a;
  y[38] = - - a;
  y[39] = a .* b ./ c .+ d .- a .^ 2;
  y[40] = (a - b) - (c - d);
  z[1] = p and q or r;
  z[2] = p and (q or r);
  z[3] = p or q and r;
  z[4] = (p or q) and r;
  z[5] = not p and q;
  z[6] = not (p and q);
  z[7] = a < b and b <= c or c > d and d >= a;
  z[8] = a == b or a <> b;
  z[9] = not a < b;
  z[10] = (a < b) == (c < d);
  z[11] = not not p;
  z[12] = p and (q and r);
end P12b_parse_error;
