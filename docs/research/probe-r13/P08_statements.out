function P08_statements.f2
  input Real x;
  output Real a;
  output Real b;
algorithm
  a := x;
  b := 2.0 * x;
end P08_statements.f2;

class P08_statements
  Real x(start = 1.0);
  Real y;
  Real z;
  Real a;
  Real b;
  Real s;
  Integer k;
  discrete Real d;
  Real arr[1];
  Real arr[2];
  Real arr[3];
equation
  der(x) = -x;
algorithm
  y := x + 1.0 "stmt comment";
  if x > 0.5 then
    z := 1.0;
  elseif x > 0.2 then
    z := 2.0;
  else
    z := 3.0;
  end if;
  if x > 2.0 then
    z := 5.0;
  end if;
  s := 0.0;
  for i in 1:3 loop
    s := s + /*Real*/(i);
    arr[i] := s;
  end for;
  for i in 1:2:5 loop
    s := s + /*Real*/(i);
  end for;
  for e in {1.5, 2.5} loop
    s := s + e;
  end for;
  k := 0;
  while k < 3 loop
    k := k + 1;
    if k == 2 then
      break;
    end if;
  end while;
  (a, b) := P08_statements.f2(x);
  (_, b) := P08_statements.f2(x);
  (a, _) := P08_statements.f2(x);
  when x < 0.5 then
    d := pre(d) + 1.0;
  elsewhen x < 0.3 then
    d := 0.0;
  end when;
  assert(x > -1.0, "msg");
  when x < 0.05 then
    terminate("bye");
  end when;
end P08_statements;
