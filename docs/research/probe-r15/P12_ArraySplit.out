class P12_ArraySplit
  parameter Real v[1] = 10.0;
  parameter Real v[2] = 20.0;
  parameter Real v[3] = 30.0;
  parameter Real a[1].p = 1.0;
  parameter Real a[1].q = 5.0;
  Real a[1].x(start = v[1]);
  parameter Real a[2].p = 2.0;
  parameter Real a[2].q = 5.0;
  Real a[2].x(start = v[2]);
  parameter Real a[3].p = 3.0;
  parameter Real a[3].q = 5.0;
  Real a[3].x(start = v[3]);
end P12_ArraySplit;
