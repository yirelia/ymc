{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug (MinGW Makefiles)  <- 默认，命令行 + gdb",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g3"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -g"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio 2022 生成器，多配置)  <- 用 VS 调试器时用这个",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/msvc"
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC + AddressSanitizer",
      "inherits": "msvc",
      "binaryDir": "${sourceDir}/build/msvc-asan",
      "cacheVariables": {
        "YMC_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug",   "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "msvc-debug",  "configurePreset": "msvc",      "configuration": "Debug" },
    { "name": "msvc-asan",   "configurePreset": "msvc-asan", "configuration": "Debug" },
    { "name": "msvc-asan-rel", "configurePreset": "msvc-asan", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "gcc-debug",   "configurePreset": "gcc-debug",   "output": { "outputOnFailure": true } },
    { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-debug",  "configurePreset": "msvc",        "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "msvc-asan",   "configurePreset": "msvc-asan",   "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "msvc-asan-rel", "configurePreset": "msvc-asan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
