//// set: md-m7 — 参差的带绑定数组（omc 内部错）及邻近形态：方程 / 算法 / 推导式 / 多维 / 离散 / 嵌在子模型里
//// model: M70
model M70
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n]; equation x = fill(time, n); end X; X xs[2](n = {1, 3});
end M70;
//// model: M71
model M71
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n]; equation for i in 1:n loop x[i] = time; end for; end X; X xs[2](n = {1, 3});
end M71;
//// model: M72
model M72
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n](each start = 1); equation der(x) = fill(1, n); end X; X xs[2](n = {1, 3});
end M72;
//// model: M73
model M73
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = {time * i for i in 1:n}; end X; X xs[2](n = {1, 3});
end M73;
//// model: M74
model M74
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = ones(n) * time; end X; X xs[2](n = {1, 3});
end M74;
//// model: M75
model M75
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = time * (1:n); end X; X xs[2](n = {1, 3});
end M75;
//// model: M76
model M76
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n]; Real s = sum(x); equation x = fill(time, n); end X; X xs[2](n = {1, 3});
end M76;
