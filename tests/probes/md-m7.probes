//// model: M78
model M78
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n]; algorithm for i in 1:n loop x[i] := time; end for; end X; X xs[2](n = {1, 3});
end M78;
//// model: M79
model M79
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; parameter Real q[n] = fill(1, n); Real s = sum(q) * time; end X; X xs[2](n = {1, 3});
end M79;
