//// model: YmcFnName3
package P2
  function g2
    input Real x;
    output Real y = x + 5;
  end g2;
  model D
    Real d = g2(time);
  end D;
  model M
    function h2
      input Real x;
      output Real y = x * 7;
    end h2;
    D dd;
    Real m = h2(time);
  end M;
end P2;
//// model: YmcFnPar1
function g
  input Real x;
  output Real y = x;
end g;
model YmcFnPar1
  parameter Real p = 2;
  Real r3 = g(p);
  parameter Real q = g(p);
end YmcFnPar1;
//// model: YmcIf11a
function f
  input Integer n;
  output Real x[2];
algorithm
  x := {1.0, 2.0};
end f;
model YmcIf11a
  Integer n;
  Real y = f(n)*{1, 1};
end YmcIf11a;
//// model: YmcIf11b
function f
  input Integer n;
  output Real x;
algorithm
  x := if n <> 2 then 1.0 else 2.0;
end f;
model YmcIf11b
  Integer n;
  Real y = f(n);
end YmcIf11b;
//// model: YmcLitMul
model YmcLitMul
  Real x[2] = {time, 2*time};
  Real y[2];
equation
  y = x + {1, 2};
end YmcLitMul;
//// model: YmcLitMul2
model YmcLitMul2
  Real x[2];
  Real y[2];
equation
  x = {time, 2*time};
  y = x + {1, 2};
end YmcLitMul2;
//// model: YmcRec1
record R
  Real x;
  Real y = 2;
end R;
model YmcRec1
  R r;
  Real z = r.x;
end YmcRec1;
//// model: YmcRec2
record R
  Real x;
  Real y = 2;
  Integer n = 3;
  parameter Real p = 4;
  constant Real c = 5;
end R;
function f
  input R r;
  output Real z = r.x + r.y;
end f;
model YmcRec2
  R r;
  Real z = f(r);
end YmcRec2;
