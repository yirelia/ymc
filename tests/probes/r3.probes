//// set: r3 — 杂项
//// model: R3
model R3
  parameter Integer n = 3;
  Real a = ({i * time for i in 1:3})[2];
  Integer b = size({i for i in 1:3}, 1);
  Real c = max({i * time for i in 1:3});
  Real d[2, 3] = {{i * time for i in 1:3}, {1, 2, 3}};
  Real e[3] = if time > 1 then {i * time for i in 1:3} else {1, 2, 3};
  Real f[4] = cat(1, {i * time for i in 1:3}, {1});
  Real g[3] = vector({i * time for i in 1:3});
  Real h[1, 3] = transpose({{i * time} for i in 1:3});
  Real k[3] = noEvent({i * time for i in 1:3});
  Real l = product({i * time for i in 1:3});
  Real m[3] = {i * time for i in 1:3} .* {1, 2, 3};
  Real o[3, 3] = diagonal({i * time for i in 1:3});
  Real p = {i * time for i in 1:3} * {i * time for i in 1:3};
  Real q[3] = linspace(0, 1, 3) * time;
  Real r[3] = cross({i * time for i in 1:3}, {1, 2, 3});
  Real s[3, 1] = matrix({i * time for i in 1:3});
  Real t[3](start = {i for i in 1:3});
  Real u[2] = {sum({i * j * time for i in 1:3}) for j in 1:2};
  discrete Real v[n](start = {i for i in 1:n});
end R3;
//// model: S0
