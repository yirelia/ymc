//// model: F12
model F12
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = sample(x, Clock(b and time > 1));
end F12;
//// model: F13
model F13
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = sample(x, Clock(if b then 0.1 else 0.2));
end F13;
//// model: F14
model F14
  parameter Integer n = 2;
