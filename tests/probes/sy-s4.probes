//// set: sy-s4 — 同步算子：Clock 实参形态、结构参数代入、钟控 when 的体
//// model: F0
model F0
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real q[n]; Real y;
equation
  when Clock(n) then y = 1; end when;
end F0;
//// model: F1
model F1
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real q[n]; Real y = sample(x, Clock(n, 2));
end F1;
//// model: F2
model F2
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real q[n]; Real y = sample(x, Clock(2, n));
end F2;
//// model: F3
model F3
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  parameter Real pp = 0.5 annotation(Evaluate = true); Real y = sample(x, Clock(pp));
end F3;
//// model: F4
model F4
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  parameter Real pp = 0.5 annotation(Evaluate = true); Real y = sample(x, Clock(b, pp));
end F4;
//// model: F5
model F5
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real q[n]; Real y = hold(q[n]);
end F5;
//// model: F6
model F6
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real q[n]; Real y = backSample(x, n);
end F6;
//// model: F7
model F7
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = sample(x, Clock(1.0 + 2.0));
end F7;
