  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = hold(1.0 + 2.0);
end F34;
//// model: F35
model F35
  parameter Integer n = 2;
