  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = hold(x + 0);
end F35;
//// model: F36
model F36
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = subSample(1 + 1, 1 + 1);
end F36;
//// model: F37
model F37
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Clock c = Clock(0.1);
end F37;
//// model: F38
model F38
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when Clock(0.1) then y = 1; end when; when Clock(0.2) then y = 2; end when;
end F38;
//// model: F39
model F39
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y; Real w;
equation
  when Clock(0.1) then y = 1; w = y + interval(); end when;
end F39;
//// model: F40
model F40
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when Clock(0.1) then y = hold(x); end when;
end F40;
//// model: F41
model F41
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y; algorithm when Clock(0.1) then y := 1; end when;
equation
  x = x;
end F41;
//// model: F42
model F42
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when Clock(0.1) then reinit(y, 1); end when;
end F42;
//// model: F43
model F43
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when Clock(0.1) then assert(y > 0, "m"); y = 1; end when;
end F43;
//// model: F44
model F44
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when Clock(0.1) then for i in 1:2 loop y = i; end for; end when;
end F44;
//// model: F45
model F45
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y[2];
equation
  when Clock(0.1) then for i in 1:2 loop y[i] = i * previous(y[i]); end for; end when;
end F45;
//// model: BASE
model BASE
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
end BASE;
