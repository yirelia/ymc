end A68cNF06;
//// model: A68cNF07
model A68cNF07
  function g input Boolean u; output Boolean v; algorithm v := not u; end g;
  function f input Real u; output Boolean v; algorithm v := g(noEvent(u > 1)); end f;
  Real y = time;
  Boolean z = f(y);
end A68cNF07;
//// model: A68cNF08
model A68cNF08
  function g input Boolean u; output Boolean v; algorithm v := not u; end g;
  function f input Boolean u; output Boolean v; algorithm v := g(noEvent(u)); end f;
  Boolean b = time > 1;
  Boolean z = f(b);
end A68cNF08;
//// model: A68cNF09
model A68cNF09
  function h input Real u; output Boolean v; algorithm v := u > 0; end h;
  function g input Boolean u; output Real v; algorithm v := if u then 1 else 2; end g;
  Real y = time;
  Real z = g(h(y));
end A68cNF09;
//// model: A68cNF10
model A68cNF10
  function h input Real u; output Boolean v; algorithm v := u > 0; end h;
