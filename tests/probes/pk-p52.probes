//// set: pk-p52 — 68c：noEvent 与离散组件 / 离散形参的变率（NE / NF / NG）、der 按变率化简与拒绝（DZ / DY）、63 位整数字面量与常量运算环绕（IL）、绑定类型矩阵（BT，生成）、矩阵幂（MP；MQ：A ^ 1 是展开后的 A，cref / 字面量 / 参数 / 常量 / 切片 / Integer × 绑定 / 方程 / 算法）、经改过的 extends 看到的继承类（IH）、纯声明复合组件的变率前缀（VC）、final 类修饰（XF：短类包、extends，组件自己的修饰与外来修饰）。含语法 / 语义非法的变体。
//// model: A68cNE01
model A68cNE01
  Real y = time;
  Boolean b = time > 0.5;
  Boolean z = noEvent(y > 1) and b;
end A68cNE01;
//// model: A68cNE02
model A68cNE02
  Real y = time;
  Boolean b = time > 0.5;
  Boolean z = b or noEvent(y > 1);
end A68cNE02;
//// model: A68cNE03
model A68cNE03
  Real y = time;
  Boolean z = not noEvent(y > 1);
end A68cNE03;
//// model: A68cNE04
model A68cNE04
  Real y = time;
  Boolean b = time > 0.5;
  Boolean z = noEvent(b);
end A68cNE04;
//// model: A68cNE05
model A68cNE05
  parameter Real p = 2;
  Boolean z = noEvent(p > 1);
end A68cNE05;
//// model: A68cNE06
model A68cNE06
  parameter Real p = 2;
  Boolean b = time > 0.5;
  Boolean z = noEvent(p > 1) and b;
end A68cNE06;
//// model: A68cNE07
model A68cNE07
  Integer i = if time > 1 then 3 else 0;
  Boolean z = noEvent(i > 1);
end A68cNE07;
//// model: A68cNE08
model A68cNE08
  Integer i = if time > 1 then 3 else 0;
  Boolean b = time > 0.5;
  Boolean z = noEvent(i > 1) and b;
end A68cNE08;
//// model: A68cNE09
model A68cNE09
  discrete Real r(start = 0);
  Boolean z = noEvent(r > 1);
equation
  when time > 1 then r = 2; end when;
end A68cNE09;
//// model: A68cNE10
model A68cNE10
  Real y = time;
  Integer k = if noEvent(y > 1) then 1 else 2;
end A68cNE10;
//// model: A68cNE11
model A68cNE11
  Real y = time;
  Boolean b1 = time > 1, b2 = time > 2;
  Boolean z = if noEvent(y > 1) then b1 else b2;
end A68cNE11;
//// model: A68cNE12
model A68cNE12
  Real y = time;
  Boolean b1 = time > 1, b2 = time > 2;
  Boolean z = if b1 then noEvent(y > 1) else b2;
end A68cNE12;
//// model: A68cNE13
model A68cNE13
  Real y = time;
  Boolean z = noEvent(y > 1) or true;
end A68cNE13;
//// model: A68cNE14
model A68cNE14
  Real y = time;
  Boolean z = false and noEvent(y > 1);
end A68cNE14;
//// model: A68cNE15
model A68cNE15
  Real y = time;
  Boolean b = time > 0.5;
  Boolean z[2] = {noEvent(y > 1), b};
end A68cNE15;
//// model: A68cNE16
model A68cNE16
  Real y = time;
  Boolean z[2] = noEvent({y > 1, y > 2});
end A68cNE16;
//// model: A68cNE17
model A68cNE17
  function g input Boolean u; output Boolean v; algorithm v := not u; end g;
  Real y = time;
  Boolean z = g(noEvent(y > 1));
end A68cNE17;
//// model: A68cNE18
model A68cNE18
  function g input Boolean u; output Boolean v; algorithm v := not u; end g;
  Real y = time;
  Boolean z = noEvent(g(y > 1));
end A68cNE18;
//// model: A68cNE19
model A68cNE19
  function f input Real u; output Real v; algorithm v := 2 * u; end f;
  Real y = time;
  Boolean z = noEvent(f(y) > 1);
end A68cNE19;
//// model: A68cNE20
model A68cNE20
  function h input Real u; output Boolean v; algorithm v := u > 0; end h;
  Real y = time;
  Boolean z = noEvent(h(y));
end A68cNE20;
//// model: A68cNE21
model A68cNE21
  Real y = time;
  Boolean b = time > 0.5;
  Boolean z = noEvent(y > 1) == b;
end A68cNE21;
//// model: A68cNE22
model A68cNE22
  Real y = time;
  Boolean z = noEvent(abs(y) > 1);
end A68cNE22;
//// model: A68cNE23
model A68cNE23
  Real y = time;
  Boolean z = noEvent(integer(y) > 1);
end A68cNE23;
//// model: A68cNE24
model A68cNE24
  Real y = time;
  Boolean z = noEvent(floor(y) > 1);
end A68cNE24;
//// model: A68cNE25
model A68cNE25
  Real y(start = 1, fixed = true);
  Boolean z = noEvent(pre(y) > 1);
equation
  der(y) = 1;
end A68cNE25;
//// model: A68cNE26
model A68cNE26
  Real y(start = 1, fixed = true);
  Boolean z = noEvent(der(y) > 1);
equation
  der(y) = 1;
end A68cNE26;
//// model: A68cNE27
model A68cNE27
  model A Boolean z; end A;
  Real y = time;
  Boolean b = time > 0.5;
  A a(z = noEvent(y > 1) and b);
end A68cNE27;
//// model: A68cNE28
model A68cNE28
  model A Boolean z; end A;
  extends A(z = noEvent(y > 1) and b);
  Real y = time;
  Boolean b = time > 0.5;
end A68cNE28;
//// model: A68cNE29
model A68cNE29
  record R Boolean f; Real r; end R;
  Real y = time;
  R a(f = not noEvent(y > 1), r = 1);
end A68cNE29;
//// model: A68cNE30
model A68cNE30
  Real y = time;
  discrete Real d = if noEvent(y > 1) then 1.0 else 2.0;
end A68cNE30;
//// model: A68cNE31
model A68cNE31
  Real y = time;
  discrete Real d = noEvent(y);
end A68cNE31;
//// model: A68cNE32
model A68cNE32
  Real y = time;
  discrete Real d = y;
end A68cNE32;
//// model: A68cNE33
model A68cNE33
  Real y = time;
  Real r = if noEvent(y > 1) then 1.0 else 2.0;
end A68cNE33;
//// model: A68cNE34
model A68cNE34
  Real y = time;
  String s = String(noEvent(y > 1));
end A68cNE34;
//// model: A68cNE35
model A68cNE35
  Real y = time;
  Boolean z;
equation
  z = noEvent(y > 1);
end A68cNE35;
//// model: A68cNE36
model A68cNE36
  function f input Real u; output Boolean v = noEvent(u > 1) and u < 3; end f;
  Real y = time;
  Boolean z = f(y);
end A68cNE36;
//// model: A68cNE37
model A68cNE37
  Real y = time;
  Boolean z = noEvent(noEvent(y > 1));
end A68cNE37;
//// model: A68cNE38
model A68cNE38
  Real y = time;
  Boolean z = noEvent(time > 1);
end A68cNE38;
//// model: A68cNE39
model A68cNE39
  Boolean z = noEvent(true);
end A68cNE39;
//// model: A68cNE40
model A68cNE40
  constant Real c = 2;
  Boolean b = time > 0.5;
  Boolean z = noEvent(c > 1) and b;
end A68cNE40;
//// model: A68cNE41
type E = enumeration(a, b);
model A68cNE41
  Real y = time;
  E e = if noEvent(y > 1) then E.a else E.b;
end A68cNE41;
//// model: A68cNE42
model A68cNE42
  Real y = time;
  Boolean z = noEvent(y > 1)
    and noEvent(y < 2);
end A68cNE42;
//// model: A68cNE43
model A68cNE43
  Real y = time;
  Integer k = integer(if noEvent(y > 1) then 1.0 else 2.0);
end A68cNE43;
//// model: A68cNE44
model A68cNE44
  Real y = time;
  Integer k = 1 + (if noEvent(y > 1) then 1 else 2);
end A68cNE44;
//// model: A68cNE45
model A68cNE45
  Real y = time;
  Boolean z = noEvent(smooth(0, y) > 1);
end A68cNE45;
//// model: A68cNE46
model A68cNE46
  Real ya[2] = {time, 2 * time};
  Boolean z = noEvent(ya[1] > 1);
end A68cNE46;
//// model: A68cNE47
model A68cNE47
  Real ya[2] = {time, 2 * time};
  Boolean z = noEvent(sum(ya) > 1);
end A68cNE47;
//// model: A68cNE48
model A68cNE48
  Real y = time;
  parameter Boolean c = true;
  Boolean b = time > 1;
  Boolean z = if c then b else noEvent(y > 1);
end A68cNE48;
//// model: A68cNF01
model A68cNF01
  function g input Boolean u; output Boolean v; algorithm v := not u; end g;
  Real y = time;
  Boolean z;
equation
  z = g(noEvent(y > 1));
end A68cNF01;
