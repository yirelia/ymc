end A68cNF10;
//// model: A68cNF11
model A68cNF11
  function g input Boolean u; output Real v; algorithm v := if u then 1 else 2; end g;
  Real y = time;
  Real z;
algorithm
  z := g(noEvent(y > 1));
end A68cNF11;
//// model: A68cNF12
model A68cNF12
  function g input Boolean u; input Real w; output Real v; algorithm v := if u then w else 2; end g;
  Real y = time;
  Real z = g(w = y, u = noEvent(y > 1));
end A68cNF12;
//// model: A68cNF13
model A68cNF13
  function g input Boolean u = true; input Real w; output Real v; algorithm v := if u then w else 2; end g;
  Real y = time;
  Real z = g(w = y);
end A68cNF13;
//// model: A68cNF14
model A68cNF14
  function g input Real u; output Real v; algorithm v := 2 * u; end g;
  Real y = time;
  Real z = g(if noEvent(y > 1) then 1.0 else 2.0);
end A68cNF14;
//// model: A68cNF15
model A68cNF15
  function g input Boolean u[2]; output Real v; algorithm v := if u[1] then 1 else 2; end g;
  Real y = time;
  Real z = g({noEvent(y > 1), true});
end A68cNF15;
//// model: A68cNF16
model A68cNF16
  function g input discrete Real u; output Real v; algorithm v := u; end g;
  Real y = time;
  Real z = g(y);
end A68cNF16;
//// model: A68cNF17
model A68cNF17
  record R Boolean f; Real r; end R;
  Real y = time;
  R a = R(noEvent(y > 1), 1);
