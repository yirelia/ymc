//// model: A68cNG02
model A68cNG02
  function g input Boolean u; output Boolean v; algorithm v := not u; end g;
  Real y = time;
  Boolean b = time > 1;
  discrete Boolean z(start = false);
equation
  when b then
    z = g(noEvent(y > 1));
  end when;
end A68cNG02;
//// model: A68cNG03
model A68cNG03
  function g input Boolean u; output Real v; algorithm v := if u then 1 else 2; end g;
  Real y = time;
  Real z;
initial equation
  z = g(noEvent(y > 1));
equation
  der(z) = 1;
end A68cNG03;
