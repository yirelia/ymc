end AB5;
//// model: AB6
model AB6
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real z[3, 3] = symmetric(m) * time;
end AB6;
//// model: AB7
model AB7
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real y = f(skew(a));
end AB7;
//// model: AB8
model AB8
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real z[3] = cross(a, {time, 1, 2});
end AB8;
//// model: AB9
model AB9
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real y = g(fill(time, 3));
end AB9;
//// model: AB10
model AB10
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real z[3, 3] = outerProduct(a, a) * time;
end AB10;
//// model: AB11
model AB11
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real y = f(diagonal(a) + m);
end AB11;
//// model: AB12
model AB12
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real z[3] = m * a * time;
end AB12;
