//// set: ab-p1 — 别的数组内建作函数实参 / 在整个数组的运算里（transpose / identity 展开、vector 的非字面量实参 SKIP、symmetric、skew、cross、fill、outerProduct、`diagonal(a) + m`、`m * a * time`）对照
//// model: AB1
model AB1
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real z[3, 3] = transpose(m) * time;
end AB1;
//// model: AB2
model AB2
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real y = f(transpose(m));
end AB2;
//// model: AB3
model AB3
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real y = g(vector(m[:, 1]));
end AB3;
//// model: AB4
model AB4
  function f
    input Real m[3, 3];
    output Real y;
  algorithm
    y := m[1, 1] + 2 * m[2, 2] + 3 * m[3, 3] + m[1, 2];
  end f;
  function g
    input Real v[3];
    output Real y;
  algorithm
    y := v[1] + 2 * v[2];
  end g;
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
  Real z[3, 3] = identity(3) * time;
end AB4;
//// model: AB5
model AB5
  function f
    input Real m[3, 3];
