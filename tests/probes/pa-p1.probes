model PA7e
  parameter Real n[3] = {1, 0, 0};
  parameter Integer ni[3] = {1, 2, 3};
  parameter Real e[3](start = {n[1], 2, n[3] * 2}) = nrm(n);
  Real y = e[2] * time;
end PA7e;
