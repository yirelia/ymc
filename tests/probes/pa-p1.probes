end nrm;
model PA7d
  parameter Real n[3] = {1, 0, 0};
  parameter Integer ni[3] = {1, 2, 3};
  parameter Real e[3](start = -n, each nominal = 3) = nrm(n);
  Real y = e[2] * time;
end PA7d;
