//// model: PA7g
function nrm
  input Real v[3];
  output Real r[3];
algorithm
  r := v / sqrt(v * v);
end nrm;
model PA7g
  parameter Real n[3] = {1, 0, 0};
  parameter Integer ni[3] = {1, 2, 3};
  parameter Real e[3](start = n .* n) = nrm(n);
  Real y = e[2] * time;
end PA7g;
//// model: PA7h
function nrm
  input Real v[3];
  output Real r[3];
algorithm
  r := v / sqrt(v * v);
end nrm;
model PA7h
  parameter Real n[3] = {1, 0, 0};
  parameter Integer ni[3] = {1, 2, 3};
  parameter Real e[3](start = n / 2, each fixed = false, min = {-1, -1, -1}) = nrm(n);
  Real y = e[2] * time;
end PA7h;
