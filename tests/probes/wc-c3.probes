//// set: wc-c3 — elsewhen 分支的条件形态
//// model: C30
model C30
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean p = a > 1;
  Boolean q = b > 1;
  Integer k = integer(a);
  Boolean v[2] = {a > 2, b > 2};
  parameter Boolean pb = true;
  parameter Real pr = 1;
  Real y;
equation
  when c > 5 then y = a; elsewhen a > 1 then y = b; end when;
end C30;
