package Lib
  partial model PB
    function f
      input Real u;
      output Real y;
    algorithm
      y := 2 * u;
    end f;
  end PB;
  model M
    extends PB;
    Real x;
  algorithm
    x := f(time);
  end M;
end Lib;
model R68fPRAM01
  Lib.M m;
