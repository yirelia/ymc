//// set: pk-p55r-pp — 68f 重做 S5 已撤：PP 族（omc 整包实例化里的 partial 检查）的控制组与语境用例，留作以后做 PP 的回归守卫
//// model: R68fPPP02
package Lib
  partial package PM
    type T = Real;
  end PM;
  package P
    constant PM.T bad = 1;
    constant Real b = 2;
  end P;
end Lib;
model R68fPPP02
  Real x = time;
end R68fPPP02;
//// model: R68fPPP04
package Lib
  partial package PM
    constant Real k = 1;
  end PM;
  package Q
    function f
      input Real u;
      output Real y = u * PM.k;
    end f;
    constant Real c = 3;
  end Q;
end Lib;
model R68fPPP04
  Real x = Lib.Q.c * time;
end R68fPPP04;
//// model: R68fPPP05
package Lib
  partial package PM
    constant Real k = 1;
  end PM;
  package Q
    function f
      input Real u;
      output Real y = u * PM.k;
    end f;
  end Q;
end Lib;
model R68fPPP05
  Real x = Lib.Q.f(time);
end R68fPPP05;
//// model: R68fPPP06
package Lib
