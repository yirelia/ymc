//// set: nr-n1 — 无返回值的调用：方程 / 算法语句 / 函数体、缺省实参、各语境
//// model: N10
model N10
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  f(t);
end N10;
//// model: N11
model N11
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; Real y = t; algorithm f(t);
end N11;
