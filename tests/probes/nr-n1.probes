  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Boolean b; end f;
equation
  f(t > 1); f(true);
end N136;
//// model: N137
model N137
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  record R Real a; end R; function f input R r; end f; R r(a = t);
equation
  f(r);
end N137;
