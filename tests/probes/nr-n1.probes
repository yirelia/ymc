//// model: N16
model N16
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  if t > 1 then f(t); end if;
end N16;
//// model: N17
model N17
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  if t > 1 then f(t); else f(2 * t); end if;
end N17;
//// model: N18
model N18
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  when t > 1 then f(t); end when;
end N18;
