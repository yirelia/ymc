//// model: N15
model N15
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  for i in 1:2 loop f(x[i]); end for;
