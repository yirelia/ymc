//// set: md-m6 — 逐元素的参数作维：各元素同维 / 参差（参数数组、复合子数组、for 范围、下标、条件组件）
//// model: M60
model M60
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = fill(time, n); end X; X xs[2](n = {3, 3});
end M60;
//// model: M61
model M61
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = fill(time, n); end X; X xs[2](n = {1, 3});
end M61;
//// model: M62
model M62
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = fill(time, n); end X; parameter Integer nn[2] = {3, 3}; X xs[2](n = nn);
end M62;
