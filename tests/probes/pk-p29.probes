//// model: SQM1
package SQM1P
  record R
    Real x;
    Real y;
  end R;
  function f2
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.y := 2 * a;
  end f2;
  function id
    input R r;
    output R s;
  algorithm
    s := r;
    s.x := s.x;
  end id;
end SQM1P;
model SQM1
  parameter Real p = 1;
  parameter SQM1P.R r1 = SQM1P.f2(p);
  final parameter SQM1P.R r2 = SQM1P.id(r1);
end SQM1;
//// model: SQM2
package SQM2P
  record R
    Real x;
    Real y;
  end R;
  function f2
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.y := 2 * a;
  end f2;
  function g
    input R r;
    output R s;
  algorithm
    s.x := r.x + 1;
    s.y := r.y;
  end g;
end SQM2P;
model SQM2
  parameter Real p = 1;
  parameter SQM2P.R r1 = SQM2P.f2(p);
  final parameter SQM2P.R r2 = SQM2P.g(r1);
end SQM2;
//// model: SQM3
package SQM3P
  record R
    Real x;
