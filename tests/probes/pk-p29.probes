  final parameter SQX16P.R r = SQX16P.f(p) annotation(Evaluate = true);
  Real z = r.x * time;
end SQX16;
//// model: SQX17
package SQX17P
  record R
    Real x;
    Real y;
  end R;
  function f
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.x := 2 * r.x;
  end f;
  model M
    parameter Real p = 2;
    final parameter R r = f(p);
  end M;
end SQX17P;
model SQX17
  SQX17P.M m[2](p = {2, 3});
  Real z = m[1].r.x * time;
end SQX17;
//// model: SQX18
package SQX18P
  record R
    Real x;
    Real y;
  end R;
  function f
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.x := 2 * r.x;
  end f;
end SQX18P;
model SQX18
  parameter Real p = 2;
  final parameter SQX18P.R r = if p > 1 then SQX18P.f(p) else SQX18P.f(2 * p);
  Real z = r.x * time;
end SQX18;
//// model: SQY1
package SQY1P
  record R
    Real x;
    Real y;
  end R;
  function f
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.x := 2 * r.x;
  end f;
  function g
    input R r;
    input Real t;
    output Real y;
  algorithm
    y := r.x * t;
    y := y + 1;
  end g;
end SQY1P;
model SQY1
  parameter Real p = 2;
  final parameter SQY1P.R r = SQY1P.f(p) annotation(Evaluate = true);
  Real z = SQY1P.g(r, time);
end SQY1;
