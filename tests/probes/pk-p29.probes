//// model: SQF8
package SQF8P
  record MC
    parameter Real a = 1;
    constant Real c = -1e40;
    parameter Real b = 2;
  end MC;
  record P
    Real u;
    Real v;
  end P;
  function ren
    input MC m;
    output P p;
  algorithm
    p.u := m.a;
    p.v := m.b + 1;
  end ren;
  function g
    input P p;
    output P q;
  algorithm
    q.u := 2 * p.u;
    q.v := p.v;
  end g;
  model Dev
    parameter MC mc annotation(Evaluate = true);
    final parameter P p = ren(mc) annotation(Evaluate = true);
    final parameter P p1 = g(p);
    Real x;
  equation
    x * p1.u = time;
  end Dev;
end SQF8P;
model SQF8
  SQF8P.Dev d(mc = M);
  parameter SQF8P.MC M(a = 3);
end SQF8;
