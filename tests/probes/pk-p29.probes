  algorithm
    r.x := a;
    r.y := 2 * a;
  end f2;
end SQM3P;
model SQM3
  parameter Real p = 1;
  parameter SQM3P.R r1 = SQM3P.f2(p);
  final parameter SQM3P.R r2 = if p > 0 then r1 else SQM3P.R(0, 0);
  parameter Real q = r1.x * 2;
end SQM3;
//// model: SQM4
package SQM4P
  record R
    Real x;
    Real y(fixed = false);
  end R;
  function g
    input R r;
    output R s;
  algorithm
    s.x := r.x + 1;
    s.y := 3;
  end g;
end SQM4P;
model SQM4
  parameter SQM4P.R r1(x = 2);
  final parameter SQM4P.R r2 = SQM4P.g(r1);
end SQM4;
