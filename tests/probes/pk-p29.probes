//// model: SQT6
package SQT6P
  record R
    Real a;
  end R;
  function f
    input Real x;
    output R r;
    output Real y;
  algorithm
    r.a := x;
    y := 2 * x;
  end f;
  function g
    input Real x;
    output Real z;
  protected
    R r;
    Real y;
  algorithm
    (r, y) := f(x);
    z := r.a + y;
  end g;
end SQT6P;
model SQT6
  Real z = SQT6P.g(time);
end SQT6;
