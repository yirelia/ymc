//// model: SQT1
package SQT1P
  record R
    Real a;
  end R;
  function f
    input Real x;
    output R r;
    output Real y;
  algorithm
    r.a := x;
    y := 2 * x;
  end f;
end SQT1P;
model SQT1
  SQT1P.R r;
  Real y;
equation
  (r, y) = SQT1P.f(time);
end SQT1;
