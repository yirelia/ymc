model SQY3
  parameter Real p = 2;
  final parameter SQY3P.R r = SQY3P.f(p);
  parameter Real q = r.y * 2;
  Real z = r.x * time;
end SQY3;
//// model: SQY5
package SQY5P
  record R
    Real x;
    Real y;
  end R;
  function f
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.x := 2 * r.x;
  end f;
end SQY5P;
model SQY5
  parameter Real p = 2;
  final parameter SQY5P.R r = SQY5P.f(p);
  Real z;
equation
  if r.y > 1 then
    z = time;
  else
    z = -time;
  end if;
end SQY5;
