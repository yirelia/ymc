  BCT54_B b;
end BCT54;
//// model: BCT55
model BCT55_A
  constant Real c;
  Real x;
equation
  if c > 1 then
    x = time;
  else
    x = 2 * time;
  end if;
end BCT55_A;
model BCT55_B
  constant Real k = 2;
end BCT55_B;
model BCT55
  BCT55_A a(c = b.k);
  BCT55_B b;
end BCT55;
