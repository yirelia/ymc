  parameter BRG2_R a(x = 3);
  parameter BRG2_R b(x = 4);
  parameter BRG2_R r = if p > 1 then a else b;
end BRG2;
//// model: BRG3
record BRG3_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRG3_R;
function BRG3_f
  input Real u;
  output Boolean b;
algorithm
  b := u > 1;
end BRG3_f;
model BRG3
  parameter Real p(fixed = false) = 2;
  parameter BRG3_R a(x = 3);
  parameter BRG3_R b(x = 4);
  parameter BRG3_R r = if BRG3_f(p) then a else b;
end BRG3;
//// model: BRG4
record BRG4_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRG4_R;
function BRG4_f
  input Real u;
  output Boolean b;
algorithm
  b := u > 1;
end BRG4_f;
model BRG4
  parameter Real q(fixed = false);
  parameter Real p = q;
  parameter BRG4_R a(x = 3);
  parameter BRG4_R b(x = 4);
  parameter BRG4_R r = if BRG4_f(p) then a else b;
initial equation
  q = 2;
end BRG4;
