//// model: BCT53
model BCT53_A
  constant Real c;
  Real x;
equation
  x = c * time;
end BCT53_A;
model BCT53_B
  constant Real k = 2;
end BCT53_B;
model BCT53
  BCT53_A a(c = b.k);
  BCT53_B b;
end BCT53;
