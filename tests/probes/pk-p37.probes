//// model: BRS1
package BRS1P
  type E = enumeration(a, b, c);
  record R
    parameter Real x = 1;
    parameter E e = E.a;
  end R;
  record S
    parameter Integer n = 2;
    parameter R r1;
    parameter R r2;
    parameter R rr[n] = {if i == 1 then r2 else r1 for i in 1:n};
  end S;
  model T
    parameter E e;
    Real y;
  equation
    if e == E.b then
      y = 1;
    else
      y = 2;
    end if;
  end T;
  model C
    parameter R cd;
    T t(final e = cd.e);
  end C;
  model St
    parameter S sd;
    C c[sd.n](cd = sd.rr);
  end St;
end BRS1P;
model BRS1
  parameter BRS1P.R ra(e = BRS1P.E.b);
  parameter BRS1P.R rb;
  parameter BRS1P.S sd(r1 = ra, r2 = rb);
  BRS1P.St st(sd = sd);
end BRS1;
//// model: BRS2
package BRS2P
  type E = enumeration(a, b, c);
  record R
    parameter Real x = 1;
    parameter E e = E.a;
  end R;
  model T
    parameter E e;
    Real y;
  equation
    if e == E.b then
      y = 1;
    else
      y = 2;
    end if;
  end T;
  model C
    parameter R cd;
    T t(final e = cd.e);
  end C;
end BRS2P;
model BRS2
  parameter BRS2P.R ra(e = BRS2P.E.b);
  parameter BRS2P.R rb;
  parameter BRS2P.R rr[2] = {rb, ra};
  BRS2P.C c[2](cd = rr);
end BRS2;
//// model: BRS3
package BRS3P
  type E = enumeration(a, b, c);
  record R
    parameter Real x = 1;
    parameter E e = E.a;
  end R;
  model T
    parameter E e;
    Real y;
  equation
    if e == E.b then
      y = 1;
    else
      y = 2;
    end if;
  end T;
  model C
    parameter R cd;
    T t(final e = cd.e);
  end C;
end BRS3P;
model BRS3
  parameter BRS3P.R ra(e = BRS3P.E.b);
  parameter BRS3P.R rb;
  parameter BRS3P.R rr[2] = {if i == 1 then rb else ra for i in 1:2};
  BRS3P.C c[2](cd = rr);
end BRS3;
