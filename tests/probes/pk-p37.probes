record BRA1_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA1_R;
model BRA1
  parameter BRA1_R a(x = 3);
  parameter BRA1_R b(x = 4);
  parameter BRA1_R c[2] = {a, b};
end BRA1;
//// model: BRA2
record BRA2_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA2_R;
model BRA2
  parameter BRA2_R a(x = 3);
  parameter BRA2_R c[2] = {a for i in 1:2};
end BRA2;
//// model: BRA3
record BRA3_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA3_R;
model BRA3
  parameter BRA3_R a(x = 3);
  parameter BRA3_R b(x = 4);
  parameter BRA3_R c[2] = {if i == 1 then a else b for i in 1:2};
end BRA3;
//// model: BRA4
record BRA4_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA4_R;
model BRA4
  parameter BRA4_R a(x = 3);
  parameter BRA4_R b(x = 4);
  parameter BRA4_R c[2, 2] = {{if i == j then a else b for j in 1:2} for i in 1:2};
end BRA4;
//// model: BRA5
record BRA5_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA5_R;
model BRA5
  parameter Integer k[:, 2] = {{1, 2}};
  parameter BRA5_R a(x = 3);
  parameter BRA5_R b(x = 4);
  parameter BRA5_R c[2, 2] = {{if k[1, 1] == i and k[1, 2] == j then a else b for j in 1:2} for i in 1:2};
end BRA5;
//// model: BRA6
record BRA6_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA6_R;
model BRA6
  import Modelica.Math.BooleanVectors.anyTrue;
  parameter Integer k[:, 2] = {{1, 2}};
  parameter BRA6_R a(x = 3);
  parameter BRA6_R b(x = 4);
  parameter BRA6_R c[2, 2] = {{if anyTrue({i == k[m, 1] and j == k[m, 2] for m in 1:size(k, 1)}) then a else b for j in 1:2} for i in 1:2};
end BRA6;
//// model: BRA7
record BRA7_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA7_R;
model BRA7
  parameter BRA7_R a(x = 3);
  parameter BRA7_R c[2] = fill(a, 2);
end BRA7;
//// model: BRA8
record BRA8_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA8_R;
record BRA8_S
  parameter Integer n;
  parameter BRA8_R a;
  parameter BRA8_R c[n] = {a for i in 1:n};
end BRA8_S;
model BRA8
  parameter BRA8_R a0(x = 5);
  parameter BRA8_S s(n = 2, a = a0);
end BRA8;
//// model: BRA9
record BRA9_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA9_R;
record BRA9_S
  parameter Integer n;
  parameter Integer k[:, 2] = {{0, 0}};
  parameter BRA9_R a;
  parameter BRA9_R b;
  parameter BRA9_R c[n, 2] = {{if k[1, 1] == i and k[1, 2] == j then b else a for j in 1:2} for i in 1:n};
end BRA9_S;
model BRA9
  parameter BRA9_R a0(x = 5);
  parameter BRA9_R b0(x = 6);
  parameter BRA9_S s(n = 2, k = [1, 1], a = a0, b = b0);
end BRA9;
//// model: BRA10
record BRA10_R
  parameter Real x = 1;
  parameter Real y = 2;
end BRA10_R;
record BRA10_S
  import Modelica.Math.BooleanVectors.anyTrue;
  parameter Integer n;
  parameter Integer k[:, 2] = {{0, 0}};
  parameter BRA10_R a;
  parameter BRA10_R b;
  parameter BRA10_R c[n, 2] = {{if anyTrue({i == k[m, 1] and j == k[m, 2] for m in 1:size(k, 1)}) then b else a for j in 1:2} for i in 1:n};
end BRA10_S;
model BRA10
  parameter BRA10_R a0(x = 5);
  parameter BRA10_R b0(x = 6);
  parameter BRA10_S s(n = 2, k = [1, 1], a = a0, b = b0);
end BRA10;
