//// model: E953
model E953
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  constant Real cr = 1.5; Real y;
equation
  when a > 0 then y = pre(cr); end when;
end E953;
//// model: E954
model E954
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  constant Boolean cb = true; Real y;
equation
  when a > 0 then y = if pre(cb) then 1 else 2; end when;
end E954;
