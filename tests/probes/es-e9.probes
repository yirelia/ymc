//// set: es-e9 — pre / change / edge 的常量与结构参数实参；min / max / fill / cat / transpose 的化简
//// model: E90
model E90
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean k = pre(true);
end E90;
