//// model: BX13
model BX13
  record R
    parameter Boolean lin = true;
    parameter Real a = 1;
    parameter Real T[:, 2] = [0, a; 1, 1];
    final parameter Real Ti[:, 2] = if lin then [0, a; 1, 1] else T;
  end R;
  record RE
    extends R(lin = false, T = [0, 0.5; 0.5, 0.7; 1, 1]);
  end RE;
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    output Real y[size(columns, 1)];
  equation
    y = table[1, columns];
  end Tab;
  model Stack
    parameter R cellData;
    Tab t(final table = cellData.Ti);
  end Stack;
  parameter RE r2;
  Stack s2(cellData = r2);
end BX13;
