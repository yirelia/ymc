//// model: BX40
model BX40
  partial record BaseIcon
    constant String CellType = "Cell Data";
  end BaseIcon;
  partial record TransientIcon
    constant String CellType = "Cell Data";
  end TransientIcon;
  record CellData
    extends BaseIcon;
    parameter Real Ri = 1;
    parameter Real R0 = Ri;
  end CellData;
  record RCData
    extends TransientIcon(CellType = "RC elements");
    parameter Real R;
    parameter Real C;
  end RCData;
  record TCellData
    extends CellData(R0 = Ri - sum(rcData.R));
    extends TransientIcon;
    parameter Integer nRC = 1 annotation(Evaluate = true);
    parameter RCData rcData[nRC] = {RCData(R = 0, C = 0)};
  end TCellData;
  record ExampleData
    extends TCellData(CellType = "Example data", nRC = 2,
      rcData = {RCData(R = 0.2 * Ri, C = 60 / (0.2 * Ri)), RCData(R = 0.1 * Ri, C = 10 / (0.1 * Ri))});
  end ExampleData;
  parameter ExampleData cd2(Ri = 2, nRC = 2, rcData = {RCData(R = 0.2 * cd2.Ri, C = 60 / (0.2 * cd2.Ri)), RCData(R = 0.1 * cd2.Ri, C = 10 / (0.1 * cd2.Ri))});
end BX40;
//// model: BX41
model BX41
  partial record TransientIcon
    constant String CellType = "Cell Data";
  end TransientIcon;
  record RCData
    extends TransientIcon(CellType = "RC elements");
    parameter Real R;
    parameter Real C;
  end RCData;
  record TCellData
    parameter Real Ri = 1;
    parameter Integer nRC = 1 annotation(Evaluate = true);
    parameter RCData rcData[nRC] = {RCData(R = 0, C = 0)};
  end TCellData;
  record ExampleData
    extends TCellData(nRC = 2, rcData = {RCData(R = 0.2 * Ri, C = 3), RCData(R = 0.1 * Ri, C = 4)});
  end ExampleData;
  parameter ExampleData cd2;
end BX41;
//// model: BX42
model BX42
  record RC
    parameter Real R = 1;
    parameter Real T = 2;
  end RC;
  record CD
    parameter Integer n = 2;
    parameter RC rc[n] = {RC(R = 1, T = 3), RC(R = 2, T = 4)};
  end CD;
  model Res
    parameter Real R = 1;
    parameter Real T = 0;
  end Res;
  parameter CD cd;
  Res res[cd.n](final R = 2 * cd.rc.R, final T = cd.rc.T);
end BX42;
//// model: BX43
model BX43
  record RC
