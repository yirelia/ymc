//// model: BX15
model BX15
  class EO
    extends ExternalObject;
    function constructor
      input Real table[:, :];
      input Integer columns[:];
      output EO eo;
      external "C" eo = initEO(table, size(table, 1), size(table, 2), columns, size(columns, 1));
    end constructor;
    function destructor
      input EO eo;
      external "C" closeEO(eo);
    end destructor;
  end EO;
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    output Real y[size(columns, 1)];
  protected
    parameter EO tableID = EO(table, columns);
  end Tab;
  parameter Real T[2, 2] = [0, 1; 1, 2];
  Tab t(table = T);
end BX15;
//// model: BX16
model BX16
  record R
    parameter Boolean lin = true;
    parameter Real a = 1;
    parameter Real T[:, 2] = [0, a; 1, 1];
    final parameter Real Ti[:, 2] = if lin then [0, a; 1, 1] else T;
  end R;
  record RE
    extends R(lin = false, T = [0, 0.5; 0.5, 0.7; 1, 1]);
  end RE;
  function f
    input Integer c[:];
    output Real y;
  algorithm
    y := sum(c);
  end f;
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    parameter Real z = f(columns);
  end Tab;
  model Stack
    replaceable parameter R cellData;
    Tab t(final table = cellData.Ti);
  end Stack;
  model Base
    replaceable parameter R cellData;
    replaceable Stack cell;
  end Base;
  model Wrap
    extends Base(redeclare R cellData, redeclare Stack cell(cellData = cellData));
  end Wrap;
  parameter RE cd;
  Wrap w(cellData = cd);
end BX16;
