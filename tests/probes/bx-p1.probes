  parameter Real rr[2] = {1, 2};
  Res res[2](final R = 2 * rr, final T = rr);
end BX44;
//// model: BX45
model BX45
  record R0
    parameter Integer s = 1;
  end R0;
  record R1
    extends R0;
    parameter Real extra = 2;
  end R1;
  model B
    replaceable parameter R0 cellData;
    Real y;
  equation
    if cellData.s == 1 then
      y = 1;
    else
      y = 2;
    end if;
  end B;
  model C
    extends B(redeclare R1 cellData);
  end C;
  parameter R1 cd(s = 2);
  C c(cellData = cd);
end BX45;
