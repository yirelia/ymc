//// set: bx-p1 — MSL Batteries 一路：下标是 Integer 参数数组（BX2、BX5-BX7 `table[1, c]` → 结构参数，BX4 字面量下标数组对照）；`:` 维向前引用、绑定是对已发射数组的引用（记录字段经记录绑定传下来，BX8-BX19，关键是 BX19）；枚举参数经记录字段求值（BX20-BX28，模型里定义的枚举打不出路径 BX22 SKIP）；记录字段自己的 Evaluate = true 在整体绑定的记录里只看 start（BX29 / BX30，此前打 final 并代入，静默错）；记录构造的记录类有继承来的字段（BX31-BX41，常量也是构造输入）；复合数组修饰按元素分发时 cref 的中间段是记录数组（BX42-BX44）；if 方程条件里整体绑定的记录的继承来的字段不算固定、照留 if 方程（BX45-BX54，自己声明的字段 / 结构语境照常求值）
//// model: BX1
model BX1
  record R
    parameter Boolean lin = true;
    parameter Real a = 1;
    parameter Real T[:, 2] = [0, a; 1, 1];
    final parameter Real Ti[:, 2] = if lin then [0, a; 1, 1] else T;
  end R;
  parameter R r;
end BX1;
//// model: BX2
model BX2
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    output Real y[size(columns, 1)];
  equation
    y = table[1, columns];
  end Tab;
  parameter Real T[2, 2] = [0, 1; 1, 2];
  Tab t(table = T);
end BX2;
//// model: BX3
model BX3
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    output Real y[size(columns, 1)];
  end Tab;
  parameter Real T[2, 2] = [0, 1; 1, 2];
  Tab t(table = T);
end BX3;
//// model: BX4
model BX4
  parameter Real table[2, 2] = [0, 1; 1, 2];
  Real y[1];
equation
  y = table[1, {2}];
end BX4;
//// model: BX5
model BX5
  parameter Real table[2, 2] = [0, 1; 1, 2];
  parameter Integer c[1] = {2};
  Real y[1];
equation
  y = table[1, c];
end BX5;
//// model: BX6
model BX6
  parameter Real table[:, :] = [0, 1; 1, 2];
  parameter Integer c[:] = 2:size(table, 2);
  Real y[size(c, 1)];
equation
  y = table[1, c];
end BX6;
//// model: BX7
model BX7
  parameter Real table[2, 2] = [0, 1; 1, 2];
  parameter Integer c[:] = 2:2;
  Real y[1];
equation
  y = table[1, c];
end BX7;
