//// model: BX54
model BX54
  record R0
    parameter Integer s = 1;
  end R0;
  record R1
    extends R0;
    parameter Real extra = 2;
  end R1;
  parameter R1 cd(s = 2);
  parameter R1 c2 = cd;
  parameter Integer k = if c2.s == 1 then 1 else 2;
  Real x[k];
end BX54;
