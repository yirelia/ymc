    parameter Integer n = 2;
    parameter RC rc[n] = {RC(R = 1, T = 3), RC(R = 2, T = 4)};
  end CD;
  parameter CD cd;
  parameter Real s = sum(cd.rc.R);
  parameter Real v[2] = cd.rc.T;
end BX43;
