//// model: BX20
model BX20
  type Sm = enumeration(A, B, C);
  record R
    parameter Sm sm = Sm.B;
  end R;
  block Tab
    parameter Sm smoothness = Sm.A;
    output Real y;
  equation
    if smoothness == Sm.A then
      y = 1;
    elseif smoothness == Sm.B then
      y = 2;
    else
      y = 3;
    end if;
  end Tab;
  model Stack
    parameter R cellData;
    Tab t(final smoothness = cellData.sm);
  end Stack;
  model Wrap
    parameter R cellData;
    Stack cell(cellData = cellData);
  end Wrap;
  parameter R cd(sm = Sm.C);
  Wrap w(cellData = cd);
end BX20;
