  record R0
    parameter Integer s = 1;
  end R0;
  record R1
    extends R0;
    parameter Real extra = 2;
  end R1;
  model B
    replaceable parameter R0 cellData;
    Real y;
  equation
    if cellData.s == 1 then
      y = 1;
    else
      y = 2;
    end if;
  end B;
  model C
    extends B;
  end C;
  parameter R0 cd(s = 2);
  C c(cellData = cd);
end BX47;
//// model: BX48
model BX48
  record R0
    parameter Integer s = 1;
  end R0;
  record R1
    parameter Integer s = 1;
    parameter Real extra = 2;
  end R1;
  model B
    replaceable parameter R0 cellData;
    Real y;
  equation
    if cellData.s == 1 then
      y = 1;
    else
      y = 2;
    end if;
  end B;
  model C
    extends B(redeclare R1 cellData);
  end C;
  parameter R1 cd(s = 2);
  C c(cellData = cd);
end BX48;
