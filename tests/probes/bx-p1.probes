  parameter R c2 = cd;
  Real g = c2.Idis * 2;
end BX30;
//// model: BX31
model BX31
  record Base
    constant String CellType = "Base";
  end Base;
  record RCData
    extends Base(CellType = "RC elements");
    parameter Real R;
    parameter Real T_ref = 293.15;
    parameter Real C;
  end RCData;
  record CellData
    parameter Real Ri = 1;
    parameter Integer nRC = 1 annotation(Evaluate = true);
    parameter RCData rcData[nRC] = {RCData(R = 0, C = 0)};
  end CellData;
  parameter CellData cd(Ri = 2, nRC = 2, rcData = {RCData(R = 0.2 * cd.Ri, C = 60 / (0.2 * cd.Ri)), RCData(R = 0.1 * cd.Ri, C = 10 / (0.1 * cd.Ri))});
end BX31;
