//// model: BX10
model BX10
  record R
    parameter Boolean lin = true;
    parameter Real a = 1;
    parameter Real T[:, 2] = [0, a; 1, 1];
    final parameter Real Ti[:, 2] = if lin then [0, a; 1, 1] else T;
  end R;
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    output Real y[size(columns, 1)];
  equation
    y = table[1, columns];
  end Tab;
  model Stack
    parameter R cellData;
    Tab t(final table = cellData.Ti);
  end Stack;
  parameter R r1(a = 2);
  Stack s(cellData = r1);
end BX10;
//// model: BX11
model BX11
  function f
    input Integer c[:];
    output Real y;
  algorithm
    y := sum(c);
  end f;
  block Tab
    parameter Real table[:, :];
    parameter Integer columns[:] = 2:size(table, 2);
    parameter Real z = f(columns);
  end Tab;
  parameter Real T[2, 2] = [0, 1; 1, 2];
  Tab t(table = T);
end BX11;
