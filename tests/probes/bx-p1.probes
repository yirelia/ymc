//// model: BX29
model BX29
  record R
    parameter Real Idis = 0 annotation(Evaluate = true);
    parameter Real q = 1;
  end R;
  model Stack
    parameter R cellData;
    Real g = cellData.Idis * 2;
  end Stack;
  model Wrap
    parameter R cellData;
    Stack cell(cellData = cellData);
  end Wrap;
  parameter R cd(Idis = 0.001);
  Wrap w(cellData = cd);
end BX29;
