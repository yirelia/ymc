//// model: VB15
model VB15
  function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function h
    input Real x;
    input Real k;
    output Real y;
  algorithm
    y := k * x;
  end h;
  function f
    input Real u[:];
    input Integer k;
    output Real a[size(u, 1) - k + 1];
  algorithm
    a := g(u[k:size(u, 1)]);
  end f;
  Real r[:] = f({time, 2, 3}, 2);
end VB15;
//// model: VFF1
model VFF1
  import Modelica.Math.FastFourierTransform.*;
  parameter Integer ns = realFFTsamplePoints(4, 0.2, f_max_factor = 5);
  Real y_buf[ns](start = vector([6.5; fill(0, ns - 1)]), each fixed = true);
equation
  der(y_buf) = zeros(ns);
end VFF1;
//// model: VFF2
model VFF2
  import Modelica.Math.FastFourierTransform.*;
  parameter Integer ns = 4;
  parameter Integer nfi = 2;
  Real y_buf[ns](each start = 1, each fixed = true);
  Real Ai[nfi](each start = 0, each fixed = true);
  Real Phii[nfi](each start = 0, each fixed = true);
  Integer info(start = 0, fixed = true);
equation
  der(y_buf) = zeros(ns);
algorithm
  when sample(0, 0.1) then
    (info, Ai, Phii) := realFFT(y_buf, nfi);
  end when;
end VFF2;
//// model: VFF4
model VFF4
  function f
    input Real u[:];
    input Integer n;
    output Integer info;
    output Real a[n];
  algorithm
    info := 0;
    a := u[1:n];
  end f;
  Real y[4](each start = 1, each fixed = true);
  Real A[2](each start = 0, each fixed = true);
  Integer info(start = 0, fixed = true);
equation
  der(y) = zeros(4);
algorithm
  when sample(0, 0.1) then
    (info, A) := f(y, 2);
  end when;
end VFF4;
//// model: VFF5
model VFF5
  function f
    input Real u[:];
    input Integer n;
    output Real a[n];
  algorithm
    a := u[1:n];
  end f;
  Real y[4](each start = 1, each fixed = true);
  Real A[2];
equation
  der(y) = zeros(4);
  A = f(y, 2);
end VFF5;
//// model: VFF6
model VFF6
  function f
    input Real u[:];
    input Integer n;
    output Real a[n];
  algorithm
    a := u[1:n];
  end f;
  Real y[4](each start = 1, each fixed = true);
  parameter Integer nfi = 2;
  Real A[nfi];
equation
  der(y) = zeros(4);
  A = f(y, nfi);
end VFF6;
//// model: VFF7
model VFF7
  function f
    input Real u[:];
    input Integer n;
    output Real a[n];
  algorithm
    a := u[1:n];
  end f;
  parameter Integer ns = 4;
  Real y[ns](each start = 1, each fixed = true);
  Real A[2];
equation
  der(y) = zeros(ns);
  A = f(y, 2);
end VFF7;
//// model: VFF8
model VFF8
  function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real u[:];
    input Integer n;
    output Real a[n];
  algorithm
    a := g(u[1:n]);
  end f;
  Real y[4](each start = 1, each fixed = true);
  Real A[2];
equation
  der(y) = zeros(4);
  A = f(y, 2);
end VFF8;
//// model: VFL1
model VFL1
  function f
    input Real u[:];
    input Real p[:] = fill(0.0, 0);
    input Real q[:] = fill(1.0, 2);
    input Real r[:] = zeros(0);
    input Real s[:] = ones(3);
    input Integer k = 2;
    input Real w[:] = fill(2.0, k);
    output Real y;
  protected
    Real a[0] = fill(0.0, 0);
    Real b[2] = fill(1.0, 2);
    Real c[:] = fill(3.0, size(u, 1));
  algorithm
    y := sum(u) + sum(p) + sum(q) + sum(r) + sum(s) + sum(w) + sum(a) + sum(b) + sum(c);
  end f;
  Real y1 = f({time, 2});
  Real y2 = f({time, 2}, fill(0.0, 0));
end VFL1;
//// model: VFL2
model VFL2
  function f
    input Real u[:];
    input Real p[:, :] = fill(0.0, 2, 0);
    input Real q[:, :] = fill(0.0, 0, 2);
    output Real y;
  algorithm
    y := sum(u) + size(p, 1) + size(q, 2);
  end f;
  Real y1 = f({time, 2});
  parameter Real e[0] = fill(0.0, 0);
  Real z[2, 0] = fill(time, 2, 0);
end VFL2;
//// model: VFV5
// name: VFV5
// keywords: vectorization function
// status: correct
//
//

model VFV5
  function mySum
    input Real x;
    input Real y;
    output Real z = x + y;
  end mySum;

  function f
    input Real[:, :] x;
    input Real[:, :] y;
    output Real s = 0.0;
  algorithm
    s := sum(mySum(x, y));
  end f;

  Real x = f({{time, 2, 3}, {4, 5, 6}}, {{1, 2, 3}, {4, 5, 6}});
  Real y = f({{1, 2, 3}, {4, 5, 6}}, {{1, 2, 3}, {4, 5, 6}});
end VFV5;


