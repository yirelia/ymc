//// model: VB12
model VB12
  function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function h
    input Real x;
    input Real k;
    output Real y;
  algorithm
    y := k * x;
  end h;
  function f
    input Real u[:];
    input Integer nfi;
    output Real a[nfi];
  protected
    Real Phi[div(size(u, 1), 2) + 1];
  algorithm
    Phi := u[1:div(size(u, 1), 2) + 1];
    a := Modelica.Units.Conversions.to_deg(Phi[1:nfi]);
  end f;
  Real r[:] = f({time, 2, 3, 4}, 2);
end VB12;
