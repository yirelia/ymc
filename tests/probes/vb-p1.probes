  end f;
  Real r[:] = f({time, 2, 3});
end VB6;
//// model: VB7
model VB7
  function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function h
    input Real x;
    input Real k;
    output Real y;
  algorithm
    y := k * x;
  end h;
  function f
    input Real u[:];
    output Real a[div(size(u, 1), 2) + 1];
  protected
    Real w[div(size(u, 1), 2) + 1];
  algorithm
    w := u[1:div(size(u, 1), 2) + 1];
    a := g(w);
  end f;
  Real r[:] = f({time, 2, 3, 4});
end VB7;
//// model: VB8
model VB8
  function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function h
    input Real x;
    input Real k;
    output Real y;
  algorithm
    y := k * x;
  end h;
  function f
    input Real u[:];
    output Real s;
  algorithm
    s := sum(g(u));
  end f;
  Real r[:] = {f({time, 2, 3})};
end VB8;
//// model: VB9
model VB9
  function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function h
    input Real x;
    input Real k;
    output Real y;
  algorithm
    y := k * x;
  end h;
  function f
    input Real u[3];
    output Real a[3];
  protected
    Real w[3];
  algorithm
    w := u;
    a := g(w);
  end f;
  Real r[:] = f({time, 2, 3});
end VB9;
