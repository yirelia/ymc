//// model: HW12
model HW12
  parameter Integer n = 3;
  discrete Real a[n](each start = 0, each fixed = true);
  Boolean e = time > 0.5;
equation
  when {e, time > 0.8} then
    if edge(e) then
      a = cat(1, {1}, fill(2, n - 1));
    else
      a = cat(1, pre(a[2:end]), {5});
    end if;
  end when;
end HW12;
//// model: HW13
model HW13
  discrete Real x(start = 0, fixed = true);
  Real h = sin(time);
equation
  when time > 0.5 then
    if h < 0.1 then
      x = 1;
    elseif h > 0.5 and time > 0.6 then
      x = 2;
    elseif not (h > 0.5) then
      x = 3;
    else
      x = 4;
    end if;
  end when;
end HW13;
