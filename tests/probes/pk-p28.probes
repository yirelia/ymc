//// model: HW23
model HW23
  parameter Integer Count = 4;
  parameter Real Hsat = 2;
  parameter Real eps = 1e-5;
  Real alpha = sin(time);
  Boolean init3 = time > 0.5;
  Boolean evAsc = time > 0.7;
  Boolean del = time > 0.9;
  discrete Real bSavI(start = 0, fixed = true);
  Real bSav[Count];
initial equation
  bSav = fill(-Hsat, Count);
equation
  when time > 0.2 then
    bSavI = alpha;
  end when;
  when {init3, evAsc, del} then
    if init3 then
      bSav = cat(1, {bSavI}, fill(-Hsat, Count - 1));
    elseif evAsc then
      bSav = if (alpha - eps) > pre(bSav[1]) then cat(1, {alpha}, pre(bSav[1:end - 1])) else pre(bSav);
    elseif del then
      bSav = cat(1, pre(bSav[2:end]), {-Hsat});
    else
      bSav = pre(bSav);
    end if;
  end when;
end HW23;
//// model: HW24
model HW24
  parameter Integer Count = 4;
  parameter Real Hsat = 2;
  Boolean del = time > 0.9;
  Real bSav[Count];
initial equation
  bSav = fill(-Hsat, Count);
equation
  when del then
    bSav = cat(1, pre(bSav[2:end]), {-Hsat});
  end when;
end HW24;
