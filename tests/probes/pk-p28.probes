//// model: HW30
model HW30
  function f
    input Real u;
    output Real a;
    output Real b;
  algorithm
    a := u;
    b := 2 * u;
  end f;
  discrete Real a(start = 0, fixed = true);
  discrete Real b(start = 0, fixed = true);
equation
  when time > 0.5 then
    if time > 0.7 then
      (a, b) = f(time);
    else
      a = 1;
      b = 2;
    end if;
  end when;
end HW30;
