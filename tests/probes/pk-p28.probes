//// model: HW48
model HW48
  function pr
    input String s;
  algorithm
    assert(false, s, AssertionLevel.warning);
  end pr;
  parameter Integer m = 3 annotation(Evaluate = true);
  parameter Integer k = 1;
  final parameter Integer mBasic = integer(m / 1);
equation
  when initial() then
