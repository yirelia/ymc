end WQ165;
//// model: WQ166
model WQ166
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  constant Real q[2] = {f(i) for i in 1:2};
  Real z[2] = q;
end WQ166;
//// model: WQ167
model WQ167
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  constant Integer n = 2;
  constant Real q[n] = {f(i) for i in 1:n};
  Real z[n](each start = 0);
equation
  der(z) = q;
end WQ167;
