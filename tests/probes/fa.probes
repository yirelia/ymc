//// set: fa — 函数注解、derivative / inverse、空 algorithm 段
//// model: EA1
function g
  input Real x;
  output Real y = x;
algorithm
end g;
model EA1
  Real a = g(time);
end EA1;
//// model: EA2
function g
  input Real x;
  output Real y = x;
algorithm
  annotation(Inline = true);
end g;
model EA2
  Real a = g(time);
end EA2;
//// model: EA3
function g
  input Real x;
  output Real y = x;
algorithm
  y := 2 * x;
algorithm
end g;
model EA3
  Real a = g(time);
end EA3;
