//// model: FD0
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = f2);
end f1;
function f2
  input Real x;
  input Real der_x;
  output Real z = 2 * der_x;
end f2;
model FD0
  Real a = f1(1);
  Real b = f1(time);
end FD0;
//// model: FD1
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = f2);
end f1;
function f2
  input Real x;
  input Real der_x;
  output Real z = 2 * der_x;
end f2;
model FD1
  Real a = f1(1);
end FD1;
//// model: FD10
function f1
  input Real x;
  output Real z;
  external "C" z = foo(x) annotation(derivative = f2, Library = "foo");
end f1;
function f2
  input Real x;
  input Real der_x;
  output Real z = 2 * der_x;
end f2;
model FD10
  Real b = f1(time);
end FD10;
//// model: FD2
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = nosuch);
end f1;
model FD2
  Real b = f1(time);
end FD2;
//// model: FD3
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = f2);
end f1;
function f2
  input Real x;
  input Real der_x;
  output Real z = 2 * der_x;
  annotation(derivative = f3);
end f2;
function f3
  input Real x;
  input Real der_x;
  input Real der_der_x;
  output Real z = 2 * der_der_x;
end f3;
model FD3
  Real b = f1(time);
end FD3;
//// model: FD4
package P
  function f1
    input Real x;
    output Real z = 2 * x;
    annotation(derivative = f2);
  end f1;
  function f2
    input Real x;
    input Real der_x;
    output Real z = 2 * der_x;
  end f2;
end P;
model FD4
  Real b = P.f1(time);
end FD4;
//// model: FD5
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = f2, derivative(order = 2) = f3);
end f1;
function f2
  input Real x;
  input Real der_x;
  output Real z = 2 * der_x;
end f2;
function f3
  input Real x;
  input Real der_x;
  input Real der_der_x;
  output Real z = 2 * der_der_x;
end f3;
model FD5
  Real b = f1(time);
end FD5;
//// model: FD6
function f
  input Real x;
  input Real y;
  output Real z = x * y;
  annotation(inverse(y = g(x, sin(z))));
end f;
function g
  input Real x;
  input Real z;
  output Real y = z / x;
end g;
model FD6
  Real b = f(time, 2);
end FD6;
//// model: FD6b
function f
  input Real x;
  input Real y;
  output Real z = x * y;
  annotation(inverse(y = g(x, sin(z))));
end f;
function g
  input Real x;
  input Real z;
  output Real y = z / x;
end g;
model FD6b
  Real b = f(time, 2);
end FD6b;
//// model: FD7
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = f1);
end f1;
model FD7
  Real b = f1(time);
end FD7;
//// model: FD8
function g
  input Real x;
  output Real y = h(x);
end g;
function h
  input Real x;
  output Real z = 2 * x;
  annotation(derivative = dh, Inline = true);
end h;
function dh
  input Real x;
  input Real der_x;
  output Real z = 2 * der_x;
end dh;
model FD8
  Real b = g(time);
end FD8;
//// model: FD9
model FD9
  function f1
    input Real x;
    output Real z = 2 * x;
    annotation(derivative = f2);
  end f1;
  function f2
    input Real x;
    input Real der_x;
    output Real z = 2 * der_x;
  end f2;
  Real b = f1(time);
end FD9;
//// model: FE0
function f
  input Real r;
  output Real o[0];
end f;
model FE0
  Real r[0];
algorithm
  r := f(time);
end FE0;
//// model: FE1
function f
  input Real r;
  output Real o[0];
end f;
model FE1
  Real r[0] = f(time);
  Real s[0];
equation
  s = f(2 * time);
end FE1;
//// model: FE2
function g
  input Real x;
  output Real y[2] = {x, x};
end g;
function h
  input Real x;
  output Real y[3] = {x, x, x};
end h;
model FE2
  parameter Boolean pt = true;
  Real a[2] = if pt then g(time) else h(time);
end FE2;
//// model: FE3
function g
  input Real x;
  output Real y = 2 * x;
end g;
model FE3
  parameter Integer n = 2;
  parameter Real m = g(n) + n;
  Real z[n];
end FE3;
//// model: FE4
function g
  input Real x;
  output Real y = 2 * x;
end g;
model FE4
  parameter Integer n = 2;
  Real z[n];
  Real w = g(n * time);
  Real v = g(n + 1) * time;
end FE4;
//// model: FE5
record R
  Real a;
  Integer b;
end R;
model FE5
  parameter Integer n = 2;
  Real z[n];
  R r = R(time, n);
end FE5;
//// model: FE6
function g
  input Real x;
  output Real y;
  external "C" y = sin(x);
end g;
model FE6
  parameter Integer n = 2;
  Real z[n];
  Real w = g(n);
end FE6;
