//// set: rp-p5 — if 条件里的参数声明在后（向前引用）：修饰 / 记录 / 嵌套实例 / Evaluate = false / fixed = false（含声明在前的对照）
//// model: Q1
model F
  parameter Integer n = 1;
  Real x;
equation
  if n > 1 then
    x = 1;
  else
    x = 2;
  end if;
end F;
model Q1
  parameter Integer k(fixed = false);
  F f(n = k);
initial equation
  k = 2;
end Q1;
//// model: P50
model F
parameter Integer n = 1;
Real x;
equation
if n > 1 then
x = 1;
else
x = 2;
end if;
end F;
model P50
F f(n = k);
parameter Integer k = 2;
end P50;
//// model: P51
model F
parameter Integer n = 1;
Real x;
equation
if n > 1 then
x = 1;
else
x = 2;
end if;
end F;
model P51
F f(n = k);
parameter Integer k = j + 1;
parameter Integer j = 1;
end P51;
//// model: P52
model F
parameter Integer n = 1;
Real x[3];
equation
for i in 1:3 loop
if i <= n then
x[i] = 1;
else
x[i] = 2;
end if;
end for;
end F;
model P52
F f(n = k);
parameter Integer k = 2;
end P52;
//// model: P53
record R
parameter Real a = 1;
end R;
model F
parameter Real a = 1;
Real tau;
equation
if a <= 0 then
tau = 0;
else
tau = time;
end if;
end F;
model P53
F f(a = data.a);
parameter R data(a = 0);
end P53;
//// model: P54
record R
parameter Real a = 1;
end R;
model F
parameter R fp;
Real tau;
equation
if fp.a <= 0 then
tau = 0;
else
tau = time;
end if;
end F;
model G
F f(fp = d);
parameter R d;
end G;
model P54
G g(d = data);
parameter R data(a = 0);
end P54;
//// model: P55
model F
parameter Integer n = 1;
Real x;
equation
if n > 1 then
x = 1;
else
x = 2;
end if;
end F;
model P55
F f(n = k);
parameter Integer k = 2 annotation(Evaluate = false);
end P55;
//// model: P56
model F
parameter Boolean b = false;
Real x;
equation
if b then
x = 1;
else
x = 2;
end if;
end F;
model P56
F f(b = c);
parameter Boolean c = not d;
parameter Boolean d = false;
end P56;
//// model: P57
model F
parameter Integer n = 1;
Real x;
equation
if n > 1 then
x = 1;
else
x = 2;
end if;
end F;
model P57
F f(n = k), g(n = f.n + 1);
parameter Integer k = 0;
end P57;
//// model: P58
model F
parameter Integer n = 1;
Real x;
equation
if n > 1 then
x = 1;
else
x = 2;
end if;
end F;
model P58
F f(n = k);
parameter Integer k(fixed = false);
initial equation
k = 2;
end P58;
