//// set: xo-e3 — if 方程 / if 式的条件参数顺绑定到外部函数调用：定型期认外部函数 → 不固定，条件照留
//// model: E30
pure function g
input Real x;
output Real y;
external "C" y = gext(x);
end g;
model E30
parameter Real p = g(1);
Real x;
equation
if p > 0 then
x = 1;
else
x = 2;
end if;
end E30;
//// model: E31
function g
input Real x;
output Real y;
external "C" y = gext(x);
end g;
model E31
parameter Real p = g(1);
Real x;
equation
if p > 0 then
x = 1;
else
x = 2;
end if;
end E31;
//// model: E32
function g
input Real x;
output Real y;
algorithm
y := 2 * x;
end g;
model E32
parameter Real p = g(1);
Real x;
equation
if p > 0 then
x = 1;
else
x = 2;
end if;
end E32;
//// model: E33
pure function g
input Real x;
output Real y;
external "C" y = gext(x);
end g;
model E33
parameter Real p = g(1);
parameter Real q = p;
Real x;
equation
if q > 0 then
x = 1;
else
x = 2;
end if;
end E33;
//// model: E34
pure function g
input Real x;
output Real y;
external "C" y = gext(x);
end g;
model E34
parameter Real p = g(1);
Real x = if p > 0 then 1 else 2;
end E34;
