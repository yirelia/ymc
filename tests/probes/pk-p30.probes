      output State s;
    end setState;
  end PM;
  partial package PMix
    extends PM(nX = 2);
    redeclare replaceable record extends State
      Real X[nX];
    end State;
  end PMix;
  package Gas
    extends PMix;
    redeclare record extends State
    end State;
    redeclare function extends setState
    algorithm
      s := State(p = p, X = fill(0.5, nX));
    end setState;
  end Gas;
  model C
    replaceable package Medium = PM;
    Medium.State s = Medium.setState(time);
  end C;
end XM32P;
model XM32
  XM32P.C c(redeclare package Medium = XM32P.Gas);
end XM32;
//// model: XM33
package XM33P
  partial package PM
    constant Integer nX = 1;
    replaceable record State
      Real p;
    end State;
  end PM;
  partial package PMix
    extends PM(nX = 2);
    redeclare replaceable record extends State
      Real X[nX];
    end State;
  end PMix;
  package Gas
    extends PMix;
    redeclare record extends State
    end State;
    function h
      input Real p;
      output Real y;
    protected
      State s;
    algorithm
      s := State(p = p, X = fill(0.5, nX));
      y := s.p + s.X[2];
    end h;
  end Gas;
end XM33P;
model XM33
  parameter Real p0 = XM33P.Gas.h(1.0);
  Real y = XM33P.Gas.h(time);
end XM33;
