//// set: pk-p30 — 定义层的包查名经包实例（66v，omc 进类查名前一律 Inst.instPackage，NFLookup.lookupLocalName :699-700 / lookupCrefInNode :976-977）：经带修饰 extends 的包（全路径 / import 别名 / 函数体 / 包常量绑定，XM1-XM15、XM56-XM64）取改过的常量与类型、函数按访问路径命名（XM4 `import M = P.A` → `P.A.f`）；继承来的类（XM16-XM20）、定义层短类（XM24-XM30，记录短类 `record iter = accuracy` 的 `iter.delp`）；class extends 记录在包实例里构造（XM31-XM33，MSL ReferenceAir.MoistAir1）；短类包的类修饰 `package M = A(T(max = 5))`（XM34-XM43、XM58，MSL SimpleLiquidWater）；限定类型路径经继承 / 短类按访问路径命名记录构造函数（XM21 / XM23 / XM45 / XM46 / XM48 / XM49 / XM51 / XM52 / XM55，此前静默错）；包 / 记录的限定词核查（XMR1-XMR6，omc 报 "Variable p in package A is not constant"）；括号单元素元组的赋值目标（XMT*，MSL Air_Utilities.airBaseProp_pT）；integer() 的实参提 Real（XMI*，MSL R134a FindInterval）；照旧 SKIP：经 extends 修饰重声明的记录类型的常量数组（XMM1，MSL MixtureGases）、extends 短类后的 class extends（XMC1，MSL TestTwoPhaseStates）、函数里记录数组局部的绑定（XMC2，MSL MoistAir 一族的 Gibbs）、枚举类型路径（XM44 / XM57）、无修饰继承的函数里的记录（XM50）；挪成初始方程的记录字段被结构用法读到（XMY*，omc 报 "has neither value nor start value"，此前 ACCEPTS-INVALID / 静默错）
//// model: XM1
package XM1P
  package Base
    constant Integer n = 1;
    function f
      input Real x;
      output Real y;
    algorithm
      y := x * n;
    end f;
  end Base;
  package A
    extends Base(n = 2);
  end A;
end XM1P;
model XM1
  Real y = XM1P.A.f(time);
end XM1;
