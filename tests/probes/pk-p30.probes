//// model: XMM1
package XMM1P
  record FCBase
    Real Tc;
  end FCBase;
  record FCData
    extends FCBase;
    Real M;
  end FCData;
  partial package Base
    constant Integer nX = 2;
    replaceable record FC = FCBase;
    constant FC[nX] fc;
    function f
      input Real x;
      input Integer i;
      output Real y;
    algorithm
      y := x * fc[i].Tc;
    end f;
  end Base;
  package Gas
    extends Base(redeclare record FC = FCData, fc = {FCData(Tc = 1.5, M = 2), FCData(Tc = 2.5, M = 3)});
  end Gas;
end XMM1P;
model XMM1
  package M = XMM1P.Gas;
  Real y = M.f(time, 1);
end XMM1;
