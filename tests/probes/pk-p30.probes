//// model: XM31
package XM31P
  partial package PM
    constant Integer nX = 1;
    replaceable record State
      Real p;
    end State;
    replaceable function setState
      input Real p;
      output State s;
    end setState;
    function h
      input Real p;
      output Real y;
    protected
      State s;
    algorithm
      s := setState(p);
      y := s.p;
    end h;
  end PM;
  partial package PMix
    extends PM(nX = 2);
    redeclare replaceable record extends State
      Real X[nX];
    end State;
  end PMix;
  package Gas
    extends PMix;
    redeclare record extends State
    end State;
    redeclare function extends setState
    algorithm
      s := State(p = p, X = fill(0.5, nX));
    end setState;
  end Gas;
  model C
    replaceable package Medium = PM;
    parameter Real p0 = Medium.h(1.0);
  end C;
end XM31P;
model XM31
  XM31P.C c(redeclare package Medium = XM31P.Gas);
end XM31;
//// model: XM32
package XM32P
