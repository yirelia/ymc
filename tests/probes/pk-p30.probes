//// model: XMI4
model XMI4
  discrete Integer k(start = 1);
  Integer m;
equation
  when sample(0, 1) then
    k = pre(k) + 1;
  end when;
  m = integer(div(k, 2));
end XMI4;
//// model: XMI5
model XMI5
  parameter Integer p = 3;
  Integer m = integer(p);
  Integer m2 = integer(div(p, 2));
end XMI5;
//// model: XMI7
model XMI7
  discrete Integer k(start = 1);
  Integer m;
equation
  when sample(0, 1) then
    k = pre(k) + 1;
  end when;
  m = integer(k) + integer(k / 2);
end XMI7;
//// model: XMN3
model XMN3
  discrete Integer k(start = 1);
  Real r;
equation
  when sample(0, 1) then
    k = pre(k) + 1;
  end when;
  r = sqrt(-(-k));
end XMN3;
