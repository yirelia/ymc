    constant Integer n = 1;
    function f
      input Real x;
      output Real y;
    algorithm
      y := x * n;
    end f;
  end Base;
  package A
    extends Base(n = 2);
    function g
      input Real x;
      output Real y;
    algorithm
      y := f(x) + h(x);
