//// model: XM24
package XM24P
  package Inverses
    record accuracy
      constant Real delp = 0.1;
      constant Real delh = 1e-9;
    end accuracy;
    function dofp
      input Real p;
      input Real delp;
      output Real d;
    algorithm
      d := p * delp;
    end dofp;
  end Inverses;
  record iter = Inverses.accuracy;
  function g
    input Real p;
    output Real d;
  algorithm
    d := Inverses.dofp(p = p, delp = iter.delp);
  end g;
end XM24P;
model XM24
  Real y = XM24P.g(time);
end XM24;
