function f input Real u; output Real y; algorithm assert(u > 0, getInstanceName()); y := u; end f;
model M Real t = f(time); end M;
//// model: A68bGI7
package A constant String s = getInstanceName(); end A;
package B extends A; end B;
model M String t = B.s; end M;
//// model: A68bGI8
model M parameter String s = getInstanceName(); end M;
//// model: A68bGI9
package P constant String s = getInstanceName(); end P;
package Q = P;
model M String t = Q.s; end M;
//// model: A68bGI10
record R String s = getInstanceName(); end R;
model M R r; end M;
//// model: A68bGI11
package P constant String s = getInstanceName(); end P;
model M import P.s; String t = s; end M;
//// model: A68bGI12
package P model A constant String s = getInstanceName(); end A; constant A a; end P;
model M String t = P.a.s; end M;
//// model: A68bGI13
model A String s = getInstanceName(); end A;
model M A a[2]; A b; end M;
//// model: A68bGI14
package P constant String s = getInstanceName(); model A String t = s; end A; end P;
model M P.A a; end M;
//// model: A68bGI15
function f output String s = getInstanceName(); algorithm end f;
model M String t = f(); end M;
//// model: A68bGI16
package P function f output String s = getInstanceName(); algorithm end f; constant String k = f(); end P;
model M String t = P.k; end M;
//// model: A68bGI17
model M String s = getInstanceName(1); end M;
//// model: A68bGI18
model M constant String s = getInstanceName(); String t = s; end M;
//// model: A68bOP1
operator record C
  Real re;
  Real im;
  encapsulated operator 'constructor'
    import C;
    function fromReal
      input Real re;
      input Real im = 0.0;
      output C result(re = re, im = im);
    algorithm
      annotation(Inline = true);
    end fromReal;
  end 'constructor';
  encapsulated operator '-'
    import C;
    function neg
      input C a;
      output C r;
    algorithm
      r := C(-a.re, -a.im);
    end neg;
    function sub
      input C a;
      input C b;
      output C r;
    algorithm
      r := C(a.re - b.re, a.im - b.im);
    end sub;
  end '-';
  encapsulated operator function '+'
    import C;
    input C a;
    input C b;
    output C r;
  algorithm
    r := C(a.re + b.re, a.im + b.im);
  end '+';
  encapsulated operator function '0'
    import C;
    output C r;
  algorithm
    r := C(0, 0);
  end '0';
  encapsulated operator function 'not'
    import C;
    input C a;
    output C r;
  algorithm
    r := C(a.im, a.re);
  end 'not';
  encapsulated operator function 'String'
    import C;
    input C a;
    input String j = "j";
    output String s;
  algorithm
    s := String(a.re) + j;
  end 'String';
end C;
model M C c = C(1, 2); C d = not c; end M;
