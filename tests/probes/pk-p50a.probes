package Q = P(redeclare replaceable function func input Real a; input Real b = 8; output Real y; algorithm y := a - b; end func constrainedby f(b = 9));
model M Real x = Q.func(15.0); end M;
//// model: A68bCC35
function f input Real a; input Real b = 2; output Real y; algorithm y := a + b; end f;
function g input Real a; input Real b = 7; output Real y; algorithm y := a * b; end g;
package P replaceable function func = f; end P;
package Q extends P; redeclare replaceable function func input Real a; input Real b = 8; output Real y; algorithm y := a - b; end func constrainedby f(b = 9); end Q;
model M Real x = Q.func(time); end M;
//// model: A68bCC36
record S Real a = 1; end S;
package P replaceable record R Real a = 1; end R constrainedby S(a = 3); end P;
model M P.R r = P.R(); end M;
//// model: A68bCC37
record S Real a = 1; end S;
package P replaceable record R = S constrainedby S(a = 3); record T = R; end P;
model M P.T r = P.T(); end M;
//// model: A68bCC38
record S Real a = 1; end S;
package P replaceable record R = S constrainedby S(a = 3); end P;
model M P.R r = P.R(a = 4); end M;
//// model: A68bCC39
function f input Real a; input Real b = 2; output Real y; algorithm y := a + b; end f;
function h = f(c = 1);
model M Real x = h(time); end M;
//// model: A68bCC40
function f input Real a; input Real b = 2; output Real y; algorithm y := a + b; end f;
function h = f(y = 1);
model M Real x = h(1.0); end M;
//// model: A68bCE13
partial function f input Real u = 1; end f;
function h = f(u = 3);
package P1 replaceable function f = h; end P1;
package P2 extends P1; redeclare function extends f output Real y = u; end f; end P2;
model M Real x = P2.f(); end M;
//// model: A68bCE14
partial function f input Real u = 1; end f;
package P1 replaceable function f = .f; end P1;
package P2 extends P1; redeclare function extends f output Real y = u; end f; end P2;
model M Real x = P2.f(); end M;
//// model: A68bEX44
function mysin input Real u; output Real y; external "C" y = sin(u); end mysin;
function g input Real u; input Real w = mysin(u) + 1; output Real y; algorithm y := u + w; end g;
model M parameter Real p = 1; Real x = g(p); Real z = g(time); end M;
//// model: A68bEX45
function mysin input Real u; output Real y; external "C" y = sin(u); end mysin;
function g input Real u; input Real w = mysin(u); output Real y; algorithm y := u + w; end g;
model M constant Real x = g(1.0); end M;
//// model: A68bOP36
operator record C
  Real re;
  Real im;
  encapsulated operator 'constructor'
    import C;
    function fromReal
      input Real re;
      input Real im = 0.0;
      output C result(re = re, im = im);
    algorithm
      annotation(Inline = true);
    end fromReal;
  end 'constructor';
  encapsulated operator '-'
    import C;
    function neg
      input C a;
      output C r;
    algorithm
      r := C(-a.re, -a.im);
    end neg;
    function sub
      input C a;
      input C b;
      output C r;
    algorithm
      r := C(a.re - b.re, a.im - b.im);
    end sub;
  end '-';
  encapsulated operator function '+'
    import C;
    input C a;
    input C b;
    output C r;
  algorithm
    r := C(a.re + b.re, a.im + b.im);
  end '+';
  encapsulated operator function '0'
    import C;
    output C r;
  algorithm
    r := C(0, 0);
  end '0';
  encapsulated operator function 'not'
    import C;
    input C a;
    output C r;
  algorithm
    r := C(a.im, a.re);
  end 'not';
  encapsulated operator function 'String'
    import C;
    input C a;
    input String j = "j";
    output String s;
  algorithm
    s := String(a.re) + j;
  end 'String';
end C;
model M C c = C(time, 2); C d = (c); end M;
