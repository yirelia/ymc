operator record C
  Real re;
  Real im;
  encapsulated operator 'constructor'
    import C;
    function fromReal
      input Real re;
      input Real im = 0.0;
      output C result(re = re, im = im);
    algorithm
      annotation(Inline = true);
    end fromReal;
  end 'constructor';
  encapsulated operator '-'
    import C;
    function neg
      input C a;
      output C r;
    algorithm
      r := C(-a.re, -a.im);
    end neg;
    function sub
      input C a;
      input C b;
      output C r;
    algorithm
      r := C(a.re - b.re, a.im - b.im);
    end sub;
  end '-';
  encapsulated operator function '+'
    import C;
    input C a;
    input C b;
    output C r;
  algorithm
    r := C(a.re + b.re, a.im + b.im);
  end '+';
  encapsulated operator function '0'
    import C;
    output C r;
  algorithm
    r := C(0, 0);
  end '0';
  encapsulated operator function 'not'
    import C;
    input C a;
    output C r;
  algorithm
    r := C(a.im, a.re);
  end 'not';
  encapsulated operator function 'String'
    import C;
    input C a;
    input String j = "j";
    output String s;
  algorithm
    s := String(a.re) + j;
  end 'String';
end C;
model M C c = C(time, 2); C d = +c; end M;
