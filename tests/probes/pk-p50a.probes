//// set: pk-p50a — 68b 评审时主代理手写的对抗形状（不来自代理的生成器）。OB：构造函数输出绑定里的自调用；EX：external "C" 内建等价函数的常量求值；UC：无绑定包常量；GI：包和函数里的 getInstanceName；OP：'not' / 'String' / sum 重载、`+r`、`-(-r)`；CC：约束修饰并入函数、重声明、构造调用；CF：组件里继承来的函数；CE：class extends 短类基类；RC：记录短类构造；SD：spatialDistribution；EM：空数组与结构条件；RS：类体限定词；IN：语法错的变体。
//// model: A68bOB1
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end C1;
model M parameter C1 c = C1(1.0, 2.0); end M;
