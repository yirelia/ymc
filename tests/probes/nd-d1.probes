//// model: D112
model D112
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[2] = {a.j, b.j};
end D112;
//// model: D113
model D113
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[a.j] = fill(time, a.j);
end D113;
//// model: D114
model D114
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[a.j];
equation
  for i in 1:a.j loop z[i] = i; end for;
end D114;
//// model: D115
model D115
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[4];
equation
  for i in 1:a.j loop z[i] = i; end for;
end D115;
//// model: D116
model D116
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[4];
equation
  for i in 1:a.p loop z[i] = i; end for; for i in 3:4 loop z[i] = 0; end for;
end D116;
//// model: D117
model D117
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[2];
equation
  for i in 1:a.p loop z[i] = a.p * time; end for;
end D117;
//// model: D118
model D118
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z = if a.j > 3 then 1 else time;
end D118;
//// model: D119
model D119
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z = if a.p > 1 then 1 else time;
end D119;
