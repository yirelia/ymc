//// set: nd-d1 — 维里的子实例常量 / 参数 `a.j`、`a.p`、`c[2].j`、记录参数字段、子实例数组的 size、ndims、矩阵字面量
//// model: D10
model D10
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z[a.j];
end D10;
