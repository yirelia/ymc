//// set: v4-f — 同上（分组 f）
//// model: F0
function F
  input Real a;
  input Real b;
  output Real c = a + b;
end F;
function G
  input Real a[3];
  output Real c = a[1];
end G;
function H
  input Real a;
  output Real c[2] = {a, a};
end H;
model F0
  parameter Real q[3] = {1, 2, 3};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real r1 = sum(if i == 2 then time else 1.0 for i in 1:3);
end F0;
