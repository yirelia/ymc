//// set: km-ut — 修饰里的类重声明（单测原文）：extends 修饰（引写修饰的类的参数）、组件声明修饰、短类修饰
//// model: KMU1
model KMU1
  model X
    parameter Real p = 1;
    Real z = p;
  end X;
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C
    parameter Real q = 6;
    extends A(redeclare model B = X(p = q));
  end C;
  model A2 = A(redeclare model B = X(p = 4));
  C c;
  A a(redeclare model B = X);
  A2 a2;
end KMU1;
