end P2_varmember;
//// model: P3
model P3
  Real x;
equation
  1 = "a";
end P3;
//// model: P3_parammember
record R
  Real x = 1.0;
  Real y = 2.0;
end R;
model P3_parammember
  parameter R r = R(4.0, 5.0);
  parameter Real p = r.x;
end P3_parammember;
//// model: P4
model P4
  Real x = sin("a");
end P4;
//// model: P4_consteq
record R
  Real x = 1.0;
  Real y = 2.0;
end R;
model P4_consteq
  constant R r1;
  Real a;
equation
  a = r1.x;
end P4_consteq;
//// model: P5
model P5
  Real x;
equation
  if 1 then x = 1; end if;
end P5;
//// model: P5_barevar
record R
  Real x = 1.0;
  Real y = 2.0;
  Real z = 3.0;
end R;
model P5_barevar
  R r;
end P5_barevar;
//// model: P6
model P6
  Real x = true + 1;
end P6;
//// model: P_2b
model P_2b
