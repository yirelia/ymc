model P_enum1
  type E = enumeration(a, b, c);
  Real x[E];
end P_enum1;
//// model: P_enum1lit
model P_enum1lit
  type E = enumeration(only);
  Real x[E];
end P_enum1lit;
//// model: P_enum_pkg
package Pk
  type E = enumeration(a, b, c);
end Pk;
model P_enum_pkg
  Real x[Pk.E];
end P_enum_pkg;
//// model: P_enum_val
model P_enum_val
  type E = enumeration(a, b, c);
  E y[E];
end P_enum_val;
//// model: P_for_enum
model P_for_enum
  type E = enumeration(a, b, c);
  Real x[E];
equation
  for i in E loop
    x[i] = 1.0;
  end for;
end P_for_enum;
//// model: P_model_b
model A_mb
  Real a;
end A_mb;
model P_model_b
  model B = A_mb[Boolean];
  B b;
end P_model_b;
//// model: P_nested
package Outer
  package Inner
    type E = enumeration(a, b);
  end Inner;
end Outer;
model P_nested
  Real x[Outer.Inner.E];
end P_nested;
//// model: P_param_b
model P_param_b
  parameter Real x[Boolean] = {1.0, 2.0};
end P_param_b;
//// model: P_ref_cross
model P_ref_cross
  Real x[Boolean];
equation
  x[true] = x[false] + 1.0;
end P_ref_cross;
//// model: P_ref_enum
model P_ref_enum
  type E = enumeration(a, b);
  Real x[E];
equation
  x[E.a] = 1.0;
  x[E.b] = 2.0;
end P_ref_enum;
//// model: P_ref_eq
model P_ref_eq
  Real x[Boolean];
equation
  x[false] = 1.0;
  x[true] = 2.0;
end P_ref_eq;
//// model: P_ref_whole
model P_ref_whole
  Real x[Boolean];
  Real y[Boolean];
equation
  y = x;
end P_ref_whole;
//// model: P_start_b
model P_start_b
  Real x[Boolean](start = {1.0, 2.0});
end P_start_b;
//// model: P_subtype
model P_subtype
  type E = enumeration(a, b, c);
  type R = Real;
  R x[E];
end P_subtype;
//// model: P_sum
model P_sum
  Real x[Boolean];
  Real s;
equation
  s = sum(x);
  x[false] = 1.0;
  x[true] = 2.0;
end P_sum;
//// model: P_typedef_b
model P_typedef_b
  type Reals = Real[Boolean];
  Reals x;
end P_typedef_b;
//// model: P_typedef_b2
model P_typedef_b2
  type Reals = Real[Boolean];
  Reals x[2];
end P_typedef_b2;
//// model: Partial
connector C
  Real e;
  flow Real f;
end C;
model M
  C c1[2,2], c2[2,2];
equation
  connect(c1[1], c2[2]);
end M;
//// model: ProbeArr
model ProbeArr
  Real x[3];
equation
  x[1] = 1.0;
  x[2] = 2.0;
  x[3] = 3.0;
end ProbeArr;
//// model: ProbeCast
model ProbeCast
  Real y;
  constant Integer k = 3;
equation
  y = k;
end ProbeCast;
//// model: ProbeCbrt
model ProbeCbrt
  constant Real a = cbrt(8.0);
  constant Real b = cbrt(-8.0);
  constant Real c = cbrt(2.0);
  constant Real d = cbrt(0.0);
end ProbeCbrt;
//// model: ProbeDiscreteCond
model ProbeDiscreteCond
  discrete Boolean b;
  Real x;
equation
  if b then
    x = 1;
  else
    x = 2;
  end if;
end ProbeDiscreteCond;
//// model: ProbeIfConst
model ProbeIfConst
  Real x;
  constant Boolean b = true;
algorithm
  if b then
    x := 1.0;
  else
    x := 2.0;
  end if;
end ProbeIfConst;
//// model: ProbeIfRT
model ProbeIfRT
  Real x;
algorithm
  if time > 1.0 then
    x := 1.0;
  else
    x := 2.0;
  end if;
end ProbeIfRT;
//// model: ProbeNE
model ProbeNE
  Real x = noEvent(time);
  Boolean b = noEvent(time > 0.5);
  constant Real c = noEvent(2.0 + 3.0);
  constant Integer i = noEvent(integer(3.7));
  Real z = smooth(0, time);
end ProbeNE;
//// model: ProbeNE2
model ProbeNE2
  Real x = noEvent(time);
  constant Real c = noEvent(2.0 + 3.0);
  constant Integer i = noEvent(integer(3.7));
  constant Boolean cb = noEvent(1 > 0);
end ProbeNE2;
//// model: ProbeNoEvent
model ProbeNoEvent
  Real x = noEvent(time);
  Real y = noEvent(time > 0.5);
  constant Real c = noEvent(2.0 + 3.0);
  constant Real d = noEvent(sin(1.0));
end ProbeNoEvent;
//// model: ProbeParamCond
model ProbeParamCond
  parameter Boolean p = false;
  Real x;
equation
  if p then
    x = 1;
  else
    x = 2;
  end if;
end ProbeParamCond;
//// model: ProbeParamRel
model ProbeParamRel
  parameter Real k = 5;
  Real x;
equation
  if k > 0 then
    x = 1;
  else
    x = 2;
  end if;
end ProbeParamRel;
//// model: ProbePure
function g
  input Real x;
  output Real y = x;
end g;

model ProbePure
  Real x = pure(g(time));
  constant Real c = pure(1.0 + 2.0);
end ProbePure;
//// model: ProbePure2
function g
  input Real x;
  output Real y = x;
end g;

model ProbePure2
  Real x = pure(g(time));
  constant Real c = pure(g(2.0));
end ProbePure2;
//// model: ProbeStr
model ProbeStr
  constant String a = String(2.0);
  constant String b = String(1.0 / 3.0);
  constant String c = String(100000.0);
  constant String d = String(1234567.0);
  constant String e = String(0.0001);
  constant String f = String(0.00001);
  constant String g = String(1e6);
  constant String h = String(-234.54);
  constant String i = String(1.5);
  constant String j = String(123.456789);
  constant String k = String(-42);
  constant String l = String(0);
  constant String m = String(2.0e-10);
  constant String n = String(3.14159265358979);
end ProbeStr;
//// model: ProbeTimeParam
model ProbeTimeParam
  parameter Real k = 5;
  Real x;
equation
  if time > k then
    x = 1;
  else
    x = 2;
  end if;
end ProbeTimeParam;
//// model: ProbeWhile
model ProbeWhile
  Real x;
algorithm
  x := 0.0;
  while x < 3.0 loop
    x := x + 1.0;
  end while;
end ProbeWhile;
//// model: RecConn
record R
  Real r2;
  Real r1;
end R;
connector C
  R e;
  flow R f;
end C;
model A
  C c;
end A;
model M
  A m1;
end M;
//// model: Sc2
model Sc2
  function f
    input Real[:] rs;
    output Integer i;
  algorithm
    i := scalar(size(rs));
  end f;
  function g
    input Real[:] rs;
    output Integer i;
  algorithm
    i := size(rs, 1);
  end g;
  Real r5 = f({1, 1, 1});
  Real r6 = g({1, 1, 1});
end Sc2;
//// model: ScalarArrElem
connector C
  Real e;
  flow Real f;
end C;
model ScalarArrElem
  C c1[2], c2[2];
equation
  connect(c1[1], c2[1]);
  connect(c1[2], c2[2]);
end ScalarArrElem;
//// model: Step
connector C
  Real e;
  flow Real f;
end C;
model M
  C c1[4], c2[2];
equation
  connect(c1[1:2:4], c2);
end M;
//// model: T
model T
  Real x[3] = {1,2,3};
equation
  der(x) = -x;
end T;
//// model: T2
model T
  Real x[3] = {1.0, 2.0, 3.0};
end T;
//// model: TD
model TD
  type E = enumeration(a, b, c);
  Real x[Boolean];
  Real y[E];
end TD;
//// model: TI
model TI
  input Real a;
  input Real b = 2.0;
end TI;
//// model: ThreeWay
connector C
  Real e;
  flow Real f;
end C;
model ThreeWay
  C c1, c2, c3;
equation
  connect(c1, c2);
  connect(c2, c3);
end ThreeWay;
//// model: UT
model UT
  Real x "cx";
  Integer n;
algorithm
  x := 1 "sc";
  n := 2;
end UT;
//// model: WA
model M
  Real x[3];
  Real y[3];
equation
  y = x;
end M;
//// model: YmcConn2D
connector C
  Real e;
  flow Real f;
end C;

model YmcConn2D
  C c1[2,2], c2[2,2];
equation
  connect(c1, c2);
end YmcConn2D;
//// model: YmcConnArrProbe
connector C
  Real e[2];
  flow Real f[2];
end C;

model YmcConnArrProbe
  C c1[3], c2[3];
equation
  connect(c1, c2);
end YmcConnArrProbe;
//// model: YmcConnElemArrMem
connector C
  Real e[2,2];
  flow Real f[2];
end C;

model YmcConnElemArrMem
  C c1[2], c2[2];
equation
  connect(c1[2], c2[1]);
end YmcConnElemArrMem;
//// model: YmcMix
package YmcMix
  connector C
    Real e2;
    Real e1;
    flow Real f2;
    flow Real f1;
  end C;
  connector N2
    flow Real z;
    Real a;
    C b;
    Real c;
  end N2;
  model M
    N2 n1, n2;
  equation
    connect(n1, n2);
  end M;
end YmcMix;
//// model: YmcOrder
package YmcOrder
  connector C
    Real e2;
    Real e1;
    flow Real f2;
    flow Real f1;
  end C;
  connector N
    C q;
    C p;
  end N;
  model Flat
    C a, b;
  equation
    connect(a, b);
  end Flat;
  model Nested
    N n1, n2;
  equation
    connect(n1, n2);
  end Nested;
end YmcOrder;
//// model: YmcRecConn
package YmcRecConn
  record R
    Real r2;
    Real r1;
  end R;
  connector C
    R e;
    flow R f;
  end C;
  model M
    C c;
  end M;
  model Unconnected
    M m1;
  end Unconnected;
  model Connected
    M m1, m2;
  equation
    connect(m1.c, m2.c);
  end Connected;
end YmcRecConn;
//// model: YmcSets
package YmcSets
  connector C
    Real e;
    flow Real f;
  end C;
  model A
    C c;
  end A;
  model ChainOut
    C c1, c2, c3;
  equation
    connect(c1, c2);
    connect(c2, c3);
  end ChainOut;
  model StarOut
    C c1, c2, c3;
  equation
    connect(c1, c2);
    connect(c1, c3);
  end StarOut;
  model ChainIn
    A a, b, d;
  equation
    connect(a.c, b.c);
    connect(b.c, d.c);
  end ChainIn;
  model Mixed
    A a, b;
    C c1;
  equation
    connect(a.c, c1);
    connect(c1, b.c);
  end Mixed;
  model ChainOutRev
    C c1, c2, c3;
  equation
    connect(c2, c3);
    connect(c1, c2);
  end ChainOutRev;
  model InRevOperands
    A a, b;
  equation
    connect(b.c, a.c);
  end InRevOperands;
  model InFwdOperands
    A a, b;
  equation
    connect(a.c, b.c);
  end InFwdOperands;
  model Star4
    C c1, c2, c3, c4;
  equation
    connect(c3, c1);
    connect(c2, c1);
    connect(c1, c4);
  end Star4;
end YmcSets;
//// model: YmcSigns
package YmcSigns
  connector C
    Real e;
    flow Real f;
  end C;
  model A
    C c;
  end A;
  model InOutOut
    A a; C c1, c2;
  equation
    connect(a.c, c1);
    connect(c1, c2);
  end InOutOut;
  model InInOutOut
    A a, b; C c1, c2;
  equation
    connect(a.c, c1);
    connect(b.c, c2);
    connect(c1, c2);
  end InInOutOut;
  model OutInIn
    A a, b; C c1;
  equation
    connect(c1, a.c);
    connect(a.c, b.c);
  end OutInIn;
  model InOut
    A a; C c1;
  equation
    connect(c1, a.c);
  end InOut;
end YmcSigns;
//// model: YmcSlice
package YmcSlice
  connector C
    Real e;
    flow Real f;
  end C;
  model Partial
    C c1[2,2], c2[2,2];
  equation
    connect(c1[1], c2[2]);
  end Partial;
  model Desc
    C c1[3], c2[3];
  equation
    connect(c1[3:-1:1], c2);
  end Desc;
  model Step
    C c1[4], c2[2];
  equation
    connect(c1[1:2:4], c2);
  end Step;
end YmcSlice;
