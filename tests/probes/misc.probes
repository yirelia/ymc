//// set: misc — 各桶零散探针（早期，按文件名看主题）
//// model: AE
model AE
  Real x[2];
  Real y[2];
  Real s;
equation
  x = -y;
  y = s * x;
end AE;
//// model: BothInside
connector C
  Real e;
  flow Real f;
end C;
model A
  C c;
end A;
model BothInside
  A a1, a2;
equation
  connect(a1.c, a2.c);
end BothInside;
//// model: CA2vars
model CA2vars
  connector InReal = input Real;
  connector OutReal = output Real;
  parameter Integer p = 3;
  InReal x[p];
  OutReal y[p+1];
end CA2vars;
//// model: CR
model CR
  record R
    Real x;
    Real y;
  end R;
  constant R r = R(3.0, 4.0);
  Real a = r.x;
  parameter R p = R(5.0, 6.0);
end CR;
//// model: CRU
record R
  Real x;
end R;
model M
  constant R r = R(1.0);
end M;
//// model: CausalScalar
model CausalScalar
  connector InReal = input Real;
  connector OutReal = output Real;
  InReal x;
  OutReal y;
equation
  connect(x, y);
end CausalScalar;
//// model: DINT
model DINT
  Real x = time;
  Integer i = integer(x);
  Boolean b = x > 0.5;
end DINT;
//// model: DINT2
model DINT2
  discrete Integer i = 1;
end DINT2;
//// model: DV
model M
  Integer i;
  Integer j;
  Real r;
equation
  r = i / j;
end M;
//// model: Desc
connector C
  Real e;
  flow Real f;
end C;
model M
  C c1[3], c2[3];
equation
  connect(c1[3:-1:1], c2);
end M;
//// model: DisjointTwo
connector C
  Real e;
  flow Real f;
end C;
model DisjointTwo
  C a1, a2, b1, b2;
equation
  connect(a1, a2);
  connect(b1, b2);
end DisjointTwo;
//// model: E1
model E1
  type Reals = Real[3];
  Reals x;
end E1;
//// model: E10
model A
  Real p;
  Real q;
end A;
model E10
  model B = A[2,3];
  B b;
end E10;
//// model: E11
model A
  Real p;
end A;
model E11
  model B = A[3];
  B b[2];
end E11;
//// model: E12
model E12
  type R = Real[3];
  R x = {1,2,3};
end E12;
//// model: E13
record A
  Real p;
end A;
model E13
  type B = A[2];
  B b;
end E13;
//// model: E2
model E2
  type Reals = Real[3];
  Reals[4] x;
end E2;
//// model: E3
model E3
  type Reals = Real[3];
  Reals[4] x[2];
end E3;
//// model: E4
model E4
  type Mat = Real[2,3];
  Mat x;
end E4;
//// model: E5
model E5
  type Mat = Real[2,3];
  Mat x[4];
end E5;
//// model: E6
model E6
  type Ints = Integer[2];
  Ints x;
end E6;
//// model: E7
model E7
  type Bools = Boolean[2];
  Bools x;
end E7;
//// model: E8
model E8
  type E = enumeration(a, b, c);
  type R = Real[E];
  R x;
end E8;
//// model: E9
model E9
  type R = Real[Boolean];
  R x;
end E9;
//// model: E_enumcolon
model E_enumcolon
  type E = enumeration(:);
  Real x[E];
end E_enumcolon;
//// model: E_int
model E_int
  Real x[Integer];
end E_int;
//// model: E_real
model E_real
  Real x[Real];
end E_real;
//// model: E_string
model E_string
  Real x[String];
end E_string;
//// model: EqPlace
connector C
  Real e;
  flow Real f;
end C;
model M
  C c1, c2;
  Real x;
equation
  x = 1;
  connect(c1, c2);
end M;
//// model: FN
function f
  input Real x;
  output Real y = 2*x;
end f;
model M
  Real b = f(time);
end M;
//// model: FS
model FS
  Real x[3];
algorithm
  for i in 1:3 loop
    x[i] := 2*i;
  end for;
end FS;
//// model: Flat
connector C
  Real e2;
  Real e1;
  flow Real f2;
  flow Real f1;
end C;
model M
  C a, b;
equation
  connect(a, b);
end M;
//// model: GN
function g
  input Real x;
  output Real y;
protected
  Real t1 = t2;
  Real t2 = 2*x;
algorithm
  y := t1 + 1;
end g;
model M
  Real b = g(time);
end M;
//// model: IFBR
model IFBR
  Real x, y;
equation
  if time > 1 then
    x = 1;
    y = 2;
  else
    x = 3;
  end if;
end IFBR;
//// model: I_bind
model I_bind
  Real x[2] = {1.0, 2.0};
end I_bind;
//// model: I_bind_param
model I_bind_param
  parameter Real x[2] = {1.0, 2.0};
end I_bind_param;
//// model: IfSimp
model IfSimp
  Real x;
  Real y;
  Boolean b1 = if x > 0 then true else false;
  Boolean b2 = if x > 0 then false else true;
  Boolean b3 = if not (x > 1) then false else true;
  Real z = if x > 2 then y else y;
equation
  x = time;
  y = 2 * time;
end IfSimp;
//// model: MM2vars
connector S
  Real r;
  flow Real f;
  stream Real s;
end S;
model A
  parameter Boolean cond = true;
  S s1(f(min = if cond then 0 else -1)), s2(f(min = if cond then 0 else 1));
end A;
model M
  A a;
end M;
//// model: M_ic
model A_ic
  Real a;
end A_ic;
model M_ic
  A_ic b[2];
end M_ic;
//// model: Mix
connector C
  Real e2;
  Real e1;
  flow Real f2;
  flow Real f1;
end C;
connector N2
  flow Real z;
  Real a;
  C b;
  Real c;
end N2;
model M
  N2 n1, n2;
equation
  connect(n1, n2);
end M;
//// model: NLB
model NLB
  Real y[3];
  Real x[3] = y;
  Real w[3] = 2*y;
  parameter Real p[3] = {1,2,3};
  parameter Real q[3] = p;
  parameter Integer ip[3] = {1,2,3};
  parameter Real r[3] = ip;
end NLB;
//// model: Nested
connector C
  Real e2;
  Real e1;
  flow Real f2;
  flow Real f1;
end C;
connector N
  C q;
  C p;
end N;
model M
  N n1, n2;
equation
  connect(n1, n2);
end M;
//// model: OrderTrap
connector C
  Real v;
  flow Real i;
end C;
model A
  C c;
end A;
model M
  C p;
  A a;
equation
  connect(a.c, p);
end M;
//// model: P1
model P1
  Real x = "a" + 1;
end P1;
//// model: P1_wholecopy
record R
  Real x = 1.0;
  Real y = 2.0;
end R;
model P1_wholecopy
  R r1 = R(4.0, 5.0);
  R r2 = r1;
end P1_wholecopy;
//// model: P2
model P2
  Real x = if time > 0 then 1 else "a";
end P2;
//// model: P2_varmember
record R
  Real x = 1.0;
  Real y = 2.0;
end R;
model P2_varmember
  R r = R(4.0, 5.0);
