//// model: for1
function f
  input Integer n;
  output Integer res;
algorithm
  res := 0;
  for i in 1:3 loop
    res := res + i;
  end for;
end f;
model M
  constant Integer a = f(10);
end M;
//// model: for2
function f
  input Integer n;
  output Integer res = 0;
algorithm
  for i in 1:n loop
    res := res + i;
  end for;
end f;
model M
  constant Integer a = f(3);
end M;
