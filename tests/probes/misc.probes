  Real x[E] = {1.0, 2.0, 3.0};
end P_bind_e;
//// model: P_bool_in_bind
model P_bool_in_bind
  Real x[Boolean];
  Real y;
equation
  y = x[true];
  x[false] = 0.0;
  x[true] = 1.0;
end P_bool_in_bind;
//// model: P_comp_b
model A_comp
  Real a;
end A_comp;
model P_comp_b
  A_comp b[Boolean];
end P_comp_b;
//// model: P_der
model P_der
  Real x[Boolean];
equation
  der(x[true]) = x[false];
  x[false] = 1.0;
end P_der;
