//// model: P_alias
model P_alias
  type E = enumeration(a, b);
  type TE = E;
  Real x[TE];
end P_alias;
//// model: P_b2
model P_b2
  Real x[Boolean, 2];
end P_b2;
//// model: P_bb
model P_bb
