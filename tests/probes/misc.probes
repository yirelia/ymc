model pC
  Real x[3](start = {1,2,3});
  Real y = x[2];
end pC;
//// model: pe
model M
  parameter Real a = 1.0;
  parameter Real b = a + 1.0;
  Real x(start = a);
  Real y = b;
  Real z(fixed = c);
  parameter Boolean c = true;
equation
  der(x) = -1;
  der(y) = 0;
end M;
//// model: pf
model M
  Real x;
  Real y = x + (1 + 2);
end M;
//// model: pr
model P
  Real a, b, c;
equation
  a = (-a)^2.0;
  a = a*(-b);
  a = -(a*b);
  a = a*(-2.0);
  a = a*(-1);
  a = a/(b*c);
  a = (a + b)*c;
end P;
//// model: probe_r6
model ProbeR6
  Real x(start = 1), y, z;
equation
  der(x) = -x + y;
  y = 2*z + x;
  z = 1 - 0.5*y;
end ProbeR6;
//// model: probe_r6_arr
model ProbeR6Arr
  parameter Real k = 2;
  Real v[2](each start = 0);
  Real w = k * v[1];
equation
  der(v) = -k * v + {1, 2};
end ProbeR6Arr;
//// model: probe_r6_nl
model ProbeR6NL
  Real x(start = 1), y, z;
equation
  der(x) = -x + y;
  y = sin(z) + x;
  z = y*y - 3;
end ProbeR6NL;
