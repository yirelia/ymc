model AttrProbe
  Real r(start = 10, min = -100, max = 100, nominal = 1, unit = "kg", fixed = true, unbounded = true, quantity = "m", displayUnit = "mm");
  Integer i(min = -100, max = 100, start = 10, fixed = true, quantity = "c");
  Boolean b(start = false, fixed = true, quantity = "flag");
  String s(start = "hi", fixed = true, quantity = "name");
  Real p(stateSelect = StateSelect.prefer);
end AttrProbe;
