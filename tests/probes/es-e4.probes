model E411
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = String(1) + "x";
end E411;
//// model: E412
model E412
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = "a" + "b" + "c";
end E412;
//// model: E413
model E413
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = String(2 * 3);
end E413;
