model E48
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = String(true);
end E48;
//// model: E49
model E49
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = String(a);
end E49;
//// model: BASE
model BASE
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
end BASE;
//// model: E410
model E410
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = "x" + String(a);
end E410;
