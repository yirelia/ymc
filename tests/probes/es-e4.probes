//// set: es-e4 — array(…) 与 String(…)、字符串拼接
//// model: E40
model E40
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[3] = array(1, 2, 3);
end E40;
//// model: E41
model E41
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[3] = array(a, b, c);
end E41;
//// model: E42
model E42
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[2, 2] = array({a, b}, {c, a});
end E42;
//// model: E43
model E43
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Integer n[2] = array(1, 2);
end E43;
//// model: E44
model E44
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[1] = array(a);
end E44;
//// model: E45
model E45
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  String s = String(1) + String(1.5) + String(true);
end E45;
