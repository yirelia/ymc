//// model: J10
model M
constant Real k = 2;
outer Real x;
end M;
model J10
inner Real x = 1;
Real y = M.k;
end J10;
//// model: J11
model M
model Base
Real z;
end Base;
outer Real x;
end M;
model J11
extends M.Base;
inner Real x = 1;
end J11;
//// model: J12
model M
function f
input Real u;
output Real y;
algorithm
y := u;
end f;
outer Real x;
end M;
model J12
inner Real x = 1;
Real y = M.f(time);
end J12;
