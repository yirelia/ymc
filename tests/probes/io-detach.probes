//// set: io-detach — omc 查名穿过类时把它整个实例化（instPackage），里面的 outer 沿词法外层找不到 inner 就生成：类型名 `P.M.J` / extends `M.Base` / 类里自引 `A.NestedA`（InnerOuter13）→ TOP_LEVEL_OUTER 或多出变量（SKIP）；简单名、经包、常量与函数引用不触发
//// model: I90
package P
model Mito
model Jox_
outer Real cv;
Real y = cv;
end Jox_;
P.Mito.Jox_ jox;
end Mito;
model Cyto
inner Real cv = 1;
P.Mito mito;
end Cyto;
end P;
model I90
P.Cyto cyto;
inner Real cv = cyto.cv;
end I90;
