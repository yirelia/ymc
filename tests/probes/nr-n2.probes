//// set: nr-n2 — 无返回值的调用：常量实参、impure / external、非法形态
//// model: N20
model N20
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  impure function f input Real u; end f;
equation
  f(1.0);
end N20;
//// model: N21
model N21
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  impure function f input Real u; output Real v = u; end f;
equation
  f(1.0);
end N21;
//// model: N22
model N22
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; external "C" ff(u); end f;
equation
  f(1.0);
end N22;
//// model: N23
model N23
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; function g input Real u; algorithm f(1.0); f(u); end g;
equation
  g(t);
end N23;
//// model: N24
model N24
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; function g input Real u; output Real v; algorithm f(1.0); v := u; end g; Real y = g(t);
end N24;
//// model: N25
model N25
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; function g input Real u; output Real v; algorithm f(1.0); v := u; end g; Real y = g(2);
end N25;
