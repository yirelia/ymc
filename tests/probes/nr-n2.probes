//// model: N233
model N233
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; Real y = t; algorithm f(t); f(2 * t); y := 1;
end N233;
//// model: N234
model N234
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; discrete Real y;
equation
  when t > 1 then y = 1; f(t); end when;
end N234;
//// model: N235
model N235
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  partial function pf input Real u; end pf; function f extends pf; end f;
equation
  f(t);
end N235;
//// model: N236
model N236
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; output Real v; algorithm v := u; return; end f; Real y = f(t);
end N236;
