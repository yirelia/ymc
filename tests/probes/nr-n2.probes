end N211;
//// model: N212
model N212
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; algorithm assert(u > 0, "neg"); end f;
equation
  f(-1.0);
end N212;
