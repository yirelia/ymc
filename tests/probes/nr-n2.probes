model N26
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; Real y = t; algorithm f(1.0);
end N26;
//// model: N27
model N27
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; Real y = t; algorithm f(1.0); y := 2;
