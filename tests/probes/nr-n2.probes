//// model: N221
model N221
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  when t > 1 then f(1.0); end when;
end N221;
//// model: N222
model N222
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  if t > 1 then f(1.0); end if;
end N222;
//// model: N223
model N223
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  if t > 1 then f(1.0); else f(t); end if;
end N223;
//// model: N224
model N224
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  for i in 1:2 loop f(i); end for;
end N224;
//// model: N225
model N225
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f;
equation
  for i in 1:2 loop f(i * t); end for;
end N225;
