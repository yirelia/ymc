//// model: N28
model N28
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; Real y; algorithm y := 2; f(1.0); f(t);
end N28;
