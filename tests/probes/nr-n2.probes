//// model: N210
model N210
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; parameter Real p = 1; Real z[integer(p)];
equation
  f(p);
end N210;
//// model: N211
model N211
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; constant Real c = 1;
equation
