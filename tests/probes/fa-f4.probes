//// set: fa-f4 — 函数体里的数组运算：Integer 数组的整体转型
//// model: F40
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  v := n .* u;
  o := 0;
end h;
model F40
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F40;
