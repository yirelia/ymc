//// model: VE26
model VE26
  function f
    input Real r;
    output Real y;
  algorithm
    y := 2 * r;
  end f;
  parameter Real a[3] = {1, 2, 3};
  model S
    Real y = time;
  end S;
  parameter Real p[3] = f(a);
  S s if p[2] > 1;
  Real x;
equation
  der(x) = p[1];
end VE26;
//// model: VE27
model VE27
  function f
    input Real r;
    output Real y;
  algorithm
    y := 2 * r;
  end f;
  parameter Real a[3] = {1, 2, 3};
  parameter Real p[3] = f(a);
  Real x;
equation
  if p[2] > 1 then
    der(x) = p[1];
  else
    der(x) = 0;
  end if;
end VE27;
