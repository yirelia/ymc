//// model: VE24
model VE24
  function f
    input Real r;
    output Real y;
  algorithm
    y := 2 * r;
  end f;
  parameter Real a[3] = {1, 2, 3};
  parameter Real p[3] = f(a);
  Real x[integer(p[2])];
equation
  for i in 1:4 loop der(x[i]) = p[1]; end for;
end VE24;
