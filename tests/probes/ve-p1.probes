//// model: VE11
model VE11
  function f
    input Real r;
    input Real s = 1;
    output Real y;
  algorithm
    y := 2 * r + s;
  end f;
  parameter Real a[2, 2] = {{1, 2}, {3, 4}};
  parameter Real p[2, 2] = f(a, 3) annotation(Evaluate = true);
  Real x;
equation
  der(x) = p[2, 1];
end VE11;
