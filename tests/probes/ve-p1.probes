//// set: ve-p1 — Evaluate / 结构参数数组的绑定是向量化调用（`to_unit1(r - r_shape)`、`f(a)`、`f(a, b)`、二维、带缺省实参）或书写的推导式：结构求值逐元素求出字面量；函数是否照打看 omc 压平变量的绑定是否还是推导式（Evaluate / 别的 Evaluate 参数读到 → 照打；维 / 条件在定型期求值过 → 不打；嵌在运算 / 外层调用里的被化简掉 → 不打）；压平期（if 方程条件、for 范围）才标的元素绑定照旧是符号式、只加 final；标量 / 非向量化的数组调用对照；记录绑定经 from_nxy 式函数（A 支）。单测取 VE8 / VE25 / VE23 / VE39
//// model: VE1
model VE1
  function to_unit1
    input Real r;
    output Real result(unit = "1");
  algorithm
    result := r;
    annotation(Inline = true);
  end to_unit1;
  model B
    parameter Real r[3](start = {0.1, 0, 0});
    parameter Real r_shape[3] = {0, 0, 0};
    parameter Real lengthDirection[3] = to_unit1(r - r_shape) annotation(Evaluate = true);
    Real x;
  equation
    der(x) = lengthDirection[1];
  end B;
  B b(r = {0.5, 0, 0});
end VE1;
//// model: VE2
model VE2
  record Rec
    Real T[3, 3];
    Real w[3];
  end Rec;
  function mk
    input Real n[3];
    input Real w[3];
    output Rec R;
  protected
    Real a = sqrt(n * n);
  algorithm
    R := Rec(T = {n / a, w, {0, 0, 1}}, w = zeros(3));
  end mk;
  function to_unit1
    input Real r;
    output Real result(unit = "1");
  algorithm
    result := r;
    annotation(Inline = true);
  end to_unit1;
  model B
    parameter Real r[3](start = {0.1, 0, 0});
    parameter Real r_shape[3] = {0, 0, 0};
    parameter Real lengthDirection[3] = to_unit1(r - r_shape) annotation(Evaluate = true);
    parameter Real widthDirection[3] = {0, 1, 0} annotation(Evaluate = true);
    final parameter Rec R = mk(r, widthDirection);
    Real x;
  equation
    der(x) = R.T[1, 1] + lengthDirection[2];
  end B;
  B b(r = {0.5, 0, 0});
end VE2;
//// model: VE3
model VE3
  record Rec
    Real T[3, 3];
    Real w[3];
  end Rec;
  function mk
    input Real n[3];
    input Real w[3];
    output Rec R;
  protected
    Real a = sqrt(n * n);
  algorithm
    R := Rec(T = {n / a, w, {0, 0, 1}}, w = zeros(3));
  end mk;
  function to_unit1
    input Real r;
    output Real result(unit = "1");
  algorithm
    result := r;
    annotation(Inline = true);
  end to_unit1;
  model B
    parameter Real r[3](start = {0.1, 0, 0}) = {2, 0, 0};
    parameter Real r_shape[3] = {0, 0, 0};
    parameter Real lengthDirection[3] = to_unit1(r - r_shape) annotation(Evaluate = true);
    parameter Real widthDirection[3] = {0, 1, 0} annotation(Evaluate = true);
    final parameter Rec R = mk(r, widthDirection);
    Real x;
  equation
    der(x) = R.T[1, 1] + lengthDirection[2];
  end B;
  B b;
end VE3;
//// model: VE4
model VE4
  record Rec
    Real T[3, 3];
    Real w[3];
  end Rec;
  function mk
    input Real n[3];
    input Real w[3];
    output Rec R;
  protected
    Real a = sqrt(n * n);
  algorithm
    R := Rec(T = {n / a, w, {0, 0, 1}}, w = zeros(3));
  end mk;
  function to_unit1
    input Real r;
    output Real result(unit = "1");
  algorithm
    result := r;
    annotation(Inline = true);
  end to_unit1;
  model B
    parameter Real r[3](start = {0.1, 0, 0});
    parameter Real r_shape[3] = {0, 0, 0};
    parameter Real lengthDirection[3] = to_unit1(r - r_shape);
    parameter Real widthDirection[3] = {0, 1, 0} annotation(Evaluate = true);
    final parameter Rec R = mk(r, widthDirection);
    Real x;
  equation
    der(x) = R.T[1, 1] + lengthDirection[2];
  end B;
  B b(r = {0.5, 0, 0});
end VE4;
//// model: VE5
model VE5
  function len
    input Real v[:];
    output Real result;
  algorithm
    result := sqrt(v * v);
  end len;
  model S
    parameter Real d = 1;
    Real y = d * time;
  end S;
  model B
    parameter Real r[3](start = {0.1, 0, 0});
    parameter Real r_shape[3] = {0, 0, 0};
    parameter Real length = len(r - r_shape);
    parameter Real dia = length / 4;
    S s(d = dia) if dia > 0;
    Real x;
  equation
    der(x) = length;
  end B;
  B b(r = {0.5, 0, 0});
end VE5;
//// model: VE6
model VE6
  record Orientation
    Real T[3, 3];
    Real w[3];
  end Orientation;
  function from_nxy
    input Real n_x[3];
    input Real n_y[3];
    output Orientation R;
  protected
    Real abs_n_x = sqrt(n_x * n_x);
    Real e_x[3] = if abs_n_x < 1.e-10 then {1, 0, 0} else n_x / abs_n_x;
    Real n_z_aux[3] = cross(e_x, n_y);
    Real n_y_aux[3] = if n_z_aux * n_z_aux > 1.0e-6 then n_y else (if abs(e_x[1]) > 1.0e-6 then {0, 1, 0} else {1, 0, 0});
    Real e_z_aux[3] = cross(e_x, n_y_aux);
    Real e_z[3] = e_z_aux / sqrt(e_z_aux * e_z_aux);
  algorithm
    R := Orientation(T = {e_x, cross(e_z, e_x), e_z}, w = {0, 0, 0});
  end from_nxy;
  function to_unit1
    input Real r;
    output Real result(unit = "1");
  algorithm
    result := r;
    annotation(Inline = true);
  end to_unit1;
  model B
    parameter Real r[3](start = {0.1, 0, 0});
    parameter Real r_shape[3] = {0, 0, 0};
    parameter Real lengthDirection[3] = to_unit1(r - r_shape) annotation(Evaluate = true);
    parameter Real widthDirection[3] = {0, 1, 0} annotation(Evaluate = true);
    final parameter Orientation R = from_nxy(r, widthDirection);
    Real x;
  equation
    der(x) = R.T[2, 2] + lengthDirection[1];
  end B;
  B b(r = {0.5, 0.5, 0});
end VE6;
//// model: VE7
model VE7
  function f
    input Real r;
    output Real y;
  algorithm
    y := 2 * r;
  end f;
  parameter Real a = 3;
  parameter Real p = f(a) annotation(Evaluate = true);
  Real x;
equation
  der(x) = p;
end VE7;
