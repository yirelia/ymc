//// set: dm-s1 — 整段范围切片 `x[1:3]` → `x[:]`：各种形态与语境
//// model: S10
model S10
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = x[1:3];
end S10;
//// model: S11
model S11
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = x[1:1:3];
end S11;
//// model: S12
model S12
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = x[{1, 2, 3}];
end S12;
//// model: S13
model S13
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = x[3:-1:1];
end S13;
//// model: S14
model S14
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[2] = x[1:2];
end S14;
//// model: S15
model S15
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[2] = x[2:3];
end S15;
//// model: S16
model S16
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = x[1:end];
end S16;
//// model: S17
model S17
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = x[:];
end S17;
//// model: S18
model S18
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer n = 3; Real y[3] = x[1:n];
end S18;
//// model: S19
model S19
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  constant Integer c = 3; Real y[3] = x[1:c];
end S19;
//// model: BASE
model BASE
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
end BASE;
//// model: S110
model S110
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer n = 1; Real y[3] = x[n:3];
end S110;
//// model: S111
model S111
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[2] = m[1:2, 1];
end S111;
