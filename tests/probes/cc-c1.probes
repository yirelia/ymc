//// model: C20
connector H
Real T;
flow Real Q;
end H;
connector PBase
end PBase;
connector PSM
extends PBase;
parameter Boolean u(start = true) annotation(Evaluate = true);
H h if u;
end PSM;
model AmbBase
replaceable PBase tp;
end AmbBase;
model Amb
parameter Boolean u(start = true) annotation(Evaluate = true);
extends AmbBase(redeclare final PSM tp(final u = u));
end Amb;
model C20
Amb amb(u = false);
end C20;
