//// set: cc-c1 — 条件组件的条件：字符串比较（`<>` / `==`，start 当绑定、子实例修饰）；redeclare 进来的连接器里的条件（多层 extends 修饰传值）；条件经修饰引用声明在后的记录字段（第二遍）/ 声明在后的参数 / 记录参数修饰
//// model: C10
model A
Real x;
end A;
model C10
parameter String s = "Y";
A a if s <> "D";
end C10;
//// model: C11
model A
Real x;
end A;
model C11
parameter String s(start = "Y");
A a if s <> "D";
end C11;
//// model: C12
model A
Real x;
end A;
model T
parameter String s(start = "Y");
A a if s <> "D";
A b if s == "D";
end T;
model C12
T t(s = "D");
end C12;
//// model: C13
connector H
Real T;
flow Real Q;
end H;
connector P
parameter Boolean u(start = true) annotation(Evaluate = true);
H h if u;
end P;
model C13
P p(u = false);
end C13;
