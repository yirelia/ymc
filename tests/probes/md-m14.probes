//// set: md-m14 — constant 绑定变率守卫的误伤面：size 的各种写法、Evaluate / final 参数、子实例里的常量
//// model: M140
model M140
  parameter Real p[3] = {1, 2, 3}; constant Integer k = size(p, 1) + 1;
end M140;
//// model: M141
model M141
  parameter Real p[3] = {1, 2, 3}; constant Real q[size(p, 1)] = fill(1.0, size(p, 1));
end M141;
//// model: M142
model M142
  parameter Real p[3] = {1, 2, 3}; constant Integer k = if size(p, 1) > 1 then 1 else 2;
end M142;
//// model: M143
model M143
  parameter Real p[3] = {1, 2, 3}; constant Integer k[2] = {size(p, 1), 2 * size(p, 1)};
end M143;
//// model: M144
model M144
  parameter Real p[2, 3] = {{1, 2, 3}, {4, 5, 6}}; constant Integer k[2] = size(p);
end M144;
//// model: M145
model M145
  parameter Real p[2, 3] = {{1, 2, 3}, {4, 5, 6}}; constant Integer k = size(p, 2) * size(p, 1);
end M145;
//// model: M146
model M146
  parameter Real p[2, 3] = {{1, 2, 3}, {4, 5, 6}}; constant Integer k = size(p[1, :], 1);
end M146;
//// model: M147
model M147
  parameter Integer n = 2 annotation(Evaluate = true); constant Integer k = n;
end M147;
//// model: M148
model M148
  final parameter Integer n = 2; constant Integer k = n;
end M148;
//// model: M149
model M149
  parameter Integer n = 2; parameter Real p[n] = {1, 2}; constant Integer k = size(p, 1);
end M149;
//// model: M1410
model M1410
  parameter Integer n = 2; Real x[n]; constant Integer k = size(x, 1);
end M1410;
//// model: M1411
model M1411
  parameter Integer n = 2; Real x[n]; constant Integer k = size(x, n - 1);
end M1411;
//// model: M1412
model M1412
  parameter Integer n = 2; constant Integer k = size(zeros(n, n + 1), 2);
end M1412;
//// model: M1413
model M1413
  parameter Real p[3] = {1, 2, 3}; constant Integer k = sum(i for i in 1:size(p, 1));
end M1413;
//// model: M1414
model M1414
  parameter Real p[3] = {1, 2, 3}; constant Integer k[3] = {i for i in 1:size(p, 1)};
end M1414;
//// model: M1415
model M1415
  parameter Real p[3] = {1, 2, 3}; constant Integer k[:] = 1:size(p, 1);
end M1415;
//// model: M1416
model M1416
  parameter Real p[3] = {1, 2, 3}; constant Real q = sum(p);
end M1416;
//// model: M1417
model M1417
  parameter Real p[3] = {1, 2, 3}; constant Real q = max(p);
end M1417;
//// model: M1418
model M1418
  parameter Real p[3] = {1, 2, 3}; constant Real q = p[1];
end M1418;
//// model: M1419
model M1419
  parameter Real p[3] = {1, 2, 3}; constant Real q[3] = p;
end M1419;
//// model: M1420
model M1420
  parameter Real p[3] = {1, 2, 3}; constant Real q[3] = 2 * p;
end M1420;
//// model: M1421
model M1421
  parameter Real p[3] = {1, 2, 3}; constant Real q[2] = p[1:2];
end M1421;
//// model: M1422
model M1422
  model A parameter Real k = 1; end A; A a; constant Real q = a.k;
end M1422;
//// model: M1423
model M1423
  model A constant Real k = 1; end A; A a; constant Real q = a.k;
end M1423;
//// model: M1424
model M1424
  model A constant Real k = 1; end A; parameter Integer n = 1; A a[2]; constant Real q = a[n].k;
end M1424;
//// model: M1425
model M1425
  type E = enumeration(a, b); parameter E e = E.a; constant Integer k = Integer(e);
end M1425;
//// model: M1426
model M1426
  parameter String s = "x"; constant String t = s + "y";
end M1426;
//// model: M1427
model M1427
  parameter Boolean b = true; constant Boolean c2 = not b;
end M1427;
