//// model: WS8
package WS8P
  record MC
    parameter Real RB = 0;
    parameter Real RC = 1;
  end MC;
  record LP
    Real rb(start = 0.0);
    Real rc(start = 0.0);
  end LP;
  function ren
    input MC ex;
    output LP r;
  algorithm
    r.rb := ex.RB;
    r.rc := ex.RC;
  end ren;
end WS8P;
model WS8
  parameter WS8P.MC modelcard annotation(Evaluate = true);
  final parameter WS8P.LP p = WS8P.ren(modelcard) annotation(Evaluate = true);
  parameter Real x0 = 0.7;
  final parameter WS8P.LP q = WS8P.ren(WS8P.MC(RB = x0)) annotation(Evaluate = true);
  Real e = p.rc * time;
  Real g = q.rb * time;
  Real d;
  Real h;
equation
  d = p.rc * time;
  h = q.rb * time;
end WS8;
//// model: WS9
package WS9P
  record LP
    Real a(start = 0.0);
    Real b(start = 0.0);
  end LP;
  function ren
    input Real x;
    output LP r;
  algorithm
    r.a := x;
    r.b := 2 * x;
  end ren;
end WS9P;
model WS9
  parameter Real x0 = 0.7;
  final parameter WS9P.LP p = WS9P.ren(x0) annotation(Evaluate = true);
  Real y = p.a * time;
end WS9;
