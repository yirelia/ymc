//// set: ws-p1 — 整个记录参数的编译期求值与结构记录：final 记录绑定里的记录参数实参（`p = ren(mc)`，tryEvalExp 求成字段字面量，WS1–WS3）、Evaluate = true 的记录绑定读整个记录参数 / 常量记录（WS4–WS7）；Evaluate = true 且有整体绑定的记录：字段只有带 start 的是结构参数、引用处代入（WS8–WS10、WS15 / WS16，isStructuralComponent 取 start）；整体引用：结构语境整体读过的记录参数节点（WS12 `g(mc, time)` → `g(MC(0.7, -1e40), time)`，字段照旧不 final）、自己 Evaluate 且有整体绑定的记录（WS14，名取值的记录类型）；记录引用整体绑定的结构记录求值成字段字面量（WS13 `m1(modelcard = MP)`）；final 记录绑定要强制内联（WS11）SKIP
//// model: WS1
package WS1P
  record MC
    parameter Real VTO = -1e40;
  end MC;
  record LP
    Real a;
    Real b;
  end LP;
  function ren
    input MC ex;
    output LP r;
  algorithm
    r.a := ex.VTO;
    r.b := 2;
  end ren;
end WS1P;
model WS1
  parameter WS1P.MC mc(VTO = 0.7);
  final parameter WS1P.LP p = WS1P.ren(mc);
end WS1;
//// model: WS2
package WS2P
  record K
    constant Real CtoK = 273.15;
  end K;
  record MC
    parameter Real VTO = -1e40;
    parameter Real TNOM = -1e40;
  end MC;
  record LP
    Real m_vt0;
    Real m_vtOIsGiven;
    Real m_tnom;
  end LP;
  function ren
    input MC ex;

    output LP intern;
  algorithm
    intern.m_vtOIsGiven := if (ex.VTO > -1e40) then 1 else 0;
    intern.m_vt0 := if (ex.VTO > -1e40) then ex.VTO else 0;
    intern.m_tnom := if (ex.TNOM > -1e40) then ex.TNOM + 273.15 else 300.15;
  end ren;
end WS2P;
model WS2
  parameter WS2P.MC modelcard = WS2P.MC(VTO = 0.7);
  constant WS2P.K C;
  final parameter WS2P.LP p = WS2P.ren(modelcard);
  Real y = p.m_vt0 * time;
end WS2;
