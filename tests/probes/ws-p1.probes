//// model: WS11
package WS11P
  record MC
    parameter Real RB = 0;
    parameter Real RC = 1;
  end MC;
  record LP
    Real rb(start = 0.0);
    Real rc(start = 0.0);
  end LP;
  function ren
    input MC ex;
    output LP r;
  algorithm
    r.rb := ex.RB;
    r.rc := ex.RC;
  end ren;
  function ren2
    input LP lp;
    output LP r;
  algorithm
    r := lp;
  end ren2;
end WS11P;
model WS11
  parameter WS11P.MC modelcard annotation(Evaluate = true);
  final parameter WS11P.LP p = WS11P.ren(modelcard) annotation(Evaluate = true);
  final parameter WS11P.LP p1 = WS11P.ren2(p);
  parameter Real x0 = 0.7;
  final parameter WS11P.LP q = WS11P.ren(WS11P.MC(RB = x0)) annotation(Evaluate = true);
  Real a, b, c, d;
equation
  a * p.rb = time;
  b * p1.rc = time;
  c * q.rb = time;
  d = p.rc * time;
end WS11;
//// model: WS12
package WS12P
  record MC
    parameter Real VTO = -1e40;
    parameter Real TNOM = -1e40;
  end MC;
  record LP
    Real a;
    Real b;
  end LP;
  function ren
    input MC ex;
    output LP r;
  algorithm
    r.a := ex.VTO;
    r.b := ex.TNOM;
  end ren;
  function g
    input MC ex;
    input Real t;
    output Real y;
  algorithm
    y := ex.VTO * t;
  end g;
end WS12P;
model WS12
  parameter WS12P.MC mc(VTO = 0.7);
  final parameter WS12P.LP p = WS12P.ren(mc) annotation(Evaluate = true);
  Real y = WS12P.g(mc, time);
  Real z = p.a * time;
end WS12;
//// model: WS13
package WS13P
  record MC
    parameter Real VTO = -1e40;
    parameter Real TNOM = -1e40;
  end MC;
  record LP
    Real a;
    Real b;
  end LP;
  function ren
    input MC ex;
    output LP r;
  algorithm
    r.a := ex.VTO;
    r.b := ex.TNOM;
  end ren;
  model M
    parameter MC modelcard annotation(Evaluate = true);
    final parameter LP p = ren(modelcard) annotation(Evaluate = true);
    Real z = p.a * time;
  end M;
end WS13P;
model WS13
  parameter WS13P.MC MP(VTO = 0.7);
  WS13P.M m1(modelcard = MP);
  WS13P.M m2(modelcard(VTO = 0.5));
end WS13;
//// model: WS14
package WS14P
  record R
    Real a;
    Integer n;
    Boolean b;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r.a := x;
    r.n := 2;
    r.b := false;
  end f;
  function g
    input R r;
    input Real t;
    output Real y;
  algorithm
    y := r.a * t + r.n;
  end g;
end WS14P;
model WS14
  parameter WS14P.R r1 = WS14P.f(3) annotation(Evaluate = true);
  final parameter WS14P.R r2 = WS14P.f(4);
  parameter WS14P.R r3(a = 5, n = 1, b = true) annotation(Evaluate = true);
  Real y1 = WS14P.g(r1, time);
  Real y2 = WS14P.g(r2, time);
  Real y3 = WS14P.g(r3, time);
end WS14;
