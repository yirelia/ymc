//// model: ESC113
operator record C
  Real re;
  encapsulated operator function '+'
    import C;
    input C a;
    input C b;
    output C c;
  algorithm
    c := C(a.re + b.re);
  end '+';
end C;
record D = C;
model ESC113
  D a = D(1);
  D b = a + a;
end ESC113;
