//// model: LMS3
package A
  replaceable function f
    input Real a;
    output Real c;
  end f;
end A;
package P
  constant Integer n = 2;
  function f1
    input Real a;
    output Real c;
  algorithm
    c := a + n;
  end f1;
  function f2
    input Real a;
    output Real c;
  algorithm
    c := a * n;
  end f2;
end P;
model C
  replaceable function fredecl = A.f;
  package Z = A(redeclare function f = fredecl);
  Real x = Z.f(time);
  Real y = Z.f(2);
end C;
model LMS3
  C c1(redeclare function fredecl = P.f1);
  C c2(redeclare function fredecl = P.f2);
end LMS3;
//// model: LMS4
