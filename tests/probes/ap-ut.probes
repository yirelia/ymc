//// set: ap-ut — 参数数组、吸收律、收尾折叠、归约范围（单测原文）
//// model: APS1
model APS1
  Real y = time;
  Boolean b = time > 1;
equation
  if b then
  else
    assert(y > 0, "n");
  end if;
end APS1;
//// model: APS2
model APS2
  parameter Integer k[2] = {1, 2};
  Real z[k[2]];
  Integer y[2] = k;
end APS2;
//// model: APS3
model APS3
  Real t = time;
  Real y = sum(v * t for v in {sin(t), 2});
end APS3;
//// model: APS4
model APS4
  Real x[3] = {time, 1, 2};
  Integer m = integer(time);
  Real y = sum(x[i] for i in {m, 2.5});
end APS4;
//// model: APS5
model APS5
  parameter Integer n = 1;
  Real x[3, 3];
equation
  for i in 1:3 loop
    x[:, i:i] = zeros(3, n + i - i);
  end for;
end APS5;
//// model: APS6
model APS6
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real s = max(sum(x[j] for j in i:n) for i in 1:2);
end APS6;
//// model: APS7
model APS7
  Real x[3];
equation
  for i in 1:1 loop
    x = {time * j for j in 1:i + 2};
  end for;
end APS7;
//// model: APS8
model APS8
  Real y = time;
  Boolean b = time > 1;
algorithm
  if b then
  end if;
end APS8;
//// model: APT1
model APT1
  parameter Integer idx[2] = {2, 1};
  parameter Integer n[2] = {2, 3};
  parameter Boolean b[2] = {true, false};
  parameter Integer k0 = 2;
  parameter Integer k[2] = {1, k0};
  parameter Integer m[2, 2] = {{1, 2}, {3, 1}};
  parameter Integer u[2] = {1, 2};
  Real x[3] = {time, 1, 2};
  Real z[n[1]];
  Real y = x[idx[1]] + x[k[2]] + x[m[2, 1]] + u[1];
  Real w if b[1];
  Real v;
equation
  z = {time, 1};
  w = 1;
  if b[2] then
    v = 1;
  else
    v = 2;
  end if;
end APT1;
//// model: APT2
model APT2
  parameter Boolean pb = true;
  parameter Integer n = 2;
  Real z[n];
  Real g if pb;
  Boolean bb[2] = {time > 1, true};
  Boolean y1 = true or bb[1];
  Boolean y2 = bb[1] or false;
  Boolean y3 = bb[1] and pb;
  Boolean y4 = not (bb[1] and false);
  Boolean v[2];
  Real r;
  Real s;
equation
  z = {time, 1};
  g = 1;
  v = {true, false} or bb;
  assert(n > 0, "m");
  assert(time > 0 and n > 0, "m2");
  if bb[1] and pb then
    r = 1;
  else
    r = 2;
  end if;
  if bb[1] or pb then
    assert(true, "m3");
  end if;
  if bb[1] then
    assert(time > 0, "m4");
  elseif bb[2] then
    assert(true, "m5");
  end if;
algorithm
  if bb[2] and not pb then
    s := 1;
  elseif bb[1] then
    s := 3;
  else
    s := 2;
  end if;
  assert(true, "m6");
end APT2;
//// model: APT3
model APT3
  parameter Integer k[2] = {1, 2};
  parameter Real q[2] = {1, 2};
  Integer m = integer(time);
  Real x[3] = {time, 1, 2};
  Real t = time;
  Real y1 = sum(x[i] for i in k);
  Real y2 = sum(v * t for v in q);
  Real y3 = max(x[i] for i in k);
  Real y4 = sum(v * t for v in {q[1] * 2, t});
  Real y5 = sum(v * t for v in {2 * t, 3});
  Real y6 = sum(v * t for v in 2 * x);
  Real y7 = max(v * t for v in {m, 2.5});
  Real y8 = sum(v * w for v in {t, 2}, w in {2 * t, 3});
  Real y9 = sum(x[i] for i in {m, 2});
  Real y10 = product(v * t for v in {q[1], 2 * q[2]});
  Real y11 = max(sum(x[i] for i in {j, 2}) for j in 1:2);
end APT3;
