//// set: ap-p8 — 归约范围的元素是含变量的式子
//// model: Q80
model Q80
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {t, 2});
end Q80;
//// model: Q81
model Q81
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {2 * t, 3});
end Q81;
//// model: Q82
model Q82
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {t + 1, 3});
end Q82;
//// model: Q83
model Q83
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in 2 * x);
end Q83;
//// model: Q84
model Q84
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in x[1:2]);
end Q84;
//// model: Q85
model Q85
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {x[1], x[2]});
end Q85;
//// model: Q86
model Q86
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {-t, 2});
end Q86;
//// model: Q87
model Q87
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {sin(t), 2});
end Q87;
//// model: Q88
model Q88
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {der(t), 2});
end Q88;
//// model: Q89
model Q89
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in x + x);
end Q89;
//// model: BASE
model BASE
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
end BASE;
//// model: Q810
model Q810
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in -x);
end Q810;
//// model: Q811
model Q811
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {if t > 1 then 1 else 2, 3});
end Q811;
//// model: Q812
model Q812
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = product(v * t for v in {2 * t, 3});
end Q812;
//// model: Q813
model Q813
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * w for v in {2 * t, 3}, w in 1:2);
end Q813;
//// model: Q814
model Q814
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * w for v in 1:2, w in {2 * t, 3});
end Q814;
//// model: Q815
model Q815
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Real q[2] = {1, 2}; Real y = sum(v * t for v in {q[1] * 2, t});
end Q815;
//// model: Q816
model Q816
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Real q[2] = {1, 2}; Real y = sum(v * t for v in {q[1] * 2, 2 * t});
end Q816;
//// model: Q817
model Q817
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y = sum(x[i] for i in {integer(t), 2});
end Q817;
//// model: Q818
model Q818
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y = sum(x[i] for i in {k[1] + integer(t), 2});
end Q818;
//// model: Q819
model Q819
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y = sum(x[i] for i in {k[1], integer(t)});
end Q819;
//// model: Q820
model Q820
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = max(v * t for v in {2 * t, 3});
end Q820;
//// model: Q821
model Q821
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {2 * t});
end Q821;
//// model: Q822
model Q822
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v for v in {2 * t, 3});
end Q822;
//// model: Q823
model Q823
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v for v in {t, 3});
end Q823;
//// model: Q824
model Q824
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum({2 * t, 3});
end Q824;
//// model: Q825
model Q825
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in cat(1, {t}, {2}));
end Q825;
//// model: Q826
model Q826
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {noEvent(t), 2});
end Q826;
//// model: Q827
model Q827
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {pre(y2), 2}); discrete Real y2;
equation
  when t > 1 then y2 = 1; end when;
end Q827;
//// model: Q828
model Q828
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = sum(v * t for v in {x[integer(t)], 2});
end Q828;
