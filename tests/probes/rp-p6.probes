//// model: P67
record R
parameter Real a = 1;
end R;
model F
parameter R fp;
Real tau;
equation
if fp.a <= 0 then
tau = 0;
else
tau = time;
end if;
end F;
model P67
parameter Real k(fixed = false) = 0;
parameter R d(a = k);
F f(fp = d);
end P67;
//// model: P68
model F
parameter Integer n = 1;
Real x;
equation
if n > 1 then
x = 1;
else
x = 2;
end if;
end F;
model G
F f;
end G;
model P68
G g(f(n = k));
parameter Integer k(fixed = false) = 2;
end P68;
