//// model: L22
package P
package Types
type LH = enumeration(A, B, C);
end Types;
package N
block L
discrete Types.LH h(start = Types.LH.A);
equation
when time > 1 then
h = Types.LH.C;
end when;
end L;
end N;
end P;
model L22
P.N.L lim;
end L22;
//// model: L23
package P
package Types
type LH = enumeration(A, B, C);
record R
LH e = LH.B;
Real x = 1;
end R;
end Types;
package N
block L
parameter Types.R r;
Real y = if r.e == Types.LH.B then time else 0;
end L;
end N;
end P;
model L23
P.N.L lim;
end L23;
