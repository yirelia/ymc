//// set: lh-l2 — 同上换位置：Integer()、修饰值、when、记录缺省、for 枚举范围、根类在包里、外层模型里的枚举（SKIP）、函数、数组
//// model: L20
package P
package Types
type LH = enumeration(A, B, C);
end Types;
package N
block L
parameter Types.LH h = Types.LH.B;
Integer k = Integer(Types.LH.C);
end L;
end N;
end P;
model L20
P.N.L lim;
end L20;
//// model: L21
package P
