//// model: MOX4
operator record MOX4C
  Real re;
  Real im;
  encapsulated operator function '*'
    import MOX4C;
    input MOX4C c1;
    input MOX4C c2;
    output MOX4C c3;
  algorithm
    c3 := MOX4C(c1.re * c2.re - c1.im * c2.im, c1.re * c2.im + c1.im * c2.re);
  end '*';
end MOX4C;
function MOX4F
  input Real x;
  output Real y;
  output Real z;
protected
  MOX4C b;
algorithm
  b := MOX4C(x, 1);
  b := b * b;
  y := b.re;
  z := b.im;
end MOX4F;
model MOX4
  parameter Real p = MOX4F(3.0);
end MOX4;
//// model: MOX5
record MOX5R
  Real a;
  Real b;
end MOX5R;
operator record MOX5C
  Real re;
  Real im;
  encapsulated operator function '*'
    import MOX5C;
    input MOX5C c1;
    input MOX5C c2;
    output MOX5C c3;
  algorithm
    c3 := MOX5C(c1.re * c2.re - c1.im * c2.im, c1.re * c2.im + c1.im * c2.re);
  end '*';
end MOX5C;
function MOX5F
  input MOX5R r;
  output Real y;
  output Real z;
protected
  MOX5C b;
algorithm
  b := MOX5C(r.a, r.b);
  b := b * b;
  y := b.re;
  z := b.im;
end MOX5F;
model MOX5
  parameter Real p = MOX5F(MOX5R(3.0, 1.0));
end MOX5;
