//// model: RBA18
record RBA18R
  Real re;
  Real im;
end RBA18R;
function RBA18F
  input Real x;
  output Real y;
protected
  RBA18R t = RBA18R(x, 2);
algorithm
  t.re := t.re + 1;
  t := RBA18R(t.im, t.re);
  y := t.re + t.im;
end RBA18F;
model RBA18
  Real y = RBA18F(time);
end RBA18;
//// model: RBA19
record RBA19R
  Real re;
  Real im;
end RBA19R;
function RBA19F
  input Real x;
  output Real y;
protected
  Real a = t.re * 2;
  RBA19R t = RBA19R(x, 2);
algorithm
  y := a + t.im;
end RBA19F;
model RBA19
  Real y = RBA19F(time);
end RBA19;
