end CXC17F;
model CXC17
  Real y = CXC17F(time);
end CXC17;
//// model: CXC18
function CXC18F
  input Complex a;
  input Complex b;
  input Real x;
  output Real y;
protected
  Complex t = if x > 0 then a else b;
algorithm
  y := t.re + t.im;
end CXC18F;
model CXC18
  Real y = CXC18F(Complex(time, 1), Complex(2, time), time);
end CXC18;
//// model: CXC19
function CXC19F
  input Real x;
  output Real y;
protected
  final Complex[3] r_2 = {Complex(-72.597457432922, -78.100842711287), Complex(-5.57107698030123e-5, 4.64578634580806e-5), Complex(2.34801409215913e-11, -2.85651142904972e-11)};
  Complex r2;
algorithm
  r2 := r_2[1];
  for k in 2:3 loop
    r2 := r2 + (r_2[k] * Complex((x - 1)^(k - 1)));
  end for;
  y := Modelica.ComplexMath.real(r2);
end CXC19F;
model CXC19
  Real y = CXC19F(time);
end CXC19;
//// model: CXC20
function CXC20F
  input Real x;
  output Real y;
protected
  Complex[2] t = {Complex(1, 2), Complex(3, 4)};
  Complex[2] o;
algorithm
  o[1] := (t[1] - Complex(x)) * Modelica.ComplexMath.log(t[1] - Complex(x));
  o[2] := Complex(x^2) / t[2] + Complex(2) * t[1];
  y := Modelica.ComplexMath.real(o[1] + o[2]);
end CXC20F;
model CXC20
  Real y = CXC20F(time);
end CXC20;
//// model: CXC21
function CXC21F
  input Real x;
  output Real y;
protected
  Complex[2] t = {Complex(1, 2), Complex(3, 4)};
  Complex s = Complex(0);
algorithm
  for i in 1:2 loop
    s := s + t[i];
  end for;
  y := x * s.re;
end CXC21F;
model CXC21
  Real y = CXC21F(time);
end CXC21;
