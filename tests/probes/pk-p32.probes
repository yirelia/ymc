  RBB10R[2, 2] t = {{RBB10R(1, 2), RBB10R(3, 4)}, {RBB10R(5, 6), RBB10R(7, x)}};
algorithm
  y := x * t[1, 2].re + t[2, 2].im;
end RBB10F;
model RBB10
  Real y = RBB10F(time);
end RBB10;
