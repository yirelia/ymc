model RBA6
  Real y = RBA6F(time);
end RBA6;
//// model: RBA7
record RBA7R
  Real re;
  Real im;
end RBA7R;
function RBA7G
  input Real x;
  output RBA7R r;
algorithm
  r := RBA7R(x, 2 * x);
end RBA7G;
function RBA7F
  input Real x;
  output Real y;
protected
  RBA7R t = RBA7G(x);
algorithm
  y := t.re + t.im;
end RBA7F;
model RBA7
  Real y = RBA7F(time);
end RBA7;
//// model: RBA8
record RBA8R
  Real re;
  Real im;
end RBA8R;
function RBA8F
  input Real x;
  output Real y;
protected
  RBA8R t = if x > 0 then RBA8R(1, 2) else RBA8R(3, 4);
algorithm
  y := t.re + t.im;
end RBA8F;
model RBA8
  Real y = RBA8F(time);
end RBA8;
