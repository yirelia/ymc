end MOX3F;
model MOX3
  parameter Real p = MOX3F(3.0);
end MOX3;
//// model: RBE38
record RBE38R
  Real re = 10;
  Real im = 20;
end RBE38R;
function RBE38F
  input Real x;
  output Real y;
protected
  RBE38R t[2];
algorithm
  t[1].re := x;
  y := t[1].re * t[1].im;
end RBE38F;
model RBE38
  parameter Real p = RBE38F(3.0);
end RBE38;
//// model: RBE39
record RBE39R
  Real re = 10;
  Real im = 20;
end RBE39R;
function RBE39F
  input Real x;
  output Real y;
protected
  RBE39R t[2];
algorithm
  t[1] := RBE39R(x, 2);
  y := t[1].re * t[1].im + t[2].re;
end RBE39F;
model RBE39
  parameter Real p = RBE39F(3.0);
end RBE39;
//// model: XDP16
package XDP16P
  partial package PM
    constant Integer nX = 1;
    constant Real reference_X[nX] = fill(1 / nX, nX);
    replaceable partial function f
      input Real X[:] = reference_X;
      output Real y;
    end f;
  end PM;
  package M
    extends PM(nX = 2, reference_X = {0.01, 0.99});
    redeclare function extends f
    algorithm
      y := sum(X);
    end f;
  end M;
  package M2
    extends M(reference_X = {0.3, 0.7});
    redeclare function extends f
    algorithm
      y := 2 * sum(X);
    end f;
  end M2;
end XDP16P;
model XDP16
  package Medium = XDP16P.M2;
  Real y = Medium.f({time, 1});
end XDP16;
//// model: MOX8
operator record MOX8C
  Real re;
  Real im;
  encapsulated operator function '*'
    import MOX8C;
    input MOX8C c1;
    input MOX8C c2;
    output MOX8C c3;
  algorithm
    c3 := MOX8C(c1.re * c2.re - c1.im * c2.im, c1.re * c2.im + c1.im * c2.re);
  end '*';
end MOX8C;
function MOX8G
  input Real x;
  output Real y;
  output Real z;
protected
  MOX8C b;
algorithm
  b := MOX8C(x, 1);
  b := b * b;
  y := b.re;
  z := b.im;
end MOX8G;
function MOX8F
  input Real x;
  output Real y;
algorithm
  y := MOX8G(3.0) * x;
end MOX8F;
model MOX8
  Real y = MOX8F(time);
end MOX8;
//// model: MOX9
function MOX9F
