//// model: CXF6
function CXF6F
  input Real x;
  output Real y;
protected
  Complex a = Complex(1, 2);
  Complex b;
algorithm
  b := a + Complex(x);
  y := b.re;
end CXF6F;
model CXF6
  Real y = CXF6F(time);
end CXF6;
//// model: CXF7
function CXF7F
  input Real x;
  output Real y;
protected
  Complex[2] t = {Complex(1, 2), Complex(3, 4)};
  Complex b;
algorithm
  b := t[1] * t[2] - Complex(x);
  y := Modelica.ComplexMath.real(b);
end CXF7F;
model CXF7
  Real y = CXF7F(time);
end CXF7;
//// model: CXF8
function CXF8F
  input Real x;
  output Real y;
protected
  Complex a;
  Complex b;
algorithm
  a := Complex(x, 2);
  b := a + a;
  y := b.re;
end CXF8F;
model CXF8
  Real y = CXF8F(time);
end CXF8;
//// model: CXF9
function CXF9F
  input Real x;
  output Real y;
protected
  Complex[2] t = {Complex(1, 2), Complex(3, 4)};
  Complex b = Complex(0);
algorithm
  for i in 1:2 loop
    b := b + t[i] * Complex(x);
  end for;
  y := b.im;
end CXF9F;
model CXF9
  Real y = CXF9F(time);
end CXF9;
//// model: RBA3
record RBA3R
  Real re;
  Real im;
end RBA3R;
function RBA3F
  input Real x;
  output Real y;
protected
  RBA3R t = RBA3R(im = 2, re = x);
algorithm
  y := x * t.re + t.im;
end RBA3F;
model RBA3
  Real y = RBA3F(time);
end RBA3;
