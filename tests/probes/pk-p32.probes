function RBE23F
  input Real x;
  output Real y;
protected
  RBE23R[2] t = {RBE23R(1, 2), RBE23R(x, 4)};
algorithm
  for i in 1:2 loop
    y := if i == 1 then t[i].re else y + t[i].re * t[i].im;
  end for;
end RBE23F;
model RBE23
  parameter Real p = RBE23F(3.0);
end RBE23;
