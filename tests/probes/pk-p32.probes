//// model: CXC16
operator record CXC16C
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import CXC16C;
      input Real re;
      input Real im = 0;
      output CXC16C result(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
  encapsulated operator function '+'
    import CXC16C;
    input CXC16C c1;
    input CXC16C c2;
    output CXC16C c3;
  algorithm
    c3 := CXC16C(c1.re + c2.re, c1.im + c2.im);
  end '+';
end CXC16C;
function CXC16F
  input Real x;
  output Real y;
protected
  CXC16C[2] t = {CXC16C(1, 2), CXC16C(3, x)};
  CXC16C s = t[1] + t[2];
algorithm
  y := s.re + s.im;
end CXC16F;
model CXC16
  Real y = CXC16F(time);
end CXC16;
//// model: CXC17
operator record CXC17C
  Real a;
  Real b;
end CXC17C;
