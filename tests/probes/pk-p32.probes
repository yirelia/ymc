//// model: RBA12
record RBA12R
  Real[2] v;
  Real w;
end RBA12R;
function RBA12F
  input Real x;
  output Real y;
protected
  RBA12R t = RBA12R({1, 2}, x);
algorithm
  y := t.v[1] + t.v[2] * t.w;
end RBA12F;
model RBA12
  Real y = RBA12F(time);
end RBA12;
//// model: RBA13
