//// model: RBF7
record RBF7C
  Real re;
  Real im;
end RBF7C;
function RBF7F
  input Real x;
  output Real y;
protected
  final constant RBF7C[2] t = {RBF7C(1, 2), RBF7C(3, 4)};
algorithm
  y := x * t[1].re + t[2].im;
end RBF7F;
model RBF7
  Real y = RBF7F(time);
end RBF7;
//// model: RBF8
record RBF8C
  Real re;
  Real im;
end RBF8C;
function RBF8F
  input Real x;
  output Real y;
protected
  RBF8C[2] t = {RBF8C(1, 2), RBF8C(3, 4)};
algorithm
  y := 0;
  for i in 1:2 loop
    y := y + x * t[i].re;
  end for;
end RBF8F;
model RBF8
  Real y = RBF8F(time);
end RBF8;
//// model: RBF9
record RBF9C
  Real re;
  Real im;
end RBF9C;
function RBF9F
  input Real x;
  output Real y;
protected
  RBF9C[2] t = {RBF9C(1, 2), RBF9C(3, 4)};
algorithm
  y := x * sum(t[i].re for i in 1:2);
end RBF9F;
model RBF9
  Real y = RBF9F(time);
end RBF9;
