//// set: pk-p32 — 函数里记录（数组）变量的绑定（66x，MSL ReferenceAir.MoistAir / MoistAir1 / MoistAir2 / Inverse_sh_TX 的 Ice09_Utilities.Basic.Gibbs `final Complex[2] t = {Complex(…), …}`）：omc 同内建类型照打绑定式（NFConvertDAE.convertFunctionParam :1136-1171 v1.25.0 的 Binding.toDAEExp），定型 / 常量求值 / 化简同函数体（Function.mapExp 管形参绑定，NFFunction.mo:2105-2185）——普通记录的局部 / 数组（RBF1-RBF9、RBA*、RBB*：字面量实参求值成记录式、变量实参照留、命名实参、缺省字段、记录 / 记录数组整体引用、返回记录的调用、if、fill、推导式、`[:]` / `t[2]` 写法的维、二维、依赖排序 RBA6 / RBA19、final 不打 RBF2 / RBF7），operator record（CXF*、CXC*、CXD*：构造经 'constructor' 求值成 `Complex(1.0, 2.0)` 或留 `Complex.'constructor'.fromReal(x, 2.0)`，绑定里的运算符重载 `Complex.'+'(a, b)` / '-' / '*' / '/' / '^' / '=='、ComplexMath 函数、别名类型 SI.ComplexVoltage、本地 operator record CXC16 / CXC17），输出 / 输入的记录绑定（RBO*；输出带绑定、没有算法段的函数在 final parameter 记录绑定里强制内联取输出的绑定 INX*，rb-p1 IN2 随之 PASS；'constructor' 输出的绑定又调自己 `output C3 result = C3(re = re, im = im)`：ymc 先发射形参再登记函数会无限递归 → SKIP，or-p1 b12 / testsuite OperatorOverloadComplex 等）；别的记录类（RBA16，omc 字段相同照收）照旧 SKIP、形状不符两边拒（RBB18）。有整体绑定的记录只看绑定的依赖（getLocalDependencies2，NFFunction.mo:2787-2807）。函数求值（RBE*，此前静默错 20 余例）：有绑定的记录（数组）输出 / 局部取绑定（NFEvalFunction.getBindingExp :312-332，此前按字段缺省求：`F(2.0)` 得 40.0、omc 4.0，含结构参数的维 RBE21），绑定求得的记录字段不可变——给标量记录整个赋值 / 给字段赋值 / 元组目标求值失败、omc 照留调用（assignVariable :764-810、assignRecord :915-958）→ SKIP（RBE26 / RBE32 / RBE33 / RBE35 / RBE40），记录数组按元素 / 整个赋值照常（RBE27 / RBE29）；没有绑定的记录数组元素是 EMPTY（buildBinding :334-352），读到没赋过的元素求值失败 → SKIP（RBE39 / RBE44，此前按字段缺省求）、全赋过的照常（RBE41-RBE43）。多输出的常量调用 `f(3.0)[1]`（simplifyTupleElement，NFSimplifyExp.mo:1381-1391）：求得的成字面量（MOX6、结构参数实参 MOX9 此前静默错），ymc 求不出的 SKIP（MOX1 / MOX2 / MOX4 / MOX5 / 函数体里 MOX8，此前原样留调用、omc 求成 8.0；MOX7 两边都求不出也 SKIP，同单输出的常量调用）。直接调 MSL Gibbs（GBS1 / GBS3）。函数别名的修饰（ALM*，目标的下一处阻塞：IF97_new 的 `function g2 = BaseIF97.Basic.g2(final checkLimits = false)`）：final 修饰照打 `final input`（NFInst.instComponentDef :1966-1968；ALM1 / ALM23 此前漏打），包里的 / 函数体里调用的别名修饰是字面量时照常（调用处补 `g(x, 2.0)`），引用常量的（ALM6）、包实例里函数体调别名（ALM18）照旧 SKIP。包实例里的 class extends 函数（XDP*，目标的再下一处：Medium.setState_pTX 的 `X = reference_X`）：隐式基类取实例类树里的那份（NFInst.mo:1742-1771），基类里的输入缺省 / 局部绑定读到 extends 修饰改过的常量（XDP1 / XDP8 / XDP9 / XDP11 / XDP13 / XDP14 此前静默错 `{1.0}` / 7.0）；两层 class extends 各带算法段两边拒（XDP16）
//// model: RBF1
record RBF1C
  Real re;
  Real im;
end RBF1C;
function RBF1F
  input Real x;
  output Real y;
protected
  RBF1C[2] t = {RBF1C(1, 2), RBF1C(3, 4)};
algorithm
  y := x * t[1].re + t[2].im;
end RBF1F;
model RBF1
  Real y = RBF1F(time);
end RBF1;
//// model: RBF2
record RBF2C
  Real re;
  Real im;
end RBF2C;
function RBF2F
  input Real x;
  output Real y;
protected
  final RBF2C[2] t = {RBF2C(1, 2), RBF2C(3, 4)};
algorithm
  y := x * t[1].re + t[2].im;
end RBF2F;
model RBF2
  Real y = RBF2F(time);
end RBF2;
