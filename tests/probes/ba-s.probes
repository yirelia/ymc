//// model: S19
model S19
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  v = change(b);
end S19;
//// model: S2
model S2
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  y = der(x);
end S2;
//// model: S20
model S20
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  der(y[1:2]) = x[1:2];
end S20;
//// model: S21
model S21
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  y[1:2] = der(x[2:3]);
end S21;
//// model: S3
model S3
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  der(y) = 2 * x;
end S3;
//// model: S4
model S4
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
