//// set: ba-s — Boolean 数组表达式
//// model: S0
model S0
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  der(y) = x;
end S0;
//// model: S1
model S1
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  der(y) = {1, 2, 3};
end S1;
//// model: S10
model S10
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  y = 2 * der(x);
end S10;
//// model: S11
model S11
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real k1[3] = der(x);
end S11;
//// model: S12
model S12
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real k2[3] = der(x) + x;
end S12;
//// model: S13
model S13
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real k3[3] = 2 * der(x);
end S13;
//// model: S14
model S14
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean k4[2] = pre(b) and b2;
end S14;
//// model: S15
model S15
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  y = noEvent(x);
end S15;
//// model: S16
model S16
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  y = smooth(1, x);
end S16;
//// model: S17
model S17
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
