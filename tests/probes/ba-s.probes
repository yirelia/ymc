end S4;
//// model: S5
model S5
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  v = pre(b) and b2;
end S5;
//// model: S6
model S6
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  v = {pre(b[1]), b2[2]};
end S6;
//// model: S7
model S7
  parameter Integer n = 2;
  parameter Boolean pb[2] = {true, false};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean v[2];
  Real y[3];
equation
  der(y) = -y;
end S7;
//// model: S8
model S8
