//// model: PKE14
package PE14
  partial package Base
    constant Real k0 = 1;
    package Utilities
      constant Real k = 3;
      function f
        input Real x;
        output Real y;
      algorithm
        y := k * x + k0;
      end f;
    end Utilities;
  end Base;
  package Gas
    extends Base(k0 = 2);
  end Gas;
end PE14;
model PKE14
  package Medium = PE14.Gas;
  Real y = Medium.Utilities.f(time);
  parameter Real k = Medium.Utilities.k;
end PKE14;
