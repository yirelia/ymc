//// model: PKE17
package PE17
  partial package PartialMedium
    constant Real R = 1;
    replaceable partial function h_T
      input Real T;
      output Real h;
    end h_T;
    function h_twice
      input Real T;
      output Real h;
    algorithm
      h := 2 * h_T(T) + R;
    end h_twice;
  end PartialMedium;
  package Gas
    extends PartialMedium(R = 287);
    redeclare function extends h_T
    algorithm
      h := R * T;
    end h_T;
  end Gas;
end PE17;
model PKE17
  package Medium = PE17.Gas;
  Real h = Medium.h_twice(time);
end PKE17;
