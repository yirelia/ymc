    algorithm
      h := 1000.0 * state.T + nX;
    end specificEnthalpy;
  end Gas;
end PE23;
model PKE23
  package Medium = PE23.Gas;
  Real h = Medium.specificEnthalpy(Medium.ThermodynamicState(p = 1e5, T = 300 + time));
end PKE23;
