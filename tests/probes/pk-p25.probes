//// set: pk-p25 — 模型（组件类）里不带修饰的本地短类包经包实例查名：函数 / 记录按实例路径命名、常量取包实例的值、没有记录组件时返回记录的调用与记录构造调用、protected / partial 照拒
//// model: PKE1
package PE1
  partial package PartialMedium "base"
    constant Integer nX = 1 "Number of mass fractions";
    constant String mediumName = "unusable";
    record ThermodynamicState "state"
      Real p;
      Real T;
    end ThermodynamicState;
    replaceable partial function setState_pT "state from p, T"
      input Real p;
      input Real T;
      output ThermodynamicState state;
    end setState_pT;
    replaceable partial function specificEnthalpy "h"
      input ThermodynamicState state;
      output Real h;
    end specificEnthalpy;
  end PartialMedium;
  package Gas "gas"
    extends PartialMedium(nX = 2, mediumName = "gas");
    redeclare function extends setState_pT "gas state"
    algorithm
      state := ThermodynamicState(p = p, T = T);
    end setState_pT;
    redeclare function extends specificEnthalpy "gas h"
    algorithm
      h := 1000.0 * state.T + nX;
    end specificEnthalpy;
  end Gas;
end PE1;
model PKE1
  package Medium = PE1.Gas;
  Medium.ThermodynamicState s;
  Real h;
equation
  s = Medium.setState_pT(1e5, 300 + time);
  h = Medium.specificEnthalpy(s);
end PKE1;
//// model: PKE2
package PE2
  partial package PartialMedium "base"
    constant Integer nX = 1 "Number of mass fractions";
    constant String mediumName = "unusable";
    constant Real T_default = 293.15;
    constant Real X_default[nX] = fill(1 / nX, nX);
    type Temperature = Real(min = 1, max = 1e4, unit = "K");
    record ThermodynamicState "state"
      Real p;
      Real T;
    end ThermodynamicState;
    replaceable partial function setState_pT "state from p, T"
      input Real p;
      input Real T;
      output ThermodynamicState state;
    end setState_pT;
    replaceable partial function specificEnthalpy "h"
      input ThermodynamicState state;
      output Real h;
    end specificEnthalpy;
  end PartialMedium;
  package Gas "gas"
    extends PartialMedium(nX = 2, mediumName = "gas", T_default = 300);
    constant Temperature T_min = 200;
    redeclare function extends setState_pT "gas state"
    algorithm
      state := ThermodynamicState(p = p, T = T);
    end setState_pT;
    redeclare function extends specificEnthalpy "gas h"
    algorithm
      h := 1000.0 * state.T + nX;
    end specificEnthalpy;
  end Gas;
end PE2;
model PKE2
  package Medium = PE2.Gas;
  parameter Integer n = Medium.nX;
  parameter String name = Medium.mediumName;
  parameter Real T0 = Medium.T_default;
  parameter Real Tmin = Medium.T_min;
  Real X[Medium.nX] = Medium.X_default;
end PKE2;
//// model: PKE3
package PE3
  record DataRecord
    String name;
    Real MM;
    Real R;
  end DataRecord;
  package Data
    constant DataRecord H2O(name = "H2O", MM = 0.018, R = 461.5);
    constant DataRecord N2(name = "N2", MM = 0.028, R = 296.8);
  end Data;
  partial package PartialMixture
    constant DataRecord[:] data;
    constant Integer nS = size(data, 1);
  end PartialMixture;
  package Moist
    extends PartialMixture(data = {Data.H2O, Data.N2});
    constant DataRecord steam = Data.H2O;
    constant DataRecord dryair = Data.N2;
  end Moist;
end PE3;
model PKE3
  package Medium = PE3.Moist;
  parameter Real MMx[2] = {Medium.dryair.MM, Medium.steam.MM};
  parameter Real R1 = Medium.data[1].R;
  parameter Integer n = Medium.nS;
end PKE3;
//// model: PKE4
package PE4
  partial package PartialMedium "base"
    constant Integer nX = 1 "Number of mass fractions";
    constant String mediumName = "unusable";
    constant Real T_default = 293.15;
    constant Real X_default[nX] = fill(1 / nX, nX);
    type Temperature = Real(min = 1, max = 1e4, unit = "K");
    record ThermodynamicState "state"
      Real p;
      Real T;
    end ThermodynamicState;
    replaceable partial function setState_pT "state from p, T"
      input Real p;
      input Real T;
      output ThermodynamicState state;
    end setState_pT;
    replaceable partial function specificEnthalpy "h"
      input ThermodynamicState state;
      output Real h;
    end specificEnthalpy;
  end PartialMedium;
  package Gas "gas"
    extends PartialMedium(nX = 2, mediumName = "gas", T_default = 300);
    constant Temperature T_min = 200;
    redeclare function extends setState_pT "gas state"
    algorithm
      state := ThermodynamicState(p = p, T = T);
    end setState_pT;
    redeclare function extends specificEnthalpy "gas h"
    algorithm
      h := 1000.0 * state.T + nX;
    end specificEnthalpy;
  end Gas;
end PE4;
model PKE4
  replaceable package Medium = PE4.Gas constrainedby PE4.PartialMedium;
  parameter Real T0 = 300;
  final parameter Real h0 = Medium.specificEnthalpy(Medium.setState_pT(1e5, T0));
  Real h = Medium.specificEnthalpy(Medium.setState_pT(1e5, T0 + time));
end PKE4;
