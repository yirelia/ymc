//// model: PKE8
package PE8
  package Lib
    constant Real c = 2.5;
    function f
      input Real x;
      output Real y;
    algorithm
      y := c * x + 1;
    end f;
  end Lib;
end PE8;
model PKE8
  package L = PE8.Lib;
  Real y = L.f(time);
  parameter Real z = L.c;
end PKE8;
//// model: PKE9
package PE9
  partial package PartialMedium "base"
    constant Integer nX = 1 "Number of mass fractions";
    constant String mediumName = "unusable";
    constant Real T_default = 293.15;
    constant Real X_default[nX] = fill(1 / nX, nX);
    type Temperature = Real(min = 1, max = 1e4, unit = "K");
    record ThermodynamicState "state"
      Real p;
      Real T;
    end ThermodynamicState;
    replaceable partial function setState_pT "state from p, T"
      input Real p;
      input Real T;
      output ThermodynamicState state;
    end setState_pT;
    replaceable partial function specificEnthalpy "h"
      input ThermodynamicState state;
      output Real h;
    end specificEnthalpy;
  end PartialMedium;
  package Gas "gas"
    extends PartialMedium(nX = 2, mediumName = "gas", T_default = 300);
    constant Temperature T_min = 200;
    redeclare function extends setState_pT "gas state"
    algorithm
      state := ThermodynamicState(p = p, T = T);
    end setState_pT;
    redeclare function extends specificEnthalpy "gas h"
    algorithm
      h := 1000.0 * state.T + nX;
    end specificEnthalpy;
    model BaseProperties
      Real T;
      Real h;
      ThermodynamicState state;
    equation
      state = setState_pT(1e5, T);
      h = specificEnthalpy(state);
    end BaseProperties;
  end Gas;
end PE9;
model PKE9
  package Medium = PE9.Gas;
  Medium.BaseProperties medium(T(start = 300, fixed = true));
  Real h2 = Medium.specificEnthalpy(Medium.setState_pT(2e5, medium.T));
equation
  der(medium.T) = 1;
end PKE9;
