//// model: VQS9
model VQS9
  function so
    input Integer m;
    output Real o[m];
  algorithm
    o := {(k - 1) * 2 / m for k in 1:m};
  end so;
  model S
    parameter Real phase = 0;
    Real y = sin(time + phase);
  end S;
  parameter Integer m = 3 annotation(Evaluate = true);
  S s[m](phase = 1 .- so(m));
end VQS9;
//// model: VQS10
model VQS10
  function so2
    input Real x;
    output Real o[3];
  algorithm
    o := {x, 2 * x, 3 * x};
  end so2;
  model S
    parameter Real phase = 0;
    Real y = sin(time + phase);
  end S;
  parameter Real k = 2;
  S s[3](phase = -so2(k));
end VQS10;
