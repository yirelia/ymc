model VQ80
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  parameter Real p[3] = f({1, 2, 3});
  parameter Real q[3] = f(p);
  Real y = q[1] * time;
end VQ80;
//// model: VQ81
model VQ81
  function g
    input Integer x;
    output Integer y;
  algorithm
    y := 2 * x;
  end g;
  parameter Integer a[2] = {1, 2};
  parameter Real p[2] = g(a) annotation(Evaluate = true);
  Real y = p[1] * time;
end VQ81;
//// model: VQ82
model VQ82
  function g
    input Integer x;
    output Integer y;
  algorithm
    y := 2 * x;
  end g;
  parameter Integer p[2] = g({1, 2}) annotation(Evaluate = true);
  Real y = p[1] * time;
end VQ82;
//// model: VQ83
model VQ83
  function g
    input Integer x;
    output Integer y;
  algorithm
    y := 2 * x;
  end g;
  parameter Integer n = 3;
  Real z[n];
  parameter Real p[2] = g({n, 1});
  Real y = p[1] * time;
equation
  z = fill(time, n);
end VQ83;
//// model: VQS1
model VQS1
  function so
    input Integer m;
    output Real o[m];
  algorithm
    o := {(k - 1) * 2 / m for k in 1:m};
  end so;
  model S
    parameter Real phase = 0;
    Real y = sin(time + phase);
  end S;
  parameter Integer m = 3 annotation(Evaluate = true);
  S s[m](phase = -so(m));
end VQS1;
