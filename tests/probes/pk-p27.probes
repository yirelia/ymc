//// set: pk-p27 — 向量化调用逐元素求值与函数去留（V4g 规矩，MSL IMC_withLosses 的 `wtable = from_rpm({…})`）：参数数组绑定 / 数组属性值里的向量化调用在标量化时逐元素求值、收函数在前 → 照打（VQ1 / VQ5 嵌在运算里 / VQ7 部分求不出 / VQ15 二维 / VQ16 两个向量化实参 / VQ17 组件修饰 / VQ22 MSL 同构 / VQ4 / VQ23 / VQ73 属性）；收函数之前就化掉的不打：迭代范围长 1（VQ2）、sum / product 化简期展开（VQ3 / VQ25 / VQ59）、代入结构参数后以迭代变量作下标的数组各元素相同（VQ45 / VQ63 / VQ74，对照 VQ29-31）、定型期被读（VQ13 / VQ21 / VQ36 / VQ67）、结构参数且推导式嵌在运算 / 转型 / 数组字面量里（VQ47 / VQ48 / VQ66 / VQ68 / VQ69 / VQ71 / VQ81）；整个绑定就是推导式的结构参数照打（VQ14 / VQ64 / VQ65 / VQ72 / VQ76）；实参末尾才代入结构参数的照打（VQ27 / VQ28 / VQ6 / VQ49，VQ28 / VQ49 此前静默丢函数）；函数另有引用（VQ8）、嵌套调用（VQ10 / VQ43 里层在化简期求值）；照旧 SKIP：if 表达式两支（VQ18，omc 只取下标不化简）、常量数组（VQ11 / VQ41）、求值失败（VQ38）、向量化实参里套向量化调用（VQ9 / VQ62）、组件数组修饰分发（VQ61）、数组字面量里的推导式（VQ69 / VQ70 别的原因）；组件数组修饰按元素分发、值是嵌着数组值用户函数调用的取负 / 四则运算（MSL PolyphaseTwoLevel 的 `sine[m](phase = -symmetricOrientation(m))`）：实参会成字面量的化简期求值后取元素、不打函数（VQS1-5 / VQS7-9 / VQS12-15，VQS6 整个是调用对照），实参不会成字面量的 omc 打 `(-f(k))[1]`（VQS10）、两个调用（VQS11）照旧 SKIP
//// model: VQ1
model VQ1
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  parameter Real p[2] = f({1, 2});
  Real y = p[1] * time;
end VQ1;
//// model: VQ2
model VQ2
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  parameter Real p[1] = f({3});
  Real y = p[1] * time;
end VQ2;
//// model: VQ3
model VQ3
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  parameter Real s = sum(f({1, 2}));
  Real y = s * time;
end VQ3;
//// model: VQ4
model VQ4
  function f
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end f;
  Real x[2](start = f({1, 2}));
equation
  der(x) = -x;
end VQ4;
