//// set: v4 — 向量化调用、sum / product / min / max
//// model: P1
model P1
  Real x = time;
  Real y = pre(x);
end P1;
//// model: P10
model P10
  record R
    Real a;
  end R;
  parameter R r(a = 1);
  model M
    Real u = time;
    discrete Real d;
    parameter Real p = 2;
  equation
    when time > 1 then
      d = 1;
    end when;
  end M;
  M m;
  Real y1 = pre(r.a);
  Real y2 = pre(m.d);
  Real y3 = pre(m.p);
end P10;
//// model: P11
model P11
  model M
    Real u = time;
  end M;
  M m;
  Real y = pre(m.u);
end P11;
//// model: P12
model P12
  Real x = time;
  Real y = pre(time);
end P12;
//// model: P13
model P13
  Boolean b = time > 1;
  Boolean c = pre(b);
  Boolean d = edge(b);
  Boolean e = change(b);
  Integer i = integer(time);
  Integer j = pre(i);
end P13;
//// model: P2
model P2
  Real x[3] = {time, 1, 2};
  Real y[3];
equation
  y = pre(x);
end P2;
//// model: P3
model P3
  discrete Real x[3];
  Real y[3] = pre(x);
equation
  when time > 1 then
    x = {1, 2, 3};
  end when;
end P3;
//// model: P4
model P4
  Real x = time;
  discrete Real y;
equation
  when time > 1 then
    y = pre(x);
  end when;
end P4;
//// model: P5
model P5
  Real x = time;
  Boolean b = change(x);
end P5;
//// model: P6
model P6
  parameter Real p = 1;
  Real y = pre(p);
  discrete Real d;
  Real z = pre(d);
  Integer i;
  Integer j = pre(i);
equation
  when time > 1 then
    d = 2;
    i = 3;
  end when;
end P6;
//// model: P7
model P7
  Real x = time;
  Real y = pre(x + 1);
end P7;
//// model: P8
model P8
  Real x = time;
  Real y;
algorithm
  when time > 1 then
    y := pre(x);
  end when;
end P8;
//// model: P9
model P9
  Real x = time;
  discrete Real y;
equation
  when change(x) then
    y = 1;
  end when;
end P9;
//// model: Q1
model Q1
  Real x[3] = {time, 1, 2};
  Boolean v[3] = x .> x;
end Q1;
//// model: Q2
model Q2
  Real x[3] = {time, 1, 2};
  Boolean v[3] = x > x;
end Q2;
//// model: Q3
model Q3
  Real x[3] = {time, 1, 2};
  Boolean v[3];
equation
  v = x > {1, 2, 3};
end Q3;
//// model: T0
function F
  input Real a;
  input Real b;
  output Real c = a + b;
end F;
function G
  input Real a[3];
  output Real c = a[1];
end G;
function H
  input Real a;
  output Real c[2] = {a, a};
end H;
model T0
  parameter Real q[3] = {1, 2, 3};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real a1[3] = cos(x);
end T0;
