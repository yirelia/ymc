//// set: cn-n1 — connect 实参的下标形态：迭代变量算式、参数、`end`、切片、`:`、多维、for / if 里、子模型数组
//// model: N10
model N10
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3];
equation
  for i in 1:2 loop connect(p[i], p[i + 1]); end for;
end N10;
//// model: N11
model N11
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[N];
equation
  for i in 1:N - 1 loop connect(p[i], p[i + 1]); end for;
end N11;
//// model: N12
model N12
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[N];
equation
  connect(p[1], p[N]);
end N12;
//// model: N13
model N13
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[N], q;
equation
  connect(p[N], q);
end N13;
//// model: N14
model N14
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q;
equation
  connect(p[N], q);
end N14;
//// model: N15
model N15
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q;
equation
  connect(p[N - 1], q);
end N15;
//// model: N16
model N16
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q[3];
equation
  connect(p, q);
end N16;
//// model: N17
model N17
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[N], q[N];
equation
  connect(p, q);
end N17;
//// model: N18
model N18
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q[3];
equation
  connect(p[1:2], q[2:3]);
end N18;
//// model: N19
model N19
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q[3];
equation
  connect(p[{1, 3}], q[{2, 1}]);
end N19;
//// model: N110
model N110
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q[3];
equation
  connect(p[:], q[:]);
end N110;
//// model: N111
model N111
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q[2];
equation
  connect(p[2:end], q);
end N111;
//// model: N112
model N112
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[2, 2], q[2, 2];
equation
  connect(p, q);
end N112;
//// model: N113
model N113
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[2, 2], q[2];
equation
  connect(p[1], q);
end N113;
//// model: N114
model N114
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[2, 2], q[2];
equation
  connect(p[:, 1], q);
end N114;
//// model: N115
model N115
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[2, 2], q;
equation
  connect(p[2, 1], q);
end N115;
//// model: N116
model N116
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[2, 2];
equation
  for i in 1:2 loop connect(p[i, 1], p[i, 2]); end for;
end N116;
//// model: N117
model N117
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3];
equation
  for i in 1:2 loop for j in i + 1:3 loop connect(p[i], p[j]); end for; end for;
end N117;
//// model: N118
model N118
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3];
equation
  for i in {1, 2} loop connect(p[i], p[3]); end for;
end N118;
//// model: N119
model N119
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[4];
equation
  for i in 1:2:3 loop connect(p[i], p[i + 1]); end for;
end N119;
//// model: N120
model N120
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3];
equation
  if N > 2 then connect(p[1], p[2]); end if;
end N120;
//// model: N121
model N121
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3];
equation
  for i in 1:2 loop if i > 1 then connect(p[i], p[i + 1]); end if; end for;
end N121;
//// model: N122
model N122
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  model A C c; end A; A a[3];
equation
  for i in 1:2 loop connect(a[i].c, a[i + 1].c); end for;
end N122;
//// model: N123
model N123
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  model A C c[2]; end A; A a[2];
equation
  connect(a[1].c, a[2].c);
end N123;
//// model: N124
model N124
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  model A C c[2]; end A; A a[2];
equation
  connect(a[1].c[1], a[2].c[2]);
end N124;
//// model: N125
model N125
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  model A C c; end A; A a[3]; C q[3];
equation
  connect(a.c, q);
end N125;
//// model: N126
model N126
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  model A C c; end A; A a[N]; C q[N];
equation
  connect(a.c, q);
end N126;
//// model: N127
model N127
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  model A C c; end A; A a[N];
equation
  for i in 1:N - 1 loop connect(a[i].c, a[i + 1].c); end for;
end N127;
//// model: N128
model N128
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q;
equation
  connect(p[end], q);
end N128;
//// model: N129
model N129
  connector C Real e; flow Real f; end C;
  parameter Integer N = 3;
  C p[3], q[2];
equation
  connect(p[end - 1:end], q);
end N129;
