//// set: dm-misc — 维 / 切片的零散探针（D / E / X）
//// model: D1
model D1
  parameter Real a[:] = {1, 1};
  Real x[size(a, 1) - 1];
end D1;
//// model: D2
model D2
  parameter Real a[:] = {1, 1};
  Real x[size(a, 1)];
end D2;
//// model: D3
model D3
  parameter Real a[:] = {1, 1};
  parameter Integer n = size(a, 1) - 1;
  Real x[n + 1];
end D3;
//// model: D4
model D4
  parameter Integer b[:] = {3, 2};
  Real c[b[end]];
end D4;
//// model: D5
model D5
  parameter Integer n = min(m, 3);
  parameter Integer m = 4;
  Real x[max(n, m)];
end D5;
//// model: D6
model D6
  Integer a[:] = 3:5;
end D6;
//// model: D7
model D7
  parameter String s1[:] = {String(i) for i in 1:3};
end D7;
//// model: D8
model D8
  parameter Real A[:, size(A, 1)] = {{1, 0}, {0, 1}};
  Real x[size(A, 1)];
end D8;
//// model: D9
model D9
  type E = enumeration(one, two, three);
  Integer ints[size(E, 1)];
end D9;
//// model: E1

model E1
  Real x[3] = {time, 1, 2};
  Real y[3] = x[1:3];
  Real z[3] = x[1:end];
  Real w[2] = x[2:end];
end E1;
//// model: E2
model A
  Real x[3];
end A;
model E2
  A a[2];
  Real x1[:] = a[end].x[1:end];
  Real x2[:] = a[1].x[1:3];
  Real x3[:] = a[1].x[2:end];
  Real x4[:] = a[end].x;
end E2;
//// model: E3
package P
  constant Real x[2] = {1, 2};
end P;
model E3
  Real x2[:] = .P.x[1:end];
  Real x3[:] = P.x[1:2];
  Real x4[:] = P.x;
end E3;
//// model: E4
model A
  Real x[3];
end A;
model E4
  A a[2];
  Real x1 = a[end].x[end];
  Real x2 = a[end - 1].x[end - 1];
end E4;
//// model: X1
model X1
  model A parameter Real c[:]; Real y[size(c, 1)]; end A;
  model B extends A(c = {1, 2}); end B;
  B b;
end X1;
//// model: X2
model A parameter Real c[:]; Real y[size(c, 1)]; end A;
model X2 extends A(c = {1, 2}); end X2;
//// model: X3
model A parameter Real c[2]; Real y[size(c, 1)]; end A;
model X3 extends A(c = {1, 2}); end X3;
//// model: X4
model A parameter Real c[2] = {1, 2}; Real y[size(c, 1)]; end A;
model X4 extends A; end X4;
//// model: X5
model A parameter Integer n = 2; Real y[n]; end A;
model X5 extends A; end X5;
//// model: X6
model A parameter Real c[2] = {1, 2}; parameter Integer n = size(c, 1); Real y[n]; end A;
model X6 extends A; end X6;
//// model: D10
model D10
  type E = enumeration(one, two, three);
  Integer ints[E];
end D10;
