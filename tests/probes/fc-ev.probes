//// set: fc-ev — 用户函数的编译期求值：函数体里的推导式 / 归约式 `sum(3 * i for i in 1:5)`、多输出调用（testsuite ForIterator1 的拆件）
//// model: F0
function f
input Integer x1;
output Integer y1;
protected
Integer a[5];
algorithm
a := {5 + i for i in 1:5};
y1 := a[2];
end f;
model F0
Integer k = f(3);
end F0;
//// model: F1
function f
input Integer x1;
output Integer y1;
protected
Integer a[3, 4];
algorithm
a := {3 * j + i for j in 1:4, i in {1, 2, 3}};
y1 := a[3, 2];
end f;
model F1
Integer k = f(3);
end F1;
//// model: F2
function f
input Integer x1;
output Real y1;
protected
Real a[3, 4];
algorithm
a := array(3.5 * j * i for j in 1:4, i in 1:3);
y1 := a[2, 2];
end f;
model F2
Real k = f(3);
end F2;
//// model: F3
function f
input Integer x1;
output Integer y1;
algorithm
y1 := sum(3 * i for i in 1:5);
end f;
model F3
Integer k = f(3);
end F3;
//// model: F4
function f
input Integer x1;
output Integer y1;
output Integer y2;
algorithm
y1 := x1;
y2 := 2 * x1;
end f;
model F4
Integer i1, i2;
equation
(i1, i2) = f(3);
end F4;
//// model: F5
function f
input Integer x1;
output Integer y1;
output Real y2;
algorithm
y1 := x1;
y2 := 2 * x1;
end f;
model F5
Integer i1;
Real r1;
equation
(i1, r1) = f(3);
end F5;
