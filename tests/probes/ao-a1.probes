//// set: ao-a1 — 结构标记：别名与声明序
//// model: AO0
model AO0
  parameter Boolean pt = true;
  parameter Boolean pd = pt;
  Real a1[2] = if pt then {1, 2} else {3, 4, 5};
end AO0;
//// model: AO1
model AO1
  parameter Boolean pt = true;
  Real a1[2] = if pt then {1, 2} else {3, 4, 5};
  parameter Boolean pd = pt;
end AO1;
//// model: AO10
model AO10
  parameter Integer i = 1;
  Real c[2] = {time, 2};
  Real v = c[i] * time;
  parameter Integer j = i;
  Real w = j * time;
end AO10;
//// model: AO11
model AO11
  parameter Integer i = 1;
  parameter Integer j = i;
  Real c[2];
  Real w = j * time;
equation
  c[i] = time;
  c[2] = 1;
end AO11;
//// model: AO12
model AO12
  parameter Integer i = 1;
  Real c[2];
  Real w = j * time;
  parameter Integer j = i;
equation
  c[i] = time;
  c[2] = 1;
end AO12;
//// model: AO13
model AO13
  model M
    parameter Boolean g = true;
    Real a[2] = if g then {1, 2} else {3, 4, 5};
  end M;
  parameter Boolean p = true;
  parameter Boolean pd = p;
  M m(g = p);
  parameter Boolean pe = p;
end AO13;
//// model: AO14
model AO14
  model M
    parameter Boolean g = true;
    parameter Boolean h = g;
    Real a[2] = if g then {1, 2} else {3, 4, 5};
    parameter Boolean k = g;
  end M;
  M m;
end AO14;
//// model: AO15
model AO15
  parameter Integer n = 2;
  parameter Integer m = n;
  Real x[:] = fill(time, n);
  parameter Integer k = n;
  Real w = (m + k) * time;
end AO15;
//// model: AO16
model AO16
  parameter Integer n = 2;
  parameter Integer m = n;
  Real x[2] = {time, 1};
  Real s = sum(x[i] for i in 1:n);
  parameter Integer k = n;
  Real w = (m + k) * time;
end AO16;
//// model: AO17
model AO17
  parameter Integer n = 2;
  parameter Integer m = n;
  Real x[2] = {time, 1};
  Real s = x[n];
  parameter Integer k = n;
  Real w = (m + k) * time;
end AO17;
//// model: AO18
model AO18
  parameter Integer n = 2;
  parameter Integer m = n;
  Real x[3] = {time, 1, 2};
  Real s[2] = x[1:n];
  parameter Integer k = n;
  Real w = (m + k) * time;
end AO18;
//// model: AO19
model AO19
  parameter Integer n = 2;
  parameter Integer m = n;
  Real x[3] = {time, 1, 2};
  Integer s = size(x[1:n], 1);
  parameter Integer k = n;
  Real w = (m + k) * time;
end AO19;
//// model: AO2
model AO2
  parameter Integer m = k;
  parameter Integer k = n;
  parameter Integer n = 2;
  Real y[n];
  Real x = m * time;
end AO2;
//// model: AO3
model AO3
  parameter Integer n = 2;
  parameter Integer k = n;
  parameter Integer m = k;
  Real y[n];
  Real x = m * time;
end AO3;
//// model: AO4
model AO4
  parameter Integer m = k;
  parameter Integer k = n;
  Real y[n];
  parameter Integer n = 2;
  Real x = (m + k) * time;
end AO4;
//// model: AO5
model AO5
  parameter Real r = q;
  parameter Real q = p;
  parameter Real p = 2 annotation(Evaluate = true);
  Real x = (r + q) * time;
end AO5;
//// model: AO6
model AO6
  parameter Real p = 2 annotation(Evaluate = true);
  parameter Real q = p;
  parameter Real r = q;
  Real x = (r + q) * time;
end AO6;
//// model: AO7
model AO7
  parameter Boolean c = b;
  parameter Boolean b = true;
  Real x = 1 if b;
  Real y = if c then time else 2 * time;
end AO7;
//// model: AO8
model AO8
  parameter Boolean b = true;
  Real x = 1 if b;
  parameter Boolean c = b;
  Real y = if c then time else 2 * time;
end AO8;
//// model: AO9
model AO9
  parameter Integer i = 1;
  parameter Integer j = i;
  Real c[2] = {time, 2};
  Real v = c[i] * time;
  Real w = j * time;
end AO9;
