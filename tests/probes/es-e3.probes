model E36
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, 2, 3);
end E36;
//// model: E37
model E37
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a - a, b, c);
end E37;
//// model: E38
model E38
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, b + 0, b);
end E38;
//// model: E39
model E39
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, 2 * b, b * 2);
end E39;
//// model: BASE
model BASE
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
end BASE;
//// model: E310
model E310
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, 1, 1);
end E310;
//// model: E311
model E311
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(2, b, b);
end E311;
//// model: E312
model E312
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a + b, c, c) + 1;
end E312;
//// model: E313
model E313
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = 2 * semiLinear(a, b, b);
end E313;
//// model: E314
model E314
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  parameter Real p = 0; Real y = semiLinear(p, a, b);
end E314;
//// model: E315
model E315
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  parameter Real p = 2; Real y = semiLinear(a, p, p);
end E315;
//// model: E316
model E316
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = smooth(0, 2);
end E316;
