model E318
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = smooth(0, -1.5);
end E318;
//// model: E319
model E319
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = smooth(0, a) + smooth(1, 2 * a);
end E319;
//// model: E320
model E320
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  parameter Real p = 2; Real y = smooth(0, p);
end E320;
//// model: E321
model E321
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  constant Real k = 2; Real y = smooth(0, k);
end E321;
//// model: E322
model E322
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = smooth(0, if a > 0 then 1 else 2);
end E322;
//// model: E323
model E323
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
