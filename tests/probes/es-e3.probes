  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e = edge(not bb);
end E329;
//// model: E330
model E330
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e = edge(bb) and change(bb);
