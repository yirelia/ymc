//// set: es-e3 — semiLinear / smooth / noEvent / edge / homotopy / delay / der 的化简
//// model: E30
model E30
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, 2, 2);
end E30;
//// model: E31
model E31
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, b, b);
end E31;
//// model: E32
model E32
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(a, 0, 0);
end E32;
//// model: E33
model E33
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(0.0, a, b);
end E33;
//// model: E34
model E34
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y = semiLinear(0, 2, 3);
end E34;
