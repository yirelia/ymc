//// set: pk-p49a — 68a 评审时主代理手写的对抗形状（不来自代理的生成器）。EA：extends 短类；LB：带类重声明的短类；CC：约束修饰与约束子句的语法位置；LD：前导点；OR：声明次序；CE：class extends 内建类型。
//// model: A68EA1
model A Real x = 1; end A;
model B = A;
model C extends B; Real y = x + 1; end C;
//// model: A68EA2
model A Real x = 1; end A;
model B1 = A; model B2 = B1;
model C extends B2; end C;
//// model: A68EA3
package P model A Real x = 1; end A; model B = A; end P;
model C extends P.B; end C;
//// model: A68EA4
package P constant Real k = 3; model A Real x = k; end A; model B = A; end P;
model C extends P.B; end C;
//// model: A68EA5
model A Real x = 1; end A;
model B = A;
model C extends B(x = 5); end C;
//// model: A68EA6
model A Real x = 1; end A;
model B = A;
model C extends B; extends A; end C;
//// model: A68EA7
connector K Real e; flow Real f; end K; connector L = K; connector L2 extends L; end L2;
model C L2 a, b; equation connect(a, b); end C;
//// model: A68EA8
function f input Real u; output Real y; algorithm y := u + 1; end f; function g = f; function h extends g; end h;
model C Real x = h(time); end C;
//// model: A68EA9
record R Real a = 1; end R; record S = R; record T extends S; Real b = 2; end T;
model C T t; Real y = t.a; end C;
//// model: A68EA10
model A Real x; equation x = time; end A; model B = A;
model C extends B; Real y; equation y = x; end C;
//// model: A68EA11
model A Real x = 1; end A;
model B = A;
model C protected extends B; public Real y = x; end C;
//// model: A68EA12
partial model A Real x; end A; model B = A;
model C extends B; equation x = 1; end C;
//// model: A68EA13
package P1 model A Real x = 1; end A; end P1; package P2 extends P1; model B = A; end P2;
model C extends P2.B; end C;
//// model: A68EA14
model A Real x = 1; end A;
model B = A;
model M model B Real q = 2; end B; model C extends .B; end C; C c; end M;
//// model: A68EA15
model A Real x = 1; end A;
model X Real x = 10; Real w = 2; end X;
model Y Real x = 20; Real z = 3; end Y;
model W replaceable model T = X; T t; end W; model B = W;
model C extends B(redeclare model T = Y); end C;
//// model: A68EA16
model A Real x = 1; end A;
model B = A(x = 2);
model C extends B; end C;
//// model: A68EA17
model A Real x = 1; model I = J; model J Real p = 2; end J; I i; end A; model B = A;
model C extends B; end C;
//// model: A68EA18
model A Real x = 1; end A;
model B = A; model C extends B; end C; model D = C;
model M D d; D e(x = 3); end M;
//// model: A68EA19
model A Real x = 1; end A;
model B = A[2];
model C extends B; end C;
//// model: A68EA20
type V = Real[3]; type W extends V; end W;
model C W w = {1, 2, 3}; end C;
//// model: A68EA21
model A Real x = 1; end A;
model C extends B; model B = A; end C;
//// model: A68EA22
model A Real x = 1; end A;
model C1 model B = A; end C1;
model C2 extends C1; extends B; end C2;
//// model: A68EA23
model A Real x = 1; end A;
model C replaceable model B = A; extends B; end C;
//// model: A68EA24
model A Real x = 1; end A;
model X Real x = 10; Real w = 2; end X;
model Y Real x = 20; Real z = 3; end Y;
package P replaceable model T = A; model B = T; end P; package P2 = P(redeclare model T = X);
model C extends P2.B; end C;
//// model: A68EA25
model A Real x = 1; end A;
model B = A; model C extends B; end C;
model M C c1(x = 2), c2(x = 3); end M;
//// model: A68EA26
model A parameter Real p = 1; Real x = p; end A; model B = A;
model C parameter Real q = 2; extends B(p = q); end C;
//// model: A68EA27
model A parameter Integer n = 2; Real x[n]; equation x = fill(1.0, n); end A; model B = A;
model C extends B(n = 3); end C;
//// model: A68EA28
model A model N Real x = 1; end N; end A; model B = A;
model C extends B; N n; end C;
//// model: A68EA29
model A constant Real k = 1; end A; model B = A;
model C extends B; Real y = k; end C;
//// model: A68EA30
package A constant Real k = 1; model N Real x = k; end N; end A; package B = A;
package C extends B; end C;
model M C.N n; Real y = C.k; end M;
//// model: A68EA31
model A end A; model B = A;
model C extends B; Real x = 1; end C;
//// model: A68EA32
type T = Real(unit = "m"); type U = T;
model C U u = 1; end C;
//// model: A68EA33
operator record R Real a; end R; operator record S = R;
model C S s(a = 1); end C;
//// model: A68EA34
block A input Real u; output Real y = u; end A; block B = A;
block C extends B; end C;
model M C c(u = 1); end M;
//// model: A68EA35
model A Real x = 1; end A; class B = A;
model C extends B; end C;
//// model: A68EA36
class A Real x = 1; end A; model B = A; block K = B;
model C extends K; end C;
//// model: A68LB1
model A Real x = 1; end A;
model X Real x = 10; Real w = 2; end X;
model Y Real x = 20; Real z = 3; end Y;
package P replaceable model T = A; model Q T t; end Q; end P;
package P2 = P(redeclare model T = X);
model C P2.T t; end C;
//// model: A68LB2
model A Real x = 1; end A;
model X Real x = 10; Real w = 2; end X;
model Y Real x = 20; Real z = 3; end Y;
package P replaceable model T = A; model Q T t; end Q; end P;
package P2 = P(redeclare model T = X);
model C P.T s; P2.T t; end C;
//// model: A68LB3
model A Real x = 1; end A;
model X Real x = 10; Real w = 2; end X;
model Y Real x = 20; Real z = 3; end Y;
package P replaceable model T = A; model Q T t; end Q; end P;
package P2 = P(redeclare model T = X);
model C P2.T t; P.T s; end C;
//// model: A68LB4
function g input Real u; output Real y; algorithm y := u; end g; function h input Real u; output Real y; algorithm y := 2 * u; end h;
package P replaceable function f = g; end P; package P2 = P(redeclare function f = h);
model C Real x = P2.f(time); Real y = P.f(time); end C;
//// model: A68LB5
package A constant Real k = 1; end A; package B constant Real k = 2; end B;
package P replaceable package M = A; constant Real c = M.k; end P; package P2 = P(redeclare package M = B);
model C Real x = P2.c; Real y = P.c; end C;
//// model: A68LB6
model A Real x = 1; end A;
model X Real x = 10; Real w = 2; end X;
model Y Real x = 20; Real z = 3; end Y;
package P replaceable model T = A; model Q T t; end Q; end P;
package P2 = P(redeclare model T = X); package P3 = P2;
model C P3.T t; end C;
//// model: A68LB7
model A Real x = 1; end A;
