model Y Real x = 20; Real z = 3; end Y;
package P replaceable model T = A; model Q T t; end Q; end P;
package P2 extends P(redeclare model T = X); end P2;
model C P2.T t; end C;
//// model: A68LB8
model A Real x = 1; end A;
package P replaceable model T = A; model Q T t; end Q; end P;
model M model X2 Real w = 9; end X2; package P2 = P(redeclare model T = X2); P2.T t; end M;
//// model: A68LB9
package P replaceable type T = Real; end P; package P2 = P(redeclare type T = Integer);
model C P2.T t = 1; end C;
//// model: A68LB10
