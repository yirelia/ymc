//// set: ac-a3 — 取负的零：`-(0.0)`、字面量数组取负（零元素 -0.0，全零数组原样）、乘参数、方程里乘 time
//// model: A30
model A30
parameter Real p[3] = -{0.0, 1.0, 2.0};
end A30;
//// model: A31
model A31
parameter Real p = -0.0;
parameter Real q = -(0.0);
end A31;
//// model: A32
model A32
parameter Integer n = 2;
parameter Real p[n] = -{0.0, 1.0};
end A32;
//// model: A33
model A33
parameter Real x = 1;
parameter Real p[3] = -{0.0, 1.0, 2.0} * x;
end A33;
//// model: A34
model A34
parameter Real p[2] = -{0.0, 0.0};
end A34;
//// model: A35
model A35
Real y[3];
equation
y = -{0.0, 1.0, 2.0} * time;
end A35;
