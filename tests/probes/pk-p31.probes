    equation
      r = s;
      s.a = time;
    end C;
  end A;
  model D
    A.C c;
    A.R q;
    A.R w;
  equation
    q = w;
    w.a = 2 * time;
  end D;
end UQR34P;
model UQR34
  UQR34P.D d;
end UQR34;
