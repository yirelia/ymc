//// model: L13
package P
package Types
type LH = enumeration(NoHomotopy, Linear, UpperLimit);
end Types;
package N
block L
parameter Types.LH h = Types.LH.Linear;
Real u = time;
Real s;
equation
if h == Types.LH.NoHomotopy then
s = u;
else
s = 2*u;
end if;
end L;
end N;
end P;
model L13
P.N.L lim(h = P.Types.LH.NoHomotopy);
end L13;
