//// set: lh-l1 — 枚举字面量的类型名在外层包里（if 式 / if 方程 / Evaluate / 修饰 / 变量 / 更深的包 / 继承来的方程）
//// model: L10
package P
package Types
type LH = enumeration(NoHomotopy, Linear, UpperLimit);
end Types;
package N
block L
parameter Types.LH h = P.Types.LH.Linear;
Real u = time;
Real s;
equation
s = if h == Types.LH.Linear then u else 0;
end L;
end N;
end P;
model L10
P.N.L lim;
end L10;
//// model: L11
package P
package Types
type LH = enumeration(NoHomotopy, Linear, UpperLimit);
end Types;
package N
block L
parameter Types.LH h = P.Types.LH.Linear annotation(Evaluate = true);
Real u = time;
Real s;
equation
s = if h == Types.LH.Linear then u else 0;
end L;
end N;
end P;
model L11
P.N.L lim;
end L11;
//// model: L12
package P
package Types
type LH = enumeration(NoHomotopy, Linear, UpperLimit);
end Types;
package N
block L
parameter Types.LH h = Types.LH.Linear;
Real u = time;
