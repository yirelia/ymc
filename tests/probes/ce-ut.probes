//// set: ce-ut — 超越函数折叠 + 元素是数组的推导式（单测原文）
//// model: CMP1
model SP
  constant Integer m = 3;
  Real v[m];
  Real vs[2];
protected
  parameter Real TM[2, m] = 2/m*{{cos(+(k - 1)/m*2*3.14159) for k in 1:m}, {+sin(+(k - 1)/m*2*3.14159) for k in 1:m}};
  parameter Real IT[m, 2] = {{cos(-(k - 1)/m*2*3.14159), -sin(-(k - 1)/m*2*3.14159)} for k in 1:m};
equation
  vs = TM*v;
  v = {time, 2*time, 3*time};
end SP;
model CMP1
  SP s;
end CMP1;
//// model: CRT1
model CRT1
  parameter Real a = cos(4.188786666666666);
  parameter Real b = sin(0.3) + tan(1.1) + asin(0.3) + acos(0.4) + atan(2.5);
  parameter Real c = sinh(1.3) + cosh(0.7) + tanh(0.9) + exp(2.7) + log(3.3) + log10(47.0);
  parameter Real d = atan2(1.3, -2.2) + 2.7 ^ 1.37;
end CRT1;
