//// set: ax-c1 — 内建包着数组调用（向量化 abs / sin → SKIP，cross / transpose 展开）、用户函数实参里的 `g(f(time) * 2.0)`、零元与负号化简（`f(time) + {0, 0, 0}` → `f(time)`、`-f(time) + a` → `a - f(time)`、`./` 的负号怪癖）、e - e（SKIP）、Var 绑定、der、when 体（SKIP）、if 分支、非法形态
//// model: C10
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C10
Real x[3];
equation
x = abs(f(time));
end C10;
//// model: C11
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C11
Real x[3];
equation
x = 2 * abs(f(time));
end C11;
//// model: C12
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C12
Real x[3];
equation
x = sin(f(time)) * 2;
end C12;
//// model: C13
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
function g
input Real t[3];
output Real y;
algorithm
y := t[1] + t[2];
end g;
model C13
Real y;
equation
y = g(2 * f(time));
end C13;
//// model: C14
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
function g
input Real t[3];
output Real y;
algorithm
y := t[1] + t[2];
end g;
model C14
parameter Real a[3] = {1, 2, 3};
Real y;
equation
y = g(f(time) + a);
end C14;
//// model: C15
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C15
parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
Real x[3];
equation
x = transpose(m) * f(time);
end C15;
//// model: C16
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C16
Real x[3];
equation
x = -2 * f(time);
end C16;
