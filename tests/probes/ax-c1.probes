//// model: C121
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C121
Real x[3](each start = 0);
equation
der(x) = 2 * f(time);
end C121;
//// model: C122
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C122
parameter Real a[3] = {1, 2, 3};
Real x[3];
equation
x = f(time) * 2 + {1, 2, 3} .* a;
end C122;
//// model: C123
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C123
parameter Real a[3] = {1, 2, 3};
Real s;
equation
s = f(time) * a + 1;
end C123;
//// model: C124
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C124
parameter Real a[3] = {1, 2, 3};
Real s;
equation
s = (2 * f(time)) * a;
end C124;
//// model: C125
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C125
parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
Real x[3];
equation
x = m * (2 * f(time));
end C125;
//// model: C126
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C126
parameter Real m[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
Real x[3];
equation
x = (m * f(time)) * 2;
end C126;
//// model: C127
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C127
discrete Real x[3];
equation
when time > 0.5 then
x = 2 * f(time);
end when;
end C127;
//// model: C128
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C128
parameter Real a[3] = {1, 2, 3};
Real x[3];
equation
x = if time > 0.5 then 2 * f(time) else a;
end C128;
