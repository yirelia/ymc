//// model: C131
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C131
parameter Real a[3] = {1, 2, 3};
Real x[3];
equation
x = {1, 2, 3} * f(time) * a;
end C131;
//// model: C132
function g2
input Real t;
output Real y;
algorithm
y := 2 * t;
end g2;
model C132
parameter Real a[3] = {1, 2, 3};
Real x[3];
equation
x = 2 * g2(a);
end C132;
