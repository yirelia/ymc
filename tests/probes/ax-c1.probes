//// model: C117
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model C117
parameter Integer n[3] = {1, 2, 3};
parameter Integer nn[3] = {4, 5, 6};
Real x[3];
equation
x = n .* nn + f(time);
end C117;
