//// set: es-e8 — edge / change / semiLinear / smooth 在 when、for、函数体、向量化里的各种形态
//// model: E80
model E80
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Real y;
equation
  when edge(bb) then y = a; end when;
end E80;
//// model: E81
model E81
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb[2] = {a > 0, b > 0}; Boolean e = edge(bb[1]);
end E81;
//// model: E82
model E82
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb[2] = {a > 0, b > 0}; Boolean e[2] = edge(bb);
end E82;
//// model: E83
model E83
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb[2] = {a > 0, b > 0}; Boolean e[2];
equation
  for i in 1:2 loop e[i] = edge(bb[i]); end for;
end E83;
//// model: E84
model E84
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  record R Boolean f; end R; R r(f = a > 0); Boolean e = edge(r.f);
end E84;
//// model: E85
model E85
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e = edge((bb));
end E85;
//// model: E86
model E86
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e = edge(pre(bb));
end E86;
//// model: E87
model E87
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e = not edge(bb);
end E87;
//// model: E88
model E88
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e = edge(bb) or edge(bb);
end E88;
//// model: E89
model E89
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Boolean e; algorithm e := edge(bb);
end E89;
//// model: BASE
model BASE
