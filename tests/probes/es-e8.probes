end E810;
//// model: E811
model E811
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Real y; algorithm when edge(bb) then y := a; end when;
end E811;
//// model: E812
model E812
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean bb = a > 0; Real y;
equation
  when {edge(bb), a > 1} then y = a; end when;
end E812;
//// model: E813
model E813
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Integer n = integer(a); Boolean e = edge(n > 0);
end E813;
//// model: E814
model E814
