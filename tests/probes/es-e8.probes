//// model: E819
model E819
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y;
equation
  for i in 1:2 loop y = semiLinear(a, i, i); end for;
end E819;
//// model: E820
model E820
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[2];
equation
  for i in 1:2 loop y[i] = semiLinear(a, i, i); end for;
end E820;
//// model: E821
model E821
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[2];
equation
  for i in 1:2 loop y[i] = semiLinear(a, b * i, b * i); end for;
end E821;
//// model: E822
model E822
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real y[2] = semiLinear({a, b}, {c, c}, {c, c});
end E822;
