//// set: ks-ut — 常量数组符号下标后跟 `:` 的逐元素展开 / 常量矩阵的注释（单测原文）
//// model: KSU1
model KSU1
  constant Boolean fire[3, 2] = [true, false; false, true; true, true];
  Integer k(start = 0, fixed = true);
  Boolean b[2];
equation
  when sample(0, 0.1) then
    k = mod(pre(k) + 1, 3);
  end when;
  b = fire[k + 1, :];
end KSU1;
//// model: KSU2
model KSU2
  constant Real T[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  Integer k(start = 1, fixed = true);
  Real c[3] = T[k, :] * time;
equation
  when sample(0, 0.1) then
    k = 3 - pre(k);
  end when;
end KSU2;
//// model: KSU3
model KSU3
  constant Integer m = 3;
  constant Boolean fire[2, m] = [true, false, false; false, true, true] "Switching patterns";
  constant Real r[2, 2] = [1, 2; 3, 4] "Matrix";
  constant Real v[2] = {1, 2} "Vector";
  parameter Real p[2, 2] = [1, 2; 3, 4] "Param matrix";
  Real y = time;
end KSU3;
