//// model: D247
model D247
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  model G parameter Boolean on = true; end G; G g; Real z;
equation
  if g.on then z = 1; else z = time; end if;
end D247;
