//// set: nd-d2 — 实例路径的值在别的编译期语境：下标、条件组件、if 方程、属性、归约范围、fill、整组结构标记、protected、Evaluate
//// model: D20
model D20
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real y[4] = {time, 1, 2, 3}; Real z = y[a.j];
end D20;
//// model: D21
model D21
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real y[4] = {time, 1, 2, 3}; Real z = y[a.p];
end D21;
//// model: D22
model D22
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z if a.j > 3;
end D22;
//// model: D23
model D23
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z if a.p > 1;
end D23;
//// model: D24
model D24
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z;
equation
  if a.j > 3 then z = 1; else z = time; end if;
end D24;
//// model: D25
model D25
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z;
equation
  if a.p > 1 then z = 1; else z = time; end if;
end D25;
//// model: D26
model D26
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z(start = a.j) = time;
end D26;
//// model: D27
model D27
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
