//// model: D28
model D28
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real z(fixed = a.p > 1, start = 0);
equation
  der(z) = 1;
end D28;
//// model: D29
model D29
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real y[3] = {time, 1, 2}; Real z = sum(y[i] for i in 1:a.p);
end D29;
//// model: D210
model D210
  model A constant Integer j = 3; parameter Integer p = 2; Real v[2] = {time, 1}; end A;
  package P constant Integer i = 2; end P;
  A a(j = 4);
  A b;
  Real y[3] = {time, 1, 2}; Real z = sum(y[i] for i in 1:a.j - 1);
end D210;
