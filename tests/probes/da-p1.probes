//// set: da-p1 — derivative 注解的修饰 order / noDerivative / zeroDerivative（不打印、引用的函数照样发射，含 MultiBody resolve2 式的记录输入与 cross 里的函数调用）；名字不是输入 / 未知属性 / order 写成式子或 Real（SKIP）。单测取 3 / 4 / FAS2
//// model: DA1
function f_der
  input Real x;
  input Real k;
  input Real der_x;
  output Real dy;
algorithm
  dy := k * der_x;
end f_der;
function f_der2
  input Real x;
  input Real k;
  input Real der_x;
  input Real der2_x;
  output Real d2y;
algorithm
  d2y := k * der2_x;
end f_der2;
function f
  input Real x;
  input Real k;
  output Real y;
algorithm
  y := k * x;
  annotation(derivative(noDerivative = k) = f_der);
end f;
model DA1
  Real y = f(time, 2);
end DA1;
//// model: DA2
function f_der
