//// model: DA9
package DA9P
  record Orientation
    Real T[3, 3];
    Real w[3];
  end Orientation;
  function resolve2
    input Orientation R;
    input Real v1[3];
    output Real v2[3];
  algorithm
    v2 := R.T*v1;
    annotation(derivative(noDerivative = R) = resolve2_der, InlineAfterIndexReduction = true);
  end resolve2;
  function resolve2_der
    input Orientation R;
    input Real v1[3];
    input Real v1_der[3];
    output Real v2_der[3];
  algorithm
    v2_der := resolve2(R, v1_der) - cross(R.w, resolve2(R, v1));
    annotation(derivative(order = 2) = resolve2_der2);
  end resolve2_der;
  function resolve2_der2
    input Orientation R;
    input Real v1[3];
    input Real v1_der[3];
    input Real v1_der2[3];
    output Real v2_der2[3];
  algorithm
    v2_der2 := resolve2(R, v1_der2);
  end resolve2_der2;
  model M
    parameter Real T0[3, 3] = [1, 0, 0; 0, 1, 0; 0, 0, 1];
    Real v[3] = resolve2(Orientation(T = T0, w = {0, 0, time}), {time, 1, 2});
  end M;
end DA9P;
model DA9
  extends DA9P.M;
end DA9;
//// model: FAS2
function f1
  input Real x;
  output Real z = 2 * x;
  annotation(derivative(order = 2) = f2);
end f1;
function f2
  input Real x;
  input Real der_x;
  input Real der_der_x;
  output Real z = 2 * der_der_x;
end f2;
model FAS2
  Real b = f1(time);
end FAS2;
