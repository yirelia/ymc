//// model: M510
model M510
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Integer n = 2; Real x[n] = fill(time, n); end X; X xs[2](n = {i + 1 for i in 1:2});
end M510;
//// model: M511
model M511
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Real k = 1; Real x(start = k) = time; end X; X xs[3](k = 2 * p);
end M511;
//// model: M512
model M512
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Real k = 1; Real x if k > 1; end X; X xs[3](k = p);
end M512;
//// model: M513
model M513
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Real k = 1; Real x if k > 1; end X; X xs[3](k = 2 * p - {2, 2, 2});
end M513;
//// model: M514
model M514
  model A parameter Real k = 1; Real x = k * time; Real v[2] = {time, k}; end A;
  model B A q[2]; parameter Real w = 1; end B;
  function f input Real u[:]; output Real s[size(u, 1)]; algorithm s := 2 * u; end f;
  parameter Real p[3] = {1, 2, 3};
  parameter Boolean c = true;
  Real tt = time;
  model X parameter Real k = 1; Real x(fixed = k > 1, start = 0); equation der(x) = 1; end X; X xs[3](k = p);
end M514;
