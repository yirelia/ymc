//// model: XSB2
package XSB2P
  package Base
    constant Integer n = 1;
    replaceable model M
      Real x = n * time;
    end M;
  end Base;
  package S = Base;
  package A
    extends S;
    redeclare model extends M
      Real y = 2 * x;
    end M;
  end A;
end XSB2P;
model XSB2
  XSB2P.A.M m;
end XSB2;
