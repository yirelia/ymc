//// set: pk-p46 — 67l：MSL MultiBody UserDefinedGravityField / Media MixtureGases 的卡点及兄弟写法（TwoPhaseWater.TestTwoPhaseStates、Fluid HeatingSystem 未做，见 XSB）。CFR1-CFR40：组件修饰里重声明的函数（`inner World world(redeclare function gravityAcceleration = …(phi = geodeticLatitude))`）——inst 在组件的类实例树里顶替成 REDECLARED_CLASS，函数名照组件的实例路径（NFFunction.lookupFunction :318-345 v1.25.0），实例化时不以组件为父（instFunctionRef 的 isRedeclare → EMPTY_NODE :380-381），短类修饰在写重声明处定型：outer / 直接组件、写在子实例里（CFR27 / CFR37 `m.lat`）、遮蔽（CFR8）、组件自己体里也调（CFR9）、变量修饰（CFR11 定义里原样 `v`）、长函数原声明、多组件、模型内函数、命名实参、算法段、组件数组里的 body、数组修饰、final、常量求值（CFR20 / CFR29）；嵌套组件修饰（CFR6 / CFR7）、Evaluate（CFR21）照旧 SKIP。别名修饰不在调用的那层短类上（`acc = alt2`、包里的 `alt2 = alt(phi = c)`，CFR31 / CFR65 / CFR73 / CFR85-CFR92 / UCF4）：修饰按词法在它自己的定义处解析，包里的常量引用求成值（此前在组件 / 写重声明处 / 调用实例里解析，CFR31 / CFR65 / CFR73 静默错）；两层都在同一个类里照常（CFR80 / CFR81）。原声明不带 constrainedby 的带修饰短类：它的修饰作约束修饰并进新类（SCodeUtil.getConstrainingMod :5273-5286、NFInst.redeclareClass ccMod :1768 / :1788、Modifier.merge 新类修饰在前 NFModifier.mo:386-409）——每项都被新类链头的修饰盖住的照常（CFR95 / CFR97），没盖住的（CFR82 / CFR83 / CFR96 / UCF3 omc 打 `w.kk` / `4.0`）→ SKIP（CFR83 此前静默错），final 的被覆盖 omc 报错（CFR98）。实例语境里找到的短类别名按定义作用域拼的名与实例路径不一致 → SKIP（CFR86 / CFR93，此前 `CFR93.Medium.alt2` 静默错）。CFR42-CFR64：函数定义里别名缺省的值（EvalConstants.evaluateFuncExpTraverser 逐个 cref 试 Ceval，NFEvalConstants.mo:599-634）——经子组件的参数 `s.k` / `s.t.k` / `s[2].k` / `s.arr[2]` / 整个数组 / Integer 转型求成值（此前按首段变率当变量，十几个静默错），没有绑定、fixed = false 的参数照留原引用（NFCeval.mo:344-360 / :580-585 / :408-412）；参数与变量混着（CFR46）照旧 SKIP。XRF1-XRF20：函数体里包常量记录（数组）的记录类型是短类别名（`replaceable record FC = FCBase`、extends 修饰里重声明成 FCData，MSL PartialMixtureMedium 的 fluidConstants）：字段同链底的长类（MLS §4.5.1）；带修饰的别名（XRF4 / XRF18）照旧 SKIP。XSB1 / XSB2：extends 短类（TwoPhaseWater 的 `extends StandardWater` 同构）未做 → SKIP。UCF1-UCF6 为单测同构。基线 PASS 14 / SKIP 85 / FAIL 18 / BOTH-REJECT 4 → PASS 97 / SKIP 20 / BOTH-REJECT 4，无 FAIL；两个 MSL 例子 PASS
//// model: CFR1
package CFR1P
  partial function base
    input Real r;
    output Real g;
  end base;
  function std
    extends base;
    input Real k = 1;
  algorithm
    g := k * r;
  end std;
  function alt
    extends base;
    input Real phi;
  algorithm
    g := phi + r;
  end alt;
  model World
    parameter Real kk = 2;
    replaceable function acc = std(k = kk) constrainedby base;
  end World;
  model Body
    outer World world;
    Real g = world.acc(time);
  end Body;
end CFR1P;
model CFR1
  parameter Real lat = 3;
  inner CFR1P.World world(redeclare function acc = CFR1P.alt(phi = lat));
  CFR1P.Body body;
end CFR1;
