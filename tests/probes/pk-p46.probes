    algorithm
      y := x * fc[i].Tc + fc[i].M;
    end f;
  end Base;
  package Gas
    extends Base(redeclare record FC = FCData, fc = {FCData(Tc = 1.5, M = 2), FCData(Tc = 2.5, M = 3)});
  end Gas;
end UCF6P;
model UCF6
  package M = UCF6P.Gas;
  Real y = M.f(time, 1);
end UCF6;
