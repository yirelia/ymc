//// model: XRF12
package XRF12P
  record S
    Real v = 1;
  end S;
  record FCBase
    Real Tc;
    String name = "x";
    Boolean has = true;
    S s;
  end FCBase;
  record FCData
    extends FCBase;
    Real M;
  end FCData;
  partial package Base
    constant Integer nX = 2;
    replaceable record FC = FCBase;
    constant FC[nX] fc;
    function f
      input Real x;
      input Integer i;
      output Real y;
    algorithm
      y := 0;
      for j in 1:nX loop
        y := y + x * fc[j].Tc;
      end for;
    end f;
  end Base;
  package Gas
    extends Base(redeclare record FC = FCData, fc = {FCData(Tc = 1.5, M = 2, s = S(v = 3)), FCData(Tc = 2.5, M = 3, s = S(v = 4), has = false, name = "b")});
  end Gas;
end XRF12P;
