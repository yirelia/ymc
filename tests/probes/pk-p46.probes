    replaceable function acc = std(k = kk) constrainedby base;
  end World;
  model Body
    outer World world;
    Real g = world.acc(time);
  end Body;
  model M
    parameter Real lat = 5;
    World world(redeclare function acc = alt(phi = lat));
    Real y = world.acc(time);
  end M;
end CFR27P;
model CFR27
