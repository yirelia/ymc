//// model: CFR25
package CFR25P
  partial function base
    input Real r;
    output Real g;
  end base;
  function std
    extends base;
    input Real k = 1;
  algorithm
    g := k * r;
  end std;
  function alt
    extends base;
    input Real phi;
    input Real[2] v = {1, 2};
  algorithm
    g := phi + r + v[1];
  end alt;
  model World
    parameter Real kk = 2;
    replaceable function acc = std(k = kk) constrainedby base;
  end World;
  model Body
    outer World world;
    Real g = world.acc(time);
  end Body;
end CFR25P;
model CFR25
