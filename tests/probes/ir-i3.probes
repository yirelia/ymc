model I39
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[3]; input Real w[3]; output Real s; algorithm s := 0; for i loop s := s + u[i] * w[i]; end for; end f; Real y = f(x, x);
end I39;
//// model: I310
model I310
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[3]; input Real w[2]; output Real s; algorithm s := 0; for i loop s := s + u[i] * w[i]; end for; end f; Real y = f(x, {1, 2});
end I310;
//// model: I311
model I311
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Integer k; output Real s; protected Real w[k]; algorithm s := 0; for i loop w[i] := 1; s := s + w[i]; end for; end f; Real y = f(x, 2);
end I311;
//// model: I312
model I312
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Integer k; output Real s; protected Real w[k]; Real w2[k]; algorithm s := 0; for i loop w[i] := 1; w2[i] := w[i]; s := s + w2[i]; end for; end f; Real y = f(x, 2);
end I312;
//// model: I313
model I313
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Integer k; output Real s; protected Real w[k]; Real w2[k + 0]; algorithm s := 0; for i loop w[i] := 1; w2[i] := w[i]; s := s + w2[i]; end for; end f; Real y = f(x, 2);
end I313;
//// model: I314
