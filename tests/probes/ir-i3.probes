  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Integer k; output Real s; protected Real w[k + 0]; algorithm s := 0; for i loop w[i] := 1; s := s + w[i]; end for; end f; Real y = f(x, 2);
