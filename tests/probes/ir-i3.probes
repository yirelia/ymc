//// set: ir-i3 — 隐式迭代范围（函数体）：`:` 维 / size 维 / 表达式维 / 整数维的相等判定与取末，嵌套同名迭代变量
//// model: I30
model I30
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; output Real v[size(u, 1)]; algorithm for i loop v[i] := u[i]; end for; end f; Real y[3] = f(x);
end I30;
//// model: I31
model I31
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; output Real v[size(u, 1)]; algorithm for i loop v[i] := 0; end for; for i loop v[i] := v[i] + u[i]; end for; end f; Real y[3] = f(x);
end I31;
//// model: I32
model I32
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; output Real v[size(u, 1)]; protected Real t; algorithm for i loop t := u[i]; v[i] := t; end for; end f; Real y[3] = f(x);
end I32;
//// model: I33
model I33
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[:]; output Real s; algorithm s := 0; for i loop s := s + u[i] * w[i]; end for; end f; Real y = f(x, x);
end I33;
//// model: I34
model I34
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[size(u, 1)]; output Real s; algorithm s := 0; for i loop s := s + u[i] * w[i]; end for; end f; Real y = f(x, x);
end I34;
//// model: I35
model I35
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[size(u, 1)]; output Real s; algorithm s := 0; for i loop s := s + w[i] * u[i]; end for; end f; Real y = f(x, x);
end I35;
//// model: I36
model I36
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; output Real s; protected Real v[size(u, 1)]; Real w[size(u, 1)]; algorithm s := 0; for i loop v[i] := u[i]; w[i] := v[i]; s := s + w[i]; end for; end f; Real y = f(x);
end I36;
//// model: I37
model I37
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; output Real s; protected Real v[size(u, 1)]; Real w[size(u, 1)]; algorithm s := 0; for i loop v[i] := 1; w[i] := v[i]; s := s + w[i]; end for; end f; Real y = f(x);
end I37;
//// model: I38
model I38
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[3]; input Real w[:]; output Real s; algorithm s := 0; for i loop s := s + u[i] * w[i]; end for; end f; Real y = f(x, x);
end I38;
