//// set: rx-r1 — extends 修饰里的组件重声明：约束修饰（原声明的修饰）、叶 / 复合、绑定与注释的来源、非 replaceable、constrainedby、数组、多层
//// model: R10
model A
parameter Real p = 1;
end A;
model B
extends A;
parameter Real q = 2;
end B;
model M
parameter Real o = 5;
replaceable A a(p = o);
end M;
model R10
extends M(redeclare B a(q = 3));
end R10;
//// model: R11
model A
parameter Real p = 1;
end A;
model B
extends A;
parameter Real q = 2;
end B;
model M
parameter Real o = 5;
replaceable A a(p = o) constrainedby A(p = 7);
end M;
model R11
extends M(redeclare B a(q = 3));
end R11;
//// model: R12
model M
replaceable Real x = 1;
end M;
model R12
extends M(redeclare Real x = 2);
end R12;
//// model: R13
model M
replaceable Real x(start = 1) = time;
end M;
model R13
extends M(redeclare Real x(min = 0));
end R13;
