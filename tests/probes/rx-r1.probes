end R117;
//// model: R118
connector C
Real e;
flow Real f;
end C;
model A
C c;
end A;
model B
extends A;
equation
c.e = time;
end B;
model M
replaceable A a1;
A a2;
equation
connect(a1.c, a2.c);
end M;
model R118
extends M(redeclare B a1);
end R118;
