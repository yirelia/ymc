//// set: rcf-r — 记录构造函数与函数里的记录字段：数组字段 / extends 来的字段（两层）/ 短类型字段（不打 unit）/ 字段缺省（数组）/ 引用别的字段的维（`Real[n] b`）/ constant 字段（照样是输入）/ 混合类型；模型里没有实例的构造调用、`r.T[1, 2]`、整个数组字段、矩阵乘、全缺省的常量调用（omc 求值，SKIP）、函数返回带数组字段的记录（SKIP）
//// model: R00
function g
input Real T[2, 2];
input Real v[2];
output Real y[2];
algorithm
y := T * v;
end g;
model R00
Real y[2] = g({{1, 2}, {3, time}}, {1, time});
end R00;
//// model: R01
function g
input Real T[3, 3];
input Real v[3];
output Real y[3];
algorithm
y := transpose(T) * v;
end g;
model R01
Real y[3] = g({{1, 2, 3}, {3, time, 1}, {0, 0, 1}}, {1, time, 2});
end R01;
//// model: R10
type L = Real(unit = "m");
record R
L x "the x";
Real y[2];
end R;
function f
input R r;
output Real z;
algorithm
z := r.x + r.y[1];
end f;
model R10
Real z = f(R(time, {2, 3}));
end R10;
//// model: R11
record Icon
end Icon;
record R
extends Icon;
Real T[2, 2];
Real w[2];
end R;
function f
input R r;
output Real z;
algorithm
z := r.T[1, 2] + r.w[2];
end f;
model R11
Real z = f(R({{1, 2}, {3, time}}, {4, 5}));
end R11;
//// model: R12
record R
Real T[2, 2];
Real w[2];
end R;
function g
input R r;
input Real v[2];
output Real y[2];
algorithm
y := r.T * v;
end g;
model R12
Real y[2] = g(R({{1, 2}, {3, time}}, {4, 5}), {1, time});
end R12;
//// model: R13
record R
Real T[2, 2];
Real w[2];
end R;
function h
input Real a;
output R r;
algorithm
r := R({{a, 0}, {0, a}}, {a, a});
end h;
model R13
R r = h(time);
end R13;
//// model: R20
record Base
Real a;
end Base;
record R
extends Base;
Real b[2];
end R;
function f
input R r;
output Real z;
algorithm
z := r.a + r.b[2];
end f;
model R20
Real z = f(R(time, {2, 3}));
end R20;
//// model: R21
record R
Real b[2] = {1, 2};
Real c = 3;
end R;
function f
input R r;
output Real z;
algorithm
z := r.b[1] + r.c;
end f;
model R21
Real z = f(R());
end R21;
//// model: R22
type L = Real(unit = "m");
record R
L x[2] "pos";
end R;
function f
input R r;
output L y;
algorithm
y := r.x[1];
end f;
model R22
Real y = f(R({time, 2}));
end R22;
//// model: R23
record R
Real T[2, 2];
end R;
function f
input R r;
input Real v[2];
output Real y[2];
algorithm
y := transpose(r.T) * v;
end f;
model R23
Real y[2] = f(R({{1, 2}, {3, time}}), {1, 2});
end R23;
//// model: R24
record R
Real T[2, 2];
end R;
function f
input R r;
output Real t;
algorithm
t := r.T[1, 1] + r.T[2, 2];
end f;
model R24
R r(T = {{1, 2}, {3, time}});
Real t = f(r);
end R24;
//// model: R25
record R
Real w[2];
end R;
function f
input R r;
output Real w[2];
algorithm
w := r.w;
end f;
model R25
Real w[2] = f(R({time, 2}));
end R25;
//// model: R26
record R
Real x;
Real y;
end R;
model R26
Real z = R(time, 2).x;
end R26;
//// model: R30
record R
Real x(unit = "m") = 2 "the x";
Real b[2] = {1, 2};
end R;
function f
input R r;
output Real z;
algorithm
z := r.x + r.b[1];
end f;
model R30
Real z = f(R(time, {time, 1}));
end R30;
//// model: R31
record R
parameter Integer n = 2;
Real b[n];
end R;
function f
input R r;
output Real z;
algorithm
z := r.b[1];
end f;
model R31
Real z = f(R(2, {time, 1}));
end R31;
//// model: R32
record R
constant Real c = 3;
Real x;
end R;
function f
input R r;
output Real z;
algorithm
z := r.x + r.c;
end f;
model R32
Real z = f(R(time));
end R32;
//// model: R33
record R
Real x;
protected
Real y = 2;
end R;
function f
input R r;
output Real z;
algorithm
z := r.x;
end f;
model R33
Real z = f(R(time));
end R33;
//// model: R34
record I
end I;
record B
extends I;
Real a;
end B;
record R
extends B;
Real b;
end R;
function f
input R r;
output Real z;
algorithm
z := r.a + r.b;
end f;
model R34
Real z = f(R(time, 1));
end R34;
//// model: R35
record R
Real a;
Boolean b;
Integer i;
String s;
end R;
function f
input R r;
output Real z;
algorithm
z := if r.b then r.a else r.i;
end f;
model R35
Real z = f(R(time, true, 1, "x"));
end R35;
