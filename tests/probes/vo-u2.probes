//// set: vo-u2 — 同上：maxDepth = 4（三层求值、四层不求，常量 / 先访问的 Evaluate 截断）、fixed = false、无绑定 / start、数组、函数、子实例修饰、外层 Evaluate
//// model: U20
model U20
parameter Real p = a annotation(Evaluate = true);
parameter Real a = b;
parameter Real b = c;
parameter Real c = 1;
Real y = p;
end U20;
//// model: U21
model U21
parameter Real p = a annotation(Evaluate = true);
parameter Real a = b;
parameter Real b = c;
parameter Real c = d;
parameter Real d = 1;
Real y = p;
end U21;
//// model: U22
model U22
parameter Real d = 1;
parameter Real c = d;
parameter Real b = c;
