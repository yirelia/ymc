//// model: PK5
package P
  partial package PartialMedium
    replaceable partial model BaseProperties
      Real p;
    end BaseProperties;
    constant Integer nX = 1;
    type MassFlowRate = Real(quantity = "MassFlowRate", unit = "kg/s", min = -1e5, max = 1e5);
    replaceable record ThermodynamicState
      Real T;
    end ThermodynamicState;
    replaceable function g
      input Real x;
      output Real y;
    algorithm
      y := x + nX;
    end g;
  end PartialMedium;
  package Water
    extends PartialMedium(nX = 2);
    redeclare model extends BaseProperties
    equation
      p = 1;
    end BaseProperties;
  end Water;
  model Vessel
    replaceable package Medium = PartialMedium;
    Medium.ThermodynamicState state(T = time);
  end Vessel;
end P;
model PK5
  P.Vessel v(redeclare package Medium = P.Water);
end PK5;
//// model: PK6
package P
  partial package PartialMedium
    replaceable partial model BaseProperties
      Real p;
    end BaseProperties;
    constant Integer nX = 1;
    type MassFlowRate = Real(quantity = "MassFlowRate", unit = "kg/s", min = -1e5, max = 1e5);
    replaceable record ThermodynamicState
      Real T;
    end ThermodynamicState;
    replaceable function g
      input Real x;
      output Real y;
    algorithm
      y := x + nX;
    end g;
  end PartialMedium;
  package Water
    extends PartialMedium(nX = 2);
    redeclare model extends BaseProperties
    equation
      p = 1;
    end BaseProperties;
  end Water;
  model Vessel
    replaceable package Medium = PartialMedium;
    Real x[Medium.nX];
  end Vessel;
  model System
    replaceable package Medium = PartialMedium;
    Vessel v(redeclare package Medium = Medium);
  end System;
end P;
model PK6
  P.System s(redeclare package Medium = P.Water);
end PK6;
//// model: PK7
model PK7
  model A
    constant Integer n = 2;
    model B
      Real x[n];
    end B;
    B b;
  end A;
  A a(n = 3);
end PK7;
//// model: PK8
package P8
  model Base
    function f
      input Real x;
      output Real y;
    algorithm
      y := 2 * x;
    end f;
  end Base;
  model M
    extends Base;
    Real y = f(time);
  end M;
end P8;
model PK8
  P8.M m;
end PK8;
