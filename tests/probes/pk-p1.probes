//// set: pk-p1 — ADR-007 第 2 阶段（A 实例树查找）的目标探针族：Medium 式包重声明（组件类型 / 常量 / 函数 / 类型 / 记录 / 两层传递）、外层实例修饰、继承函数的访问路径、递归短类
//// model: PK1
package P
  partial package PartialMedium
    replaceable partial model BaseProperties
      Real p;
    end BaseProperties;
    constant Integer nX = 1;
    replaceable partial function f
      input Real x;
      output Real y;
    end f;
  end PartialMedium;
  package Water
    extends PartialMedium(nX = 2);
    redeclare model extends BaseProperties
    equation
      p = 1;
    end BaseProperties;
    redeclare function extends f
    algorithm
      y := 2 * x;
    end f;
  end Water;
  model Vessel
    replaceable package Medium = PartialMedium;
    Medium.BaseProperties medium;
    Real x[Medium.nX];
    Real y = Medium.f(time);
  end Vessel;
end P;
model PK1
  P.Vessel v(redeclare package Medium = P.Water);
end PK1;
//// model: PK2
package P
  partial package PartialMedium
    replaceable partial model BaseProperties
      Real p;
    end BaseProperties;
    constant Integer nX = 1;
    type MassFlowRate = Real(quantity = "MassFlowRate", unit = "kg/s", min = -1e5, max = 1e5);
    replaceable record ThermodynamicState
      Real T;
    end ThermodynamicState;
    replaceable function g
      input Real x;
      output Real y;
    algorithm
      y := x + nX;
    end g;
  end PartialMedium;
  package Water
    extends PartialMedium(nX = 2);
    redeclare model extends BaseProperties
    equation
      p = 1;
    end BaseProperties;
  end Water;
  model Vessel
    replaceable package Medium = PartialMedium;
    Real x[Medium.nX];
    Real y = Medium.g(time);
  end Vessel;
end P;
model PK2
  P.Vessel v;
end PK2;
