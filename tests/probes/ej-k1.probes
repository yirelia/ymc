//// model: CEd
package P
  type L = enumeration(U, X, Z, O);
end P;
model Inner
  constant Integer t[P.L, P.L] = [1, 2, 3, 4; 2, 3, 4, 1; 3, 4, 1, 2; 4, 1, 2, 3];
  discrete P.L a(start = P.L.U, fixed = true);
  Integer k;
algorithm
  when time > 0.5 then
    a := P.L.Z;
  end when;
  k := t[a, a];
end Inner;
model CEd
  Inner i;
end CEd;
