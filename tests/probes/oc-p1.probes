  end Body;
end OCa;

model ProbeM
  OCa.World w1;
  OCa.World w2;
  OCa.Joint j;
  OCa.World w3;
  OCa.World w4;
  OCa.Joint k;
  OCa.Body b;
equation
  connect(w1.frame_b, j.frame_a);
  connect(j.frame_b, w2.frame_b);
  connect(w3.frame_b, w4.frame_b);
  connect(k.frame_a, b.frame_a);
end ProbeM;
//// model: ProbeN
// Probe (n): naming of the generated equalityConstraint function when lhs is nested / an array element.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;
end OCa;

model Sub
  OCa.World world;
  OCa.Joint j[2];
equation
  connect(j[1].frame_b, world.frame_b);
  connect(j[1].frame_a, j[2].frame_a);
  connect(j[2].frame_b, world.frame_b);
end Sub;

model ProbeN
  Sub sub;
  OCa.World w2;
  OCa.Joint jj[2];
equation
  connect(jj[2].frame_a, w2.frame_b);
  connect(jj[1].frame_b, jj[2].frame_b);
  connect(jj[1].frame_a, w2.frame_b);
end ProbeN;
//// model: ProbeP
// Probe (p): connector arrays connected as whole arrays (connect(a.fs, b.fs)) -> per-element graph edges; loop over array elements.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model Bus
    Frame fs[2];
  equation
    Connections.branch(fs[1].R, fs[2].R);
    fs[2].R.T = fs[1].R.T;
    fs[2].R.w = fs[1].R.w;
    fs[1].f + fs[2].f = 0;
  end Bus;
end OCa;

model ProbeP
  OCa.World world;
  OCa.Bus a;
  OCa.Bus b;
equation
  connect(world.frame_b, a.fs[1]);
  connect(a.fs, b.fs);
  connect(b.fs[2], world.frame_b);
end ProbeP;
//// model: ProbeQ
// Probe (q): graph without any (definite or potential) root: isRoot=false, rooted=true (no distances), loop still broken.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model RJ
    Frame frame_a;
    Frame frame_b;
    Boolean ra;
    Boolean rb;
    Boolean ia;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    ra = Connections.rooted(frame_a.R);
    rb = Connections.rooted(frame_b.R);
    ia = Connections.isRoot(frame_a.R);
    frame_a.f + frame_b.f = 0;
  end RJ;
end OCa;

model ProbeQ
  OCa.RJ j1;
  OCa.RJ j2;
equation
  connect(j1.frame_b, j2.frame_a);
  connect(j2.frame_b, j1.frame_a);
end ProbeQ;
//// model: ProbeR
// Probe (r): overdetermined record that itself contains a nested record -> ComponentRef.isPrefix only strips ONE level,
// so in a broken connect the nested-record leaves (R.I.T[*]) are still connected while direct leaves (R.w) are dropped.
package OCr
  record Inner
    Real T[2];
  end Inner;

  record Orientation
    Inner I;
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.I.T[1]*R2.I.T[2] - R1.I.T[2]*R2.I.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_a.f + frame_b.f = 0;
  end Joint;
end OCr;

model ProbeR
  OCr.World world;
  OCr.Joint j1;
equation
  connect(world.frame_b, j1.frame_a);
  connect(j1.frame_b, world.frame_b);
end ProbeR;
//// model: ProbeS
// Probe (s): rooted() distances are computed on branches + NON-redundant connections only (connections dropped as redundant are not edges).
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model RJ2
    Frame frame_a;
    Frame frame_b;
    Boolean ra;
    Boolean rb;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    ra = Connections.rooted(frame_a.R);
    rb = Connections.rooted(frame_b.R);
    frame_a.f + frame_b.f = 0;
  end RJ2;
end OCa;

model ProbeS
  OCa.World w;
  OCa.RJ2 j;
  OCa.Body k;
  OCa.Body l;
equation
  connect(j.frame_a, w.frame_b);
  connect(j.frame_a, k.frame_a);
  connect(k.frame_a, w.frame_b);
  connect(w.frame_b, l.frame_a);
  connect(l.frame_a, j.frame_b);
end ProbeS;
//// model: ProbeT
// Probe (t): PowerSystems-style overdetermined TYPE (extends Real) used as an ARRAY theta[2] in a connector,
// equalityConstraint with Real[0] residue; loop -> broken edge (a.theta, b.theta) removes theta[1] AND theta[2]
// connections (ComponentRef.isPrefix ignores the subscripts of the last identifier).
package PS
  type ReferenceAngle "Reference angle"
    extends Real;
    function equalityConstraint
      input ReferenceAngle theta1[:];
      input ReferenceAngle theta2[:];
      output Real[0] residue "No constraints";
    algorithm
    end equalityConstraint;
  end ReferenceAngle;

  connector Terminal
    Real v[2];
    flow Real i[2];
    ReferenceAngle theta[2];
  end Terminal;

  model Source
    Terminal term;
  equation
    Connections.potentialRoot(term.theta);
    if Connections.isRoot(term.theta) then
      term.theta = {0, 0};
    end if;
    term.v = {1, 2};
  end Source;

  model Line
    Terminal term_p;
    Terminal term_n;
  equation
    Connections.branch(term_p.theta, term_n.theta);
    term_n.theta = term_p.theta;
    term_p.i + term_n.i = {0, 0};
    term_p.v - term_n.v = term_p.i;
  end Line;
end PS;

model ProbeT
  PS.Source s;
  PS.Line l1;
  PS.Line l2;
equation
  connect(s.term, l1.term_p);
  connect(s.term, l2.term_p);
  connect(l1.term_n, l2.term_n);
end ProbeT;
//// model: ProbeU
// Probe (u): (1) rooted() partner selection when a cref is in two branches: the LAST added branch wins
// (graph.branches is in reverse addition order); (2) broken connections are still edges for the rooted() BFS.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model Tri
    Frame frame_a;
    Frame frame_b;
    Frame frame_c;
    Boolean ra;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    Connections.branch(frame_a.R, frame_c.R);
    ra = Connections.rooted(frame_a.R);
    frame_a.f + frame_b.f + frame_c.f = 0;
  end Tri;

  model RJ3
    Frame frame_a;
    Frame frame_b;
    Boolean ra;
    Boolean rb;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    ra = Connections.rooted(frame_a.R);
    rb = Connections.rooted(frame_b.R);
    frame_a.f + frame_b.f = 0;
  end RJ3;
end OCa;

model ProbeU
  OCa.World w;
  OCa.Tri x;
  OCa.RJ3 j1;
  OCa.RJ3 j2;
  OCa.RJ3 j3;
equation
  connect(w.frame_b, x.frame_b);
  connect(w.frame_b, j1.frame_a);
  connect(j1.frame_b, j2.frame_a);
  connect(j2.frame_b, j3.frame_b);
  connect(j3.frame_a, w.frame_b);
end ProbeU;
//// model: ProbeV
// Probe (v): connector with TWO overdetermined records (Ra declared before Rb) -> one connect yields two graph edges;
// both edges of the first connect get broken -> order of the two equalityConstraint equations within one connect.
package OCv
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector F2
    Real r;
    Orientation Ra;
    Orientation Rb;
    flow Real f;
  end F2;

  model World
    F2 f;
  equation
    Connections.root(f.Ra);
    Connections.root(f.Rb);
  end World;

  model Joint
    F2 a;
    F2 b;
  equation
    Connections.branch(a.Ra, b.Ra);
    Connections.branch(a.Rb, b.Rb);
  end Joint;
end OCv;

model ProbeV
  OCv.World w;
  OCv.Joint j;
equation
  connect(w.f, j.a);
  connect(j.b, w.f);
end ProbeV;
//// model: ProbeW
// Probe (w): how Connections.* calls print when they are NOT consumed/evaluated (time-varying if-equation, algorithm, binding).
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model JW
    Frame frame_a;
    Frame frame_b;
    Boolean ar;
    parameter Boolean pb = Connections.rooted(frame_a.R);
  equation
    if time > 0.5 then
      Connections.branch(frame_a.R, frame_b.R);
      Connections.root(frame_a.R);
    end if;
    frame_a.f + frame_b.f = 0;
  algorithm
    ar := Connections.rooted(frame_a.R);
  end JW;
end OCa;

model ProbeW
  OCa.JW j;
end ProbeW;
