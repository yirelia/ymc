//// set: oc-p1 — 超定连接图：root / branch 摘除、环里压平序最先的连接断开出 equalityConstraint 方程（函数按 lhs 实例路径起名）、潜在根按优先级 + cref 字节序、isRoot / rooted（BFS 距离、最后一个 branch 定对端）、纯连接环 / 重复连接不断、结构 if / for 里的、非结构 if 里留裸名、Real[0] 输出消失；标量输出 / 类型超定 / 裸 rooted / 绑定里的（SKIP）
//// model: ProbeA
// Probe (a): definite root (world) + chain of branches (joints), tree-shaped graph, no loop.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;
end OCa;

model ProbeA
  OCa.World world;
  OCa.Joint j1;
  OCa.Joint j2;
  OCa.Body b;
equation
  connect(world.frame_b, j1.frame_a);
  connect(j1.frame_b, j2.frame_a);
  connect(j2.frame_b, b.frame_a);
end ProbeA;
//// model: ProbeB
// Probe (b): kinematic loop (single cycle) world-j1-j2-j3-world; one connect must be broken.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
