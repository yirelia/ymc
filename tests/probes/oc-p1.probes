model ProbeH
  OCa.World world;
  OCa.Joint j1;
  OCa.Body b1;
  OCa.Body b2;
equation
  connect(world.frame_b, j1.frame_a);
  connect(world.frame_b, j1.frame_a);
  connect(j1.frame_b, b1.frame_a);
  connect(b1.frame_a, b2.frame_a);
  connect(b2.frame_a, j1.frame_b);
  connect(j1.frame_b, world.frame_b);
end ProbeH;
//// model: ProbeI
// Probe (i): Connections.root/potentialRoot inside a parameter if-equation (resolved at flattening) and Connections.branch inside a for-loop.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model World2
    parameter Boolean useRoot = true;
    Frame frame_b;
  equation
    if useRoot then
      Connections.root(frame_b.R);
    else
      Connections.potentialRoot(frame_b.R, 3);
    end if;
    frame_b.r = 0;
  end World2;

  model MultiJoint
    parameter Integer n = 2;
    Frame fa[n];
    Frame fb[n];
    Boolean ro[n];
  equation
    for i in 1:n loop
      Connections.branch(fa[i].R, fb[i].R);
      fb[i].R.T = fa[i].R.T;
      fb[i].R.w = fa[i].R.w;
      ro[i] = Connections.rooted(fa[i].R);
      fa[i].f + fb[i].f = 0;
    end for;
  end MultiJoint;
end OCa;

model ProbeI
  OCa.World2 wa(useRoot = true);
  OCa.World2 wb(useRoot = false);
  OCa.MultiJoint mj;
equation
  connect(wa.frame_b, mj.fa[1]);
  connect(mj.fb[1], mj.fa[2]);
  connect(wb.frame_b, mj.fb[2]);
end ProbeI;
//// model: ProbeJ
// Probe (j): Connections.isRoot in a parameter binding and in an algorithm section (evaluation only covers equations/initial equations).
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model FB3
    Frame frame_a;
    parameter Boolean pr = Connections.isRoot(frame_a.R);
    Boolean ar;
  equation
    Connections.potentialRoot(frame_a.R);
    frame_a.f = 1;
  algorithm
    ar := Connections.isRoot(frame_a.R);
  end FB3;
end OCa;

model ProbeJ
  OCa.FB3 b;
end ProbeJ;
//// model: ProbeK
// Probe (k): Connections.rooted on a cref that has no Connections.branch -> warning + false.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model FB4
    Frame frame_a;
    Boolean bb;
  equation
    Connections.potentialRoot(frame_a.R);
    bb = Connections.rooted(frame_a.R);
    frame_a.f = 1;
  end FB4;
end OCa;

model ProbeK
  OCa.FB4 b;
end ProbeK;
//// model: ProbeL
// Probe (l): name of the generated equalityConstraint function for different ways of declaring the overdetermined class:
// record extending a base record that holds the function (b1), short-class record alias (b2), type extending Real[2] (b3).
package OCl
  record OBase
    Real T[2];
    Real w;
    function equalityConstraint
      input OBase R1;
      input OBase R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1] - R2.T[1]};
    end equalityConstraint;
  end OBase;

  record OExt
    extends OBase;
  end OExt;

  record OAlias = OBase;

  type Real2 = Real[2];
  type OType
    extends Real2;
    function equalityConstraint
      input Real u1[2];
      input Real u2[2];
      output Real residue[1];
    algorithm
      residue[1] := u1[1] - u2[1];
    end equalityConstraint;
  end OType;

  connector F1
    Real r;
    OExt R;
    flow Real f;
  end F1;

  connector F2
    Real r;
    OAlias R;
    flow Real f;
  end F2;

  connector F3
    Real r;
    OType R;
    flow Real f;
  end F3;

  model Loop1
    F1 a, b;
  equation
    Connections.root(a.R);
    Connections.branch(a.R, b.R);
    connect(a, b);
  end Loop1;

  model Loop2
    F2 a, b;
  equation
    Connections.root(a.R);
    Connections.branch(a.R, b.R);
    connect(a, b);
  end Loop2;

  model Loop3
    F3 a, b;
  equation
    Connections.root(a.R);
    Connections.branch(a.R, b.R);
    connect(a, b);
  end Loop3;
end OCl;

model ProbeL
  OCl.Loop1 b1;
  OCl.Loop2 b2;
  OCl.Loop3 b3;
end ProbeL;
