package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
