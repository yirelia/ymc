    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;
end OCa;

model ProbeG2
  OCa.World world;
  OCa.Joint j1;
equation
  connect(world.frame_b, j1.frame_a);
  connect(j1.frame_b, world.frame_b);
end ProbeG2;
//// model: ProbeI2
// Probe (i2): Connections.potentialRoot inside an if-equation with a NON-parameter condition (not seen by the graph builder).
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model FBTime
    Frame frame_a;
  equation
    if time > 0.5 then
      Connections.potentialRoot(frame_a.R);
    end if;
    frame_a.f = 1;
  end FBTime;
end OCa;

model ProbeI2
  OCa.FBTime b;
end ProbeI2;
//// model: ProbeV2
// Probe (v2): same as (v) but Rb declared BEFORE Ra in the connector -> edge order is by NAME (connector potentials sorted), not declaration.
// both edges of the first connect get broken -> order of the two equalityConstraint equations within one connect.
package OCv
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector F2
    Real r;
    Orientation Rb;
    Orientation Ra;
    flow Real f;
  end F2;

  model World
    F2 f;
  equation
    Connections.root(f.Ra);
    Connections.root(f.Rb);
  end World;

  model Joint
    F2 a;
    F2 b;
  equation
    Connections.branch(a.Ra, b.Ra);
    Connections.branch(a.Rb, b.Rb);
  end Joint;
end OCv;

model ProbeV2
  OCv.World w;
  OCv.Joint j;
equation
  connect(w.f, j.a);
  connect(j.b, w.f);
end ProbeV2;
