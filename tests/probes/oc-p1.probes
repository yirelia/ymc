  end Body;
end OCa;

model ProbeB
  OCa.World world;
  OCa.Joint j1;
  OCa.Joint j2;
  OCa.Joint j3;
equation
  connect(world.frame_b, j1.frame_a);
  connect(j1.frame_b, j2.frame_a);
  connect(j2.frame_b, j3.frame_b);
  connect(j3.frame_a, world.frame_b);
end ProbeB;
//// model: ProbeC
// Probe (c): potential roots with different priorities, no definite root. Lower number wins?
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model FreeBody
    Frame frame_a;
    parameter Integer p = 0;
    Boolean isR;
  equation
    Connections.potentialRoot(frame_a.R, p);
    isR = Connections.isRoot(frame_a.R);
    frame_a.f = 1;
  end FreeBody;
end OCa;

model ProbeC
  OCa.FreeBody b1(p = 2);
  OCa.Joint j;
  OCa.FreeBody b2(p = 1);
equation
  connect(b1.frame_a, j.frame_a);
  connect(j.frame_b, b2.frame_a);
end ProbeC;
//// model: ProbeD
// Probe (d): Connections.isRoot / Connections.rooted / rooted in if-equations, if-expressions, initial equations.
package OCa
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;

  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r = 0;
    frame_b.R.T = {1, 0};
    frame_b.R.w = 0;
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r = frame_a.r + 1;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    frame_a.f + frame_b.f = 0;
  end Joint;

  model Body
    Frame frame_a;
  equation
    frame_a.f = 1;
  end Body;

  model RJoint "joint whose equations depend on rooted()"
    Frame frame_a;
    Frame frame_b;
    Real y;
    Real y2;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    if Connections.rooted(frame_a.R) then
      frame_b.R.T = frame_a.R.T;
      frame_b.R.w = frame_a.R.w;
    else
      frame_a.R.T = frame_b.R.T;
      frame_a.R.w = frame_b.R.w;
    end if;
    y = if rooted(frame_a.R) then 1 else 2;
    y2 = if Connections.rooted(frame_b.R) then 3 else 4;
    frame_b.r = frame_a.r;
    frame_a.f + frame_b.f = 0;
  end RJoint;

  model FreeBody2
    Frame frame_a;
    Real z;
  equation
    Connections.potentialRoot(frame_a.R);
    if Connections.isRoot(frame_a.R) then
      frame_a.R.T = {1, 0};
      frame_a.R.w = 0;
    end if;
    z = if Connections.isRoot(frame_a.R) then 10 else 20;
    frame_a.f = 1;
  initial equation
    z = if Connections.isRoot(frame_a.R) then 10 else 20;
  end FreeBody2;
end OCa;

model ProbeD
  OCa.World world;
  OCa.RJoint rj1;
  OCa.RJoint rj2;
  OCa.FreeBody2 fb;
  OCa.RJoint rj3;
equation
  connect(world.frame_b, rj1.frame_a);
  connect(rj1.frame_b, rj2.frame_b);
  connect(rj3.frame_b, fb.frame_a);
end ProbeD;
//// model: ProbeE
// Probe (e): MultiBody-like Frames.Orientation (T[3,3], w[3], equalityConstraint -> Real[3])
// inside a connector with r_0[3], f[3], t[3]; two independent kinematic loops sharing the world frame
// -> two broken connects with different lhs instance paths.
package MB
  record Orientation "Orientation object defining rotation from a frame 1 into a frame 2"
    Real T[3, 3] "Transformation matrix from world frame to local frame";
    Real w[3] "Absolute angular velocity of local frame, resolved in local frame";

    encapsulated function equalityConstraint
      "Return the constraint residues to express that two frames have the same orientation"
      import MB;
      input MB.Orientation R1 "Orientation object to rotate frame 0 into frame 1";
      input MB.Orientation R2 "Orientation object to rotate frame 0 into frame 2";
      output Real residue[3] "The rotation angles around x-, y-, and z-axis";
    algorithm
      residue := {
         atan2(cross(R1.T[1, :], R1.T[2, :])*R2.T[2, :], R1.T[1, :]*R2.T[1, :]),
         atan2(-cross(R1.T[1, :], R1.T[2, :])*R2.T[1, :], R1.T[2, :]*R2.T[2, :]),
         atan2(R1.T[2, :]*R2.T[1, :], R1.T[3, :]*R2.T[3, :])};
      annotation(Inline=true);
    end equalityConstraint;
  end Orientation;

  connector Frame "Coordinate system fixed to the component with one cut-force and cut-torque"
    Real r_0[3] "Position vector from world frame to the connector frame origin";
    Orientation R "Orientation object to rotate the world frame into the connector frame";
    flow Real f[3] "Cut-force resolved in connector frame";
    flow Real t[3] "Cut-torque resolved in connector frame";
  end Frame;

  model World
    Frame frame_b;
  equation
    Connections.root(frame_b.R);
    frame_b.r_0 = zeros(3);
    frame_b.R.T = identity(3);
    frame_b.R.w = zeros(3);
  end World;

  model Joint
    Frame frame_a;
    Frame frame_b;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    frame_b.r_0 = frame_a.r_0;
    frame_b.R.T = frame_a.R.T;
    frame_b.R.w = frame_a.R.w;
    zeros(3) = frame_a.f + frame_b.f;
    zeros(3) = frame_a.t + frame_b.t;
  end Joint;
end MB;

model ProbeE
  MB.World world;
  MB.Joint j1;
  MB.Joint j2;
  MB.Joint j3;
  MB.Joint j4;
equation
  connect(world.frame_b, j1.frame_a);
  connect(j1.frame_b, j2.frame_a);
  connect(j2.frame_b, world.frame_b);
  connect(j3.frame_b, j4.frame_a);
  connect(world.frame_b, j3.frame_a);
  connect(j4.frame_b, world.frame_b);
end ProbeE;
//// model: ProbeF
