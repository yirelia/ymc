//// set: il-p1 — 继承来的类 / 元素的查找（ClassTree.expand：本地 > 继承 > import，extends 先后先到先得；继承类的词法父亲是基类）；经改了基类常量的 extends 继承来的类、本类有元素级重声明时继承来的类（IL22）、外层实例上被改过的常量（嵌套类 / 模型内函数读到的是改过的值）SKIP；继承来的函数的压平名 = 访问它的实例路径，经包路径访问的 SKIP
//// model: IL1
model IL1
  model Base
    model B
      Real x = 1;
    end B;
  end Base;
  model A
    extends Base;
    B b;
  end A;
  A a;
end IL1;
//// model: IL2
model IL2
  model Base
    function f
      input Real x;
      output Real y;
    algorithm
      y := 2 * x;
    end f;
    constant Real k = 3;
    type T = Real(unit = "m");
  end Base;
  model A
    extends Base;
    Real y = f(time) + k;
    T z = time;
  end A;
  A a;
end IL2;
//// model: IL3
model IL3
  package Base
    constant Integer n = 1;
    model B
      Real x[n] = fill(1, n);
    end B;
  end Base;
  package P
    extends Base(n = 3);
  end P;
  P.B b;
end IL3;
//// model: IL4
model IL4
  package Base
    constant Integer n = 2;
    type T = Real(unit = "m");
    function f
      input Real x;
      output Real y;
    algorithm
      y := n * x;
    end f;
    model B
      T x = f(time);
    end B;
  end Base;
  package P
    extends Base;
  end P;
  P.B b;
  P.T t = P.f(time) + P.n;
end IL4;
//// model: IL5
model IL5
  model A
    constant Integer n = 1;
    model B
      Real x[n] = fill(1, n);
    end B;
    B b;
  end A;
  A a(n = 3);
end IL5;
//// model: IL6
model IL6
  model Base
