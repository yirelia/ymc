//// set: pk-p48 — 67n：67m 留下的两个旧错及 testsuite 里 "non-literal array dimension" 的余量（redeclare/Bug2695、enums/EnumArrayMod1、records/RecordEnumBinding、scodeinst/RecordBinding5、scodeinst/Size6）及兄弟写法。ECR1-ECR99：外层作用域里查到的非常量组件，omc 报 "Component 'n' was found in an enclosing scope but is not a constant."（NFLookup.lookupSimpleCref :838-908 + LookupState.checkCrefVariability，NFLookupState.mo:649-672 v1.25.0）——维 / 绑定 / 方程 / 下标 / 属性 / 条件 / for 范围 / extends 修饰 / 短类的修饰与维 / 函数体 / 函数形参缺省；条件为假的组件、零长数组、if false 分支里、被折叠的函数调用的体里同样报（ECR42-44 / ECR28 / ECR94 / ECR95）；只看末段（`c.k` 常量成员读得，ECR19 / ECR21），变率下沉（`constant R r` 的 `r.y`，ECR18）；此前维 / 条件 / 范围 / 函数体 ACCEPTS-INVALID 共 25 例。NCR1-NCR25：修饰里的类重声明（`A a(redeclare type T = T)`）右边的名字在写修饰的那个实例里解析，类节点此前只按元素缓存（b2 取到 b1 那份，TDN13 一族 15 例静默错），extends 修饰里的新类词法作用域同样是实例（NCR20）。FWD1-FWD55：维读到声明在后的子实例 / 记录参数（`Real x[a.p]; A a(p = 2);`、`size(a.y, 1)`，含 Size6）走第二遍；读的是数组元素或依赖链上有数组元素（FWD6 / FWD12 / FWD13 / FWD47-FWD50）标记是组件级的，照旧 SKIP（FWD13 / FWD50 omc 内部错）。CCB1-CCB28：复合组件的 `:` 维由绑定引用的记录数组定（deduceDimensionFromExp，NFTyping.mo:776-821），`:` 维的数组再被引用取发射时记下的维；别的式子（`fill(R(), 3)` 定型留下构造函数）、推导式照旧 SKIP。ETD1-ETD30：复合数组的类型名维（`R re[E]`、`M m[Boolean]`），元素下标打标签；写了下标的引用（ETD7 / ETD19）照旧 SKIP，Integer 下标 omc 报类型错（ETD8）。CSX1-CSX18：常量数组带切片取已发射的整体值（看得到 extends 修饰）、非字面量维的常量数组记形状、空常量数组经子实例引用。UEN1-UEN15 单测同构。基线 PASS 49 / FAIL 17 / ACCEPTS-INVALID 28 / SKIP 126 / BOTH-REJECT 50 → PASS 152 / SKIP 40 / BOTH-REJECT 78，无 FAIL
//// model: ECR1
model ECR1
  parameter Integer n = 2;
  model A
    Real x[n];
  end A;
  A a;
end ECR1;
//// model: ECR2
model ECR2
  model A
    parameter Integer n = 2;
    model B
      Real x[n];
    end B;
    B b;
  end A;
  A a(n = 3);
end ECR2;
//// model: ECR3
model ECR3
  parameter Real p = 2;
  model A
    Real x = p;
  end A;
  A a;
end ECR3;
//// model: ECR4
model ECR4
  parameter Real p = 2;
  model A
    Real x;
  equation
    x = p;
  end A;
  A a;
end ECR4;
//// model: ECR5
model ECR5
  parameter Integer n = 2;
  model A
    Real y[3];
    Real x = y[n];
  end A;
  A a;
end ECR5;
//// model: ECR6
model ECR6
  parameter Real p = 2;
  model A
    Real x(start = p);
  end A;
  A a;
end ECR6;
//// model: ECR7
model ECR7
  parameter Real p = 2;
  model B
    parameter Real k = 1;
  end B;
  model A
    B b(k = p);
  end A;
  A a;
end ECR7;
//// model: ECR8
model ECR8
  parameter Boolean c = true;
  model A
    Real x if c;
  end A;
  A a;
end ECR8;
//// model: ECR9
model ECR9
  parameter Boolean c = true;
  model A
    Real x;
  equation
    if c then
      x = 1;
    else
      x = 2;
    end if;
  end A;
  A a;
end ECR9;
//// model: ECR10
model ECR10
  parameter Integer n = 2;
  model A
    Real x[2];
  equation
    for i in 1:n loop
      x[i] = i;
    end for;
  end A;
  A a;
end ECR10;
//// model: ECR11
