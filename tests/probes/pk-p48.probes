  parameter Real p = 2;
  function f
    input Real u;
    output Real y;
  algorithm
    y := u * p;
  end f;
  function g = f;
  Real x = g(time);
end ECR89;
//// model: ECR90
model ECR90
  constant Real p = 2;
  function f
    input Real u;
    output Real y;
  algorithm
    y := if u > 0 then f(u - 1) * p else 1;
  end f;
  Real x = f(2);
end ECR90;
