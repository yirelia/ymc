end ECR43;
//// model: ECR44
model ECR44
  parameter Boolean b = true;
  model A
    Real x;
  equation
    if false then
      x = if b then 1 else 2;
    else
      x = 3;
    end if;
  end A;
  A a;
end ECR44;
//// model: ECR45
model ECR45
