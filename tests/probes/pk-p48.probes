end ECR57;
//// model: ECR58
model ECR58
  parameter Integer n = 2;
  function f
    input Real u[n];
    output Real y;
  algorithm
    y := sum(u);
  end f;
  Real x = f({1, 2});
end ECR58;
//// model: ECR59
