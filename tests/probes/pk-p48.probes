//// model: ECR47
model ECR47
  connector C
    Real e;
    flow Real f;
  end C;
  C c;
  model A
    C d;
  equation
    connect(c, d);
  end A;
  A a;
end ECR47;
//// model: ECR48
model ECR48
  parameter Real p = 1;
  model A
    Real x;
  equation
    when x > p then
      reinit(x, 0);
    end when;
    der(x) = 1;
  end A;
  A a;
end ECR48;
//// model: ECR49
model ECR49
  parameter Real p = 1;
  model A
    Real x = 1;
  equation
    assert(x > p, "bad");
  end A;
  A a;
end ECR49;
