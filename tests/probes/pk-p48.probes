//// model: CSX1
model CSX1
  record B
    constant Boolean f;
    constant Real m[2];
    constant Real d[2] = if f then {1, 2} else m;
    constant Real e[1] = d[1:1];
  end B;
  record D
    extends B(final f = false, final m = {3, 4});
  end D;
  D r;
end CSX1;
//// model: CSX2
model CSX2
  record B
    constant Boolean f;
    constant Real m[2];
    constant Real d[2] = if f then {1, 2} else m;
    constant Real e[1] = d[1:end - 1] / sum(d);
  end B;
  record D
    extends B(final f = false, final m = {3, 4});
  end D;
  D r;
end CSX2;
