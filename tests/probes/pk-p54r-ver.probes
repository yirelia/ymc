//// model: R68eVVC15
model S
  function h
    input Real u;
    output Real v;
  algorithm
    v := u * 10;
  end h;
  class H
    function g
      input Real u;
      output Real v;
    algorithm
      v := u + 1;
    end g;
    function f
      input Real x;
      output Real y;
    algorithm
      y := g(x) + h(x);
      annotation(inverse(x = h(y)));
    end f;
