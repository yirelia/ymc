//// set: pk-p54r-ver — 68e A3 核对评审的边界探针（门控时序、raw 遍、内建同名判定、实例树改名、G1 深处不纯调用；模型名前缀 R68eV）
//// model: R68eVVC01
model S
  function h
    input Real u;
    output Real v;
  algorithm
    v := u * 10;
  end h;
  class H
    function g
      input Real u;
      output Real v;
    algorithm
      v := u + 1;
    end g;
    function f
      input Real x;
      output Real y;
    algorithm
      y := g(x) + h(x);
    end f;
    Real y = f(time);
  end H;
  H c;
  Real w = 2;
end S;
model R68eVVC01
  extends S;
  Real q = w + 1;
end R68eVVC01;
//// model: R68eVVC02
model S
  function h
    input Real u;
    output Real v;
  algorithm
    v := u * 10;
  end h;
  class T
    class H
      function g
        input Real u;
        output Real v;
      algorithm
        v := u + 1;
      end g;
      function f
        input Real x;
        output Real y;
      algorithm
        y := g(x) + h(x);
      end f;
      Real y = f(time);
    end H;
    H c;
  end T;
  T t;
end S;
model R68eVVC02
  S s;
end R68eVVC02;
