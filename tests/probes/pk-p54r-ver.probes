//// model: R68eVVC10
model S
  function hd
    input Real x;
    input Real dx;
    output Real dy;
  algorithm
    dy := 3 * dx;
  end hd;
  class H
    function g
      input Real u;
      output Real v;
    algorithm
      v := u + 1;
    end g;
    function f2
      input Real x;
      output Real y;
    algorithm
      y := 3 * x;
      annotation(derivative = hd);
    end f2;
    function f
      input Real x;
      output Real y;
    algorithm
      y := g(x);
    end f;
    Real y = f2(time) + f(time);
  end H;
  H c;
end S;
model R68eVVC10
  S s;
end R68eVVC10;
//// model: R68eVVC11
package Pk
  function k
    input Real u;
    output Real v;
  algorithm
    v := u * 4;
  end k;
  class H
    function g
      input Real u;
      output Real v;
    algorithm
      v := u + 1;
    end g;
    function f
      input Real x;
      output Real y;
    algorithm
      y := g(x) + k(x);
    end f;
    Real y = f(time);
  end H;
  model M
    H c;
    Real z = k(time);
  end M;
end Pk;
model R68eVVC11
  extends Pk.M;
end R68eVVC11;
