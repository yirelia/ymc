//// set: pk-p24 — 函数型实参（ADR-009）：函数型输入的函数类型、部分函数应用、函数名当值、经函数型输入的调用（装箱 / 拆箱）
//// model: PKZ1
package PZ1
  partial function PSF "base"
    input Real u "Independent variable";
    output Real y "Dependent variable";
  end PSF;
  function solve "solve f(u) = 0"
    input PSF f "the function";
    input Real u_min;
    input Real u_max;
    input Real tolerance = 1e-13;
    output Real u;
  protected
    Real fa;
    Real fb;
  algorithm
    fa := f(u_min);
    fb := f(u_max);
    u := if abs(fa) < tolerance then u_min else u_max - fb * (u_max - u_min) / (fb - fa);
  end solve;
  function T_ph "inverse"
    input Real p;
    input Real h;
    output Real T;
  protected
    function f_nl "residual"
      extends PSF;
      input Real p;
      input Real h;
    algorithm
      y := p * u - h;
    end f_nl;
  algorithm
    T := solve(function f_nl(p = p, h = h), 190, 647);
  end T_ph;
end PZ1;
model PKZ1
  Real T = PZ1.T_ph(time, 2);
end PKZ1;
//// model: PKZ2
package PZ2
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
    input Real b;
  algorithm
    y := a * u + b;
  end g;
  function solve
    input PSF fun;
    input Real x;
    output Real r;
  algorithm
    r := fun(x) + 2 * fun(x + 1);
  end solve;
  function h
    input Real a;
    input Real b;
    output Real r;
  algorithm
    r := solve(function g(b = b, a = a), 3);
  end h;
end PZ2;
model PKZ2
  Real r = PZ2.h(time, 2);
end PKZ2;
//// model: PKZ3
package PZ3
  constant Integer n = 1;
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function solve
    input PSF f;
    input Real a;
    output Real r;
  algorithm
    r := f(a);
  end solve;
  function T_X
    input Real p;
    input Real X[:];
    output Real T;
  protected
    function f_nl
      extends PSF;
      input Real p;
      input Real X[:];
    algorithm
      y := p * u - sum(X);
    end f_nl;
  algorithm
    T := solve(function f_nl(p = p, X = X[1:n]), 1);
  end T_X;
end PZ3;
model PKZ3
  Real T = PZ3.T_X(time, {0.5, 0.5});
end PKZ3;
//// model: PKZ4
package PZ4
  partial function PF
    input Real u[2];
    input Integer k = 2;
    output Real y;
  end PF;
  function g
    extends PF;
    input Real c;
  algorithm
    y := c * u[1] + k * u[2];
  end g;
  function apply
    input PF f;
    input Real v[2];
    output Real r;
  algorithm
    r := f(v);
  end apply;
  function h
    input Real c;
    output Real r;
  algorithm
    r := apply(function g(c = c), {c, 2 * c});
  end h;
end PZ4;
model PKZ4
  Real r = PZ4.h(time);
end PKZ4;
//// model: PKZ4b
package PZ4b
  constant Integer n = 2;
  partial function PF
    input Real u;
    input Real x[n];
    input Real k = 1;
    output Real y;
  end PF;
  function g
    extends PF;
    input Real c;
  algorithm
    y := c * u + k * x[1] + x[2];
  end g;
  function apply
    input PF f;
    input Real v;
    input Real w[2];
    output Real r;
  algorithm
    r := f(v, w) - f(x = w, u = 2 * v, k = 3);
  end apply;
  function h
    input Real c;
    output Real r;
  algorithm
    r := apply(function g(c = c), c, {c, 1});
  end h;
end PZ4b;
model PKZ4b
  Real r = PZ4b.h(time);
end PKZ4b;
//// model: PKZ5
package PZ5
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u - 1;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
end PZ5;
model PKZ5
  parameter Real a = 2;
  Real r = PZ5.solve(function PZ5.g(a = a), time);
end PKZ5;
//// model: PKZ6
package PZ6
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function solve
    input PSF f;
    input Real a;
    input Real b;
    output Real r;
  algorithm
    r := (f(a) + f(b)) / 2;
  end solve;
  package BaseMedium
    constant Integer nX = 2;
    replaceable function T_phX
      input Real p;
      input Real h;
      input Real X[:];
      output Real T;
    end T_phX;
  end BaseMedium;
  package Moist
    extends BaseMedium(nX = 2);
    constant Integer nXi = 1;
    redeclare function extends T_phX
    protected
      function f_nl
        extends PSF;
        input Real p;
        input Real h;
        input Real X[:];
      algorithm
        y := p * u - h + sum(X);
      end f_nl;
    algorithm
      T := solve(function f_nl(p = p, h = h, X = X[1:nXi]), 190, 647);
    end T_phX;
  end Moist;
  model Comp
    replaceable package Medium = BaseMedium;
    Real T = Medium.T_phX(1e5, time, {0.1, 0.9});
  end Comp;
end PZ6;
model PKZ6
  PZ6.Comp c(redeclare package Medium = PZ6.Moist);
end PKZ6;
//// model: PKZ7
package PZ7
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function solve2
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := solve(f, x) * 2;
  end solve2;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve2(function g(a = a), 3);
  end h;
end PZ7;
model PKZ7
  Real r = PZ7.h(time);
end PKZ7;
//// model: PKZ8
package PZ8
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
  algorithm
    y := 2 * u - 1;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(u = x);
  end solve;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve(g, a);
  end h;
end PZ8;
model PKZ8
  Real r = PZ8.h(time);
end PKZ8;
//// model: PKZ9
package PZ9
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u;
  end g;
  function solve
