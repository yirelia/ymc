//// model: PKZ15
package PZ15
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
    input Real b;
  algorithm
    y := a * u + b;
  end g;
  function solve
    input PSF f;
    input Integer n;
    output Real r;
  algorithm
    r := f(n) + f(2);
  end solve;
  function h
    input Integer k;
    output Real r;
  algorithm
    r := solve(function g(a = k, b = 2), 3);
  end h;
end PZ15;
model PKZ15
  Real r = PZ15.h(integer(time));
end PKZ15;
//// model: PKZ16
package PZ16
  record Data
    Real a;
    Real b;
  end Data;
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Data d;
  algorithm
    y := d.a * u + d.b;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Data d;
    input Real x;
    output Real r;
  algorithm
    r := solve(function g(d = d), x);
  end h;
end PZ16;
model PKZ16
  Real r = PZ16.h(PZ16.Data(2, 3), time);
end PKZ16;
//// model: PKZ16b
package PZ16b
  record Data
    Real a;
    Real b;
  end Data;
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Data d;
  algorithm
    y := d.a * u + d.b;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Data d;
    input Real x;
    output Real r;
  algorithm
    r := solve(function g(d = d), x);
  end h;
end PZ16b;
model PKZ16b
  PZ16b.Data d(a = 2, b = 3);
  Real r = PZ16b.h(d, time);
end PKZ16b;
//// model: PKZ17
package PZ17
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real p[2];
  algorithm
    y := p[1] * u + p[2];
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Real x;
    output Real r;
  protected
    Real q[2] = {x, 1};
  algorithm
    r := solve(function g(p = {5, 1}), x) + solve(function g(p = q), x) + solve(function g(p = 2 * q), x);
  end h;
end PZ17;
model PKZ17
  Real r = PZ17.h(time);
end PKZ17;
//// model: PKZ18
package PZ18
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function solve
    input PSF f;
    input Real u_min;
    input Real u_max;
    input Real tolerance = 1e-13;
    output Real u;
  protected
    Real fa;
  algorithm
    fa := f(u_min);
    u := if fa > 0 then u_min else u_max;
  end solve;
end PZ18;
model PKZ18
  parameter Real y_zero = 0.5;
  parameter Real A = 1;
  parameter Real w = 1;
  Real x_zero;
  function f_nonlinear
    extends PZ18.PSF;
    input Real A = 1;
    input Real w = 1;
    input Real s = 0;
  algorithm
    y := A * sin(w * u) + s;
  end f_nonlinear;
equation
  x_zero = PZ18.solve(function f_nonlinear(A = A, w = w, s = -y_zero), -1.7, 1.7);
end PKZ18;
//// model: PKZ19
package PZ19
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
  algorithm
    y := 2 * u + 1;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x) - 1;
  end solve;
end PZ19;
model PKZ19
  Real r = PZ19.solve(PZ19.g, time);
  Real s = PZ19.solve(function PZ19.g(), 2 * time);
end PKZ19;
//// model: PKZ20
package PZ20
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    input Integer u;
    input Real a;
    output Real y;
  algorithm
    y := a * u;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve(function g(a = a), 3);
  end h;
end PZ20;
model PKZ20
  Real r = PZ20.h(time);
end PKZ20;
//// model: PKZ21
package PZ21
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u + 1;
  end g;
  function g0
    extends PSF;
  algorithm
    y := 3 * u;
  end g0;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Real x;
    output Real r;
  algorithm
    r := x + solve(function g(a = 2), 3);
  end h;
end PZ21;
model PKZ21
  Real r = PZ21.h(time);
  Real r2 = PZ21.solve(function PZ21.g(a = 2), 3);
  Real r3 = PZ21.solve(PZ21.g0, 4);
  parameter Real p = PZ21.solve(PZ21.g0, 5);
end PKZ21;
//// model: PKZ22
package PZ22
  record State
    Real p;
    Real T;
  end State;
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real p;
  algorithm
    y := p * u - 1;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := if f(x) > 0 then x else -x;
  end solve;
  function h
    input State state;
    output Real r;
  algorithm
    r := solve(function g(p = state.p), state.T);
  end h;
end PZ22;
model PKZ22
  PZ22.State s(p = 2, T = time);
  Real r = PZ22.h(s);
end PKZ22;
//// model: PKZ23
package PZ23
  record DataRecord
    Real MM;
    Real R_s;
  end DataRecord;
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function solve
    input PSF f;
    input Real a;
    input Real b;
    output Real r;
  algorithm
    r := (f(a) + f(b)) / 2;
  end solve;
  package Gas
    constant DataRecord data(MM = 0.018, R_s = 461.5);
    function T_h
      input Real h;
      output Real T;
    protected
      function f_nonlinear
        extends PSF;
        input DataRecord data;
        input Real h;
      algorithm
        y := data.R_s * u - h;
      end f_nonlinear;
    algorithm
      T := solve(function f_nonlinear(data = data, h = h), 200, 6000);
    end T_h;
  end Gas;
end PZ23;
model PKZ23
  Real T = PZ23.Gas.T_h(time);
end PKZ23;
//// model: PKZ25
package PZ25
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    input Real u;
    input Real a;
    input Integer k = 2;
    output Real y;
  algorithm
    y := a * u ^ k;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x) + 1;
  end solve;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve(function g(a = a), 3);
  end h;
end PZ25;
model PKZ25
  Real r = PZ25.h(time);
end PKZ25;
