//// model: PKZ10
package PZ10
  type Temp = Real(unit = "K", min = 0);
  partial function PSF
    input Temp u "temperature";
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve(function g(a = 2 * a), 3);
  end h;
end PZ10;
model PKZ10
  Real r = PZ10.h(time);
end PKZ10;
//// model: PKZ11
package PZ11
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u;
  end g;
  function useless
    input PSF fn;
    input Real x;
    output Real r;
  algorithm
    r := 2 * x;
  end useless;
  function h
    input Real a;
    output Real r;
  algorithm
    r := useless(function g(a = a), 3);
  end h;
end PZ11;
model PKZ11
  Real r = PZ11.h(time);
end PKZ11;
