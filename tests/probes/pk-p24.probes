//// model: PKZ11c
package PZ11c
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
    input Real a;
  algorithm
    y := a * u;
  end g;
  function useless
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := if x > 0 then 2 * x else f(x);
  end useless;
  function h
    input Real a;
    output Real r;
  algorithm
    r := useless(function g(a = a), 3);
  end h;
end PZ11c;
model PKZ11c
  Real r = PZ11c.h(time);
end PKZ11c;
//// model: PKZ12
package PZ12
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function solve
    input PSF f;
    input Real a;
    input Real b;
    output Real r;
  algorithm
    r := (f(a) + f(b)) / 2;
  end solve;
  function T_ph
    input Real p;
    input Real h;
    output Real T;
  protected
    function f_nl
      extends PSF;
      input Real p;
      input Real h;
    algorithm
      y := p * u - h;
    end f_nl;
  algorithm
    T := solve(function f_nl(p = p, h = h), 190, 647);
  end T_ph;
end PZ12;
model PKZ12
  parameter Real T0 = PZ12.T_ph(2, 3);
  constant Real T1 = PZ12.T_ph(2, 3);
  Real T = T0 + T1 * time;
end PKZ12;
//// model: PKZ13
package PZ13
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    extends PSF;
  algorithm
    y := 3 * u;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve(function g(), a);
  end h;
end PZ13;
model PKZ13
  Real r = PZ13.h(time);
end PKZ13;
//// model: PKZ14
package PZ14
  partial function PSF
    input Real u;
    output Real y;
  end PSF;
  function g
    input Real v;
    input Real a;
    output Real y;
  algorithm
    y := a * v;
  end g;
  function solve
    input PSF f;
    input Real x;
    output Real r;
  algorithm
    r := f(x);
  end solve;
  function h
    input Real a;
    output Real r;
  algorithm
    r := solve(function g(a = a), 3);
  end h;
end PZ14;
model PKZ14
  Real r = PZ14.h(time);
