//// set: kr-p1 — 派生类里的元素级类重声明（redeclareClass：基类实例的类树里顶替 replaceable 类，新类的词法作用域 = 写它的类）：长 / 短 / 带修饰的新类（KR1 / KR2 / KR8）、多层基类（KR3 / KR23）、新类引派生类的常量（KR4）、不是 replaceable 的也照换（KR6，1.25.0 不查）、派生类自己也用（KR7）、带修饰 / extends 修饰的继承组件（KR12 / KR17 / KR28）、两层重声明（KR14）、type（KR16）、根类（KR18）、两个（KR19）、组件数组（KR21）、派生类的嵌套类（KR22）、同一基类另有不重声明的实例（KR27）；基类的嵌套类体写到被换名（KR5 / KR26）、经 SCode 链查到被换的函数 / 记录（KR10 / KR11）SKIP
//// model: KR1
model KR1
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C
    extends A;
    redeclare model B
      Real y = 2;
    end B;
  end C;
  C c;
end KR1;
//// model: KR2
model KR2
  model X
    Real z = 3;
  end X;
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C
    extends A;
    redeclare model B = X;
  end C;
  C c;
end KR2;
//// model: KR3
model KR3
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model A2
    extends A;
    Real w = 4;
  end A2;
  model C
    extends A2;
    redeclare model B
      Real y = 2;
    end B;
  end C;
  C c;
end KR3;
//// model: KR4
model KR4
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C
    extends A;
    constant Real k = 5;
    redeclare model B
      Real y = k;
    end B;
  end C;
  C c;
end KR4;
//// model: KR5
model KR5
  model A
    replaceable model B
      Real x = 1;
    end B;
    model M
      B b2;
    end M;
    M m;
  end A;
  model C
    extends A;
    redeclare model B
      Real y = 2;
    end B;
  end C;
  C c;
end KR5;
