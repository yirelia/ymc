//// model: KR28
model KR28
  model A
    replaceable model B
      parameter Real p = 1;
      Real x = p * time;
    end B;
    B b(p = 5);
  equation
    b.x = time;
  end A;
  model C
    extends A;
    redeclare model B
      parameter Real p = 1;
      Real x;
      Real y = 2 * p;
    end B;
  end C;
  C c;
end KR28;
