  end B;
end KR18;
//// model: KR19
model KR19
  model A
    replaceable model B1
      Real x = 1;
    end B1;
    replaceable model B2
      Real u = 1;
    end B2;
    B1 b1;
    B2 b2;
  end A;
  model C
    extends A;
    redeclare model B1
      Real y = 2;
    end B1;
    redeclare model B2
      Real v = 4;
    end B2;
  end C;
  C c;
end KR19;
