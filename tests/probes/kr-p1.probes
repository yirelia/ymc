//// model: KR8
model KR8
  model X
    parameter Real p = 1;
    Real z = p;
  end X;
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C
    extends A;
    redeclare model B = X(p = 3);
  end C;
  C c;
end KR8;
//// model: KR10
model KR10
  function g
    input Real x;
    output Real y;
  algorithm
    y := 3 * x;
  end g;
  model A
    replaceable function f
      input Real x;
      output Real y;
    algorithm
      y := 2 * x;
    end f;
    Real v = f(time);
  end A;
  model C
    extends A;
    redeclare function f = g;
  end C;
  C c;
end KR10;
//// model: KR11
model KR11
  model A
    replaceable record R
      Real a = 1;
    end R;
    R r;
  end A;
  model C
    extends A;
    redeclare record R
      Real b = 2;
    end R;
  end C;
  C c;
end KR11;
//// model: KR12
model KR12
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b(x = 2);
  end A;
  model C
    extends A;
    redeclare model B
      Real x = 5;
      Real y = 2;
    end B;
  end C;
  C c;
end KR12;
//// model: KR14
model KR14
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C1
    extends A;
    redeclare replaceable model B
      Real y = 2;
    end B;
  end C1;
  model C2
    extends C1;
    redeclare model B
      Real z = 3;
    end B;
  end C2;
  C2 c;
end KR14;
//// model: KR16
model KR16
  model A
    replaceable type T = Real(unit = "m");
    T t = time;
  end A;
  model C
    extends A;
    redeclare type T = Real(unit = "s");
  end C;
  C c;
end KR16;
//// model: KR17
model KR17
  model A
    replaceable model B
      Real x = 1;
    end B;
    B b;
  end A;
  model C
    extends A(b(y = 7));
    redeclare model B
      Real y = 2;
    end B;
  end C;
  C c;
end KR17;
