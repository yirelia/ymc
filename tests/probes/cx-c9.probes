//// set: cx-c9 — end / 负步长 / 三维 / 修饰里的切片 / 大数组 / protected / fixed = false 与 Evaluate = false 的参数下标
//// model: C90
model C90
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y = x[p + n];
end C90;
//// model: C91
