//// model: C925
model C925
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real big[400] = {i * 1.0 for i in 1:400}; Real y = big[n] + sum(big[2:399]); Real z[400] = big[:] * tt;
end C925;
//// model: C926
model C926
