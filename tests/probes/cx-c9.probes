//// model: C933
model C933
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  discrete Integer d(start = 1); Real y = x[d];
equation
  when sample(0, 1) then d = pre(d) + 1; end when;
end C933;
//// model: C934
model C934
  constant Real x[5] = {1, 2, 3, 4, 5};
