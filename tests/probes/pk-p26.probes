//// model: PKB10
package PKBP10
  constant Real pi = 3.141592653589793;
  record Ori "ori"
    Real T[3, 3] "T";
    Real w[3] "w";
  end Ori;
  package TM
    function axisRotation "axis rotation"
      input Integer axis;
      input Real angle;
      output Real T[3, 3];
    algorithm
      T := if axis == 1 then [1, 0, 0; 0, cos(angle), sin(angle); 0, -sin(angle), cos(angle)] else if axis == 2 then [cos(angle), 0, -sin(angle); 0, 1, 0; sin(angle), 0, cos(angle)] else [cos(angle), sin(angle), 0; -sin(angle), cos(angle), 0; 0, 0, 1];
    end axisRotation;
    function from_nxy "from nxy"
      input Real n_x[3];
      input Real n_y[3];
      output Real T[3, 3];
    protected
      Real e_x[3];
      Real e_y[3];
    algorithm
      e_x := n_x / sqrt(n_x * n_x);
      e_y := n_y / sqrt(n_y * n_y);
      T := {e_x, e_y, {e_x[2] * e_y[3] - e_x[3] * e_y[2], e_x[3] * e_y[1] - e_x[1] * e_y[3], e_x[1] * e_y[2] - e_x[2] * e_y[1]}};
    end from_nxy;
    function resolve2 "resolve2"
      input Real T[3, 3];
      input Real v1[3];
      output Real v2[3];
    algorithm
      v2 := T * v1;
    end resolve2;
  end TM;
  function axis "axis"
    input Integer axis;
    output Real e[3];
  algorithm
    e := if axis == 1 then {1, 0, 0} else (if axis == 2 then {0, 1, 0} else {0, 0, 1});
  end axis;
  function from_nxy "from nxy"
    input Real n_x[3];
    input Real n_y[3];
    output Ori R;
  algorithm
    R := Ori(T = TM.from_nxy(n_x, n_y), w = zeros(3));
  end from_nxy;
  function axesRotations "axes rotations"
    input Integer sequence[3] = {1, 2, 3};
    input Real angles[3];
    input Real der_angles[3];
    output Ori R;
  algorithm
    R := Ori(T = TM.axisRotation(sequence[3], angles[3]) * TM.axisRotation(sequence[2], angles[2]) * TM.axisRotation(sequence[1], angles[1]), w = axis(sequence[3]) * der_angles[3] + TM.resolve2(TM.axisRotation(sequence[3], angles[3]), axis(sequence[2]) * der_angles[2]) + TM.resolve2(TM.axisRotation(sequence[3], angles[3]) * TM.axisRotation(sequence[2], angles[2]), axis(sequence[1]) * der_angles[1]));
  end axesRotations;
  function resolve2 "resolve2"
    input Ori R;
    input Real v1[3];
    output Real v2[3];
  algorithm
    v2 := R.T * v1;
  end resolve2;
  function absoluteRotation "absolute rotation"
    input Ori R1;
    input Ori R_rel;
    output Ori R2;
  algorithm
    R2 := Ori(T = R_rel.T * R1.T, w = resolve2(R_rel, R1.w) + R_rel.w);
  end absoluteRotation;
  function nullRotation "null rotation"
    output Ori R;
  algorithm
    R := Ori(T = [1, 0, 0; 0, 1, 0; 0, 0, 1], w = zeros(3));
  end nullRotation;
  model Surf "surface"
    input Ori R = nullRotation() "R";
    input Real r_0[3] = {0, 0, 0} "r_0";
  end Surf;
  model World "world"
    parameter Real n[3] = {0, -1, 0} "n" annotation(Evaluate = true);
    parameter Real gu[3] = if abs(n[1]) >= 0.99 then {0, 1, 0} else {1, 0, 0} "gu";
    Surf surface(final R = absoluteRotation(from_nxy(n, gu), axesRotations({1, 2, 3}, {pi / 2, pi / 2, 0}, {0, 0, 0})), final r_0 = zeros(3));
  end World;
end PKBP10;

model PKB10
  PKBP10.World world(n = {0, 0, -1});
end PKB10;
//// model: PKB11
package PKBP11
  record Ori "ori"
    Real T[2, 2] "T";
    Real w[2] "w";
  end Ori;
  function fromv "fromv"
    input Real v[2];
    output Ori R;
  algorithm
    R := Ori(T = {{v[1], v[2]}, {-v[2], v[1]}}, w = zeros(2));
  end fromv;
  function rot "rot"
    input Real a;
    output Ori R;
  algorithm
    R := Ori(T = {{cos(a), sin(a)}, {-sin(a), cos(a)}}, w = {0, 0});
  end rot;
  function res2 "res2"
    input Ori R;
    input Real v[2];
    output Real v2[2];
  algorithm
    v2 := R.T * v;
  end res2;
  function absRot "absRot"
    input Ori R1;
    input Ori Rr;
    output Ori R2;
  algorithm
    R2 := Ori(T = Rr.T * R1.T, w = res2(Rr, R1.w) + Rr.w);
  end absRot;
  model Surf
    input Ori R = fromv({1, 0}) "R";
    Real y = R.T[1, 1];
  end Surf;
end PKBP11;

model PKB11
  parameter Real u[2] = {1, 0};
  PKBP11.Surf s(final R = PKBP11.absRot(PKBP11.fromv(u), PKBP11.rot(0.5)));
end PKB11;
