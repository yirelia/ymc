//// set: pk-p26 — 记录整体绑定：构造调用里 `:` 维的字段维由值推出（子记录经 extends 修饰换了表的长度，MSL FluxTubes HysteresisTableData）；final 连续记录、绑定是只读参数的用户函数调用 → 强制内联（按化简前的函数体，MSL World 的 surface.R）、内联里函数局部带下标的代换、实参全成字面量的内联调用求值（含记录式实参）；限定名非首段查到 protected 元素照 omc 报错（经 extends / protected extends 继承来的、函数体 / 包里自引用的、import 的）
//// model: PKB1
package PKBP1
  record Base "base"
    parameter Real[:,:] tab = [1, 2; 3, 4] "tab";
    parameter Real s = 1 "s";
  end Base;
  record Derived "derived"
    extends Base(tab = [5, 6; 7, 8; 9, 10], s = 2);
  end Derived;
  model M
    parameter Base mat = Base() "mat";
    parameter Real e = mat.tab[size(mat.tab, 1), 2];
  end M;
end PKBP1;

model PKB1
  PKBP1.M m(mat = PKBP1.Derived());
end PKB1;
