//// model: PKB15
package PKBP15
  record Ori "ori"
    Real T[2, 2] "T";
    Real w[2] "w";
  end Ori;
  function fromv "fromv"
    input Real v[2];
    output Ori R;
  algorithm
    R := Ori(T = {{v[1], v[2]}, {-v[2], v[1]}}, w = zeros(2));
