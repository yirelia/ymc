//// model: S157
model S157
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; output Integer n[2]; algorithm n := size(u); end f; Integer k[2] = f(m);
end S157;
