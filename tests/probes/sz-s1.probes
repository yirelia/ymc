//// set: sz-s1 — size / ndims 的实参形态：字面量、算术式、切片、内建；维号的形态；维与常量里的 size
//// model: S10
model S10
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Integer k = size({1, 2, 3}, 1);
end S10;
