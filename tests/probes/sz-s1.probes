//// model: S151
model S151
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y;
equation
  y = size(x, 1) * a;
end S151;
//// model: S152
model S152
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y;
equation
  y = size(2 * x, 1) * a;
end S152;
//// model: S153
model S153
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y; algorithm y := size({1, 2, 3}, 1) * a;
end S153;
//// model: S154
model S154
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:]; output Integer n; algorithm n := size(2 * u, 1); end f; Integer k = f(x);
end S154;
//// model: S155
model S155
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:]; output Integer n; algorithm n := size({1, 2, 3}, 1); end f; Integer k = f(x);
