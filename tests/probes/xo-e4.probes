//// set: xo-e4 — 外部对象的非法用法：算术、比较、传给 Real 形参、实参 / 绑定类型不符、两种外部对象相等、der、修饰、多余 / 命名不符的构造实参、if 式绑定
//// model: E40
class EO
extends ExternalObject;
function constructor
input Integer i = 1;
output EO o;
external "C" o = initEO(i);
end constructor;
function destructor
input EO o;
external "C" freeEO(o);
end destructor;
end EO;
model E40
parameter EO e = EO();
Real y = e + 1;
end E40;
//// model: E41
class EO
extends ExternalObject;
function constructor
input Integer i = 1;
output EO o;
external "C" o = initEO(i);
end constructor;
function destructor
input EO o;
external "C" freeEO(o);
end destructor;
end EO;
model E41
parameter EO e = EO();
parameter EO e2 = EO();
Boolean b = e == e2;
end E41;
//// model: E42
class EO
extends ExternalObject;
function constructor
input Integer i = 1;
output EO o;
external "C" o = initEO(i);
end constructor;
function destructor
input EO o;
external "C" freeEO(o);
end destructor;
end EO;
function f
input Real x;
output Real y;
algorithm
y := x;
end f;
model E42
parameter EO e = EO();
Real y = f(e);
end E42;
//// model: E43
class EO
extends ExternalObject;
function constructor
input Integer i = 1;
output EO o;
external "C" o = initEO(i);
end constructor;
function destructor
input EO o;
external "C" freeEO(o);
end destructor;
end EO;
function f
input EO o;
output Real y;
external "C" y = useEO(o);
end f;
model E43
Real y = f(1.0);
end E43;
