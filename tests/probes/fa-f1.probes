//// model: F142
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
algorithm
  v := u * 2 * a;
  o := 0;
end h;
model F142
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F142;
