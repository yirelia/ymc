//// set: fa-f1 — 函数体里的数组运算（点号算符、标量 * 数组、已知维的展开）
//// model: F10
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
algorithm
  v := 2 * u;
  o := 0;
end h;
model F10
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F10;
