//// model: PKT24
package P24
  record R
    Real x;
    Real y;
  end R;
  function f
    input Real a;
    output Real s;
  protected
    R r[2];
    Real xs[2];
  algorithm
    r[1] := R(a, 2 * a);
    r[2] := R(3 * a, 4 * a);
    xs := r.x;
    s := xs[1] + xs[2];
  end f;
end P24;
model PKT24
  parameter Real p = P24.f(1.5);
  Real y = p * time;
end PKT24;
