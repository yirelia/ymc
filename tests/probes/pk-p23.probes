//// model: PKT11
package P11
  partial package PartialMedium
    constant Real reference_T = 298.15;
    replaceable partial function temperature_phX
      input Real p;
      input Real h;
      output Real T;
    end temperature_phX;
  end PartialMedium;
  partial package PartialLinearFluid
    extends PartialMedium;
    constant Real cp_const;
    constant Real reference_h;
    redeclare function extends temperature_phX
    algorithm
      T := (h - reference_h) / cp_const + reference_T;
    end temperature_phX;
  end PartialLinearFluid;
  package LinearColdWater
    extends PartialLinearFluid(reference_T = 278.15, reference_h = 104929, cp_const = 4181.9);
  end LinearColdWater;
  model Vol
    replaceable package Medium = PartialMedium;
    Real T = Medium.temperature_phX(1e5, 1e5 * time);
  end Vol;
end P11;
model PKT11
  P11.Vol v(redeclare package Medium = P11.LinearColdWater);
end PKT11;
//// model: PKT12
package P12
  package StandardWater
    record ThermodynamicState
      Real p;
      Real T;
    end ThermodynamicState;
    function setState_pT
      input Real p;
      input Real T;
      output ThermodynamicState state;
    algorithm
      state := ThermodynamicState(p = p, T = T);
    end setState_pT;
    function specificEnthalpy
      input ThermodynamicState state;
      output Real h;
    algorithm
      h := 4184 * (state.T - 273.15) + state.p / 1000;
    end specificEnthalpy;
  end StandardWater;
  partial package PartialMedium
    constant Real reference_p = 101325;
    constant Real reference_T = 298.15;
    replaceable partial function temperature_phX
      input Real p;
      input Real h;
      output Real T;
    end temperature_phX;
  end PartialMedium;
  partial package PartialLinearFluid
    extends PartialMedium;
    constant Real cp_const;
    constant Real reference_h;
    redeclare function extends temperature_phX
    algorithm
      T := (h - reference_h) / cp_const + reference_T;
    end temperature_phX;
  end PartialLinearFluid;
  partial package LinearWater_pT
    extends PartialLinearFluid(reference_h = StandardWater.specificEnthalpy(state), cp_const = 4181.9);
    constant StandardWater.ThermodynamicState state = StandardWater.setState_pT(reference_p, reference_T);
  end LinearWater_pT;
  package LinearWater_pT_Ambient
    extends LinearWater_pT(reference_p = 101325, reference_T = 298.15);
  end LinearWater_pT_Ambient;
  model Vol
    replaceable package Medium = PartialMedium;
    Real T = Medium.temperature_phX(1e5, 1e5 * time);
  end Vol;
end P12;
model PKT12
  P12.Vol v(redeclare package Medium = P12.LinearWater_pT_Ambient);
end PKT12;
//// model: PKT13
package P13
  record DataRecord
    String name;
    Real MM;
    Real alow[3];
    Real R_s;
  end DataRecord;
  package SingleGasesData
    constant DataRecord H2O(name = "H2O", MM = 0.01801528, alow = {-39479.6083, 575.573102, 0.931782653}, R_s = 461.5233290850878);
    constant DataRecord Air(name = "Air", MM = 0.0289651159, alow = {10099.5016, -196.827561, 5.00915511}, R_s = 287.0512249529787);
  end SingleGasesData;
  function h_Tlow
    input DataRecord data;
    input Real T;
    input Real h_off = 0;
    output Real h;
  algorithm
    h := data.R_s * T * data.alow[3] + h_off;
  end h_Tlow;
  partial package PartialMedium
    constant Integer nX = 1;
    replaceable partial function h_pTX
      input Real p;
      input Real T;
      input Real X[nX];
      output Real h;
    end h_pTX;
  end PartialMedium;
  package MoistAir
    extends PartialMedium(nX = 2);
    constant DataRecord dryair = SingleGasesData.Air;
    constant DataRecord steam = SingleGasesData.H2O;
    redeclare function extends h_pTX
    protected
      Real R_gas;
    algorithm
      R_gas := dryair.R_s * X[2] + steam.R_s * X[1];
      h := {h_Tlow(data = steam, T = T, h_off = 46479.819 + 2501014.5), h_Tlow(data = dryair, T = T, h_off = 25104.684)} * X + R_gas * p;
    end h_pTX;
  end MoistAir;
  model Vol
    replaceable package Medium = PartialMedium;
    Real h = Medium.h_pTX(1e5, time, {0.01, 0.99});
  end Vol;
end P13;
model PKT13
  P13.Vol v(redeclare package Medium = P13.MoistAir);
end PKT13;
//// model: PKT14
package P14
  record DataRecord
    String name;
    Real MM;
    Real R_s;
  end DataRecord;
  record FluidConstants
    String chemicalFormula;
    Real criticalTemperature;
    Real dipoleMoment;
    Boolean hasDipoleMoment;
  end FluidConstants;
  package SingleGasesData
    constant DataRecord N2(name = "N2", MM = 0.0280134, R_s = 296.8033869505308);
    constant DataRecord O2(name = "O2", MM = 0.0319988, R_s = 259.8369938872708);
  end SingleGasesData;
  package FluidData
    constant FluidConstants N2(chemicalFormula = "N2", criticalTemperature = 126.2, dipoleMoment = 0.0, hasDipoleMoment = true);
    constant FluidConstants O2(chemicalFormula = "O2", criticalTemperature = 154.58, dipoleMoment = 0.0, hasDipoleMoment = true);
  end FluidData;
  function cp_T
    input DataRecord data;
    input Real T;
    output Real cp;
  algorithm
    cp := data.R_s * T;
  end cp_T;
  partial package PartialMixtureMedium
    constant String substanceNames[:] = {"a"};
    constant Integer nS = size(substanceNames, 1);
    constant Integer nX = nS;
    constant FluidConstants[nS] fluidConstants;
    replaceable partial function f
      input Real T;
      input Real X[nX];
      output Real y;
    end f;
  end PartialMixtureMedium;
  partial package MixtureGasNasa
    extends PartialMixtureMedium;
    constant DataRecord[:] data;
    redeclare function extends f
    protected
      Real MM;
    algorithm
      MM := 1 / sum(X[j] / data[j].MM for j in 1:size(X, 1));
      y := {cp_T(data[i], T) for i in 1:nX} * X + X * data.MM + MM;
      for i in 1:nX loop
        assert(fluidConstants[i].hasDipoleMoment, "no dipole for " + fluidConstants[i].chemicalFormula);
        y := y + fluidConstants[i].criticalTemperature * T + fluidConstants[i].dipoleMoment;
      end for;
    end f;
  end MixtureGasNasa;
  package CombustionAir
    extends MixtureGasNasa(data = {SingleGasesData.N2, SingleGasesData.O2}, fluidConstants = {FluidData.N2, FluidData.O2}, substanceNames = {"Nitrogen", "Oxygen"});
  end CombustionAir;
  model Vol
    replaceable package Medium = PartialMixtureMedium;
    Real y = Medium.f(time, {0.768, 0.232});
  end Vol;
end P14;
model PKT14
  P14.Vol v(redeclare package Medium = P14.CombustionAir);
end PKT14;
//// model: PKT15
package P15
  partial package PartialMedium
    type SpecificEnthalpy = Real(min = -1e10, max = 1e10);
    replaceable record ThermodynamicState
    end ThermodynamicState;
    replaceable partial function specificEnthalpy
      input ThermodynamicState state;
      output SpecificEnthalpy h;
    end specificEnthalpy;
  end PartialMedium;
  partial package WaterBase
    extends PartialMedium(SpecificEnthalpy(start = 1e5));
    redeclare record extends ThermodynamicState
      SpecificEnthalpy h;
    end ThermodynamicState;
    redeclare function extends specificEnthalpy
    algorithm
      h := state.h;
    end specificEnthalpy;
  end WaterBase;
  package Water_ph
    extends WaterBase;
  end Water_ph;
  package StandardWater = Water_ph;
  partial package PartialLinearFluid
    constant Real reference_h;
    function f
      input Real h;
      output Real y;
    algorithm
      y := h - reference_h;
    end f;
  end PartialLinearFluid;
  package LinearWater
    extends PartialLinearFluid(reference_h = StandardWater.specificEnthalpy(state));
    constant StandardWater.ThermodynamicState state(h = 104929.0);
  end LinearWater;
  model Vol
    replaceable package Medium = PartialLinearFluid;
    Real y = Medium.f(time);
  end Vol;
end P15;
model PKT15
  P15.Vol v(redeclare package Medium = P15.LinearWater);
end PKT15;
