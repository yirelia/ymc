//// model: PKT28
package P28
  record Rec
    String name;
    Real MM;
  end Rec;
  package Mix
    constant Rec[:] data = {Rec(name = "N2", MM = 0.0280134), Rec(name = "O2", MM = 0.0319988)};
    constant Real c[3] = {1.5, 2.5, 3.5};
    function f
      input Real T;
      output Real y;
    algorithm
      y := 0;
      for i in 1:size(data, 1) loop
        y := y + data[i].MM * T;
      end for;
      for j in 1:size(data.MM, 1) loop
        y := y + data[j].MM;
      end for;
      y := y + size(c, 1) * T + sum(data.MM) * T + max(data.MM);
    end f;
  end Mix;
end P28;
model PKT28
  Real y = P28.Mix.f(time);
end PKT28;
