    Sub sub;
  end Rec;
  package Data
    constant Rec N2(name = "N2", sub(x = 1.5, v = {2.0, 3.0}));
    constant Rec[2] arr = {Rec(name = "a", sub = Sub(x = 1.0, v = {4.0, 5.0})), Rec(name = "b", sub = Sub(x = 2.0, v = {6.0, 7.0}))};
  end Data;
  function f
    input Real T;
    input Integer n;
    output Real y;
  algorithm
    y := Data.N2.sub.x * T + Data.N2.sub.v[n] + Data.arr[n].sub.x + Data.arr[2].sub.v[n] + Data.arr[n].sub.v[1];
  end f;
end P25;
model PKT25
  Real y = P25.f(time, 2);
end PKT25;
