//// model: PKT5
package QPKT5
  record Rec
    String name;
    Real MM;
    Real R_s;
  end Rec;
  record FC
    String chemicalFormula;
    Real Tc;
    Real mu;
    Boolean hasDipoleMoment;
  end FC;
  package Data
    constant Rec N2(name = "N2", MM = 0.0280134, R_s = 296.8033869505308);
    constant Rec O2(name = "O2", MM = 0.0319988, R_s = 259.8369938872708);
  end Data;
  package FData
    constant FC N2(chemicalFormula = "N2", Tc = 126.2, mu = 0.0, hasDipoleMoment = true);
    constant FC O2(chemicalFormula = "O2", Tc = 154.58, mu = 0.0, hasDipoleMoment = true);
  end FData;
  function cp_T
    input Rec data;
    input Real T;
    output Real cp;
  algorithm
    cp := data.R_s * T;
  end cp_T;
  package Mix
    constant Rec[:] data = {Data.N2, Data.O2};
    constant FC[2] fc = {FData.N2, FData.O2};
    constant Integer nX = 2;
    function f
      input Real X[nX];
      output Real MM;
    algorithm
      MM := X * data.MM;
    end f;
  end Mix;
end QPKT5;
model PKT5
  Real x[2] = {0.3, 0.7} * time;
  Real a = QPKT5.Mix.f(x);
end PKT5;
//// model: PKT5b
package P5b
  package Mix
    constant Real MMX[2] = {0.0280134, 0.0319988};
    function f
      input Real X[2];
      output Real MM;
    algorithm
      MM := X * MMX;
    end f;
    function g
      input Real T;
      input Real X[2];
      output Real h;
    algorithm
      h := {T * 2, T * 3} * X + MMX * X;
    end g;
  end Mix;
end P5b;
model PKT5b
  Real x[2] = {0.3, 0.7} * time;
  Real a = P5b.Mix.f(x);
  Real b = P5b.Mix.g(time, x);
end PKT5b;
//// model: PKT6
package QPKT6
  record Rec
    String name;
    Real MM;
    Real R_s;
  end Rec;
  record FC
    String chemicalFormula;
    Real Tc;
    Real mu;
    Boolean hasDipoleMoment;
  end FC;
  package Data
    constant Rec N2(name = "N2", MM = 0.0280134, R_s = 296.8033869505308);
    constant Rec O2(name = "O2", MM = 0.0319988, R_s = 259.8369938872708);
  end Data;
  package FData
    constant FC N2(chemicalFormula = "N2", Tc = 126.2, mu = 0.0, hasDipoleMoment = true);
    constant FC O2(chemicalFormula = "O2", Tc = 154.58, mu = 0.0, hasDipoleMoment = true);
  end FData;
  function cp_T
    input Rec data;
    input Real T;
    output Real cp;
  algorithm
    cp := data.R_s * T;
  end cp_T;
  package Mix
    constant Rec[:] data = {Data.N2, Data.O2};
    constant FC[2] fc = {FData.N2, FData.O2};
    constant Integer nX = 2;
    function f
      input Real T;
      input Real X[nX];
      output Real cp;
    algorithm
      cp := {cp_T(data[i], T) for i in 1:nX} * X;
    end f;
  end Mix;
end QPKT6;
model PKT6
  Real x[2] = {0.3, 0.7} * time;
  Real a = QPKT6.Mix.f(time, x);
end PKT6;
//// model: PKT7
package QPKT7
  record Rec
    String name;
    Real MM;
    Real R_s;
  end Rec;
  record FC
    String chemicalFormula;
    Real Tc;
    Real mu;
    Boolean hasDipoleMoment;
  end FC;
  package Data
    constant Rec N2(name = "N2", MM = 0.0280134, R_s = 296.8033869505308);
    constant Rec O2(name = "O2", MM = 0.0319988, R_s = 259.8369938872708);
  end Data;
  package FData
    constant FC N2(chemicalFormula = "N2", Tc = 126.2, mu = 0.0, hasDipoleMoment = true);
    constant FC O2(chemicalFormula = "O2", Tc = 154.58, mu = 0.0, hasDipoleMoment = true);
  end FData;
  function cp_T
    input Rec data;
    input Real T;
    output Real cp;
  algorithm
    cp := data.R_s * T;
  end cp_T;
  package Mix
    constant Rec[:] data = {Data.N2, Data.O2};
    constant FC[2] fc = {FData.N2, FData.O2};
    constant Integer nX = 2;
    function f
      input Real X[nX];
      output Real MM;
    algorithm
      MM := 1 / sum(X[j] / data[j].MM for j in 1:size(X, 1));
    end f;
  end Mix;
end QPKT7;
model PKT7
  Real x[2] = {0.3, 0.7} * time;
  Real a = QPKT7.Mix.f(x);
end PKT7;
//// model: PKT8
package QPKT8
  record Rec
    String name;
    Real MM;
    Real R_s;
  end Rec;
  record FC
    String chemicalFormula;
    Real Tc;
    Real mu;
    Boolean hasDipoleMoment;
  end FC;
  package Data
    constant Rec N2(name = "N2", MM = 0.0280134, R_s = 296.8033869505308);
    constant Rec O2(name = "O2", MM = 0.0319988, R_s = 259.8369938872708);
  end Data;
  package FData
    constant FC N2(chemicalFormula = "N2", Tc = 126.2, mu = 0.0, hasDipoleMoment = true);
    constant FC O2(chemicalFormula = "O2", Tc = 154.58, mu = 0.0, hasDipoleMoment = true);
  end FData;
  function cp_T
    input Rec data;
    input Real T;
    output Real cp;
  algorithm
    cp := data.R_s * T;
  end cp_T;
  package Mix
    constant Rec[:] data = {Data.N2, Data.O2};
    constant FC[2] fc = {FData.N2, FData.O2};
    constant Integer nX = 2;
    function f
      input Real T;
      output Real y;
    algorithm
      y := 0;
      for i in 1:nX loop
        assert(fc[i].hasDipoleMoment, "no dipole for " + fc[i].chemicalFormula);
        y := y + fc[i].Tc * T + fc[i].mu;
      end for;
    end f;
  end Mix;
end QPKT8;
model PKT8
  Real x[2] = {0.3, 0.7} * time;
  Real a = QPKT8.Mix.f(time);
end PKT8;
//// model: PKT8a
package QPKT8a
  record Rec
    String name;
    Real MM;
    Real R_s;
  end Rec;
  record FC
    String chemicalFormula;
    Real Tc;
    Real mu;
    Boolean hasDipoleMoment;
  end FC;
  package Data
    constant Rec N2(name = "N2", MM = 0.0280134, R_s = 296.8033869505308);
    constant Rec O2(name = "O2", MM = 0.0319988, R_s = 259.8369938872708);
  end Data;
  package FData
    constant FC N2(chemicalFormula = "N2", Tc = 126.2, mu = 0.0, hasDipoleMoment = true);
    constant FC O2(chemicalFormula = "O2", Tc = 154.58, mu = 0.0, hasDipoleMoment = true);
  end FData;
  function cp_T
    input Rec data;
    input Real T;
    output Real cp;
  algorithm
    cp := data.R_s * T;
  end cp_T;
  package Mix
    constant Rec[:] data = {Data.N2, Data.O2};
    constant FC[2] fc = {FData.N2, FData.O2};
    constant Integer nX = 2;
    function f
      input Real T;
      output Real y;
    algorithm
      y := 0;
      for i in 1:nX loop
        y := y + cp_T(data[i], T);
      end for;
    end f;
  end Mix;
end QPKT8a;
model PKT8a
  Real x[2] = {0.3, 0.7} * time;
  Real a = QPKT8a.Mix.f(time);
end PKT8a;
//// model: PKT9
package P9
  record FundamentalConstants
    Real R_s;
    Real MM;
    Real Tred;
    Real pred;
  end FundamentalConstants;
  package Ice
    package Basic
      record IceConstants
        extends FundamentalConstants;
        Real p0;
      end IceConstants;
      constant IceConstants Constants(R_s = 461.52364, MM = 18.015268E-003, Tred = 273.16, pred = 611.657, p0 = 101325);
      function Gibbs
        input Real p;
        input Real T;
        output Real g;
      protected
        final constant Real s_0 = -0.332733756492168E+004;
        final Real pi0 = Constants.p0 / Constants.pred;
        Real theta;
      algorithm
        g := Constants.R_s;
        theta := T / Constants.Tred;
        g := g + s_0 * Constants.Tred * theta + 1 / Constants.Tred * p / Constants.pred + pi0;
      end Gibbs;
    end Basic;
  end Ice;
end P9;
model PKT9
  Real g = P9.Ice.Basic.Gibbs(1e5, time);
end PKT9;
//// model: PKT10
package P10
  package Data
    constant Real R_s = data.R_s;
    record crit
      constant Real TCRIT = 374.18;
      constant Real PCRIT = 4056290.0;
    end crit;
    record fcrit
      constant Real FTCRIT = 374.209;
      constant Real FPCRIT = 4059280.0;
    end fcrit;
    record data
      constant Real R_s = 81.4888564372;
      constant Real MM = 0.102032;
      extends crit;
      constant Real HCRIT = 389653;
      extends fcrit;
    end data;
  end Data;
  package R134a
    function f
      input Real p;
      output Real pred;
    algorithm
      pred := p / Data.data.FPCRIT + p / Data.data.MM + Data.R_s * p + P10.Data.data.TCRIT;
    end f;
  end R134a;
end P10;
model PKT10
  Real p = P10.R134a.f(time);
end PKT10;
