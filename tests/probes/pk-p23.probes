//// model: PKT16
package P16
  record FC
    Real Tc;
    Real arr[3];
  end FC;
  record Rec
    String name;
    Real MM;
  end Rec;
  package Mix
    constant Integer Water = 2;
    constant FC[2] fc = {FC(Tc = 126.2, arr = {1.0, 2.0, 3.0}), FC(Tc = 154.58, arr = {4.0, 5.0, 6.0})};
    constant Real c[3] = {1.5, 2.5, 3.5};
    constant Rec[2] data = {Rec(name = "N2", MM = 0.0280134), Rec(name = "O2", MM = 0.0319988)};
    function f1
      input Real T;
      input Integer n;
      output Real y;
    algorithm
      y := 0;
      for i in 1:2 loop
        y := y + fc[i].arr[2] * T + fc[2].arr[i] + data[i].MM;
        for j in 1:3 loop
          y := y + fc[i].arr[j];
        end for;
      end for;
      y := y + sum(fc[:].Tc) * T + c[Water] * T + sum(c[1:2]) * T + sum(c[2:n]) * T + c[n] + fc[n].Tc;
    end f1;
  end Mix;
end P16;
model PKT16
  Real y = P16.Mix.f1(time, 3);
end PKT16;
//// model: PKT16s
package P16s
  record FC
    Real Tc;
    Real arr[3];
  end FC;
  record Rec
    String name;
    Real MM;
  end Rec;
  package Mix
    constant Integer Water = 2;
    constant FC[2] fc = {FC(Tc = 126.2, arr = {1.0, 2.0, 3.0}), FC(Tc = 154.58, arr = {4.0, 5.0, 6.0})};
    constant Real c[3] = {1.5, 2.5, 3.5};
    constant Rec[2] data = {Rec(name = "N2", MM = 0.0280134), Rec(name = "O2", MM = 0.0319988)};
    function f1
      input Real T;
      input Integer n;
      output Real y;
    algorithm
      y := 0;
      for i in 1:2 loop
        y := y + fc[i].arr[2] * T + fc[2].arr[i] + data[i].MM;
        for j in 1:3 loop
          y := y + fc[i].arr[j];
        end for;
      end for;
      y := y + sum(fc[:].Tc) * T + c[Water] * T + c[n] + fc[n].Tc + c[end] * T + c[n - 1] * T;
    end f1;
  end Mix;
end P16s;
model PKT16s
  Real y = P16s.Mix.f1(time, 3);
end PKT16s;
//// model: PKT17
package P17
  package Mix
    constant Real K = 0.0280134;
    function f
      input Real X[2];
      output Real MM;
    algorithm
      MM := 1 / sum(X[j] / K for j in 1:size(X, 1));
    end f;
  end Mix;
end P17;
model PKT17
  Real x[2] = {0.3, 0.7} * time;
  Real a = P17.Mix.f(x);
end PKT17;
//// model: PKT18
package P18
  record Rec
    String name;
    Real MM;
    Real a[2];
  end Rec;
  package Moist
    constant Rec steam(name = "H2O", MM = 0.01801528, a = {1.5, 2.5});
    function f
      input Real x;
      output Rec r;
    algorithm
      r := steam;
      r.MM := r.MM * x;
    end f;
    function g
      input Real x;
      output Real y;
    protected
      Rec r = steam;
    algorithm
      y := r.MM * x;
    end g;
  end Moist;
end P18;
model PKT18
  P18.Rec r = P18.Moist.f(time);
  Real y = P18.Moist.g(time);
end PKT18;
//// model: PKT19
operator record Cplx
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      input Real re;
      input Real im = 0;
      output .Cplx result(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end Cplx;
package P19
  constant Cplx j = Cplx(0, 1);
  function f
    input Real x;
    output Real y;
  protected
    Cplx c;
  algorithm
    c := j;
    y := j.im * x + c.re;
  end f;
end P19;
model PKT19
  Real y = P19.f(time);
end PKT19;
//// model: PKT20
package P20
  package Mix
    constant Integer k[3] = {3, 1, 2};
    function f
      input Real x;
      input Integer n;
      output Real y;
    algorithm
      y := k[n] * x + k[n];
      for i in 1:3 loop
        y := y + k[i] * x;
      end for;
    end f;
  end Mix;
end P20;
model PKT20
  Real y = P20.Mix.f(time, 2);
end PKT20;
//// model: PKT21
package P21
  record Rec
    String name;
    Real MM;
    Real a[2];
  end Rec;
  package Data
    constant Rec N2(name = "N2", MM = 0.0280134, a = {1.0, 2.0});
    constant Rec O2(name = "O2", MM = 0.0319988, a = {3.0, 4.0});
  end Data;
  function g
    input Rec r[:];
    input Real T;
    output Real y;
  algorithm
    y := 0;
    for i in 1:size(r, 1) loop
      y := y + r[i].MM * T;
    end for;
  end g;
  package Mix
    constant Rec[:] data = {Data.N2, Data.O2};
    function f
      input Real T;
      input Integer n;
      output Real y;
    algorithm
      y := g(data, T) + Data.N2.MM * T + Data.O2.a[2] * T + Data.O2.a[n] * T + data[2].a[n] + data[n].a[1];
    end f;
  end Mix;
end P21;
model PKT21
  Real y = P21.Mix.f(time, 2);
end PKT21;
