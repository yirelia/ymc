//// set: pk-p23 — 函数体里的包常量换成值：记录常量的字段 / 整个记录 / 记录数组、常量数组的下标、限定常量名经继承的成员、归约范围定型后是字面量、函数局部的 final
//// model: PKT1
package P1
  record Rec
    String name;
    Real MM;
    Real a[3];
    Real R_s;
  end Rec;
  package Data
    constant Rec H2O(name = "H2O", MM = 0.01801528, a = {1.5, 2.5, 3.5}, R_s = 461.5233290850878);
    constant Rec Air(name = "Air", MM = 0.0289651159, a = {4.0, 5.0, 6.0}, R_s = 287.0512249529787);
  end Data;
  package Moist
    constant Rec steam = Data.H2O;
    constant Rec dryair = Data.Air;
    function R_gas
      input Real x;
      output Real R;
    algorithm
      R := dryair.R_s * (1 - x) + steam.R_s * x;
    end R_gas;
  end Moist;
end P1;
model PKT1
  Real r = P1.Moist.R_gas(time);
end PKT1;
//// model: PKT2
package P2
  record Rec
    String name;
    Real MM;
    Real a[3];
    Real R_s;
  end Rec;
  package Data
    constant Rec H2O(name = "H2O", MM = 0.01801528, a = {1.5, 2.5, 3.5}, R_s = 461.5233290850878);
  end Data;
  function h_T
    input Rec data;
    input Real T;
    input Real h_off = 0;
    output Real h;
  algorithm
    h := data.R_s * T + data.a[1] + h_off;
  end h_T;
  package Moist
    constant Rec steam = Data.H2O;
    function h_pT
      input Real T;
      output Real h;
    algorithm
      h := h_T(data = steam, T = T, h_off = 46479.819 + 2501014.5);
    end h_pT;
  end Moist;
end P2;
model PKT2
  Real h = P2.Moist.h_pT(time);
end PKT2;
