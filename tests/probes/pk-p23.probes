//// model: PKT3
package P3
  record Rec
    String name;
    Real MM;
    Real a[3];
    Real R_s;
  end Rec;
  package Moist
    constant Rec steam(name = "H2O", MM = 0.01801528, a = {1.5, 2.5, 3.5}, R_s = 461.5233290850878);
    function f
      input Real x;
      output Real y;
    protected
      Real v[3];
    algorithm
      v := steam.a * x;
      y := steam.a[2] * x;
      for i in 1:3 loop
        y := y + steam.a[i] * v[i];
      end for;
    end f;
  end Moist;
end P3;
model PKT3
  Real y = P3.Moist.f(time);
end PKT3;
//// model: PKT4
package P4
  package Moist
    constant Real c[3] = {1.5, 2.5, 3.5};
    function f
      input Real x;
      output Real y;
    protected
      Real v[3];
    algorithm
      v := c * x;
      y := c[2] * x;
      for i in 1:3 loop
        y := y + c[i] * v[i];
      end for;
    end f;
  end Moist;
end P4;
model PKT4
  Real y = P4.Moist.f(time);
end PKT4;
