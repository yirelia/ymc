    Real xs[2];
  algorithm
    r[1] := R(a, 2 * a);
    r[2] := R(3 * a, 4 * a);
    xs := {r[1].x, r[2].x};
    s := xs[1] + xs[2];
  end f;
end P24b;
model PKT24b
