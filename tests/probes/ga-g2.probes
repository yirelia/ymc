//// set: ga-g2 — 数组内建 / 切片作函数实参
//// model: G20
model G20
  function g input Real u[3]; output Real v; algorithm v := u[1]; end g;
  function g2 input Real u[:]; output Real v; algorithm v := u[1]; end g2;
  function g3 input Real u[2, 3]; output Real v; algorithm v := u[1, 1]; end g3;
  function k input Real u[3]; output Real v[3]; algorithm v := 2 * u; end k;
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function gm input Real u[:, :]; output Real v; algorithm v := u[1, 1]; end gm;
  Real y = g2(vector(x));
end G20;
