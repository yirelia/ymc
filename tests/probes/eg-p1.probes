//// set: eg-p1 — Evaluate = true 的记录参数 × 字段声明网格（omc 1.25.0 实测）：整体绑定（构造 `R(3)` / 函数 `f(3)` / final）下只有带 start 的字段成结构参数（final、引用处代入），字段绑定 / 无绑定的不是；只带字段修饰（`r(a = 3)`）的各字段都是
//// model: EGCB
model EGCB
  record R
    Real a = 1;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r.a := x;
  end f;
  parameter R r = R(3) annotation(Evaluate = true);
  Real y = r.a * time;
end EGCB;
//// model: EGCN
model EGCN
  record R
    Real a;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r.a := x;
  end f;
  parameter R r = R(3) annotation(Evaluate = true);
  Real y = r.a * time;
end EGCN;
