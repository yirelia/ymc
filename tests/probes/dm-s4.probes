//// set: dm-s4 — `:` 维由修饰给、继承来的组件、组件数组
//// model: S40
model S40
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A parameter Real c[:]; Real y[size(c, 1)]; end A; A a(c = {1, 2, 3});
end S40;
//// model: S41
model S41
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A parameter Real c[:]; parameter Integer n = size(c, 1) - 1; Real y[n + 1]; end A; A a(c = {1, 2, 3});
end S41;
//// model: S42
model S42
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A parameter Real c[:] = {1}; Real y[size(c, 1)]; end A; A a(c = {1, 2, 3}); A b;
end S42;
//// model: S43
model S43
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A parameter Real c[:]; Real y[size(c, 1)]; end A; parameter Real p[:] = {1, 2}; A a(c = p);
end S43;
//// model: S44
model S44
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A parameter Real c[:]; Real y[size(c, 1)]; end A; parameter Real p[2] = {1, 2}; A a(c = p);
end S44;
//// model: S45
model S45
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A parameter Real c[:]; Real y[size(c, 1)]; end A; A a(c = x);
end S45;
//// model: S46
model S46
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  model A Real c[:]; Real y[size(c, 1)]; end A; A a(c = x);
