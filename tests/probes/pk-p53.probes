//// set: pk-p53 — 68d：数组维度与形状。SC scalar(a) 先展开再取唯一元素（typeScalarCall）；DA der 的数组实参填零（simplifyDer / makeZero）；ER / EM 枚举区间的长度、逐元素、整条保留，枚举的 min / max 归约；MC 矩阵拼接 `[x, y]` 的 `:` 维；TS 类型维上的标签区间切片成整数维、空标签区间；CB 推导式的体是数组值的式子；FW 声明在后的记录字段 / 子实例参数数组（第二遍）；DU 互相推 `:` 维（typeExpDim）；OC 嵌套类引用外层类组件的常量；RS 算法里边界含变量的切片与 fill；MV vector(引用) / matrix(3 维) 留调用（基线 vector 静默展开）；PR 参数变率的区间绑定（typeRange 标结构）；AC 推导式范围是记录 / 数组引用（未做，SKIP）。含 omc 拒绝的变体。
//// model: A68dSC01
model A68dSC01
  Real m2[1, 1, 1] = {{{4}}};
  Real s1 = scalar(m2);
end A68dSC01;
//// model: A68dSC02
model A68dSC02
  Real r1 = scalar({{1}});
  Real r2 = scalar(4);
  Real r3 = scalar({{{{5}}}});
end A68dSC02;
//// model: A68dSC03
model A68dSC03
  parameter Real p[1] = {2};
  Real s = scalar(p);
end A68dSC03;
//// model: A68dSC04
model A68dSC04
  Real v[1] = {time};
  Real s;
equation
  s = scalar(v) + 1;
end A68dSC04;
//// model: A68dSC05
model A68dSC05
  Real v[1, 1] = {{time}};
  Real s;
algorithm
  s := scalar(v);
end A68dSC05;
//// model: A68dSC06
model A68dSC06
  Real x = time;
  Real s = scalar(x);
end A68dSC06;
//// model: A68dSC07
model A68dSC07
  Real v[2] = {time, 1};
  Real s = scalar(v);
end A68dSC07;
//// model: A68dSC08
model A68dSC08
  Real v[1] = {time};
  Real s = scalar(2 * v);
end A68dSC08;
//// model: A68dSC09
model A68dSC09
  Real v[1] = {time};
  Real s = scalar(v[1:1]);
end A68dSC09;
//// model: A68dSC10
model A68dSC10
  parameter Integer n = 1;
  Real v[n] = fill(time, n);
  Real s = scalar(v);
end A68dSC10;
//// model: A68dSC11
model A68dSC11
  Integer k[1] = {3};
  Real s = scalar(k);
end A68dSC11;
//// model: A68dSC12
model A68dSC12
  Real v[1] = {time};
  Real s = scalar(-v);
end A68dSC12;
//// model: A68dSC13
function f
  input Real u[1];
  output Real y;
algorithm
  y := scalar(u) * 2;
end f;
model A68dSC13
  Real s = f({time});
end A68dSC13;
//// model: A68dSC14
function f
  input Real u[:];
  output Real y;
algorithm
  y := scalar(u);
end f;
model A68dSC14
  Real s = f({time});
end A68dSC14;
//// model: A68dSC15
model A68dSC15
  Real v[1] = {time};
  Real s(start = scalar({2})) = scalar(v);
end A68dSC15;
//// model: A68dSC16
model A68dSC16
  model M
    parameter Real p[1] = {1};
    Real s = scalar(p);
  end M;
  M m1(p = {2});
  M m2(p = {3});
end A68dSC16;
//// model: A68dSC17
model A68dSC17
  Real v[1, 1] = {{time}};
  Real s = scalar(transpose(v));
end A68dSC17;
//// model: A68dSC18
function g
  input Real x;
  output Real y[1];
algorithm
  y := {x};
end g;
model A68dSC18
  Real s = scalar(g(time));
end A68dSC18;
//// model: A68dSC19
model A68dSC19
  Real v[1] = {time};
  Real w[1] = {2 * time};
  Real s = scalar(v + w);
end A68dSC19;
//// model: A68dSC20
model A68dSC20
  Real v[0];
  Real s = scalar(v);
end A68dSC20;
//// model: A68dSC21
model A68dSC21
  Boolean b[1] = {time > 1};
  Boolean s = scalar(b);
end A68dSC21;
//// model: A68dSC22
model A68dSC22
  Real v[1, 1] = {{time}};
  Real s = scalar(v ^ 2);
end A68dSC22;
//// model: A68dSC23
model A68dSC23
  Real v[1] = {time};
  Real s = scalar(scalar(v));
end A68dSC23;
//// model: A68dSC24
model A68dSC24
  constant Real c[1] = {7};
  Real s = scalar(c);
end A68dSC24;
//// model: A68dSC25
model A68dSC25
  Real v[1] = {time};
  Real s;
equation
  s = scalar(v, 1);
end A68dSC25;
//// model: A68dDA01
model A68dDA01
  parameter Real[1,2,1,2] pc = {{{{1,2}},{{3,4}}}};
  Real[1,2,1,2] c = der(pc);
end A68dDA01;
//// model: A68dDA02
model A68dDA02
  Real[1,2,1,2] d = der({{{{1.0,2.0}},{{3.0,4.0}}}});
end A68dDA02;
//// model: A68dDA03
model A68dDA03
  parameter Real p[2] = {1, 2};
  Real c[2] = der(p);
end A68dDA03;
//// model: A68dDA04
model A68dDA04
  parameter Real p[2] = {1, 2};
  Real c[2];
equation
  c = der(p);
end A68dDA04;
//// model: A68dDA05
model A68dDA05
  parameter Real p[2] = {1, 2};
  Real c[2] = der(2 * p);
end A68dDA05;
//// model: A68dDA06
model A68dDA06
  parameter Real p[2] = {1, 2};
  parameter Real c[2] = der(p);
end A68dDA06;
//// model: A68dDA07
model A68dDA07
  Real c[2] = der({1, 2});
end A68dDA07;
//// model: A68dDA08
model A68dDA08
  parameter Integer k[2] = {1, 2};
  Real c[2] = der(k);
end A68dDA08;
//// model: A68dDA09
model A68dDA09
  constant Real k[2] = {1, 2};
  Real c[2] = der(k);
end A68dDA09;
//// model: A68dDA10
model A68dDA10
  parameter Real p[2] = {1, 2};
  Real c[2];
algorithm
  c := der(p);
end A68dDA10;
//// model: A68dDA11
model A68dDA11
  parameter Real p[2] = {1, 2};
  Real c[2];
equation
  c = der(p) + {time, time};
end A68dDA11;
//// model: A68dDA12
function f
  input Real u[2];
  output Real y = u[1] + u[2];
end f;
model A68dDA12
  parameter Real p[2] = {1, 2};
  Real s = f(der(p));
end A68dDA12;
//// model: A68dDA13
model A68dDA13
  Real x[2](each start = 1);
  Real c[2] = der(x);
equation
  der(x) = {1, 2};
end A68dDA13;
//// model: A68dDA14
model A68dDA14
  parameter Real p[2] = {1, 2};
  Real s = sum(der(p));
end A68dDA14;
//// model: A68dDA15
model A68dDA15
  parameter Real p[2, 2] = {{1, 2}, {3, 4}};
  Real c[2, 2] = der(p);
end A68dDA15;
//// model: A68dDA16
model A68dDA16
  parameter Real p[0];
  Real c[0] = der(p);
end A68dDA16;
//// model: A68dDA17
model A68dDA17
  model M
    parameter Real p[2] = {1, 2};
    Real c[2] = der(p);
  end M;
  M m1, m2(p = {3, 4});
end A68dDA17;
//// model: A68dDA18
model A68dDA18
  discrete Real d[2](each start = 0);
  Real c[2] = der(d);
equation
  when time > 1 then d = {1, 2}; end when;
end A68dDA18;
//// model: A68dDA19
model A68dDA19
  parameter Real p[2] = {1, 2};
  Real c[2] = der(p) * time;
end A68dDA19;
//// model: A68dDA20
model A68dDA20
  parameter Real p[2] = {1, 2};
  Real c[2](start = der(p));
equation
  c = {time, time};
end A68dDA20;
//// model: A68dER01
model A68dER01
  type E = enumeration(a, b, c, d);
  constant E earr[E] = E.a:E.d;
  constant E e1 = min(E.a, E.d);
  constant E e3 = min(earr);
  constant E e4 = max(earr);
  constant E e5 = min(e for e in earr);
  constant E e6 = max(e for e in earr);
end A68dER01;
//// model: A68dER02
model A68dER02
  type E = enumeration(a, b, c, d);
  constant E earr[4] = E.a:E.d;
end A68dER02;
//// model: A68dER03
model A68dER03
  type E = enumeration(a, b, c, d);
  parameter E earr[E] = E.a:E.d;
end A68dER03;
//// model: A68dER04
model A68dER04
  type E = enumeration(one, two, three, four);
  E e1[E] = E.one:E.four;
  E e2[2] = E.two:E.three;
end A68dER04;
//// model: A68dER05
model A68dER05
  type E = enumeration(one, two, three, four);
  E e2[2];
equation
  e2 = E.two:E.three;
end A68dER05;
//// model: A68dER06
model A68dER06
  type E = enumeration(one, two, three, four);
  E e2[2];
algorithm
  e2 := E.two:E.three;
end A68dER06;
//// model: A68dER07
model A68dER07
  type E = enumeration(one, two, three, four);
  E e2[:] = E.two:E.three;
end A68dER07;
//// model: A68dER08
model A68dER08
  type E = enumeration(one, two, three, four);
  parameter E e2[:] = E.two:E.three;
end A68dER08;
//// model: A68dER09
model A68dER09
  type E = enumeration(one, two, three, four);
  E e0[0] = E.three:E.two;
end A68dER09;
//// model: A68dER10
model A68dER10
  type E = enumeration(one, two, three, four);
  type F = enumeration(one, two, three, four);
  E e2[2] = F.two:F.three;
end A68dER10;
//// model: A68dER11
model A68dER11
  type E = enumeration(one, two, three, four);
  E e2[3] = E.two:E.three;
end A68dER11;
//// model: A68dER12
model A68dER12
  type E = enumeration(one, two, three);
  Real x[3] = {1, 2, 3};
  Real y[2];
equation
  for e in E.two:E.three loop
    y[Integer(e) - 1] = x[Integer(e)];
  end for;
end A68dER12;
//// model: A68dER13
model A68dER13
  type E = enumeration(one, two, three, four);
  constant E c[2] = E.two:E.three;
  E y = c[2];
end A68dER13;
//// model: A68dER14
package P
  type E = enumeration(one, two, three);
end P;
model A68dER14
  P.E e[3] = P.E.one:P.E.three;
  constant P.E k[2] = P.E.two:P.E.three;
end A68dER14;
//// model: A68dER15
model A68dER15
  type E = enumeration(one, two, three, four);
  E e2[2] = (E.two:E.three);
  Integer n[2] = Integer(E.two:E.three);
end A68dER15;
//// model: A68dMC01
model A68dMC01
  parameter Real x[:] = {1, 2};
  parameter Real y[:] = {3, 4};
  parameter Real z[:, :] = [x, y];
end A68dMC01;
