//// model: A68dMC13
model A68dMC13
  model M
    parameter Real x[:] = {1, 2};
    parameter Real z[:, :] = [x, x];
  end M;
  M m1, m2(x = {1, 2, 3});
end A68dMC13;
//// model: A68dMC14
model A68dMC14
