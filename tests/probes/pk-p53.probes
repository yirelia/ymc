  Real x[2, :] = y;
  Real y[:, 3] = x;
end A68dDU01;
//// model: A68dDU02
model A68dDU02
  Real x[2, 3] = y;
  Real y[:, :] = x;
end A68dDU02;
//// model: A68dDU03
model A68dDU03
  Real x[:] = y;
  Real y[3] = {1, 2, 3};
end A68dDU03;
//// model: A68dDU04
model A68dDU04
  parameter Real x[:] = y;
  parameter Real y[:] = {1, 2, 3};
end A68dDU04;
//// model: A68dDU05
model A68dDU05
  Real x[:] = y;
  Real y[:] = x;
end A68dDU05;
//// model: A68dDU06
model A68dDU06
  Real x[:] = y;
  Real y[:] = z;
  Real z[2] = {time, 1};
end A68dDU06;
//// model: A68dDU07
model A68dDU07
  model M
    Real x[2, :] = y;
    Real y[:, 3] = x;
  end M;
  M m;
end A68dDU07;
//// model: A68dDU08
model A68dDU08
  Real x[:] = 2 * y;
  Real y[:] = {1, 2};
end A68dDU08;
//// model: A68dDU09
model A68dDU09
  Real x[:] = y;
  Real y[:] = {time, 2 * time};
equation
end A68dDU09;
//// model: A68dDU10
model A68dDU10
  type E = enumeration(a, b);
  Real x[:] = y;
  Real y[:] = z;
  Real z[E] = {1, 2};
end A68dDU10;
//// model: A68dDU11
model A68dDU11
  Real x[:] = y[1:2];
  Real y[:] = {1, 2, 3};
end A68dDU11;
//// model: A68dDU12
model A68dDU12
  Real x[:] = y;
  Real y[:] = {{1, 2}};
end A68dDU12;
//// model: A68dDU13
model Base
  Real y[:] = {1, 2};
end Base;
model A68dDU13
  extends Base(y = {1, 2, 3});
  Real x[:] = y;
end A68dDU13;
//// model: A68dDU14
model A68dDU14
  Real x[:] = y;
  Real y[:] = fill(time, 2);
end A68dDU14;
//// model: A68dEM01
model A68dEM01
  type E = enumeration(a, b, c, d);
  constant E earr[E] = E.a:E.d;
  constant E e5 = min(e for e in earr);
  constant E e6 = max(e for e in earr);
  constant E e7 = min(e for e in {E.c, E.b, E.d});
  constant E e8 = max(e for e in {E.a, E.c, E.b});
end A68dEM01;
//// model: A68dEM02
model A68dEM02
  type E = enumeration(a, b, c, d);
  constant E earr[E] = E.a:E.d;
  constant E e3 = min(earr);
  constant E e4 = max(earr);
end A68dEM02;
//// model: A68dEM03
model A68dEM03
  type E = enumeration(a, b, c, d);
  parameter E p = E.b;
  parameter E e = min(x for x in {E.c, p});
end A68dEM03;
//// model: A68dEM04
model A68dEM04
  type E = enumeration(a, b, c, d);
  E v = if time > 1 then E.a else E.b;
  E e = max(x for x in {E.c, v});
end A68dEM04;
//// model: A68dEM05
model A68dEM05
  type E = enumeration(a, b, c, d);
  constant E e = min(x for x in E);
end A68dEM05;
//// model: A68dEM06
model A68dEM06
  type E = enumeration(a, b, c, d);
  type F = enumeration(a, b);
  constant E e = min(x for x in {E.c, F.a});
end A68dEM06;
//// model: A68dEM07
model A68dEM07
  constant Boolean b = min(x for x in {true, false});
end A68dEM07;
//// model: A68dEM08
model A68dEM08
  type E = enumeration(a, b, c, d);
  constant E e = max(x for x in E.b:E.c);
end A68dEM08;
//// model: A68dAC01
