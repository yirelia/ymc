//// model: A68dFW01
record R
  parameter Real x = 3;
  parameter Real[:] y = {1, 2, 3};
end R;
model A
  parameter Real[:] y = {1};
end A;
model B
  replaceable record Data = R;
  final parameter Data data;
end B;
model A68dFW01
  A a(y = b.data.y);
  B b;
end A68dFW01;
//// model: A68dFW02
model A
  parameter Real[:] y = {1};
end A;
model B
  parameter Real q[:] = {4, 5};
end B;
model A68dFW02
  A a(y = b.q);
  B b;
end A68dFW02;
//// model: A68dFW03
model A
  parameter Real[2] y = {1, 1};
end A;
