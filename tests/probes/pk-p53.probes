  constant Real c[:, :] = [{1, 2}, {3, 4}];
  parameter Real z[:, :] = [x, x] * 2;
end A68dMC14;
//// model: A68dER16
model A68dER16
  type E = enumeration(one, two, three, four);
  parameter E p = E.three;
  E e[3] = E.one:p;
end A68dER16;
//// model: A68dER17
function f
  input Integer n[:];
  output Integer s = sum(n);
end f;
model A68dER17
  type E = enumeration(one, two, three);
  Integer k = f(Integer(E.one:E.three));
end A68dER17;
//// model: A68dER18
model A68dER18
  type E = enumeration(one, two, three);
  E e[2];
equation
  e = if time > 1 then E.one:E.two else E.two:E.three;
end A68dER18;
//// model: A68dER19
model A68dER19
  type E = enumeration(one, two, three);
  model M
    parameter E lo = E.one;
    E e[2] = E.two:E.three;
  end M;
  M m1, m2;
end A68dER19;
