//// model: A68dAC06
record R
  Real x;
end R;
model A68dAC06
  parameter Real p = 2;
  parameter R r[3](x = {1, p, 3});
  parameter Real x[:] = {i.x for i in r};
end A68dAC06;
//// model: A68dAC07
record R
  Real x;
end R;
model A68dAC07
  parameter R r[2](x = {1, 2});
  Real y[2];
equation
  y = {i.x for i in r};
end A68dAC07;
//// model: A68dAC08
model A68dAC08
  parameter Real a[3] = {1, 2, 3};
  parameter Real x[:] = {i for i in a};
