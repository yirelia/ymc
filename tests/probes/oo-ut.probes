end C;
package P
  type Voltage = Real(quantity = "V", unit = "V");
  operator record CV = C(redeclare Voltage re, redeclare Voltage im) "voltage";
end P;
model ORU7
  C a, b;
  Integer n = 3;
equation
  a = C(time);
  b = -(-a) + a * n;
end ORU7;
//// model: ORU8
