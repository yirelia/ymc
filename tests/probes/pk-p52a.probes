  function g input Boolean u; output Real v; algorithm v := if u then 1 else 0; end g;
  function gi input Integer u; output Real v; algorithm v := u; end gi;
  function h input Real u; output Real v; algorithm v := u * 2; end h;
  type E = enumeration(a, b, c);
  parameter Real p = 2;
  parameter Integer n = 3;
  parameter Boolean pb = true;
  Real y(start = 1, fixed = true);
  Integer j;
  Boolean b;
  discrete Real d(start = 0, fixed = true);
  Real z = noEvent(gi(j));
equation
  der(y) = 1 - y;
  j = integer(time);
  b = time > 0.5;
  when time > 0.9 then d = time; end when;

end R68cNE32;
