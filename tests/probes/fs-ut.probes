//// set: fs-ut — size 与函数体切片（单测原文）
//// model: FS2
function f2
  input Real a[3];
  input Real b[3];
  output Real s;
algorithm
  s := sum(a .* b);
end f2;
model FS2
  Real x = f2({time, 1, 2}, {1, 2, 3});
end FS2;
//// model: FAS2
function h
  input Real w[3];
  output Real s;
algorithm
  s := w * w;
end h;
model FAS2
  Real x[3] = {time, 1, 2};
  Real y = h(x);
end FAS2;
//// model: FSS1
function f
  input Real u[:];
  output Integer n;
algorithm
  n := size({u, u}, 2);
end f;

model FSS1
  Real x[3] = {time, 1, 2};
  Integer k = f(x);
end FSS1;
//// model: FST1
function f
  input Real u[:];
  input Real w[3];
  input Real q[:, :];
  input Real g[2, 3];
  input Integer k;
  input Integer n2[2];
  input Integer idx[:];
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real v2[2];
  Integer n[2];
  Integer r;
algorithm
  v := u[:];
  v2 := u[1:2];
  v2 := w[2:end];
  v3 := w[1:end];
  v3 := w[end:-1:1];
  v2 := w[{1, 3}];
  v := u[idx];
  v3 := q[k, :];
  v2 := g[:, k];
  v3 := -g[2, :];
  v3 := 2 * q[1, :];
  v := u[1:end];
  v[1:2] := {1, 2};
  v3[2:end] := w[1:2];
  v2 := n2;
  v2 := n2 * 2.5;
  v2 := if k > 0 then n2 else w[1:2];
  v2 := 2 * (if k > 0 then n2 else w[1:2]);
  v3 := fill(1, 3) + w;
  v2 := g * w;
  o := sum(u[1:2]) + sum(q[1, :]) + sum(2 * w[1:2]) + w[1:2] * n2;
  n := size(q);
  n := size(q) + {1, 1};
  r := size(2 * u, 1) + ndims(q) + sum(size(q));
  o := o + r + sum(n);
end f;

model FST1
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real y = f(x, x, m, m, 1, {1, 2}, {1, 2, 3});
end FST1;
//// model: SZT1
model SZT1
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  parameter Integer d = 1;
  Integer k1 = size({1, 2, 3}, 1);
  Integer k2 = size({{1, 2}, {3, 4}, {5, 6}}, 2);
  Integer k3 = size(1:5, 1);
  Integer k4 = size(m, d);
  Integer k5 = size(m, d) + size(m, 2);
  Integer k6[1] = size({1, 2, 3});
  Integer k7 = ndims(m);
  constant Integer c = size({1, 2}, 1);
  Real y[size({1, 2, 3}, 1)] = fill(a, 3);
end SZT1;
