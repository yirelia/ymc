//// model: T28
model T28
  type E = enumeration(one, two, three);
  Real a = time;
  Real y[Boolean] = {a, 1}; Real z; algorithm z := 0; for b in Boolean loop z := z + y[b]; end for;
end T28;
//// model: T29
model T29
  type E = enumeration(one, two, three);
  Real a = time;
  Real y[Boolean] = {a, 1}; Real z; algorithm z := 0; for b in {true, false} loop z := z + (if b then y[b] else 0); end for;
end T29;
//// model: T210
model T210
  type E = enumeration(one, two, three);
  Real a = time;
  Real y[Boolean] = {a, 1}; Real z; algorithm z := 0; for b in false:true loop z := z + y[not b]; end for;
end T210;
