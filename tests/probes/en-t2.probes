//// model: T217
model T217
  type E = enumeration(one, two, three);
  Real a = time;
  Real y[E, 2] = {{a, 1}, {2, 3}, {4, 5}}; Real z;
equation
  z = sum(y[i, j] for i in E, j in 1:2);
end T217;
