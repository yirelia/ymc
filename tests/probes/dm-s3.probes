//// model: S336
model S336
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer b[:] = {3, 2}; Real y = x[b[end]];
