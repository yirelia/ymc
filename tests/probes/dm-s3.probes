//// model: S340
model S340
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  constant Integer b[:] = {3, 2}; Real y[b[end]];
end S340;
//// model: S341
model S341
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer b[:] = {3, 2}; Real y[size(b, 1)] = x[b[1:end]];
end S341;
//// model: S342
model S342
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  type E = enumeration(one, two, three); Integer y[size(E, 1)];
end S342;
