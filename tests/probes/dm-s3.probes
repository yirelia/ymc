model S311
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real a[:] = {t, 1}; Real y[size(a, 1)];
end S311;
//// model: S312
model S312
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real a[:] = {t, 1}; Real y[size(a, 1)] = a;
