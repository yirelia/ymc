//// set: dm-s3 — 维里的 size(`:` 数组) / end / 类型名的 size
//// model: S30
model S30
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {1, 1}; Real y[size(a, 1) - 1];
end S30;
//// model: S31
model S31
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {1, 1}; Real y[size(a, 1)];
end S31;
//// model: S32
model S32
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {1, 1}; parameter Integer n = size(a, 1) - 1; Real y[n + 1];
end S32;
//// model: S33
model S33
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {1, 1}; parameter Integer n = size(a, 1); Real y = n * t;
end S33;
//// model: S34
model S34
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {1, 1}; Integer n = size(a, 1);
end S34;
//// model: S35
model S35
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {1, 1}; Real y = size(a, 1) * t;
end S35;
//// model: S36
model S36
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, :] = {{1, 2, 3}, {4, 5, 6}}; Real y[size(a, 1), size(a, 2)];
end S36;
