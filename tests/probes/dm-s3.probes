model S327
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, size(a, 1)] = {{1, 0}, {0, 1}}; parameter Real b[size(a, 1), :] = {{1}, {1}}; Real y[size(b, 2)];
end S327;
//// model: S328
model S328
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, size(a, 1)] = {{1, 0}, {0, 1}}; parameter Real b[size(a, 1), :] = {{1}, {1}}; parameter Real c[:, size(a, 1)] = {{1, 1}}; parameter Real d[size(c, 1), size(b, 2)] = zeros(size(c, 1), size(b, 2));
end S328;
