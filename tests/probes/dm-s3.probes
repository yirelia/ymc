model S319
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer a[:] = 1:3; Real y[size(a, 1)];
end S319;
//// model: S320
model S320
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = {i for i in 1:3}; Real y[size(a, 1)];
end S320;
//// model: S321
model S321
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = cat(1, {1, 2}, {3}); Real y[size(a, 1)];
end S321;
//// model: S322
model S322
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = x; Real y[size(a, 1)];
end S322;
//// model: S323
model S323
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real b[:] = {1, 2, 3}; parameter Real a[:] = b; Real y[size(a, 1)];
end S323;
//// model: S324
model S324
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real b[:] = {1, 2, 3}; parameter Real a[:] = 2 * b; Real y[size(a, 1)];
end S324;
//// model: S325
model S325
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real b[:] = {1, 2, 3}; parameter Real a[size(b, 1)] = b; Real y[size(a, 1)];
end S325;
//// model: S326
model S326
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, size(a, 1)] = {{1, 0}, {0, 1}}; Real y[size(a, 1)];
end S326;
