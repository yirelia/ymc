//// model: S349
model S349
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[size(x, 1)] = x; Real z[size(m, 2), size(m, 1)];
