model S316
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer k = 2; parameter Real a[:] = fill(1.0, k); Real y[size(a, 1)];
end S316;
//// model: S317
model S317
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer k = 2; parameter Real a[k] = fill(1.0, k); Real y[size(a, 1)];
end S317;
//// model: S318
model S318
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:] = 1.0:3.0; Real y[size(a, 1)];
end S318;
