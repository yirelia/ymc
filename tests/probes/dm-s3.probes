model S38
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, 3] = {{1, 2, 3}, {4, 5, 6}}; Real y[size(a, 1) + size(a, 2)];
end S38;
//// model: S39
model S39
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, :] = {{1, 2, 3}, {4, 5, 6}}; Integer s[2] = size(a);
end S39;
//// model: BASE
model BASE
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
end BASE;
//// model: S310
model S310
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, :] = {{1, 2, 3}, {4, 5, 6}}; Real y[sum(size(a))];
end S310;
