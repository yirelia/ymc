model S339
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer b[:] = {3, 2}; parameter Integer c[:] = {1, 2}; Real y[b[c[end]]];
