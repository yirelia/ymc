//// model: S351
model S351
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Integer s[1] = size(x); Integer s2[2] = size(m);
end S351;
