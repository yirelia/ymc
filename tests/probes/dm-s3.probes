model S37
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real a[:, :] = {{1, 2, 3}, {4, 5, 6}}; Real y[size(a, 2)];
