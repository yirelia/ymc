//// set: nr-c1 — 常量实参的调用：函数体里有 assert / 调用语句
//// model: C10
model C10
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm assert(u > 0, "m"); v := u; end g; Real y = g(2);
end C10;
//// model: C11
model C11
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm assert(u > 0, "m"); v := u; end g; Real y = g(-2);
end C11;
//// model: C12
model C12
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm assert(u > 0, "m"); v := u; end g; constant Real y = g(2);
end C12;
//// model: C13
model C13
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm assert(u > 0, "m"); v := u; end g; parameter Real y = g(2);
end C13;
//// model: C14
model C14
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm assert(u > 0, "m"); v := u; end g; Real y = g(t);
end C14;
//// model: C15
model C15
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm assert(u > 0, "m"); v := u; end g; Real y = g(2) + t;
end C15;
//// model: C16
model C16
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm v := u; terminate("x"); end g; Real y = g(2);
end C16;
//// model: C17
model C17
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm v := u; assert(v > 0, "m", AssertionLevel.warning); end g; Real y = g(2);
end C17;
//// model: C18
model C18
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function g input Real u; output Real v; algorithm v := u; assert(v < 0, "m", AssertionLevel.warning); end g; Real y = g(2);
end C18;
//// model: C19
model C19
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; end f; function g input Real u; output Real v; algorithm f(u); v := u; end g; Real y = g(2);
end C19;
//// model: BASE
model BASE
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
end BASE;
//// model: C110
model C110
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; algorithm assert(u > 0, "m"); end f; function g input Real u; output Real v; algorithm f(u); v := u; end g; Real y = g(2);
end C110;
//// model: C111
model C111
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; algorithm assert(u > 0, "m"); end f; function g input Real u; output Real v; algorithm f(u); v := u; end g; Real y = g(-2);
end C111;
//// model: C112
model C112
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real u; output Real w = 2 * u; end f; function g input Real u; output Real v; algorithm f(u); v := u; end g; Real y = g(2);
end C112;
//// model: C113
model C113
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  impure function f input Real u; end f; function g input Real u; output Real v; algorithm f(u); v := u; end g; Real y = g(2);
end C113;
//// model: C114
model C114
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  impure function f input Real u; end f; impure function g input Real u; output Real v; algorithm f(u); v := u; end g; Real y = g(2);
end C114;
