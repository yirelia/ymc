end E217;
//// model: E218
model C
parameter Real x = 1;
end C;
model A
C c;
end A;
model B
extends A(c(x = 2));
end B;
model D
B b;
end D;
model E218
D d(b(c(x = 9)));
end E218;
//// model: E219
connector P
Real e;
flow Real f;
end P;
model A
P p;
equation
p.e = time;
end A;
model E219
extends A(p(e(nominal = 2)));
end E219;
//// model: E220
package P
constant Real k = 3;
model C
parameter Real x = 1;
parameter Real z = 1;
end C;
model A
C c(x = k);
end A;
end P;
model E220
extends P.A(c(z = 2));
end E220;
//// model: E221
model C
parameter Real x = 1;
end C;
model A
C c;
end A;
model E221
parameter Boolean b = true;
extends A(c(x = if b then 1 else 2));
end E221;
//// model: E222
model C
parameter Integer n = 1;
Real v[n];
equation
v = fill(time, n);
end C;
model A
C c;
end A;
model E222
extends A(c(n = 3));
end E222;
//// model: E223
model C
parameter Real x = 1;
