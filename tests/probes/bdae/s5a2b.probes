//// set: s5a2b — S5a-2b：pre 模块 FunctionAlias（NBFunctionAlias.mo v1.25.0）。Lfa 前缀，走 tools/bdae_sweep.py --probes s5a2b --stage functionalias。LfaB*：内建 × 实参 × 位置；LfaBI*：Integer / Boolean / String 的实参和返回；LfaD*：去重、实参次序、嵌套、绑定、跨桶；LfaN*：数量跨 Map rehash、连续离散交错；LfaU*：用户函数的体（单条赋值、多条、if、for、while、输出绑定、空算法、impure、外部、builtin）；LfaI*：初值方程（只在初值、与 simulation 共用、Integer、嵌套）；LfaC*：语境（when、if 方程、assert、reinit、der、if 表达式、算法、运算）；LfaZ*：枚举结果 / 实参、离散绑定、绑定与初值、初值里大量调用、顶层 input、stateSelect；LfaK*：previous、hold（换）、ticksInState、timeInState（impure 不换）；LfaX*：Clock、元组、数组、记录、omc 报错。
//// model: LfaB_sin_t_rhs
model LfaB_sin_t_rhs
  parameter Real p = 0.4;
  parameter Real q = 0.2;
  Real y;
  discrete Real d(start = 0.2, fixed = true);
equation
  y = sin(0.5 * time);
  when sample(0, 0.1) then d = pre(d) + 0.01; end when;
end LfaB_sin_t_rhs;
//// model: LfaB_sin_t_sum
model LfaB_sin_t_sum
  parameter Real p = 0.4;
  parameter Real q = 0.2;
  Real y;
  discrete Real d(start = 0.2, fixed = true);
equation
  y = sin(0.5 * time) + time;
  when sample(0, 0.1) then d = pre(d) + 0.01; end when;
end LfaB_sin_t_sum;
//// model: LfaB_sin_t_prod
model LfaB_sin_t_prod
  parameter Real p = 0.4;
  parameter Real q = 0.2;
  Real y;
  discrete Real d(start = 0.2, fixed = true);
equation
  y = 2 * sin(0.5 * time) * time;
  when sample(0, 0.1) then d = pre(d) + 0.01; end when;
end LfaB_sin_t_prod;
//// model: LfaB_sin_t_neg
model LfaB_sin_t_neg
  parameter Real p = 0.4;
  parameter Real q = 0.2;
  Real y;
  discrete Real d(start = 0.2, fixed = true);
equation
