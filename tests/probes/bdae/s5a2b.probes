//// model: LfaZ_input
model LfaZ_input
  input Real u = sin(time);
  Real y;
equation
  y = sin(time) + u;
end LfaZ_input;
//// model: LfaZ_alias_eq
model LfaZ_alias_eq
  Real y;
  Real z;
equation
  y = z;
  z = sin(time);
end LfaZ_alias_eq;
//// model: LfaZ_nested_dedup
model LfaZ_nested_dedup
  Real y1;
  Real y2;
  Real y3;
equation
  y1 = exp(sin(cos(time)));
  y2 = exp(sin(cos(time))) + sin(cos(time));
  y3 = cos(time);
end LfaZ_nested_dedup;
//// model: LfaZ_state_select
model LfaZ_state_select
  Real x(stateSelect = StateSelect.always, start = 1, fixed = true);
  Real y;
equation
  der(x) = -sin(x);
  y = sin(x);
end LfaZ_state_select;
//// model: LfaZ_fixed_param
model LfaZ_fixed_param
  parameter Real p(fixed = false);
  Real x(start = 1, fixed = true);
initial equation
  p = cos(time) + sin(time);
equation
  der(x) = -p * sin(time);
end LfaZ_fixed_param;
//// model: LfaK_prev_r
model LfaK_prev_r
  Real x;
equation
  x = previous(x);
end LfaK_prev_r;
//// model: LfaK_prev_i
model LfaK_prev_i
  output Integer x(start = 1, fixed = true);
equation
  x = -previous(x);
end LfaK_prev_i;
//// model: LfaK_prev_twice
model LfaK_prev_twice
  Real x;
equation
  x = previous(x) + previous(x) * 2;
end LfaK_prev_twice;
//// model: LfaK_prev_two
model LfaK_prev_two
  Real x;
  Real y;
equation
  x = previous(x) + previous(y);
  y = previous(x);
end LfaK_prev_two;
//// model: LfaK_prev_sin
model LfaK_prev_sin
  Real x;
equation
  x = sin(previous(x)) + previous(x);
end LfaK_prev_sin;
//// model: LfaK_prev_b
model LfaK_prev_b
  Boolean b;
equation
  b = not previous(b);
end LfaK_prev_b;
//// model: LfaK_hold_r
model LfaK_hold_r
  Real x;
  Real y;
equation
  y = hold(x);
end LfaK_hold_r;
//// model: LfaK_hold_i
model LfaK_hold_i
  Integer n;
  Integer m;
equation
  m = hold(n) + 1;
end LfaK_hold_i;
//// model: LfaK_hold_sin
model LfaK_hold_sin
  Real x;
  Real y;
equation
  y = sin(hold(x)) + hold(x);
end LfaK_hold_sin;
//// model: LfaK_hold_prev
model LfaK_hold_prev
  Real x;
  Real y;
equation
  y = hold(previous(x));
  x = previous(x) + 1;
end LfaK_hold_prev;
//// model: LfaK_ticks
model LfaK_ticks
  output Integer t;
equation
  t = ticksInState();
end LfaK_ticks;
//// model: LfaK_ticks2
model LfaK_ticks2
  Integer t;
  Real y;
equation
  t = ticksInState() + ticksInState();
  y = sin(ticksInState());
end LfaK_ticks2;
//// model: LfaK_time
model LfaK_time
  output Real t;
equation
  t = timeInState();
end LfaK_time;
//// model: LfaK_time2
model LfaK_time2
  Real t;
  Real y;
equation
  t = timeInState() * 2;
  y = sin(timeInState()) + exp(time);
end LfaK_time2;
//// model: LfaX_enum
model LfaX_enum
  function fe
    input Real u;
    output E v;
  algorithm
    v := E.a;
    v := if u > 0.5 then E.b else E.c;
  end fe;
  type E = enumeration(a, b, c);
  E e;
equation
  e = fe(time);
end LfaX_enum;
//// model: LfaX_clock
model LfaX_clock
  Real u = 1;
  output Real ud;
  parameter Real dt = 0.1;
equation
  ud = sample(time * u, Clock(dt));
end LfaX_clock;
//// model: LfaX_tuple
model LfaX_tuple
  function ft2
    input Real u;
    output Real v;
    output Real w;
  algorithm
    v := u;
    w := u * 2;
  end ft2;
  Real y;
equation
  y = ft2(time);
end LfaX_tuple;
//// model: LfaX_array
model LfaX_array
  Real y[2];
equation
  y = {sin(time), cos(time)};
end LfaX_array;
//// model: LfaX_for
model LfaX_for
  Real y[2];
equation
  for i in 1:2 loop y[i] = sin(i * time); end for;
end LfaX_for;
//// model: LfaX_rec
model LfaX_rec
  record R Real a; Real b; end R;
  R r;
equation
  r.a = sin(time);
  r.b = cos(time);
end LfaX_rec;
//// model: LfaX_badarg
model LfaX_badarg
  Real y;
equation
  y = sin(time, 2);
end LfaX_badarg;
//// model: LfaX_undef
model LfaX_undef
  Real y;
equation
  y = nosuchfn(time);
end LfaX_undef;
//// model: LfaX_empty
model LfaX_empty
end LfaX_empty;
//// model: LfaX_noeq
model LfaX_noeq
  Real y = sin(time);
end LfaX_noeq;
//// model: LfaX_param
model LfaX_param
  parameter Real p = sin(2);
  parameter Real q = 3;
  Real y;
equation
  y = sin(q) * time;
end LfaX_param;
