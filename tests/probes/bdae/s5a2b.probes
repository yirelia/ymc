//// model: LfaU_fcall
model LfaU_fcall
  function f2
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end f2;
  function fcall
    input Real u;
    output Real v;
  algorithm
    v := f2(u) + 1;
  end fcall;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = fcall(time);
end LfaU_fcall;
