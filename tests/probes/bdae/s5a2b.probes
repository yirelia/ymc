//// model: LfaU_fe
model LfaU_fe
  function fe
    input Real u;
    output E v;
  algorithm
    v := E.a;
    v := if u > 0.5 then E.b else E.c;
  end fe;
  type E = enumeration(a, b, c);
  E e;
equation
  e = fe(time);
end LfaU_fe;
//// model: LfaU_fe_cmp
model LfaU_fe_cmp
  function fe
    input Real u;
    output E v;
  algorithm
    v := E.a;
    v := if u > 0.5 then E.b else E.c;
  end fe;
  type E = enumeration(a, b, c);
  Boolean b;
equation
  b = fe(time) == E.b;
end LfaU_fe_cmp;
//// model: LfaI_only
model LfaI_only
  function fn
    input Real u;
    output Integer v;
  algorithm
    v := integer(u);
    v := v + 1;
  end fn;
  function f2
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end f2;
  parameter Real p = 0.5;
  Real x;
  Real y;
  Integer n;
  Boolean b;
initial equation
  x = sin(p) + cos(p);
equation
  der(x) = -x;
  y = time;
  n = 1;
  b = true;
end LfaI_only;
//// model: LfaI_shared
model LfaI_shared
  function fn
    input Real u;
    output Integer v;
  algorithm
    v := integer(u);
    v := v + 1;
  end fn;
  function f2
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end f2;
  parameter Real p = 0.5;
  Real x;
  Real y;
  Integer n;
  Boolean b;
initial equation
  x = sin(time) + cos(p);
equation
  der(x) = -sin(time);
  y = cos(p) + exp(time);
  n = 1;
  b = true;
end LfaI_shared;
