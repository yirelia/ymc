//// model: LfaN_mix8
model LfaN_mix8
  Real y0;
  Real y1;
  Real y2;
  Real y3;
  Real y4;
  Real y5;
  Real y6;
  Real y7;
  Integer k0;
  Integer k1;
  Integer k2;
  Integer k3;
  Integer k4;
  Integer k5;
  Integer k6;
  Integer k7;
equation
  y0 = cos(1 * time) + sin(1 * time);
  k0 = sign(time - 1 / 9);
  y1 = cos(2 * time) + sin(1 * time);
  k1 = sign(time - 2 / 9);
  y2 = cos(3 * time) + sin(2 * time);
  k2 = sign(time - 3 / 9);
