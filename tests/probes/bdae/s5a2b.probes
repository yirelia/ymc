  discrete Real d(start = 0.2, fixed = true);
equation
  y = rem(0.5 * pre(d), 0.3) + time;
  when sample(0, 0.1) then d = pre(d) + 0.01; end when;
end LfaB_rem_pre_sum;
//// model: LfaB_rem_pre_twice
model LfaB_rem_pre_twice
  parameter Real p = 0.4;
  parameter Real q = 0.2;
  Real y;
  discrete Real d(start = 0.2, fixed = true);
equation
  y = rem(0.5 * pre(d), 0.3) + rem(0.5 * pre(d), 0.3) * rem(0.5 * pre(d), 0.3);
  when sample(0, 0.1) then d = pre(d) + 0.01; end when;
end LfaB_rem_pre_twice;
//// model: LfaBI_abs
model LfaBI_abs
  type E = enumeration(a, b, c);
  Integer m;
  Integer n;
  Real y;
  Boolean b;
  Boolean c;
  E e;
  String s;
equation
  m = integer(time * 10);
  c = time > 0.3;
  e = if c then E.a else E.b;
  y = 0;
  b = false;
  s = "";
  n = abs(m - 3);
end LfaBI_abs;
