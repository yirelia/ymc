//// model: LfaD_same_eq
model LfaD_same_eq
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(time) + sin(time);
  y2 = time;
  m = integer(time);
end LfaD_same_eq;
//// model: LfaD_cross_eq
model LfaD_cross_eq
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(time);
  y2 = sin(time) * 2;
  m = integer(time);
end LfaD_cross_eq;
//// model: LfaD_order
model LfaD_order
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = atan2(time, p);
  y2 = atan2(p, time);
  m = integer(time);
end LfaD_order;
//// model: LfaD_const
model LfaD_const
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = atan2(time, 2);
  y2 = atan2(time, 3);
  m = integer(time);
end LfaD_const;
//// model: LfaD_commute
model LfaD_commute
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(time + 1);
  y2 = sin(1 + time);
  m = integer(time);
end LfaD_commute;
//// model: LfaD_prod
model LfaD_prod
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(p * time);
  y2 = sin(time * p);
  m = integer(time);
end LfaD_prod;
//// model: LfaD_names
model LfaD_names
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(time);
  y2 = cos(time);
  m = integer(time);
end LfaD_names;
//// model: LfaD_names2
model LfaD_names2
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(time) + cos(time) + tan(time);
  y2 = tan(time) + cos(time) + sin(time);
  m = integer(time);
end LfaD_names2;
//// model: LfaD_nested
model LfaD_nested
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(cos(time));
  y2 = cos(time) + sin(cos(time));
  m = integer(time);
end LfaD_nested;
//// model: LfaD_nested3
model LfaD_nested3
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = exp(sin(cos(time)));
  y2 = sin(cos(time)) + exp(cos(time));
  m = integer(time);
end LfaD_nested3;
//// model: LfaD_nested_rev
model LfaD_nested_rev
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = cos(time) + 1;
  y2 = sin(cos(time));
  m = integer(time);
end LfaD_nested_rev;
//// model: LfaD_bnd
model LfaD_bnd
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
  Real z1 = sin(time) + 1;
  Real z2 = cos(time) * sin(time);
equation
  y1 = sin(time);
  y2 = time;
  m = integer(time);
end LfaD_bnd;
//// model: LfaD_cross_bucket
model LfaD_cross_bucket
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sign(time - 0.5) + sin(time);
  y2 = sign(time - 0.5);
  m = integer(time);
end LfaD_cross_bucket;
//// model: LfaD_disc_first
model LfaD_disc_first
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = time;
  y2 = abs(time) + sign(time - 0.5) + sqrt(time + 1) + sign(time - 0.3);
  m = integer(time);
end LfaD_disc_first;
//// model: LfaD_lhs_rhs
model LfaD_lhs_rhs
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  sin(y1) = cos(time);
  y2 = sin(y1);
  m = integer(time);
end LfaD_lhs_rhs;
//// model: LfaD_neg_arg
model LfaD_neg_arg
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = sin(-time);
  y2 = -sin(time);
  m = integer(time);
end LfaD_neg_arg;
//// model: LfaD_real_int
model LfaD_real_int
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = abs(time - 1);
  y2 = abs(m - 1);
  m = integer(time);
end LfaD_real_int;
//// model: LfaD_if_both
model LfaD_if_both
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = if time > 0.5 then sin(time) else cos(time);
  y2 = if time > 0.6 then cos(time) else sin(time);
  m = integer(time);
end LfaD_if_both;
//// model: LfaD_if_cond
model LfaD_if_cond
  parameter Real p = 2;
  Real y1;
  Real y2;
  Integer m;
equation
  y1 = if sin(time) > 0.5 then 1 else 2;
  y2 = sin(time);
  m = integer(time);
end LfaD_if_cond;
//// model: LfaN_many1
model LfaN_many1
