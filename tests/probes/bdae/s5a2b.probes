//// model: LfaU_fd
model LfaU_fd
  function fd
    input Real u;
    input Real k = 2;
    output Real v;
  algorithm
    v := u * k;
    v := v + k;
  end fd;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = fd(time) + fd(time, 2) + fd(time, 3);
end LfaU_fd;
