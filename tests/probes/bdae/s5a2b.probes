end LfaB_sin_t_neg;
//// model: LfaB_sin_t_if
model LfaB_sin_t_if
  parameter Real p = 0.4;
  parameter Real q = 0.2;
  Real y;
  discrete Real d(start = 0.2, fixed = true);
equation
  y = if time > 0.5 then sin(0.5 * time) else 0;
  when sample(0, 0.1) then d = pre(d) + 0.01; end when;
end LfaB_sin_t_if;
