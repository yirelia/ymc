//// model: LfaU_f1
model LfaU_f1
  function f1
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
  end f1;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = f1(time);
end LfaU_f1;
//// model: LfaU_f2
model LfaU_f2
  function f2
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end f2;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = f2(time);
end LfaU_f2;
