model LfaU_fi
  impure function fi
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end fi;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = fi(time);
end LfaU_fi;
//// model: LfaU_fif
model LfaU_fif
  function fif
    input Real u;
    output Real v;
  algorithm
    if u > 0 then
      v := u;
    else
      v := -u;
    end if;
  end fif;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = fif(time);
end LfaU_fif;
//// model: LfaU_ffor
model LfaU_ffor
  function ffor
    input Real u;
    output Real v;
  algorithm
    v := 0;
    for i in 1:3 loop
      v := v + u * i;
    end for;
  end ffor;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = ffor(time);
end LfaU_ffor;
//// model: LfaU_fwh
model LfaU_fwh
  function fwh
    input Real u;
    output Real v;
  algorithm
    v := u;
    while v > 1 loop
      v := v / 2;
    end while;
  end fwh;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = fwh(time);
end LfaU_fwh;
