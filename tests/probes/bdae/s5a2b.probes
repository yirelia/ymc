//// model: LfaN_mix7
model LfaN_mix7
  Real y0;
  Real y1;
  Real y2;
  Real y3;
  Real y4;
  Real y5;
  Real y6;
  Integer k0;
  Integer k1;
  Integer k2;
  Integer k3;
  Integer k4;
  Integer k5;
  Integer k6;
equation
  y0 = cos(1 * time) + sin(1 * time);
  k0 = sign(time - 1 / 8);
  y1 = cos(2 * time) + sin(1 * time);
  k1 = sign(time - 2 / 8);
  y2 = cos(3 * time) + sin(2 * time);
  k2 = sign(time - 3 / 8);
  y3 = cos(4 * time) + sin(2 * time);
  k3 = sign(time - 4 / 8);
  y4 = cos(5 * time) + sin(3 * time);
  k4 = sign(time - 5 / 8);
  y5 = cos(6 * time) + sin(3 * time);
  k5 = sign(time - 6 / 8);
  y6 = cos(7 * time) + sin(4 * time);
  k6 = sign(time - 7 / 8);
end LfaN_mix7;
