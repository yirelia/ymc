initial equation
  x0 = cos(1 * p) + sin(1 * time);
  x1 = cos(2 * p) + sin(2 * time);
  x2 = cos(3 * p) + sin(3 * time);
  x3 = cos(4 * p) + sin(4 * time);
  x4 = cos(5 * p) + sin(5 * time);
  x5 = cos(6 * p) + sin(6 * time);
  x6 = cos(7 * p) + sin(7 * time);
  x7 = cos(8 * p) + sin(8 * time);
  x8 = cos(9 * p) + sin(9 * time);
  x9 = cos(10 * p) + sin(10 * time);
  x10 = cos(11 * p) + sin(11 * time);
  x11 = cos(12 * p) + sin(12 * time);
  x12 = cos(13 * p) + sin(13 * time);
  x13 = cos(14 * p) + sin(14 * time);
  x14 = cos(15 * p) + sin(15 * time);
equation
  der(x0) = -sin(1 * time);
  der(x2) = -sin(3 * time);
  der(x4) = -sin(5 * time);
  der(x6) = -sin(7 * time);
  der(x8) = -sin(9 * time);
  der(x10) = -sin(11 * time);
  der(x12) = -sin(13 * time);
  der(x14) = -sin(15 * time);
  der(x1) = -x1;
  der(x3) = -x3;
  der(x5) = -x5;
  der(x7) = -x7;
  der(x9) = -x9;
  der(x11) = -x11;
  der(x13) = -x13;
end LfaZ_init_many15;
