//// model: LfaI_pre
model LfaI_pre
  function fn
    input Real u;
    output Integer v;
  algorithm
    v := integer(u);
    v := v + 1;
  end fn;
  function f2
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end f2;
  parameter Real p = 0.5;
  Real x;
  Real y;
  Integer n;
  Boolean b;
initial equation
  pre(n) = sign(p);
equation
  der(x) = -x;
  when sample(0, 0.1) then n = pre(n) + sign(time - 0.5); end when;
  y = time;
  b = true;
end LfaI_pre;
//// model: LfaI_alg
model LfaI_alg
  parameter Real p = 0.5;
  Real x;
initial algorithm
  x := sin(p);
equation
  der(x) = -sin(time);
end LfaI_alg;
//// model: LfaI_bnd
model LfaI_bnd
  parameter Real p = 0.5;
  Real x(start = 1, fixed = true);
  Real y = sin(time);
equation
  der(x) = -sin(time);
end LfaI_bnd;
//// model: LfaI_start
model LfaI_start
  parameter Real p = 0.5;
  Real x(start = sin(p), fixed = true);
equation
  der(x) = -sin(time);
end LfaI_start;
//// model: LfaI_param
model LfaI_param
  parameter Real p = 0.5;
  parameter Real q(fixed = false);
  Real x(start = 1, fixed = true);
initial equation
  q = sin(p) + sin(time);
equation
  der(x) = -sin(time) * q;
end LfaI_param;
//// model: LfaC_when
model LfaC_when
  Real x(start = 1, fixed = true);
  discrete Real y;
equation
  der(x) = -x;
  when x < 0.5 then y = sin(time); end when;
end LfaC_when;
//// model: LfaC_when_cond
model LfaC_when_cond
  Real x(start = 1, fixed = true);
  discrete Real y(start = 0, fixed = true);
equation
  der(x) = -x;
  when sin(time) > 0.5 then y = pre(y) + 1; end when;
end LfaC_when_cond;
//// model: LfaC_reinit
model LfaC_reinit
  Real x(start = 1, fixed = true);
equation
  der(x) = -sin(time);
  when x < 0.5 then reinit(x, cos(time)); end when;
end LfaC_reinit;
//// model: LfaC_ifeq
model LfaC_ifeq
  Real x(start = 1, fixed = true);
  Real y;
equation
  der(x) = -x;
  if time > 0.5 then y = sin(time); else y = cos(time); end if;
end LfaC_ifeq;
//// model: LfaC_ifeq_mix
model LfaC_ifeq_mix
  Real x(start = 1, fixed = true);
  Real y;
  Real z;
equation
  der(x) = -sin(time);
  if time > 0.5 then y = sin(time); else y = cos(time); end if;
  z = cos(time);
end LfaC_ifeq_mix;
//// model: LfaC_assert
model LfaC_assert
  Real x(start = 1, fixed = true);
  Real y;
equation
  der(x) = -x;
  assert(sin(time) < 2, "msg");
  y = sin(time);
end LfaC_assert;
//// model: LfaC_der
model LfaC_der
  Real x(start = 1, fixed = true);
equation
  der(sin(x)) = cos(time);
end LfaC_der;
//// model: LfaC_der2
model LfaC_der2
  Real x(start = 1, fixed = true);
  Real y;
equation
  der(x) = -sin(x) * cos(x);
  y = der(sin(x));
end LfaC_der2;
//// model: LfaC_deep
model LfaC_deep
  Real y;
equation
  y = sin(cos(tan(exp(time * 0.1))));
end LfaC_deep;
//// model: LfaC_arith
model LfaC_arith
  Real y;
equation
  y = 2 * sin(time) ^ 2 + sin(time) / cos(time) - sqrt(abs(sin(time)));
end LfaC_arith;
//// model: LfaC_rel
model LfaC_rel
  Boolean b;
equation
  b = sin(time) > cos(time) or abs(time) < 0.5;
end LfaC_rel;
//// model: LfaC_noevent
model LfaC_noevent
  Real y;
equation
  y = noEvent(if sin(time) > 0 then sin(time) else -sin(time));
end LfaC_noevent;
//// model: LfaC_smooth
model LfaC_smooth
  Real y;
equation
  y = smooth(1, if time > 0.5 then sin(time) else cos(time));
end LfaC_smooth;
//// model: LfaC_delay
model LfaC_delay
  Real y;
equation
  y = delay(sin(time), 0.1) + delay(time, 0.1);
end LfaC_delay;
//// model: LfaC_homotopy
model LfaC_homotopy
  Real y;
equation
  y = homotopy(sin(time), cos(time));
end LfaC_homotopy;
//// model: LfaC_minmax
model LfaC_minmax
  Real y;
equation
  y = max(sin(time), cos(time)) + min(sin(time), 0.2);
end LfaC_minmax;
//// model: LfaC_semilinear
model LfaC_semilinear
  Real y;
equation
  y = semiLinear(sin(time), 2, 3) + semiLinear(time - 0.5, sin(time), 1);
end LfaC_semilinear;
//// model: LfaC_pow
model LfaC_pow
  Real y;
equation
  y = sin(time) ^ 2 + 2 ^ sin(time);
end LfaC_pow;
//// model: LfaC_string
model LfaC_string
  String s;
equation
  s = String(sin(time));
end LfaC_string;
//// model: LfaC_integer
model LfaC_integer
  Integer n;
equation
  n = integer(sin(time) * 10);
end LfaC_integer;
//// model: LfaC_alg
model LfaC_alg
  Real y;
  Real z;
algorithm
  z := sin(time);
equation
  y = sin(time);
end LfaC_alg;
//// model: LfaC_alg_if
model LfaC_alg_if
  Real y;
  Real z;
algorithm
  if time > 0.5 then
    z := sin(time);
  else
    z := cos(time);
  end if;
equation
  y = cos(time);
end LfaC_alg_if;
//// model: LfaC_tie
model LfaC_tie
  Real y;
  Real z;
equation
  y = sin(time);
  z = sin(time);
end LfaC_tie;
//// model: LfaC_self
model LfaC_self
  Real y;
equation
  y = sin(y) + time;
end LfaC_self;
//// model: LfaC_cast
model LfaC_cast
  Real y;
  Integer n;
equation
  y = sin(n) + abs(n);
  n = integer(time * 3);
end LfaC_cast;
//// model: LfaZ_enum_res
model LfaZ_enum_res
  function fep
    input E u;
    output E v;
  algorithm
    v := u;
    v := v;
  end fep;
  type E = enumeration(a, b, c);
  E e1;
  E e2;
equation
  e1 = if time > 0.5 then E.a else E.b;
  e2 = fep(e1);
end LfaZ_enum_res;
//// model: LfaZ_enum_res_cmp
model LfaZ_enum_res_cmp
  function fep
    input E u;
    output E v;
  algorithm
    v := u;
    v := v;
  end fep;
  type E = enumeration(a, b, c);
  E e1;
  Boolean b;
equation
  e1 = if time > 0.5 then E.a else E.b;
  b = fep(e1) == E.b;
end LfaZ_enum_res_cmp;
//// model: LfaZ_enum_init
model LfaZ_enum_init
  function fep
    input E u;
    output E v;
  algorithm
    v := u;
    v := v;
  end fep;
  type E = enumeration(a, b, c);
  parameter E p = E.b;
  E e1;
  Boolean b;
initial equation
  b = fep(p) == E.b;
equation
  e1 = if time > 0.5 then E.a else E.b;
  b = time > 0.5;
end LfaZ_enum_init;
//// model: LfaZ_enum_arg
model LfaZ_enum_arg
  function fer
    input E u;
    output Real v;
  algorithm
    v := Integer(u);
    v := v * 2;
  end fer;
  type E = enumeration(a, b, c);
  E e1;
  Real y;
equation
  e1 = if time > 0.5 then E.a else E.b;
  y = fer(e1) + fer(E.c);
end LfaZ_enum_arg;
//// model: LfaZ_disc_bnd
model LfaZ_disc_bnd
  Integer k = sign(time - 0.5);
  Boolean c = sin(time) > 0;
  Real y;
equation
  y = sin(time) + sign(time - 0.5);
end LfaZ_disc_bnd;
//// model: LfaZ_bnd_init
model LfaZ_bnd_init
  parameter Real p = 0.5;
  Real x(start = 1, fixed = true);
  Real y = cos(time) + sin(p);
equation
  der(x) = -x;
end LfaZ_bnd_init;
//// model: LfaZ_bnd_init2
model LfaZ_bnd_init2
  parameter Real p = 0.5;
  Real x;
  Real y = cos(time) + sin(p);
initial equation
  x = sin(p) + cos(time);
equation
  der(x) = -x;
end LfaZ_bnd_init2;
//// model: LfaZ_init_twice
model LfaZ_init_twice
  parameter Real p = 0.5;
  Real x;
  Real y;
initial equation
  x = sin(p) + cos(p);
  y = cos(p) * sin(p);
equation
  der(x) = -x;
  der(y) = -y;
end LfaZ_init_twice;
//// model: LfaZ_init_many14
model LfaZ_init_many14
  parameter Real p = 0.5;
  Real x0;
  Real x1;
  Real x2;
  Real x3;
  Real x4;
  Real x5;
  Real x6;
  Real x7;
  Real x8;
  Real x9;
  Real x10;
  Real x11;
  Real x12;
  Real x13;
initial equation
  x0 = cos(1 * p) + sin(1 * time);
  x1 = cos(2 * p) + sin(2 * time);
  x2 = cos(3 * p) + sin(3 * time);
  x3 = cos(4 * p) + sin(4 * time);
  x4 = cos(5 * p) + sin(5 * time);
  x5 = cos(6 * p) + sin(6 * time);
  x6 = cos(7 * p) + sin(7 * time);
  x7 = cos(8 * p) + sin(8 * time);
  x8 = cos(9 * p) + sin(9 * time);
  x9 = cos(10 * p) + sin(10 * time);
  x10 = cos(11 * p) + sin(11 * time);
  x11 = cos(12 * p) + sin(12 * time);
  x12 = cos(13 * p) + sin(13 * time);
  x13 = cos(14 * p) + sin(14 * time);
equation
  der(x0) = -sin(1 * time);
  der(x2) = -sin(3 * time);
  der(x4) = -sin(5 * time);
  der(x6) = -sin(7 * time);
  der(x8) = -sin(9 * time);
  der(x10) = -sin(11 * time);
  der(x12) = -sin(13 * time);
  der(x1) = -x1;
  der(x3) = -x3;
  der(x5) = -x5;
  der(x7) = -x7;
  der(x9) = -x9;
  der(x11) = -x11;
  der(x13) = -x13;
end LfaZ_init_many14;
//// model: LfaZ_init_many15
model LfaZ_init_many15
  parameter Real p = 0.5;
  Real x0;
  Real x1;
