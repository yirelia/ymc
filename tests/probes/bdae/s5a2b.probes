//// model: LfaU_f2_nested
model LfaU_f2_nested
  function f2
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
    v := v + 1;
  end f2;
  function f1
    input Real u;
    output Real v;
  algorithm
    v := u * 2;
  end f1;
  parameter Real p = 2;
  Real y;
  Integer n;
  Integer m;
  Boolean b;
  String s;
equation
  m = integer(time * 4);
  n = 0;
  b = false;
  s = "";
  y = f2(f1(time)) + f1(f2(time));
end LfaU_f2_nested;
