  function f
    input Real u;
    output Real v;
  algorithm
    v := u + 1;
  end f;
  function g
    input Real u;
    output Real v1;
    output Real v2;
  algorithm
    v1 := u;
    v2 := u + 1;
  end g;
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  function b2
    input Real u;
    output Boolean v;
  algorithm
    v := u > 0;
  end b2;
  type E = enumeration(a, b, c);
  parameter Real p = 0.5, q = 1.5;
  parameter Integer k = 2;
  parameter Boolean t = true, ff = false;
  Real x, y, z, w;
  Real s(start = 1, fixed = true), s2(start = 2, fixed = true);
  Integer n, m;
  Boolean b, c;
  String st;
  E e;
algorithm
  if time > 1 then
    y := 1;
  elseif st == "a" then
    y := 2;
  else
    y := 3;
  end if;
end LwcC017e;
