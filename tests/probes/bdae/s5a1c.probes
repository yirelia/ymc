  Real y(start = 1);
initial algorithm
  for qr in 1:2 loop
    x := qr;
  end for;
  for alpha in 1:2 loop
    x := alpha;
  end for;
  for r2d2 in 1:2 loop
    x := r2d2;
  end for;
  for omega in 1:2 loop
    x := omega;
  end for;
  for psi in 1:2 loop
