//// model: LwcHWhen
model LwcHWhen
  model A
    Real x, y;
    Real s(start = 1), r(start = 1);
  equation
    der(s) = 1;
    der(r) = 1;
    when time > 1 then
      y = 1;
      x = 2;
      reinit(s, 1);
      reinit(r, 2);
    end when;
  end A;
  A a, b;
end LwcHWhen;
