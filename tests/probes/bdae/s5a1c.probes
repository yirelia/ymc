//// model: LwcHConn
model LwcHConn
  connector P
    Real v;
    flow Real i;
  end P;
  model R
    P a, b;
    parameter Boolean open = false;
  equation
    a.i + b.i = 0;
    if open then
      a.i = 0;
    else
      a.v = b.v;
    end if;
  end R;
  R r1, r2(open = true);
equation
  connect(r1.b, r2.a);
end LwcHConn;
//// model: LwcHIfConnect
model LwcHIfConnect
  connector P
    Real v;
    flow Real i;
  end P;
  parameter Boolean use = true;
  P a, b;
equation
  if use then
    connect(a, b);
  else
    a.v = 0;
    b.v = 0;
  end if;
end LwcHIfConnect;
