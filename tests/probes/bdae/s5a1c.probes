//// model: LwcWR2
model LwcWR2
  Real qr(start = 1);
  Real mu(start = 1);
equation
  der(qr) = 1;
  der(mu) = 1;
  when time > 1 then
    reinit(qr, 0);
    reinit(mu, 1);
  end when;
end LwcWR2;
