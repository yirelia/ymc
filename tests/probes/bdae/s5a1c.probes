  end R;
  model A
    Real x;
  end A;
  Real a[2]; Real x;
algorithm
  x := 1;
  if false then
    a[1] := 1;
  end if;
end LwcOArrAlgDrop;
//// model: LwcOArrAlgDropAll
model LwcOArrAlgDropAll
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real a[0]; Real x;
algorithm
  x := 1;
  if false then
    a := fill(1, 0);
  end if;
end LwcOArrAlgDropAll;
//// model: LwcOArrWhen
model LwcOArrWhen
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real a[2];
equation
  when time > 1 then
    a[1] = 1;
    a[2] = 2;
  end when;
end LwcOArrWhen;
//// model: LwcOArrReinit
model LwcOArrReinit
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real a[2](each start = 1);
equation
  der(a) = {1, 2};
  when time > 1 then
    reinit(a[1], 1);
    reinit(a[2], 2);
  end when;
end LwcOArrReinit;
//// model: LwcORecIf
model LwcORecIf
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  R r;
equation
  if time > 1 then
    r.x = 1;
    r.y = 2;
  else
    r.y = 3;
    r.x = 4;
  end if;
end LwcORecIf;
//// model: LwcORecAlg
model LwcORecAlg
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  R r;
algorithm
  r.x := 1;
  r.y := 2;
end LwcORecAlg;
//// model: LwcORecAlgWhole
model LwcORecAlgWhole
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  R r;
algorithm
  r := R(1, 2);
end LwcORecAlgWhole;
//// model: LwcORecWhen
model LwcORecWhen
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  R r;
equation
  when time > 1 then
    r.x = 1;
    r.y = 2;
  end when;
end LwcORecWhen;
//// model: LwcORecReinit
model LwcORecReinit
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  R r(x(start = 1), y(start = 2));
equation
  der(r.x) = 1;
  der(r.y) = 1;
  when time > 1 then
    reinit(r.x, 1);
    reinit(r.y, 2);
  end when;
end LwcORecReinit;
//// model: LwcORecDrop
model LwcORecDrop
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  R r; Real x;
algorithm
  x := 1;
  if false then
    r.x := 1;
  end if;
end LwcORecDrop;
//// model: LwcOCompArr
model LwcOCompArr
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  A a[2];
equation
  if time > 1 then
    a[1].x = 1;
    a[2].x = 2;
  else
    a[2].x = 3;
    a[1].x = 4;
  end if;
end LwcOCompArr;
//// model: LwcOQuote
model LwcOQuote
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real 'a b'(start = 1), 'c.d'(start = 1), e1(start = 1);
equation
  der('a b') = 1;
  der('c.d') = 1;
  der(e1) = 1;
  when time > 1 then
    reinit('a b', 1);
    reinit('c.d', 2);
    reinit(e1, 3);
  end when;
end LwcOQuote;
//// model: LwcOQuoteIf
model LwcOQuoteIf
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real 'a b', 'c.d', e1;
equation
  if time > 1 then
    'a b' = 1;
    'c.d' = 2;
    e1 = 3;
  else
    e1 = 4;
    'c.d' = 5;
    'a b' = 6;
  end if;
end LwcOQuoteIf;
//// model: LwcOQuoteIter
model LwcOQuoteIter
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real x;
algorithm
  for 'i j' in 1:2 loop
    x := 'i j';
  end for;
  for k in 1:2 loop
    x := k;
  end for;
end LwcOQuoteIter;
//// model: LwcOExtObj
model LwcOExtObj
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Real x;
equation
  if time > 1 then
    x = 1;
  else
    x = 2;
  end if;
end LwcOExtObj;
//// model: LwcOClockIf
model LwcOClockIf
  record R
    Real x, y;
  end R;
  model A
    Real x;
  end A;
  Clock cl = Clock(0.1); Real x;
equation
  if time > 1 then
    x = 1;
  else
    x = 2;
  end if;
end LwcOClockIf;
//// model: LwcXBoth
model LwcXBoth
  Real y, z;
equation
  when time > 1 then
    y = 1;
  end when;
algorithm
  when time > 2 then
    z := 2;
  end when;
end LwcXBoth;
//// model: LwcXWhenElse
model LwcXWhenElse
  Real y;
  Boolean b;
algorithm
  when time > 1 then
    if b then
      y := 1;
    else
      y := 2;
    end if;
  elsewhen time > 2 then
    y := 3;
  end when;
equation
  b = time > 3;
end LwcXWhenElse;
//// model: LwcXNumber
model LwcXNumber
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real a, b, c, d, e, f;
  Integer n;
  Real s(start = 1), r(start = 2);
initial equation
  if time > 1 then
    a = 1;
    b = 2;
  end if;
  h(a);
initial algorithm
  c := 1;
equation
  der(s) = 1;
  der(r) = 1;
  if time > 2 then
    e = 1;
    if time > 3 then
      f = 1;
      n = 1;
    else
      n = 2;
      f = 2;
    end if;
  else
    e = 2;
    n = 3;
    f = 3;
  end if;
  when time > 4 then
    reinit(s, 1);
    reinit(r, 2);
    d = 1;
  end when;
  h(e);
algorithm
  a := 1;
algorithm
  h(a);
end LwcXNumber;
