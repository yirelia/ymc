model LwcItn33
  Real x;
algorithm
  for qr in 1:2 loop
    for mu in 1:qr loop
      for alpha in 1:mu loop
        for zeta9 in 1:alpha loop
          for r2d2 in 1:zeta9 loop
            for kappa in 1:r2d2 loop
              for omega in 1:kappa loop
                for nu0 in 1:omega loop
                  for psi in 1:nu0 loop
                    for tau7 in 1:psi loop
                      for beta in 1:tau7 loop
                        for gamma3 in 1:beta loop
                          x := gamma3;
                        end for;
                      end for;
                    end for;
                  end for;
                end for;
              end for;
            end for;
          end for;
        end for;
      end for;
    end for;
  end for;
end LwcItn33;
