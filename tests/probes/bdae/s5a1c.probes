//// set: s5a1c — S5a-1c：lower 收 [-IF-]、[ALGO]、顶层无返回值调用、多赋值 when。Lwc 前缀，走 tools/bdae_sweep.py --probes。LwcC* / LwcE*：条件、表达式 × 位置；LwcS* / LwcT*：sortForSplit 的排序和相同左边；LwcI*：if 的结构（嵌套、when、assert、无 else、分支不齐）；LwcP*：结构条件；LwcA*：语句形状；LwcZ* / LwcH*：多段、继承、实例；LwcD*：算法 when 的隐式离散；LwcW*：多赋值 when（跨 rehash 规模）；LwcIt* / LwcJ*：迭代量的桶序；LwcN*：顶层无返回值调用。
//// model: LwcC000a
model LwcC000a
  function f
    input Real u;
    output Real v;
  algorithm
    v := u + 1;
  end f;
  function g
    input Real u;
    output Real v1;
    output Real v2;
  algorithm
    v1 := u;
    v2 := u + 1;
  end g;
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  function b2
    input Real u;
    output Boolean v;
  algorithm
    v := u > 0;
  end b2;
  type E = enumeration(a, b, c);
  parameter Real p = 0.5, q = 1.5;
  parameter Integer k = 2;
  parameter Boolean t = true, ff = false;
  Real x, y, z, w;
  Real s(start = 1, fixed = true), s2(start = 2, fixed = true);
  Integer n, m;
  Boolean b, c;
  String st;
  E e;
equation
  if time > 1 then
    y = 1;
  else
    y = 2;
  end if;
end LwcC000a;
