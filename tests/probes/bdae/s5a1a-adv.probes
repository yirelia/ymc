//// set: s5a1a-adv — S5a-1a 评审时主代理手写的对抗形状（不来自 s5a1a 的生成器）。X* / Y*：表达式打印与 combineBinaries（负字面量、幂、if、字面量版式、内建调用，方程与绑定各一份）、声明前缀与属性、枚举、层次、连接、函数调用。比对走 tools/bdae_sweep.py --probes。
//// model: XRe1
model XRe1
  Real a = time, b = 2 * time, c = 3 * time, d = 4 * time;
  Integer i = integer(time), j = 2, k = 3;
  Boolean p = time > 1, q = time > 2, r = time > 3;
  parameter Real pa = 2, pb = 3;
  Real y;
equation
  y = -(a + b);
end XRe1;
//// model: XRb1
model XRb1
  Real a = time, b = 2 * time, c = 3 * time, d = 4 * time;
  Integer i = integer(time), j = 2, k = 3;
  Boolean p = time > 1, q = time > 2, r = time > 3;
  parameter Real pa = 2, pb = 3;
  Real y = -(a + b);
end XRb1;
