//// model: XC2
model XC2
  connector P Real v; flow Real i; end P;model T P l, r; equation l.i + r.i = 0; l.v = r.v; end T;T t1, t2, t3;equation connect(t1.r, t2.l);connect(t2.r, t3.l);t1.l.v = 1;t3.r.i = 1;
end XC2;
//// model: XC3
model XC3
  connector P Real v; flow Real i; end P;P a, b, c;equation connect(a, b);connect(b, c);a.v = 1;a.i = 1;b.i = 2;
end XC3;
//// model: XC4
model XC4
  connector F Real p; flow Real m; stream Real h; end F;model S F a, b; equation a.m + b.m = 0; a.p = b.p; a.h = inStream(b.h); b.h = inStream(a.h); end S;S s1, s2;equation connect(s1.b, s2.a);s1.a.p = 1;s1.a.m = 1;s1.a.h = 2;s2.b.h = 3;s2.b.p = 1;
end XC4;
//// model: XC5
model XC5
  connector I = input Real;connector O = output Real;model S I u; O y; equation y = u; end S;S a, b;equation connect(a.y, b.u);a.u = 1;
end XC5;
//// model: XQ1
model XQ1
  Real x, y;equation der(x) = -x;der(y) = x + y;initial equation x = 1;y = 2 * x;
end XQ1;
//// model: XQ2
model XQ2
  Real x;equation der(x) + der(x) = 1;
end XQ2;
//// model: XQ3
model XQ3
  Real x, y;equation der(2 * x) = 1;der(x + y) = 2;
end XQ3;
//// model: XQ4
model XQ4
  Real x, y;equation x = y;0 = x + y;
end XQ4;
//// model: XQ5
model XQ5
  Real x, y;equation x + y = 0;1 = x - y;
end XQ5;
//// model: XQ6
model XQ6
  Integer i;Boolean b;String s;equation i = 1;b = true;s = "a";
end XQ6;
//// model: XQ7
model XQ7
  Real x;equation x = 1;x = 2;
end XQ7;
//// model: XQ8
model XQ8
  Real x, y;equation x = 1;
end XQ8;
//// model: XQ9
model XQ9
  Real x;equation 0 = 0;x = 1;
end XQ9;
//// model: XQ10
model XQ10
  Real x;Integer i;equation i = 1;x = i;
end XQ10;
//// model: XQ11
model XQ11
  Real x;Boolean b;equation b = x > 1;x = time;
end XQ11;
//// model: XQ12
model XQ12
  Real x;initial equation x = 1;pre(x) = 2;equation x = time;
end XQ12;
//// model: XQ13
model XQ13
  Real x;Integer i;equation der(x) = 1;i = 1;initial equation i = 2;x = 2 + i + 1;
end XQ13;
//// model: XQ14
model XQ14
  Real x(start = 1);Real y(start = 2, fixed = true);equation der(x) = y;der(y) = -x;
end XQ14;
//// model: XF1
function f input Real x; output Real y; algorithm y := x; end f;model XF1 Real a = time; Real y = f(a + a + a); Real z; equation z = f(a * a * a); end XF1;
//// model: XF2
function f input Real x; input Real k = 2; output Real y; algorithm y := x * k; end f;model XF2 Real a = time; Real y = f(a); Real z = f(a, 3); Real w = f(k = 4, x = a); end XF2;
//// model: XF4
package P function f input Real x; output Real y; algorithm y := x; end f; end P;model XF4 Real y = P.f(time); end XF4;
//// model: XF5
function f input Real x; output Real y; external "C" y = sin(x); end f;model XF5 Real y = f(time); end XF5;
//// model: XF6
function f input Real x; output Real y; algorithm y := x; annotation(Inline = true); end f;model XF6 Real y = f(time) + 1; end XF6;
//// model: XF7
function f input Integer n; output Real y = n; end f;model XF7 Real y = f(3); parameter Real p = f(2); constant Real c = f(1); end XF7;
//// model: XT1
block XT1
  Real x;
end XT1;
//// model: XT2
class XT2
  Real x;
end XT2;
//// model: XT3
connector XT3
  Real x;
end XT3;
//// model: XT4
record XT4
  Real x;
end XT4;
//// model: YRe1
model YRe1
  Real a = time, b = 2 * time, c = 3 * time, d = 4 * time;
  Integer i = integer(time), j = 2, k = 3;
  Boolean p = time > 1, q = time > 2, r = time > 3;
  Real y;
equation
  y = a * (-b);
end YRe1;
