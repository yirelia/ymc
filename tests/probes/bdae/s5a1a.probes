//// model: LwaVConn10
model LwaVConn10
  connector C
    Real v;
    flow Real i;
  end C;
  model M
    C p, n;
  equation
    p.v - n.v = p.i;
    p.i + n.i = 0;
  end M;
  M a, b, c, d;
equation
  connect(a.n, b.p);
  connect(b.p, c.p);
  connect(c.p, d.p);
  connect(a.p, d.n);
end LwaVConn10;
//// model: LwaVConn11
model LwaVConn11
  connector I = input Real;
  connector O = output Real;
  block B
    I u;
    O y;
  equation
    y = 2 * u;
  end B;
  B a, b;
  I x;
  O z;
equation
  connect(x, a.u);
  connect(a.y, b.u);
  connect(b.y, z);
end LwaVConn11;
