//// set: s5a1a — S5a-1a：lower 与 `(After Lowering)` 的兄弟形态。Lwa 前缀；与 omc 1.25.0 的比对走 tools/bdae_sweep.py --probes（这个包在 tests/probes/bdae/ 下，probe_recheck 不递归，压平门不看它）。LwaC*：表达式链 × 外层包裹（方程右边、绑定、start 属性各一份）；LwaT*：打印；LwaV*：变量声明；LwaE*：方程。
//// model: LwaC00n
model LwaC00n
  parameter Real a = 1.5, b = 2.5, c = 3.5, d = 4.5;
  parameter Integer i = 1, j = 2, k = 3;
  Boolean u = time > 0.5, v = time > 0.7;
  Real e(start = a + b);
  Real f = a + b;
  Real g;
equation
  g = a + b;
end LwaC00n;
