//// model: LwaTStr4
model LwaTStr4
  function f
    input Real x;
    output String s;
  algorithm
    s := "v";
  end f;
  Real x = time;
  String a = f(x) + "a" + f(x + 1 + 2);
  String b = "a" + f(x * 2 * 3);
end LwaTStr4;
//// model: LwaTEnum0
model LwaTEnum0
  type E = enumeration(one, two, three);
  E x = E.one;
  parameter E p = E.two;
  constant E c = E.three;
  E y;
  Boolean b = x == E.two;
  Integer i = Integer(x);
  String s = String(x);
equation
  y = if b then E.one else E.three;
end LwaTEnum0;
//// model: LwaTTime0
model LwaTTime0
  Real x = time;
  Real y = time + 1;
  Real z = 2 * time * time;
  Real w = sin(time) + time + 1;
end LwaTTime0;
//// model: LwaTDer0
model LwaTDer0
  Real x, y, z, w;
equation
  der(x) = -x;
  der(y) + x = 1;
  z = der(x + y);
  w = der(2 * x * y);
end LwaTDer0;
//// model: LwaTDer1
model LwaTDer1
  Real x(start = 1, fixed = true);
  Real y;
equation
  der(x) = x + y + 1;
  y = der(x) * 2 + der(x) * der(x);
end LwaTDer1;
//// model: LwaTPre0
model LwaTPre0
  Integer i;
  Boolean b;
  Real y;
  Integer j = pre(i);
equation
  y = pre(i) + 1;
  b = pre(b) or time > 1;
end LwaTPre0;
//// model: LwaTCall0
model LwaTCall0
  Real x = time;
  Real a = abs(x) + sign(x) + sqrt(x);
  Real b = sin(x) + cos(x) + tan(x);
  Real c = asin(x) + acos(x) + atan(x);
  Real d = sinh(x) + cosh(x) + tanh(x);
  Real e = exp(x) + log(x) + log10(x);
  Real f = atan2(x, 1.0);
end LwaTCall0;
//// model: LwaTCall1
model LwaTCall1
  Real x = time;
  Real a = ceil(x);
  Real b = floor(x);
  Integer c = integer(x);
  Real d = mod(x, 2.0);
  Real e = rem(x, 2.0);
  Real f = div(x, 2.0);
  Real g = min(x, 1.0);
  Real h = max(x, 1.0);
  Integer i = mod(3, integer(x));
end LwaTCall1;
//// model: LwaTCall2
model LwaTCall2
  Real x = time;
  Boolean b = time > 1;
  Real a = noEvent(x);
  Real c = smooth(1, x);
  Boolean d = initial();
  Boolean e = terminal();
  Boolean f = edge(b);
  Boolean g = change(b);
  Real h = delay(x, 1.0);
  Real i = delay(x, 1.0, 2.0);
  Real j = homotopy(x, 2.0 * x);
  Real k = semiLinear(x, 1.0, 2.0);
end LwaTCall2;
//// model: LwaTCall3
model LwaTCall3
  Boolean a = sample(0, 1);
  Boolean b = sample(0.5, 1.5);
  Real x = time;
  Real y = if sample(0, 1) then 1 else 2;
end LwaTCall3;
//// model: LwaTCall4
model LwaTCall4
  function f
    input Real a;
    input Real b = 2;
    input Real c = a + 1;
    output Real y;
  algorithm
    y := a + b + c;
  end f;
  Real x = time;
  Real a = f(x);
  Real b = f(x, 3);
  Real c = f(x, c = 4);
  Real d = f(b = 5, a = x);
  Real e = f(x + 1 + 2, x * 2 * 3, x - 1 - 2);
end LwaTCall4;
//// model: LwaTCall5
model LwaTCall5
  function g
    input Integer n;
    input Boolean b = true;
    input String s = "d";
    output Integer y;
  algorithm
    y := n;
  end g;
  Integer i = integer(time);
  Integer a = g(i);
  Integer b = g(i, false);
  Integer c = g(i, s = "x");
end LwaTCall5;
//// model: LwaTCall6
model LwaTCall6
  package P
    function h
      input Real x;
      output Real y = x;
    end h;
  end P;
  function e
    input Real x;
    output Real y;
    external "C" y = sin(x);
  end e;
  Real x = time;
  Real a = P.h(x);
  Real b = e(x);
  Real c = sin(P.h(x + 1 + 2));
end LwaTCall6;
//// model: LwaTCall7
model LwaTCall7
  function f2
    input Real x;
    output Real a;
    output Real b;
  algorithm
