    b := x;
  end f2;
  Real x = time;
  Real a = f2(x);
end LwaTCall7;
//// model: LwaTCast0
model LwaTCast0
  parameter Integer i = 1, j = 2;
  Real x = i;
  Real y = i + 0.5;
  Real z = sin(i);
  Real w = (i + j) * 0.5;
  Real v = -i;
  Real u = i * j;
  Real t = i / j;
  Real s = i ^ j;
end LwaTCast0;
//// model: LwaTCast1
model LwaTCast1
  parameter Integer i = 1, j = 2;
  Boolean b = time > 1;
  Real x = if b then i else 0.5;
  Real y = if b then i else j;
  Real z;
  Real w;
equation
  z = i;
  w = i + j;
end LwaTCast1;
//// model: LwaTCast2
model LwaTCast2
  Integer i = integer(time);
  Real x;
  Real y;
  Real z;
equation
  x = i;
  i = y;
  z + i = 1;
end LwaTCast2;
//// model: LwaTParen0
model LwaTParen0
  Real a = time, b = 2, c = 3;
  Boolean u = time > 1;
  Real x = (if u then a else b) + c;
  Real y = c + (if u then a else b);
  Real z = (if u then a else b) * c;
  Real w = -(if u then a else b);
  Real v = (if u then a else b) ^ c;
  Real t = sin(if u then a else b);
end LwaTParen0;
//// model: LwaTParen2
model LwaTParen2
  Real a = time, b = 2, c = 3, d = 4;
  Boolean u = time > 1, v = time > 2;
  Real x = if a + b + c > d then a + b + c else if v then a * b * c else a - b - c;
  Real y;
  Real z = sin(if u then a + b + c else a * b * c);
equation
  y = if a + b + c > d then a + b + c elseif v then a * b * c else a - b - c;
end LwaTParen2;
//// model: LwaTParen3
model LwaTParen3
  Real a = time, b = 2;
  Boolean u = (a < b) == (b < a);
end LwaTParen3;
//// model: LwaTRel0
model LwaTRel0
  String s = "a";
  Boolean x = s == "a";
  Boolean y = s <> "b" and s < "c";
  Boolean z = false < true;
  type E = enumeration(p, q);
  E e = E.p;
  Boolean w = e < E.q;
  Integer i = 1;
  Boolean v = i + 1 + 2 == 3;
end LwaTRel0;
//// model: LwaTStream0
model LwaTStream0
