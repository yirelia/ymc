//// model: LwaESimp0
model LwaESimp0
  Real a = time;
  Real b = a + 0;
  Real c = a * 1;
  Real d = 0 + a;
  Real e = 1 * a;
  Real f = a * 0;
  Real g = a - 0;
  Real h = a / 1;
  Real i = a ^ 1;
  Real j = a ^ 0;
end LwaESimp0;
//// model: LwaESimp1
model LwaESimp1
  Real a = time;
  Real b = -(-a);
  Real c = 2 + 3;
  Real d = 2 * 3 + a;
  Real e = a + 2 * 3;
  Real f = 1 + 2 + a + 3 + 4;
  Boolean g = not (not (a > 1));
end LwaESimp1;
