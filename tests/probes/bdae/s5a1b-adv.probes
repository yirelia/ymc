//// model: Wc17
model Wc17
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
