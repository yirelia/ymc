//// model: Wc28
model Wc28
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when i == 2 then
    w = 1;
  end when;
end Wc28;
//// model: Wr28
model Wr28
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when i == 2 then
    reinit(s, 0);
  end when;
  w = 1;
end Wr28;
