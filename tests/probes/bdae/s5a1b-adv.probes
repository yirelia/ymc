//// set: s5a1b-adv — S5a-1b 评审时主代理手写的对抗形状（不来自 s5a1b 的生成器）。Wc / Wr / Wv：when 条件与赋值右端；WB：elsewhen、reinit、terminate 混排；Wa / Wi：assert；WM：编号与入桶混排；Wt：变量种类与层次；Wq：每支都赋值、reinit 只在部分分支，专测 acc_condition 泄漏。比对走 tools/bdae_sweep.py --probes。
//// model: Wc0
model Wc0
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when time > 1 then
    w = 1;
  end when;
end Wc0;
//// model: Wr0
model Wr0
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when time > 1 then
    reinit(s, 0);
  end when;
  w = 1;
end Wr0;
//// model: Wc1
model Wc1
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when x > 1 and y < 2 then
    w = 1;
  end when;
end Wc1;
