model WqS130
  Real x = time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when true then
    w = 1;
  elsewhen e then
    w = 2;
    reinit(s, 0);
  end when;
end WqS130;
