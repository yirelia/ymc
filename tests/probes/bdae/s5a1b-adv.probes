//// model: WtT1
model WtT1
  Integer g; equation when time > 1 then g = 1; end when;
end WtT1;
//// model: WtT2
model WtT2
  Boolean g; equation when time > 1 then g = true; end when;
end WtT2;
//// model: WtT3
model WtT3
  String g; equation when time > 1 then g = "a"; end when;
end WtT3;
//// model: WtT4
model WtT4
  type E = enumeration(u, v); E g; equation when time > 1 then g = E.v; end when;
end WtT4;
//// model: WtT5
model WtT5
  Real g(start = 1); equation when time > 1 then g = 1; end when;
end WtT5;
//// model: WtT6
model WtT6
  Real g(start = 1, fixed = true); equation when time > 1 then g = pre(g) + 1; end when;
end WtT6;
//// model: WtT7
model WtT7
  Real g(min = 0, max = 1, nominal = 2); equation when time > 1 then g = 1; end when;
end WtT7;
//// model: WtT8
model WtT8
  output Real g; equation when time > 1 then g = 1; end when;
end WtT8;
//// model: WtT9
model WtT9
  protected Real g; equation when time > 1 then g = 1; end when;
end WtT9;
//// model: WtT10
model WtT10
  discrete Real g; equation when time > 1 then g = 1; end when;
end WtT10;
//// model: WtT11
model WtT11
  discrete Real g(start = 2); equation when time > 1 then g = pre(g); end when;
end WtT11;
//// model: WtT12
model WtT12
  Real g(stateSelect = StateSelect.always); equation when time > 1 then g = 1; end when;
end WtT12;
//// model: WtT13
model WtT13
  Real g(stateSelect = StateSelect.prefer); equation when time > 1 then g = 1; end when;
end WtT13;
//// model: WtT14
model WtT14
  final Real g; equation when time > 1 then g = 1; end when;
end WtT14;
//// model: WtT15
model WtT15
  model S Real g; Boolean t = time > 1; equation when t then g = 1; end when; end S; S a, b;
end WtT15;
//// model: WtT16
model WtT16
  model B Real g; equation when time > 1 then g = 1; end when; end B; model D extends B; Real h = g; end D; D d;
end WtT16;
//// model: WtT17
model WtT17
  connector P Real v; flow Real f; end P; P a; Real g; equation a.f = 1; when time > 1 then a.v = 1; end when;
end WtT17;
//// model: WtT18
model WtT18
  Real g, h; equation h = g + 1; when time > 1 then g = 1; end when;
end WtT18;
//// model: WtT19
model WtT19
  Real g; Real h(start = 1); equation der(h) = g; when h > 2 then g = 1; end when;
end WtT19;
//// model: WtT20
model WtT20
  Real h(start = 1); Real v(start = 0); equation der(h) = v; der(v) = -9.81; when h < 0 then reinit(v, -0.9 * pre(v)); end when;
end WtT20;
//// model: WtT21
model WtT21
  function f input Real u; algorithm assert(u > 0, "z"); end f; Real g; equation when time > 1 then g = 1; f(g); end when;
end WtT21;
//// model: WtT22
model WtT22
  function f input Real u; algorithm assert(u > 0, "z"); end f; Real g = 1; equation when time > 1 then f(g); end when;
end WtT22;
//// model: WtT23
model WtT23
  parameter Boolean f = false; Real g; equation if f then when time > 1 then g = 1; end when; else g = 2; end if;
end WtT23;
//// model: WtT24
model WtT24
  parameter Boolean f = true; Real g; equation if f then when time > 1 then g = 1; end when; else g = 2; end if;
end WtT24;
//// model: WqS100
model WqS100
  Real x = time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Real s(start = 1, fixed = true);
  Real w;
equation
  der(s) = 1;
  when b then
    w = 1;
  elsewhen e then
    w = 2;
    reinit(s, 0);
  end when;
end WqS100;
//// model: WqS101
model WqS101
