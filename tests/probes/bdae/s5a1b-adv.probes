//// model: WM1
model WM1
  parameter Real p = 1, q = 2;
  Real x = time, y = 2 * time, z = 3 * time;
  Boolean b = time > 1, c = time > 2, e = time > 3;
  Integer i = integer(time);
  Real s(start = 1, fixed = true);
  Real w;
  Integer i2, k;
  Real r2;
equation
  der(s) = 1;
  w = x;
  when b then
    i2 = 1;
  end when;
  assert(x > 0, "a");
  k = 1;
  when c then
    r2 = 2;
  end when;
  assert(y > 0, "b");
end WM1;
