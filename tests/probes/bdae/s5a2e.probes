//// model: LalT_intneg
model LalT_intneg
  Integer i(min = 0, max = 3), j(min = -1, max = 5);
equation
  i = -j;
  j = integer(time);
end LalT_intneg;
//// model: LalT_boolfixed
model LalT_boolfixed
  Boolean a, b(start = true, fixed = true);
equation
  a = b;
  b = time > 1;
end LalT_boolfixed;
//// model: LalT_discfixed
model LalT_discfixed
  discrete Integer n(start = 0, fixed = true);
  Integer m;
equation
  m = n;
  when time > 1 then
    n = pre(n) + 1;
  end when;
end LalT_discfixed;
//// model: LalT_discfixed2
model LalT_discfixed2
  discrete Integer n;
  Integer m(start = 2, fixed = true);
equation
  n = m;
  when time > 1 then
    m = pre(m) + 1;
  end when;
end LalT_discfixed2;
//// model: LalT_tearing
model LalT_tearing
  Real a annotation(__OpenModelica_tearingSelect = TearingSelect.prefer);
  Real b(start = 1) annotation(__OpenModelica_tearingSelect = TearingSelect.avoid);
equation
  a = b;
  b = sin(time);
end LalT_tearing;
//// model: LalT_maxonly
model LalT_maxonly
  Real a(max = 2), b(max = 3);
equation
  a = -b;
  b = sin(time);
end LalT_maxonly;
//// model: LalT_minmaxpar
model LalT_minmaxpar
  parameter Real p = 1;
  Real a(min = 0, max = p), b(min = -p, max = 10);
equation
  a = b + 1;
  b = sin(time);
end LalT_minmaxpar;
//// model: LalT_fixedequal
model LalT_fixedequal
  Real a(start = 2, fixed = true), b(start = 1, fixed = true);
equation
  a = 2 * b;
  der(a) = -a;
end LalT_fixedequal;
//// model: LalT_startdiff
model LalT_startdiff
  Real a(start = 2), b(start = 3), c(start = 4, fixed = true);
equation
  a = b;
  b = c;
  der(a) = -a;
end LalT_startdiff;
//// model: LalC_preconst
model LalC_preconst
  Integer i(start = 0), j;
equation
  i = 3;
  when time > 1 then
    j = pre(i) + 1;
  end when;
end LalC_preconst;
//// model: LalC_prechain
model LalC_prechain
  Integer i, j, k;
equation
  i = j;
  j = k;
  k = 3;
  when time > 1 then
    j = pre(i);
  end when;
end LalC_prechain;
//// model: LalC_enumconst
model LalC_enumconst
  type E = enumeration(x, y);
  E a, b;
  Real r;
equation
  a = b;
  r = time;
end LalC_enumconst;
//// model: LalC_mixed
model LalC_mixed
  Real a, b, c, d;
  Integer i, j;
equation
  a = b;
  i = j;
  c = d + a;
  j = 4;
  d = sin(time);
  b = cos(time);
end LalC_mixed;
//// model: LalF_int_trunc
model LalF_int_trunc
  Integer k(start = 1, fixed = true);
  Integer m;
equation
  when sample(0, 0.1) then
    k = pre(k) + 1;
  end when;
  m = 2 * k + 1;
end LalF_int_trunc;
//// model: LalF_int_trunc_nopre
model LalF_int_trunc_nopre
  Integer k(start = 1, fixed = true);
  Integer m;
equation
  m = 2 * k + 1;
  k = integer(time);
end LalF_int_trunc_nopre;
//// model: LalF_int_real
model LalF_int_real
  Integer k(start = 1, fixed = true);
  Real m;
equation
  m = 2.0 * k;
  k = integer(time);
end LalF_int_real;
//// model: LalF_int_minmax
model LalF_int_minmax
  Integer k(min = 0, max = 4);
  Integer m;
equation
  m = 3 * k;
  k = integer(time);
end LalF_int_minmax;
//// model: LalF_inf
model LalF_inf
  Real y(start = 1);
  Real z;
equation
  z = 1e308 * 10 * y;
  der(y) = 1 - y;
end LalF_inf;
//// model: LalF_inf_fixed
model LalF_inf_fixed
  Real y(start = 1, fixed = true);
  Real z;
equation
  z = 1e308 * 10 * y;
  der(y) = 1 - y;
end LalF_inf_fixed;
//// model: LalF_int_neg
model LalF_int_neg
  Integer k(start = 2, fixed = true, min = -1, max = 5);
  Integer m;
equation
  m = -k;
  k = integer(time);
end LalF_int_neg;
//// model: LalF_cast1
model LalF_cast1
  Integer i = integer(time);
  Real x, y, z;
equation
  x = i;
  i = y;
  z + i = 1;
end LalF_cast1;
//// model: LalF_cast2
model LalF_cast2
  Integer i = integer(time);
  Real y(start = 3), z(min = 0);
equation
  i = y;
  z + i = 1;
end LalF_cast2;
//// model: LalF_cast3
model LalF_cast3
  Integer i = integer(time);
  Real y, z;
equation
  y = 2 * i;
  z = y - i;
end LalF_cast3;
//// model: LalF_cast4
model LalF_cast4
  Integer i;
  Real y(min = -1, max = 4), z;
equation
  i = integer(time);
  y = i;
  z = -y;
end LalF_cast4;
