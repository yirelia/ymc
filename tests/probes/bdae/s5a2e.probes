//// model: LalE_protected
model LalE_protected
  Real a;
protected
  Real b;
equation
  a = b;
  b = sin(time);
end LalE_protected;
//// model: LalE_depth
model LalE_depth
  model M
    model N
      Real v;
    end N;
    N n;
  end M;
  M m;
  model K
    Real w;
  end K;
  K k;
equation
  m.n.v = k.w;
  k.w = sin(time);
end LalE_depth;
//// model: LalE_initonly
model LalE_initonly
  Real a, b, c;
initial equation
  a = 1;
equation
  der(c) = a;
  a = b;
  b = c + 1;
end LalE_initonly;
//// model: LalE_whencond
model LalE_whencond
  Real a, b;
  Integer n(start = 0, fixed = true);
equation
  a = b;
  b = sin(time);
  when a > 0.5 then
    n = pre(n) + 1;
  end when;
end LalE_whencond;
//// model: LalE_ifcond
model LalE_ifcond
  Real a, b, c, d;
equation
  a = b;
  b = sin(time);
  if a > 0 then
    c = 1;
    d = a;
  else
    c = 2;
    d = -a;
  end if;
end LalE_ifcond;
//// model: LalE_alg_for
model LalE_alg_for
  Real a, b, c;
equation
  a = b;
  b = sin(time);
algorithm
  c := 0;
  for i in 1:3 loop
    c := c + a * i;
  end for;
end LalE_alg_for;
//// model: LalE_par_set
model LalE_par_set
  parameter Real p = 1;
  Real a, b, c;
equation
  a = b + p;
  b = c - p;
  c = sin(time);
end LalE_par_set;
//// model: LalE_par_const
model LalE_par_const
  parameter Real p = 1;
  Real a, b;
equation
  a = b + p;
  b = 2 * p;
end LalE_par_const;
//// model: LalE_neg_chain
model LalE_neg_chain
  Real a, b, c;
equation
  a = -b;
  b = -c;
  c = sin(time);
end LalE_neg_chain;
//// model: LalE_mix_chain
model LalE_mix_chain
  Real a, b, c;
equation
  a = 2 * b;
  b = c + 1;
  c = sin(time);
end LalE_mix_chain;
//// model: LalE_connect
model LalE_connect
  connector P
    Real v;
    flow Real i;
  end P;
  model R
    P p, n;
    Real u, i;
  equation
    u = p.v - n.v;
    0 = p.i + n.i;
    i = p.i;
    u = 2 * i;
  end R;
  R r1, r2;
equation
  connect(r1.n, r2.p);
  connect(r1.p, r2.n);
  r1.p.v = sin(time);
end LalE_connect;
//// model: LalE_pre_const
model LalE_pre_const
  Integer i, j;
equation
  i = 3;
  when time > 1 then
    j = pre(i) + 1;
  end when;
end LalE_pre_const;
//// model: LalE_initial_const
model LalE_initial_const
  Real a, x;
initial equation
  x = a;
equation
  a = 2;
  der(x) = -x;
end LalE_initial_const;
//// model: LalE_der_alias
model LalE_der_alias
  Real x, y, z;
equation
  der(x) = y;
  z = y;
  y = -x;
end LalE_der_alias;
//// model: LalE_two_sets_order
model LalE_two_sets_order
  Real a, b, c, d, e;
equation
  c = d;
  a = b;
  e = c;
  b = sin(time);
  d = cos(time);
end LalE_two_sets_order;
//// model: LalE_cast2
model LalE_cast2
  Real r;
  Integer i;
equation
  i = integer(time);
  r = 2 * i;
end LalE_cast2;
//// model: LalE_nonsimple_both
model LalE_nonsimple_both
  Real a, b, c;
equation
  a = b + c;
  b = sin(time);
  c = cos(time);
end LalE_nonsimple_both;
//// model: LalE_time_only
model LalE_time_only
  Real a, b;
equation
  a = time + 1;
  b = a * a;
end LalE_time_only;
//// model: LalE_stringc
model LalE_stringc
  String s;
  Real x;
equation
  s = "a" + "b";
  x = time;
end LalE_stringc;
//// model: LalE_bindpar
model LalE_bindpar
  parameter Real p = 2;
  Real a = p;
  Real b = a + time;
equation
end LalE_bindpar;
