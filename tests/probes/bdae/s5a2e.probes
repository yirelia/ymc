//// model: LalW_gap_order3
model LalW_gap_order3
  parameter Real p = 2;
  Real x, z, w, v;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 2 * p * 3 then x = 2; end when;
  when false then i = 3; end when;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end LalW_gap_order3;
//// model: LalW_gap_orderok1
model LalW_gap_orderok1
  parameter Real p = 2;
  Real x, z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 2 * p * 3 then x = 2; end when;
  when false then i = 3; end when;
  assert(false, "removed with the when");
  assert(w > 2 * p * 3, "kept");
end LalW_gap_orderok1;
//// model: LalW_gap_orderok2
model LalW_gap_orderok2
  Real z, w;
equation
  w = time;
  when false then z = 1; end when;
  assert(w > 2, "kept");
end LalW_gap_orderok2;
//// model: LalW_gap_orderok3
model LalW_gap_orderok3
  Real z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when false then i = 3; end when;
  assert(false, "removed");
end LalW_gap_orderok3;
//// model: LalW_gap_orderok4
model LalW_gap_orderok4
  Real w;
  Integer i;
equation
  w = time;
  when false then i = 3; end when;
  assert(false, "removed");
end LalW_gap_orderok4;
//// model: LalW_gap_order4
model LalW_gap_order4
  Real x, z, w, v;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 6 then x = 2; end when;
  when false then i = 3; end when;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end LalW_gap_order4;
//// model: LalW_gap_orderok5
model LalW_gap_orderok5
  parameter Real p = 2;
  Real x, z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 2 * p * 3 then x = 2; end when;
  when false then i = 3; end when;
end LalW_gap_orderok5;
//// model: LalW_gap_order5
model LalW_gap_order5
  Real z, w, v;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when false then i = 3; end when;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end LalW_gap_order5;
//// model: LalW_gap_order6
model LalW_gap_order6
  Real z, w, v;
equation
  w = time;
  when false then z = 1; end when;
  when false then v = 1; elsewhen w > 1 then v = 2; end when;
end LalW_gap_order6;
//// model: LalW_gap_order7
model LalW_gap_order7
  Real z, w, v;
equation
  w = time;
  when false then v = 1; elsewhen w > 1 then v = 2; end when;
  when false then z = 1; end when;
end LalW_gap_order7;
//// model: LalW_gap_order1
model LalW_gap_order1
  Real z, w, v;
equation
  w = time;
  when w > 1 then v = 2; end when;
  when false then z = 1; end when;
end LalW_gap_order1;
//// model: LalW_gap_order2
model LalW_gap_order2
  Real z, w, v;
equation
  w = time;
  when false then z = 1; end when;
  when w > 1 then v = 2; end when;
end LalW_gap_order2;
//// model: LalU_Sets
model LalU_Sets
  parameter Real p = 2;
  Real y, x, z, a, b, c, d, e;
equation
  a = b;
  b = c;
  x = z;
  c = 3;
  y = time + c;
  z = sin(time);
  d = 2 * e + p;
  e = -x;
end LalU_Sets;
//// model: LalU_Pre
model LalU_Pre
  Integer i, j, k;
  Real u, v;
equation
  j = i;
  k = j;
  when time > 1 then
    i = pre(k) + pre(j);
  end when;
  v = u;
  u = cos(time);
  assert(v > -2, "v too small");
end LalU_Pre;
//// model: LalU_Attr
model LalU_Attr
  Real a(min = -1, max = 3), b(start = 1, fixed = true, min = 0, max = 2);
  Real c, w(start = 2), q(nominal = 5);
equation
  a = 2 * b;
  der(a) = -a;
  c = -w;
  w = q;
  q = cos(time);
end LalU_Attr;
//// model: LalU_Star
model LalU_Star
  input Real u;
  Real y, s, t, r;
  Real m = sin(r);
equation
  y = u;
  s = t;
  s = r;
  t = cos(time);
  r = y;
end LalU_Star;
//// model: LalU_Self
model LalU_Self
  model M
    Real b(min = 1, start = 2);
  end M;
  M m;
  Real a(max = 9);
  Real c, d;
equation
  a = 17 + 2 * a;
  m.b = a;
  c = -d;
  d = sin(time);
end LalU_Self;
