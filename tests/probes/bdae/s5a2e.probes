//// set: s5a2e — S5a-2e：pre 模块 Alias（NBAlias.aliasDefault NBAlias.mo:209-284、Replacements.simple / applySimple NBReplacements.mo:99-234、Solve.solveBody NBSolve.mo:576-806、AttributeCollector NBAlias.mo:837-1445，v1.25.0）。Lal 前缀，走 tools/bdae_sweep.py --probes s5a2e --stage alias。LalB：基本写法（a = b、-b、2 * b、b + 1、a + b = 0、time、参数、常量、链、星形、环、两个常量、顶层 input / output、Boolean not、Integer、String、pre 例外、removed 不换、绑定方程造的别名、初值方程、der、cast、子组件深度、$FUN）；LalR：替换落在 assert / 初值 / pre / when 左边 / reinit / 算法 / if / 变量绑定；LalS：solveLinear 的各种写法（Integer 截断、除法、减法、参数、双负、not not、Boolean / String / 枚举常量）；LalM：集合合并、常量并入、链式常量、time 链、两个集合；LalA：属性合并（start / fixed 让出、min 取大 max 取小、参数取 max(…)、Integer min 变 Real、nominal、stateSelect、always、fixed 没 start / start 冲突 omc 报错）；LalE：protected、深度、初值、when / if 条件、算法 for、参数链、负链、混合链、连接器（成环）、pre 常量、der、两集合次序、cast、time + 1、String 常量、参数绑定；LalG：写法 14 × 用法 3 × 属性 10 的生成族（gen.py，420 个）；LalD：同一变量两次（a = -a、x = 17 + 2 * x 解出常量，x = x + 1 导数为 0 omc 失败）；LalF：属性折算时 solveBody 解不出代表变量（Integer 的 solveLinear 截断成 0、除以 inf 成 0.0）只回 UNSOLVABLE、拿原右边接着算，LalF_cast：Real / Integer 混合集合里 CAST(Real, 字面量) 的常数按 Ceval 求值；LalT：两个 always、always + fixed、nominal 0 / 负 / 比值、Integer 负号的 min / max、Boolean / 离散 fixed、tearingSelect、只有 max、参数 min / max、fixed 等值、start 冲突；LalC：pre 与常量、pre 与链、枚举、混合类型；LalW：omc 在后面模块崩溃（0xC0000005）时撑大输出拿到完整 Alias 段；LalW_gap：Simplify 1 删掉的 when 变量在 Discrete 桶留空位（S5a-2d Ls1W_order* 的副本），不在桶尾时 omc 打印失败、后面也没有 Alias 段，在桶尾时 Alias 的 removeList 压紧；LalU：单测 alias_test 的四个模型。
//// model: LalB_ab
model LalB_ab
  Real a, b;
equation
  a = b;
  b = sin(time);
end LalB_ab;
//// model: LalB_neg
model LalB_neg
  Real a, b;
equation
  a = -b;
  b = sin(time);
end LalB_neg;
//// model: LalB_neg2
model LalB_neg2
  Real a, b;
equation
  -a = b;
  b = sin(time);
end LalB_neg2;
//// model: LalB_two
model LalB_two
  Real a, b;
equation
  a = 2 * b;
  b = sin(time);
end LalB_two;
//// model: LalB_two2
model LalB_two2
  Real a, b;
equation
  b = 2 * a;
  b = sin(time);
end LalB_two2;
//// model: LalB_plus1
model LalB_plus1
  Real a, b;
equation
  a = b + 1;
  b = sin(time);
end LalB_plus1;
//// model: LalB_sum0
model LalB_sum0
  Real a, b;
equation
  a + b = 0;
  b = sin(time);
end LalB_sum0;
//// model: LalB_time
model LalB_time
  Real a, b;
equation
  a = time;
  b = a + sin(a);
end LalB_time;
//// model: LalB_negtime
model LalB_negtime
  Real a, b;
equation
  a = -time;
  b = a + sin(a);
end LalB_negtime;
//// model: LalB_2time
model LalB_2time
  Real a, b;
equation
  a = 2 * time;
  b = a + sin(a);
end LalB_2time;
//// model: LalB_par
model LalB_par
  parameter Real p = 3;
  Real a, b;
equation
  a = p;
  b = a + sin(time);
end LalB_par;
//// model: LalB_const
model LalB_const
  Real a, b;
equation
  a = 4;
  b = a + sin(time);
end LalB_const;
//// model: LalB_chain
model LalB_chain
  Real a, b, c;
equation
  a = b;
  b = c;
  c = sin(time);
end LalB_chain;
//// model: LalB_star
model LalB_star
  Real a, b, c, d;
equation
  a = b;
  a = c;
  a = d;
  d = sin(time);
end LalB_star;
//// model: LalB_star2
model LalB_star2
  Real a, b, c, d;
equation
  b = a;
  c = a;
  d = a;
  d = sin(time);
end LalB_star2;
//// model: LalB_star3
model LalB_star3
  Real a, b, c, d, e;
equation
  a = b;
  c = d;
  b = c;
  e = d;
  e = sin(time);
end LalB_star3;
//// model: LalB_cstar
model LalB_cstar
  Real a, b, c, d;
equation
  a = b;
  a = c;
  a = d;
  a = 5;
  der(d) = 1;
end LalB_cstar;
//// model: LalB_loop
model LalB_loop
  Real a, b;
equation
  a = b;
  b = a;
end LalB_loop;
//// model: LalB_twoconst
model LalB_twoconst
  Real a, b;
equation
  a = b;
  a = 1;
  b = 1;
end LalB_twoconst;
//// model: LalB_input
model LalB_input
  input Real u;
  Real y;
equation
  y = u;
end LalB_input;
//// model: LalB_input2
model LalB_input2
  input Real u;
  Real y;
equation
  u = y;
end LalB_input2;
//// model: LalB_output
model LalB_output
  output Real y;
  Real x;
equation
  y = x;
  x = sin(time);
end LalB_output;
//// model: LalB_not
model LalB_not
  Boolean a, b;
equation
  a = not b;
  b = time > 1;
end LalB_not;
//// model: LalB_int
model LalB_int
  Integer i, j;
equation
  i = j;
  j = integer(time);
end LalB_int;
//// model: LalB_str
model LalB_str
  String s, t;
equation
  s = t;
  t = String(time);
end LalB_str;
//// model: LalB_pre
model LalB_pre
  Integer i, j;
equation
  i = j;
  when time > 1 then
    j = pre(i) + 1;
  end when;
end LalB_pre;
//// model: LalB_assert
model LalB_assert
  Real a, b;
equation
  a = b;
  b = sin(time);
  assert(a > -2, "a too small");
end LalB_assert;
//// model: LalB_bind
model LalB_bind
  Real a = b;
  Real b, c = a + 1;
equation
  b = sin(time);
end LalB_bind;
//// model: LalB_fixedfalse
model LalB_fixedfalse
  Real a(start = 2, fixed = false);
  Real b;
equation
  a = 4;
  b = a + sin(time);
end LalB_fixedfalse;
//// model: LalB_init
model LalB_init
  Real a, b, x;
initial equation
  a = 1;
equation
  a = b;
  der(x) = b;
  b = sin(time) + x;
end LalB_init;
//// model: LalB_der
model LalB_der
  Real x, y;
equation
  y = x;
  der(x) = -y;
end LalB_der;
//// model: LalB_cast
model LalB_cast
  Real r;
  Integer i;
equation
  r = i;
  i = integer(time);
end LalB_cast;
//// model: LalB_sub
model LalB_sub
  model M
    Real v;
  end M;
  M m;
  Real w;
equation
  w = m.v;
  m.v = sin(time);
end LalB_sub;
//// model: LalB_sub2
model LalB_sub2
  model M
    Real v;
  end M;
  M m;
  Real w;
equation
  m.v = w;
  m.v = sin(time);
end LalB_sub2;
//// model: LalB_fun
model LalB_fun
  Real a, b;
equation
  a = sin(time);
  b = a;
end LalB_fun;
//// model: LalR_assert
model LalR_assert
  Real a, b, c;
equation
  a = b;
  c = sin(time);
  b = c * c;
  assert(b > -2, "b too small");
end LalR_assert;
//// model: LalR_init
model LalR_init
  Real a, b, x;
initial equation
  b = 1;
equation
  a = b;
  der(x) = a;
  a = cos(time) + x;
end LalR_init;
//// model: LalR_pre
model LalR_pre
  Integer i, j;
equation
  j = i;
  when time > 1 then
    i = pre(j) + 1;
  end when;
end LalR_pre;
//// model: LalR_pre2
model LalR_pre2
  Integer i, j, k;
equation
  j = i;
  k = j;
  when time > 1 then
    i = pre(k) + pre(j);
  end when;
end LalR_pre2;
//// model: LalR_whenlhs
model LalR_whenlhs
  discrete Real a;
  Real b;
equation
  b = a;
  when time > 1 then
    a = 2;
  end when;
end LalR_whenlhs;
//// model: LalR_reinit
model LalR_reinit
  Real x, y;
equation
  y = x;
  der(y) = -1;
  when y < 0 then
    reinit(x, 1);
  end when;
end LalR_reinit;
//// model: LalR_algo
model LalR_algo
  Real a, b, c;
equation
  a = b;
  b = sin(time);
algorithm
  c := b + 1;
end LalR_algo;
//// model: LalR_algo2
model LalR_algo2
  Real a, b, c;
equation
  b = a;
  c = sin(time);
algorithm
  b := c + 1;
end LalR_algo2;
//// model: LalR_ifeq
model LalR_ifeq
  Real a, b, c;
equation
  a = b;
  b = sin(time);
  if time > 1 then
    c = b;
  else
    c = 2 * b;
  end if;
end LalR_ifeq;
//// model: LalR_bindline
model LalR_bindline
  Real a, b;
  Real c = sin(b);
equation
  b = a;
  a = cos(time);
end LalR_bindline;
//// model: LalR_bindline2
model LalR_bindline2
  Real a, b;
  Real c = sin(a);
equation
  b = a;
  b = cos(time);
end LalR_bindline2;
