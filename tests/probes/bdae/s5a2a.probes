  parameter Real p = 2;
  parameter Real q = 3;
  parameter Integer k = 2;
  parameter Boolean c = true;
  Real x(start = 1, fixed = true);
  Real y;
  Real w;
  Integer n;
  Integer m;
  Boolean b;
  Boolean d;
  E e;
  E f;
  String s0;
  String s1;
  Real z = if b then -p else 0;
equation
