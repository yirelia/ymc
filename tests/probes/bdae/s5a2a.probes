  type E = enumeration(a, b, c);
  parameter Real p = 2;
  parameter Real q = 3;
  parameter Integer k = 2;
  parameter Boolean c = true;
  Real x(start = 1, fixed = true);
  Real y;
  Real w;
  Integer n;
  Integer m;
  Boolean b;
  Boolean d;
  E e;
  E f;
  String s0;
  String s1;
  Real z1;
  Real z2;
  Real z3 = semiLinear(y + 1 - 1, w, x);
  Real z4 = z3 + (semiLinear(y + 1 - 1, w, x));
equation
  der(x) = -x;
  y = time;
  w = 2 * time;
  n = integer(time);
  m = integer(2 * time);
  b = time > 0.5;
  d = time > 0.7;
  e = if b then E.a else E.b;
  f = if d then E.b else E.c;
  s0 = "x";
  s1 = "y";
  z1 = 1;
  z2 = z3;
end LbnR303b;
