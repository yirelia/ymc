//// set: s5a2a — S5a-2a：pre 模块 Bindings（NBBindings.mo、generateBindingEquation NBEquation.mo:2186-2240、SimplifyExp.simplify NFSimplifyExp.mo:78-133，v1.25.0）。Lbn 前缀，走 tools/bdae_sweep.py --probes --stage bindings。LbnR* / LbnB* / LbnBE* / LbnI* / LbnS* / LbnN*：Real / Boolean / 枚举比较 / Integer / String / 枚举绑定的表达式 × 位置；LbnO*：编号和桶序；LbnV*：变量种类、前缀、属性；LbnP*：层次、修饰、函数；LbnW*：绑定变量又有方程、算法、when、if，过定，常数除零、大数、浮点。
//// model: LbnR000a
model LbnR000a
  type E = enumeration(a, b, c);
  parameter Real p = 2;
  parameter Real q = 3;
  parameter Integer k = 2;
  parameter Boolean c = true;
  Real x(start = 1, fixed = true);
  Real y;
  Real w;
  Integer n;
  Integer m;
  Boolean b;
  Boolean d;
  E e;
  E f;
  String s0;
  String s1;
  Real z = y + 1;
equation
  der(x) = -x;
  y = time;
  w = 2 * time;
  n = integer(time);
  m = integer(2 * time);
  b = time > 0.5;
  d = time > 0.7;
  e = if b then E.a else E.b;
  f = if d then E.b else E.c;
  s0 = "x";
  s1 = "y";
end LbnR000a;
