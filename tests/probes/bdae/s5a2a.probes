  parameter Real p = 2;
  parameter Real q = 3;
  parameter Integer k = 2;
  parameter Boolean c = true;
  Real x(start = 1, fixed = true);
  Real y;
  Real w;
  Integer n;
  Integer m;
  Boolean b;
  Boolean d;
  E e;
  E f;
  String s0;
  String s1;
  Real z1;
  Real z2;
  Real z3 = (y * 2 * 3) ^ 2;
  Real z4 = z3 + ((y * 2 * 3) ^ 2);
equation
