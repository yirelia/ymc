//// model: BdaM5
model BdaM5
  Real x = 1;
  Real y = 2;
  Real z;
equation
  if time > 1 then
    z = x;
  else
    z = y;
  end if;
end BdaM5;
//// model: BdaM6
model BdaM6
  Real x = 1;
  Integer i = 2;
  Real z;
  discrete Real d;
equation
  when time > 1 then
    d = x;
  end when;
  z = d + i;
  assert(z > 0, "z");
end BdaM6;
//// model: BdaM7
model BdaM7
  Boolean b = time > 1;
  Real x;
  Real y = x;
algorithm
  when b then
    x := 1;
  end when;
end BdaM7;
