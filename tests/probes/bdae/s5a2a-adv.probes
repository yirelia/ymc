  function g input Real u; input Real s = 2; output Real v; algorithm v := u * s; end g;
  type E = enumeration(a, b, c);
  parameter Real p = 2;
  parameter Real q = 3;
  parameter Integer n = 4;
  parameter Boolean pb = true;
  parameter E pe = E.b;
  Real y(start = 1);
  Real w;
  Integer j;
  Integer k;
  Boolean b;
  Boolean c;
  Real z = homotopy(y, 2 * y);
equation
  der(y) = 1 - y;
  w = time;
  j = integer(time);
  k = integer(2 * time);
  b = time > 0.5;
  c = y > 1;
end BdaR193;
