//// set: s5a2a-adv — S5a-2a 评审时主代理手写的对抗形状（不来自 s5a2a 的生成器）。BdaR / I / B / S / E：五种类型的绑定式子；BdaD：声明形状（变量种类、前缀、属性、编号桶序、自引用、数组、记录、Clock、别名类型）；BdaM：绑定和方程、算法、when、if、初值方程、层次的混排。比对走 tools/bdae_sweep.py --probes --stage bindings。
//// model: BdaR0
model BdaR0
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; input Real s = 2; output Real v; algorithm v := u * s; end g;
  type E = enumeration(a, b, c);
  parameter Real p = 2;
  parameter Real q = 3;
  parameter Integer n = 4;
  parameter Boolean pb = true;
  parameter E pe = E.b;
  Real y(start = 1);
  Real w;
  Integer j;
  Integer k;
  Boolean b;
  Boolean c;
  Real z = 1 / y;
equation
  der(y) = 1 - y;
  w = time;
  j = integer(time);
  k = integer(2 * time);
  b = time > 0.5;
  c = y > 1;
end BdaR0;
//// model: BdaR1
