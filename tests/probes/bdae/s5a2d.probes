//// set: s5a2d — S5a-2d：pre 模块 Simplify 第一次运行（NBackendDAE.simplify NBackendDAE.mo:386-444、Equation.simplify NBEquation.mo:1652-1767、SimplifyModel.simplifyStatements NFSimplifyModel.mo:289-380，v1.25.0）。Ls1 前缀，走 tools/bdae_sweep.py --probes s5a2d --stage simplify1。Ls1W：when 条件 false / 数组里的 false、elsewhen 顶上来、整条删掉后变量改参数（参数序、Discrete 桶空位时 omc 打不出段：order*）；Ls1I：if 方程并成一条（链、嵌套、左边不等、无 else 的初值 if 换成体）；Ls1E：两边相等 → 0 = 0（Real / Integer / Boolean；枚举、String omc 报错）；Ls1A：算法两遍化简、if 语句剪枝、while / for / assert / when / 元组 / 无返回值调用；Ls1M：和 / 积常数合并、符号、幂、关系、逻辑、if 表达式；Ls1C：内建调用（delay、homotopy、smooth、noEvent、semiLinear 改写、min / max、integer、div）；Ls1N：Early Inline 换进来的体（常数体让条件变字面量、嵌套积不展平）；Ls1B / F / R / T / D：绑定方程、$FUN 方程、removed、reinit、der / pre；Ls1S：semiLinear 在绑定和内联体里；Ls1G：式子模板 × 位置（rhs、lhs、调用实参、if 表达式、when 体与条件、初值、算法、if 方程）的生成族。
//// model: Ls1W_false1
model Ls1W_false1
  Real x, y;
equation
  y = time;
  when false then x = 1; end when;
end Ls1W_false1;
//// model: Ls1W_false2
model Ls1W_false2
  discrete Real x(start = 1, fixed = true);
  Real y;
equation
  y = time;
  when false then x = pre(x) + 1; end when;
end Ls1W_false2;
//// model: Ls1W_false3
model Ls1W_false3
  Integer i;
  Boolean b;
  Real y;
equation
  y = time;
  when false then i = 1; end when;
  when false then b = true; end when;
end Ls1W_false3;
//// model: Ls1W_elsewhen1
model Ls1W_elsewhen1
  Real x, y;
equation
  y = time;
  when false then x = 1; elsewhen time > 1 then x = 2; end when;
end Ls1W_elsewhen1;
//// model: Ls1W_elsewhen2
model Ls1W_elsewhen2
  Real x, y;
equation
  y = time;
  when time > 1 then x = 1; elsewhen false then x = 2; end when;
end Ls1W_elsewhen2;
//// model: Ls1W_two
model Ls1W_two
  Real x, y, z;
equation
  z = time;
  when false then y = 1; end when;
  when false then x = 2; end when;
end Ls1W_two;
//// model: Ls1W_arr1
model Ls1W_arr1
  Real x, y;
equation
  y = time;
  when {false, time > 1} then x = 1; end when;
end Ls1W_arr1;
//// model: Ls1W_arr2
model Ls1W_arr2
  Real x, y;
equation
  y = time;
  when {false, false} then x = 1; end when;
end Ls1W_arr2;
//// model: Ls1W_arr3
model Ls1W_arr3
  Real x, y;
equation
  y = time;
  when {time > 1, false, time > 2} then x = 1; end when;
end Ls1W_arr3;
//// model: Ls1W_reinit1
model Ls1W_reinit1
  Real s(start = 0, fixed = true), y;
equation
  der(s) = 1;
  y = time;
  when false then reinit(s, 1); end when;
end Ls1W_reinit1;
//// model: Ls1W_split1
model Ls1W_split1
  Real x, y, z;
equation
  z = time;
  when false then x = 1; y = 2; end when;
end Ls1W_split1;
//// model: Ls1W_reinit2
model Ls1W_reinit2
  Real s(start = 0, fixed = true), x;
equation
  der(s) = 1;
  when false then x = 1; elsewhen time > 1 then reinit(s, 0); end when;
end Ls1W_reinit2;
//// model: Ls1W_cond1
model Ls1W_cond1
  parameter Real p = 2;
  Real x, y;
equation
  y = time;
  when time > 2 * p * 3 then x = 1 + 2 * p * 3; end when;
end Ls1W_cond1;
//// model: Ls1W_assert1
model Ls1W_assert1
  parameter Real p = 2;
  Real y;
equation
  y = time;
  assert(y > 2 * p * 3, "too small " + String(p));
end Ls1W_assert1;
//// model: Ls1W_init1
model Ls1W_init1
  Real x, y;
equation
  y = time;
  when initial() then x = 1; elsewhen false then x = 2; end when;
end Ls1W_init1;
//// model: Ls1W_use1
model Ls1W_use1
  Real x, y, z;
equation
  y = time;
  z = x + y;
  when false then x = 1; end when;
end Ls1W_use1;
//// model: Ls1I_basic1
model Ls1I_basic1
  Real x;
equation
  if time > 1 then x = 1; else x = 2; end if;
end Ls1I_basic1;
//// model: Ls1I_chain1
model Ls1I_chain1
  Real x;
equation
  if time > 1 then x = 1; elseif time > 2 then x = 2 * time; else x = 3; end if;
end Ls1I_chain1;
//// model: Ls1I_two1
model Ls1I_two1
  Real x, y;
equation
  if time > 1 then x = 1; y = 2; else y = 3; x = 4; end if;
end Ls1I_two1;
//// model: Ls1I_difflhs1
model Ls1I_difflhs1
  Real x;
equation
  if time > 1 then x = 1; else 2 = x; end if;
end Ls1I_difflhs1;
//// model: Ls1I_explhs1
model Ls1I_explhs1
  Real x, y;
equation
  y = time;
  if time > 1 then x + y = 1; else x + y = 2; end if;
end Ls1I_explhs1;
//// model: Ls1I_nested1
model Ls1I_nested1
  Real x;
equation
  if time > 1 then
    if time > 2 then x = 1; else x = 2; end if;
  else
    x = 3;
  end if;
end Ls1I_nested1;
//// model: Ls1I_nested2
model Ls1I_nested2
  Real x, y;
equation
  y = time;
  if time > 1 then
    if time > 2 then x = 1; else 2 = x; end if;
  else
    x = 3;
  end if;
end Ls1I_nested2;
//// model: Ls1I_initnoelse1
model Ls1I_initnoelse1
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  if time > 0 then x = 1; end if;
end Ls1I_initnoelse1;
//// model: Ls1I_initnoelse2
model Ls1I_initnoelse2
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  if time > 0 then x = 1; elseif time > 1 then x = 2; end if;
end Ls1I_initnoelse2;
//// model: Ls1I_initelse1
model Ls1I_initelse1
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  if time > 0 then x = 1; else x = 2 * time * 3; end if;
end Ls1I_initelse1;
//// model: Ls1I_disc1
model Ls1I_disc1
  Integer i;
equation
  if time > 1 then i = 1; else i = 2; end if;
end Ls1I_disc1;
//// model: Ls1I_bool1
model Ls1I_bool1
  Boolean b;
equation
  if time > 1 then b = true; else b = false; end if;
end Ls1I_bool1;
//// model: Ls1I_bool2
model Ls1I_bool2
  Boolean b;
equation
  if time > 1 then b = false; else b = true; end if;
end Ls1I_bool2;
//// model: Ls1I_same1
model Ls1I_same1
  Real x;
equation
  if time > 1 then x = 2 * time; else x = time * 2; end if;
end Ls1I_same1;
//// model: Ls1I_param1
model Ls1I_param1
  parameter Real p = 2;
  Real x;
equation
  if p > 1 then x = time + 1; else x = time - 1; end if;
end Ls1I_param1;
//// model: Ls1E_self1
model Ls1E_self1
  Real x, y;
equation
  x = x;
  y = time;
end Ls1E_self1;
//// model: Ls1E_comm1
model Ls1E_comm1
  Real x, y;
equation
  2 * x = x * 2;
  y = time;
end Ls1E_comm1;
//// model: Ls1E_int1
model Ls1E_int1
  Integer i;
  Real y;
equation
  i = i;
  y = time;
end Ls1E_int1;
//// model: Ls1E_bool1
model Ls1E_bool1
  Boolean b;
  Real y;
equation
  b = b;
  y = time;
end Ls1E_bool1;
//// model: Ls1E_str1
model Ls1E_str1
  String s;
  Real y;
equation
  s = s;
  y = time;
end Ls1E_str1;
//// model: Ls1E_add1
model Ls1E_add1
  Real x, y;
equation
  x + 1 = 1 + x;
  y = time;
end Ls1E_add1;
//// model: Ls1E_init1
model Ls1E_init1
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  x * 2 = 2 * x;
end Ls1E_init1;
//// model: Ls1A_basic1
model Ls1A_basic1
  Real x, y, z;
algorithm
  x := time - 1.0;
  y := 2 * time * 3;
  z := x / 10;
end Ls1A_basic1;
//// model: Ls1A_while1
model Ls1A_while1
  Real x;
  Integer i;
algorithm
  x := 0;
  i := 0;
  while i / 10 < time loop
    i := i + 1;
    x := x + 0.5;
  end while;
end Ls1A_while1;
//// model: Ls1A_if1
model Ls1A_if1
  Real x;
algorithm
  if time > 2 * 3 then
    x := time + 1;
  elseif time < 1 then
    x := time - 1;
  else
    x := 2 * time * 3;
  end if;
end Ls1A_if1;
//// model: Ls1A_assert1
model Ls1A_assert1
  Real x;
algorithm
  x := time + 1;
  assert(x > 2 * 3 * time, "bad");
end Ls1A_assert1;
//// model: Ls1A_when1
model Ls1A_when1
  Real x(start = 0);
algorithm
  when time > 1 + 2 then
    x := pre(x) + 1;
  end when;
end Ls1A_when1;
//// model: Ls1A_for1
model Ls1A_for1
  Real x;
  parameter Integer n = 3;
algorithm
  x := 0;
  for i in 1:n + 1 loop
    x := x + i * 2;
  end for;
end Ls1A_for1;
//// model: Ls1M_ops1
model Ls1M_ops1
  parameter Real p = 2;
  parameter Integer n = 3;
  Real a, b, c, d, e, f, g, h;
equation
  a = 2 * time * 3;
  b = time + 1 + 2;
  c = time / time;
  d = (time + 1) ^ 2;
  e = 2 ^ time * 3 * 4;
  f = -2 * time * 3;
  g = time - 2 - 3;
  h = 1 / (2 * time);
end Ls1M_ops1;
//// model: Ls1M_ops2
model Ls1M_ops2
  parameter Real p = 2;
  parameter Integer n = 3;
  Integer i;
  Real a, b, c, d, e, f, g, h;
equation
  i = n + 1 + 2;
  a = p * 2 / 4;
  b = -(time + 1) * 2;
  c = 2 * time - time * 2;
  d = i * 2 + 0.5;
  e = time * 0.5 * 2;
  f = time + 2 - 2;
  g = 2 * time / 2;
  h = (2 * time) / (4 * p);
end Ls1M_ops2;
//// model: Ls1M_ops3
model Ls1M_ops3
  parameter Real p = 2;
  Real a, b, c, d, e, f;
equation
  a = -time / (-p);
  b = time ^ 2 * 3;
  c = 1.0 / p * time;
  d = time - 1 - time;
  e = (time - 1) * (time + 1) * 2;
  f = time * (-1) * 3;
end Ls1M_ops3;
//// model: Ls1M_rel1
model Ls1M_rel1
  parameter Real p = 2;
  Boolean b1, b2, b3;
  Real x, y, z;
equation
  b1 = time > 2 * 3 * p;
  b2 = time > 1 or p * 2 * 3 > 4;
  b3 = not (time + 1 + 2 > 4);
  x = if time > 1 then 2 * time * 3 else time + 1 + 1;
  y = if p > 2 then time * 2 else 2 * time;
  z = noEvent(if time > 1 then time * 2 * 3 else 3);
end Ls1M_rel1;
//// model: Ls1C_calls1
model Ls1C_calls1
  parameter Real p = 2;
  Real s(start = 1, fixed = true);
  Real a, b, c, d, e, f;
equation
  der(s) = -s * 2 * 3;
  a = sin(2 * time * 3);
  b = delay(time + 1, 1);
  c = homotopy(time * 2 * 3, time);
  d = smooth(1, time * 2 * 3);
  e = noEvent(time * 2 * 3);
  f = abs(time - 1 - 2);
end Ls1C_calls1;
//// model: Ls1C_calls2
model Ls1C_calls2
  parameter Real p = 2;
  Real a, b, c, d;
  Integer i(start = 0, fixed = true);
equation
  a = max(time * 2, 3 * time + 1 + 1);
  b = min(time * 2 * 3, p);
  c = sign(time * 2 * 3);
  i = integer(time * 2 * 3);
  d = pre(i) + 1 + 2;
end Ls1C_calls2;
//// model: Ls1C_semi1
model Ls1C_semi1
  parameter Real p = 2;
  Real a, b;
equation
  a = semiLinear(time, 2 * p * 3, 6 * p);
  b = semiLinear(time - 1 - 1, p, 2 * p);
end Ls1C_semi1;
//// model: Ls1C_user1
model Ls1C_user1
  function f
    input Real u;
    output Real y;
  protected
    Real t;
  algorithm
    t := u * 2;
    y := t + 1;
  end f;
  Real x, z;
equation
  x = f(time * 2 * 3);
  z = f(x + 1 + 2) * 2 * 3;
end Ls1C_user1;
//// model: Ls1N_inl1
model Ls1N_inl1
  function f input Real u; output Real y; algorithm y := u * 2; end f;
  Real x, y, z;
equation
  x = f(time) * 3;
  y = f(time) + 1 + 2;
  z = f(time) * 2 * 3;
end Ls1N_inl1;
//// model: Ls1N_const1
model Ls1N_const1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x, z;
equation
  if f(time) > 0 then x = 1; else x = 2; end if;
  z = if f(time) > 0 then time else -time;
end Ls1N_const1;
//// model: Ls1N_const2
model Ls1N_const2
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x, z;
equation
  z = time;
  when f(time) > 2 then x = 1; end when;
end Ls1N_const2;
//// model: Ls1N_bool1
model Ls1N_bool1
  function g input Real u; output Boolean y; algorithm y := true; end g;
  Boolean b, c;
equation
  b = g(time) and time > 1;
  c = g(time) or time > 1;
end Ls1N_bool1;
//// model: Ls1N_zero1
model Ls1N_zero1
  function f input Real u; output Real y; algorithm y := u - u; end f;
  Real x, z;
equation
  x = 2 * f(time);
  z = f(time) + time;
end Ls1N_zero1;
//// model: Ls1N_alg1
model Ls1N_alg1
  function f input Real u; output Real y; algorithm y := u * 2 + 1; end f;
  Real x, z;
algorithm
  x := f(time) + 1;
  z := f(x) * 2 * 3;
end Ls1N_alg1;
//// model: Ls1N_init1
model Ls1N_init1
  function f input Real u; output Real y; algorithm y := u * 2 + 1; end f;
  Real x(start = 0);
equation
  der(x) = f(x) * 2;
initial equation
  x = f(time) + 1 + 2;
end Ls1N_init1;
//// model: Ls1N_if1
model Ls1N_if1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
initial equation
  if f(time) > 2 then x = 1; else x = 2; end if;
equation
  der(x) = 1;
end Ls1N_if1;
//// model: Ls1N_if2
model Ls1N_if2
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
equation
  if time > 1 then x = 1; elseif f(time) > 0 then x = 2; else x = 3; end if;
end Ls1N_if2;
//// model: Ls1N_if3
model Ls1N_if3
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
equation
  if f(time) < 0 then x = 1; elseif time > 1 then x = 2; else x = 3; end if;
end Ls1N_if3;
//// model: Ls1N_algif1
model Ls1N_algif1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
algorithm
  if f(time) > 0 then
    x := 1;
  else
    x := 2;
  end if;
end Ls1N_algif1;
//// model: Ls1N_algif2
model Ls1N_algif2
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
algorithm
  x := 0;
  if time > 1 then
    x := 1;
  elseif f(time) > 0 then
    x := 2;
  else
    x := 3;
  end if;
  if f(time) < 0 then
    x := 4;
  end if;
end Ls1N_algif2;
//// model: Ls1N_assert1
model Ls1N_assert1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
equation
  x = time;
  assert(f(time) > 0, "never");
  assert(f(time) < 0, "always");
end Ls1N_assert1;
//// model: Ls1B_bind1
model Ls1B_bind1
  Real y = time + 1 + 2;
  Real z = (time + 1) ^ 2 * 2 * 3;
  Integer i = integer(time) + 1 + 2;
end Ls1B_bind1;
//// model: Ls1F_aux1
model Ls1F_aux1
  Real x, y(start = 0, fixed = true);
equation
  x = sin(time * 2) + cos(time + 1 + 2);
  der(y) = exp(-y * 2);
initial equation
  y = sin(time * 2);
end Ls1F_aux1;
//// model: Ls1R_noret1
model Ls1R_noret1
  impure function g input Real u; algorithm assert(u < 1e10, "big"); end g;
  Real x;
equation
  x = time;
  g(time * 2 * 3);
end Ls1R_noret1;
//// model: Ls1T_reinit1
model Ls1T_reinit1
  Real s(start = 1, fixed = true);
equation
  der(s) = -1;
  when s < 0 then reinit(s, -2 * pre(s) * 3); end when;
end Ls1T_reinit1;
//// model: Ls1E_enum1
model Ls1E_enum1
  type E = enumeration(a, b);
  E e;
  Real y;
equation
  e = e;
  y = time;
end Ls1E_enum1;
//// model: Ls1I_ifbody1
model Ls1I_ifbody1
  Real x, y;
equation
  y = time;
  if time > 1 then x = 2 * y * 3; else x = y + 1 + 2; end if;
end Ls1I_ifbody1;
//// model: Ls1I_ifcond1
model Ls1I_ifcond1
  parameter Real p = 2;
  Real x;
equation
  if time > 2 * p * 3 then x = 1; else x = 2; end if;
end Ls1I_ifcond1;
//// model: Ls1I_ifdisc2
model Ls1I_ifdisc2
  Real x;
  Integer i;
equation
  if time > 1 then x = 1; i = 2; else i = 3; x = 4; end if;
end Ls1I_ifdisc2;
//// model: Ls1I_noevent1
model Ls1I_noevent1
  Real x;
equation
  if noEvent(time > 1) then x = time * 2; elseif noEvent(time > 2) then x = 1 + time + 2; else x = 0; end if;
end Ls1I_noevent1;
//// model: Ls1S_semiB
model Ls1S_semiB
  parameter Real p = 2;
  Real y = semiLinear(time, 2 * p * 3, 6 * p);
  Real z;
equation
  z = semiLinear(y, p, p * 1);
end Ls1S_semiB;
//// model: Ls1S_semiI
model Ls1S_semiI
  function f input Real u; input Real k; output Real y; algorithm y := semiLinear(u, k * 2 * 3, 6 * k); end f;
  parameter Real p = 2;
  Real y;
equation
  y = f(time, p);
end Ls1S_semiI;
//// model: Ls1A_algwhen1
model Ls1A_algwhen1
  Real x(start = 0);
algorithm
  when false then
    x := 1;
  end when;
end Ls1A_algwhen1;
//// model: Ls1A_noret1
model Ls1A_noret1
  impure function g input Real u; algorithm assert(u < 1e10, "big"); end g;
  Real x;
algorithm
  x := time;
  g(time * 2 * 3);
end Ls1A_noret1;
//// model: Ls1A_term1
model Ls1A_term1
  Real x;
algorithm
  x := time;
  when time > 2 * 3 + x then
    terminate("stop " + String(time * 2 * 3));
  end when;
end Ls1A_term1;
//// model: Ls1A_tuple1
model Ls1A_tuple1
  function f2 input Real u; output Real a; output Real b; algorithm a := u; b := 2 * u; end f2;
  Real a, b;
algorithm
  (a, b) := f2(time * 2 * 3);
end Ls1A_tuple1;
//// model: Ls1A_for2
model Ls1A_for2
  Real x;
algorithm
  x := 0;
  for i in 1:3 loop
    x := x + i * 2 * 3;
  end for;
end Ls1A_for2;
//// model: Ls1A_init1
model Ls1A_init1
  Real x(start = 0);
equation
  der(x) = 1;
initial algorithm
  x := time * 2 * 3;
end Ls1A_init1;
//// model: Ls1I_nestedlit1
model Ls1I_nestedlit1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
equation
  if time > 1 then
    if f(time) > 0 then x = 1; else x = 2; end if;
  else
    x = 3;
  end if;
end Ls1I_nestedlit1;
//// model: Ls1I_inittrue1
model Ls1I_inittrue1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
equation
  der(x) = 1;
initial equation
  if f(time) > 0 then x = 1; else x = 2; end if;
end Ls1I_inittrue1;
//// model: Ls1I_initfalse1
model Ls1I_initfalse1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  if f(time) < 0 then x = 1; end if;
end Ls1I_initfalse1;
//// model: Ls1W_arrmul1
model Ls1W_arrmul1
  parameter Real p = 2;
  Real x;
equation
  when {time > 2 * p * 3, sample(0, 1)} then x = 1; end when;
end Ls1W_arrmul1;
//// model: Ls1W_else3
model Ls1W_else3
  Real x;
equation
  when false then x = 1; elsewhen false then x = 2; elsewhen time > 1 then x = 3; end when;
end Ls1W_else3;
//// model: Ls1W_allfalse2
model Ls1W_allfalse2
  Real x, y;
equation
  y = time;
  when false then x = 1; elsewhen false then x = 2; end when;
end Ls1W_allfalse2;
//// model: Ls1W_inline1
model Ls1W_inline1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x, y;
equation
  y = time;
  when time > 1 then x = 1; elsewhen f(time) > 2 then x = 2; end when;
end Ls1W_inline1;
//// model: Ls1W_inline2
model Ls1W_inline2
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x, y;
equation
  y = time;
  when {f(time) > 2, time > 1} then x = 1; end when;
end Ls1W_inline2;
//// model: Ls1W_mixed1
model Ls1W_mixed1
  Real x, z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 1 then x = 2; end when;
  when false then i = 3; end when;
end Ls1W_mixed1;
//// model: Ls1M_int1
model Ls1M_int1
  parameter Integer n = 3;
  Integer i, j, k;
equation
  i = 2 * n * 3;
  j = n + 1 - 1;
  k = div(n * 2 * 3, 4);
end Ls1M_int1;
//// model: Ls1M_neg1
model Ls1M_neg1
  Real x, y, z;
equation
  x = -(2 * time * 3);
  y = -(time + 1 + 2);
  z = -(-(time * 2 * 3));
end Ls1M_neg1;
//// model: Ls1N_pow1
model Ls1N_pow1
  function f0 input Real u; output Real y; algorithm y := 0; end f0;
  function f1 input Real u; output Real y; algorithm y := 1; end f1;
  Real x, y;
equation
  x = time ^ f0(time);
  y = time ^ f1(time);
end Ls1N_pow1;
//// model: Ls1N_cast1
model Ls1N_cast1
  function g input Real u; output Integer y; algorithm y := 2; end g;
  Real x;
equation
  x = g(time) * 2.5;
end Ls1N_cast1;
//// model: Ls1N_eq1
model Ls1N_eq1
  function f input Real u; output Real y; algorithm y := u * 2; end f;
  function g input Real u; output Real y; algorithm y := 2 * u; end g;
  Real x;
equation
  x = time;
  f(x) = g(x);
end Ls1N_eq1;
//// model: Ls1D_der1
model Ls1D_der1
  Real x(start = 1, fixed = true), y;
equation
  der(x) = 2 * x * 3;
  y = der(x) * 2 * 3;
end Ls1D_der1;
//// model: Ls1D_pre1
model Ls1D_pre1
  discrete Real x(start = 1, fixed = true);
  Boolean b(start = false, fixed = true);
equation
  when sample(0, 0.1) then
    x = pre(x) * 2 * 3 + 1 + 2;
    b = not pre(b) and true;
  end when;
end Ls1D_pre1;
//// model: Ls1T_str1
model Ls1T_str1
  String s;
  Real y;
equation
  y = time;
  s = String(y * 2 * 3) + "x";
end Ls1T_str1;
//// model: Ls1W_elsearr1
model Ls1W_elsearr1
  Real v, w;
equation
  w = time;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end Ls1W_elsearr1;
//// model: Ls1W_elsearr2
model Ls1W_elsearr2
  Real v, w;
equation
  w = time;
  when w > 2 then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end Ls1W_elsearr2;
//// model: Ls1W_elsearr3
model Ls1W_elsearr3
  Real v, w;
equation
  w = time;
  when {false, w > 1} then v = 1; elsewhen false then v = 2; end when;
end Ls1W_elsearr3;
//// model: Ls1W_elsearr4
model Ls1W_elsearr4
  Real v, w;
equation
  w = time;
  when false then v = 1; elsewhen {w > 2, w > 1} then v = 2; end when;
end Ls1W_elsearr4;
//// model: Ls1W_assertfalse2
model Ls1W_assertfalse2
  parameter Real p = 2;
  Real z, w;
equation
  w = time;
  when false then z = 1; end when;
  assert(false, "removed with the when");
end Ls1W_assertfalse2;
//// model: Ls1W_order3
model Ls1W_order3
  parameter Real p = 2;
  Real x, z, w, v;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 2 * p * 3 then x = 2; end when;
  when false then i = 3; end when;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end Ls1W_order3;
//// model: Ls1W_orderok1
model Ls1W_orderok1
  parameter Real p = 2;
  Real x, z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 2 * p * 3 then x = 2; end when;
  when false then i = 3; end when;
  assert(false, "removed with the when");
  assert(w > 2 * p * 3, "kept");
end Ls1W_orderok1;
//// model: Ls1W_orderok2
model Ls1W_orderok2
  Real z, w;
equation
  w = time;
  when false then z = 1; end when;
  assert(w > 2, "kept");
end Ls1W_orderok2;
//// model: Ls1W_orderok3
model Ls1W_orderok3
  Real z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when false then i = 3; end when;
  assert(false, "removed");
end Ls1W_orderok3;
//// model: Ls1W_orderok4
model Ls1W_orderok4
  Real w;
  Integer i;
equation
  w = time;
  when false then i = 3; end when;
  assert(false, "removed");
end Ls1W_orderok4;
//// model: Ls1W_order4
model Ls1W_order4
  Real x, z, w, v;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 6 then x = 2; end when;
  when false then i = 3; end when;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end Ls1W_order4;
//// model: Ls1W_orderok5
model Ls1W_orderok5
  parameter Real p = 2;
  Real x, z, w;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when time > 2 * p * 3 then x = 2; end when;
  when false then i = 3; end when;
end Ls1W_orderok5;
//// model: Ls1W_order5
model Ls1W_order5
  Real z, w, v;
  Integer i;
equation
  w = time;
  when false then z = 1; end when;
  when false then i = 3; end when;
  when false then v = 1; elsewhen {false, w > 1} then v = 2; end when;
end Ls1W_order5;
//// model: Ls1W_order6
model Ls1W_order6
  Real z, w, v;
equation
  w = time;
  when false then z = 1; end when;
  when false then v = 1; elsewhen w > 1 then v = 2; end when;
end Ls1W_order6;
//// model: Ls1W_order7
model Ls1W_order7
  Real z, w, v;
equation
  w = time;
  when false then v = 1; elsewhen w > 1 then v = 2; end when;
  when false then z = 1; end when;
end Ls1W_order7;
//// model: Ls1W_order1
model Ls1W_order1
  Real z, w, v;
equation
  w = time;
  when w > 1 then v = 2; end when;
  when false then z = 1; end when;
end Ls1W_order1;
//// model: Ls1W_order2
model Ls1W_order2
  Real z, w, v;
equation
  w = time;
  when false then z = 1; end when;
  when w > 1 then v = 2; end when;
end Ls1W_order2;
//// model: Ls1W_prevar1
model Ls1W_prevar1
  Real y, w, x;
equation
  w = time;
  y = pre(x) + w;
  when false then x = 1; end when;
end Ls1W_prevar1;
//// model: Ls1W_prevar2
model Ls1W_prevar2
  discrete Real x(start = 2, fixed = true);
  Real y;
equation
  y = pre(x) * 2 * 3;
  when false then x = pre(x) + 1; end when;
end Ls1W_prevar2;
//// model: Ls1W_last2
model Ls1W_last2
  Real a, b, c, w;
equation
  w = time;
  when w > 1 then a = 1; end when;
  when false then c = 2; end when;
  when false then b = 3; end when;
end Ls1W_last2;
//// model: Ls1W_last3
model Ls1W_last3
  Real a, b, c, w;
equation
  w = time;
  when false then b = 3; end when;
  when w > 1 then a = 1; end when;
  when false then c = 2; end when;
end Ls1W_last3;
//// model: Ls1W_fa1
model Ls1W_fa1
  Real x, w, y;
equation
  w = time;
  y = sin(w) * 2 * 3;
  when false then x = cos(w); end when;
end Ls1W_fa1;
//// model: Ls1W_bnddisc1
model Ls1W_bnddisc1
  Real w;
  Integer k = integer(w) + 1 + 2;
  Real x;
equation
  w = time;
  when false then x = 1; end when;
end Ls1W_bnddisc1;
//// model: Ls1I_innerself1
model Ls1I_innerself1
  Real y;
equation
  if time > 1 then y = 2 * y * 3 / 6; else y = time; end if;
end Ls1I_innerself1;
//// model: Ls1I_initmulti1
model Ls1I_initmulti1
  Real x(start = 0), y(start = 0);
equation
  der(x) = 1;
  der(y) = 2;
initial equation
  if time > 0 then x = 1; y = 2 * time * 3; end if;
end Ls1I_initmulti1;
//// model: Ls1I_initbool1
model Ls1I_initbool1
  parameter Boolean b(fixed = false);
  parameter Integer n(fixed = false);
  Real x;
equation
  x = time;
initial equation
  if x > 0 then b = true; n = 1 + 2; else b = false; n = 4; end if;
end Ls1I_initbool1;
//// model: Ls1I_eqbranch1
model Ls1I_eqbranch1
  Real x, y;
equation
  y = time;
  if y > 1 then x = y * 2 * 3; else x = 6 * y; end if;
end Ls1I_eqbranch1;
//// model: Ls1I_lhsexpr2
model Ls1I_lhsexpr2
  Real x, y;
equation
  y = time;
  if y > 1 then 2 * x = y; else x * 2 = y + 1; end if;
end Ls1I_lhsexpr2;
//// model: Ls1I_der1
model Ls1I_der1
  Real x(start = 1, fixed = true);
equation
  if time > 1 then der(x) = -x * 2 * 3; else der(x) = 0; end if;
end Ls1I_der1;
//// model: Ls1I_nested3
model Ls1I_nested3
  Real x;
equation
  if time > 1 then
    x = 1;
  elseif time > 2 then
    if time > 3 then x = 2; elseif time > 4 then x = 3; else x = 4; end if;
  else
    x = 5;
  end if;
end Ls1I_nested3;
//// model: Ls1I_ifdummy1
model Ls1I_ifdummy1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  if f(time) < 0 then x = 1; elseif f(time) > 2 then x = 2; end if;
end Ls1I_ifdummy1;
//// model: Ls1A_noret2
model Ls1A_noret2
  impure function g input Real u; algorithm assert(u < 1e10, "big"); end g;
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
algorithm
  x := time;
  if f(time) > 0 then
    g(x * 2 * 3);
  end if;
end Ls1A_noret2;
//// model: Ls1A_ifelse2
model Ls1A_ifelse2
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
algorithm
  if time > 1 then
    x := 1;
  elseif f(time) < 0 then
    x := 2;
  else
    x := 3 * 2 * time;
  end if;
end Ls1A_ifelse2;
//// model: Ls1A_while3
model Ls1A_while3
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
algorithm
  x := 0;
  while f(time) < 0 loop
    x := x + 1;
  end while;
end Ls1A_while3;
//// model: Ls1A_nested1
model Ls1A_nested1
  function f input Real u; output Real y; algorithm y := 1; end f;
  Real x;
algorithm
  x := 0;
  for i in 1:2 loop
    if f(time) > 0 then
      x := x + i * 2 * 3;
    end if;
  end for;
end Ls1A_nested1;
//// model: Ls1A_assertlvl1
model Ls1A_assertlvl1
  Real x;
algorithm
  x := time;
  assert(x < 1 + 2 + x * 2 * 3, "m", AssertionLevel.warning);
end Ls1A_assertlvl1;
//// model: Ls1M_intreal1
model Ls1M_intreal1
  parameter Integer n = 3;
  Integer i;
  Real x;
equation
  i = integer(time);
  x = i * 2 * 0.5 + n * 2 / 4;
end Ls1M_intreal1;
//// model: Ls1M_powlit1
model Ls1M_powlit1
  Real x, y;
equation
  y = time;
  x = (y * 2 * 3) ^ 2 + (2 * y) ^ (1 + 1);
end Ls1M_powlit1;
//// model: Ls1M_divneg1
model Ls1M_divneg1
  Real x, y, z;
equation
  y = time;
  x = (-y) / 2 / 3;
  z = y / (-2) / 3;
end Ls1M_divneg1;
//// model: Ls1S_semiLit1
model Ls1S_semiLit1
  Real z, y;
equation
  y = time;
  z = semiLinear(0, 1, 2) + y;
end Ls1S_semiLit1;
//// model: Ls1S_semiWhen1
model Ls1S_semiWhen1
  parameter Real p = 2;
  Real z, y;
equation
  y = time;
  when y > 1 then z = semiLinear(y, 2 * p * 3, 6 * p); end when;
end Ls1S_semiWhen1;
//// model: Ls1S_semiWhen2
model Ls1S_semiWhen2
  Real z, y;
equation
  y = time;
  when y > 1 then z = semiLinear(y - y, 1, 2); end when;
end Ls1S_semiWhen2;
//// model: Ls1S_semiIf1
model Ls1S_semiIf1
  parameter Real p = 2;
  Real z, y;
equation
  y = time;
  if y > 1 then z = semiLinear(y, 2 * p * 3, 6 * p); else z = 0; end if;
end Ls1S_semiIf1;
//// model: Ls1S_semiAlg1
model Ls1S_semiAlg1
  parameter Real p = 2;
  Real z, y;
algorithm
  y := time;
  z := semiLinear(y, 2 * p * 3, 6 * p) + semiLinear(1, 2, 3);
end Ls1S_semiAlg1;
//// model: Ls1L_str1
model Ls1L_str1
  Real y;
equation
  y = time;
  assert(y > 1, "a" + "b" + String(y));
end Ls1L_str1;
//// model: Ls1L_str2
model Ls1L_str2
  Real x(start = 0);
equation
  der(x) = 1;
initial equation
  assert(x > -1, "x" + "y");
end Ls1L_str2;
//// model: Ls1L_str3
model Ls1L_str3
  function f input Real u; output String s; algorithm s := "v"; end f;
  Real y;
  String a;
equation
  y = time;
  a = f(y) + "a" + f(y + 1);
end Ls1L_str3;
//// model: Ls1L_not1
model Ls1L_not1
  Real s(start = 1, fixed = true), x, y;
equation
  y = time;
  der(s) = 1;
  when {false, false} then x = 1; elsewhen y > 9 then x = 2; reinit(s, 1); end when;
end Ls1L_not1;
//// model: Ls1L_not2
model Ls1L_not2
  Real s(start = 1, fixed = true), x, y;
equation
  y = time;
  der(s) = 1;
  when {y > 1, false} then x = 1; elsewhen y > 9 then x = 2; reinit(s, 1); end when;
end Ls1L_not2;
//// model: Ls1L_not3
model Ls1L_not3
  Real s(start = 1, fixed = true), x, y;
equation
  y = time;
  der(s) = 1;
  when {true, false} then x = 1; elsewhen {y > 9, y > 8} then x = 2; reinit(s, 1); end when;
end Ls1L_not3;
//// model: Ls1L_div0
model Ls1L_div0
  function f input Real u; input Real z; output Real y; algorithm y := u ^ (z / z); end f;
  Real x;
equation
  x = f(time, 0);
end Ls1L_div0;
//// model: Ls1L_div1
model Ls1L_div1
  function f input Real u; input Real z; output Real y; algorithm y := u ^ (1 / z); end f;
  Real x;
equation
  x = f(time, 0);
end Ls1L_div1;
//// model: Ls1L_nan1
model Ls1L_nan1
  Real y = time;
  Real a = 0 / 0;
  Real b = 0 * y / 0 + y;
equation
end Ls1L_nan1;
//// model: Ls1G_rhs_00
model Ls1G_rhs_00
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = 2 * y * 3;
end Ls1G_rhs_00;
//// model: Ls1G_rhs_01
model Ls1G_rhs_01
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y * 2 * 3;
end Ls1G_rhs_01;
//// model: Ls1G_rhs_02
model Ls1G_rhs_02
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y + 1 + 2;
end Ls1G_rhs_02;
//// model: Ls1G_rhs_03
model Ls1G_rhs_03
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = 1 + y + 2;
end Ls1G_rhs_03;
//// model: Ls1G_rhs_04
model Ls1G_rhs_04
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y - 1 - 2;
end Ls1G_rhs_04;
//// model: Ls1G_rhs_05
model Ls1G_rhs_05
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = 1 - y - 2;
end Ls1G_rhs_05;
//// model: Ls1G_rhs_06
model Ls1G_rhs_06
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y / 2 / 4;
end Ls1G_rhs_06;
//// model: Ls1G_rhs_07
model Ls1G_rhs_07
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = 2 / y / 4;
end Ls1G_rhs_07;
//// model: Ls1G_rhs_08
model Ls1G_rhs_08
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y * 2 / 4;
end Ls1G_rhs_08;
//// model: Ls1G_rhs_09
model Ls1G_rhs_09
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = -y * 2 * 3;
end Ls1G_rhs_09;
//// model: Ls1G_rhs_10
model Ls1G_rhs_10
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y * (-2) * 3;
end Ls1G_rhs_10;
//// model: Ls1G_rhs_11
model Ls1G_rhs_11
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = -(y + 1 + 2);
end Ls1G_rhs_11;
//// model: Ls1G_rhs_12
model Ls1G_rhs_12
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = (y + 1) ^ 2 * 3;
end Ls1G_rhs_12;
//// model: Ls1G_rhs_13
model Ls1G_rhs_13
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y ^ 2 * 2 * 3;
end Ls1G_rhs_13;
//// model: Ls1G_rhs_14
model Ls1G_rhs_14
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = 2 * p * y * 3;
end Ls1G_rhs_14;
//// model: Ls1G_rhs_15
model Ls1G_rhs_15
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = p * 2 + 3 + y;
end Ls1G_rhs_15;
//// model: Ls1G_rhs_16
model Ls1G_rhs_16
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y * 0.5 * 2;
end Ls1G_rhs_16;
//// model: Ls1G_rhs_17
model Ls1G_rhs_17
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y + 2 - 2;
end Ls1G_rhs_17;
//// model: Ls1G_rhs_18
model Ls1G_rhs_18
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = (y - 1) * (y + 1) * 2;
end Ls1G_rhs_18;
//// model: Ls1G_rhs_19
model Ls1G_rhs_19
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
equation
  y = time;
  z = y / y * 2;
end Ls1G_rhs_19;
//// model: Ls1G_rhs_20
model Ls1G_rhs_20
  parameter Real p = 2;
  parameter Integer n = 3;
  Real y;
  Real z;
