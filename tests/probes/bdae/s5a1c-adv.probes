//// set: s5a1c-adv — S5a-1c 评审时主代理手写的对抗形状（不来自 s5a1c 的生成器）。Ita：迭代量（和变量同名、重名嵌套、只在范围里用、跨 rehash、类型不同）；Out：算法输出与入桶；Pr：语句打印；If：if 方程的排序、拆分、编号；Wm：多赋值 when。比对走 tools/bdae_sweep.py --probes。
//// model: Ita1
model Ita1
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; output Real v1; output Real v2; algorithm v1 := u; v2 := u + 1; end g;
  function h input Real u; algorithm assert(u > 0, "h"); end h;
  Real i, x;
algorithm
  for i in 1:3 loop
    x := i;
  end for;
equation
  i = 1;
end Ita1;
//// model: Ita2
model Ita2
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; output Real v1; output Real v2; algorithm v1 := u; v2 := u + 1; end g;
  function h input Real u; algorithm assert(u > 0, "h"); end h;
  Real x;
  Integer i;
algorithm
  for i in 1:3 loop
    x := i;
  end for;
  i := 2;
end Ita2;
//// model: Ita3
model Ita3
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; output Real v1; output Real v2; algorithm v1 := u; v2 := u + 1; end g;
  function h input Real u; algorithm assert(u > 0, "h"); end h;
  Real x;
algorithm
  for i in 1:3 loop
    for i in {1.5, 2.5} loop
      x := i;
    end for;
  end for;
end Ita3;
