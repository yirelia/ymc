//// model: Ita8
model Ita8
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; output Real v1; output Real v2; algorithm v1 := u; v2 := u + 1; end g;
  function h input Real u; algorithm assert(u > 0, "h"); end h;
  Real x;
algorithm
  x := 0;
  for a in 1:2 loop x := x + a; end for;
  for b in 1:2 loop x := x + b; end for;
  for c in 1:2 loop x := x + c; end for;
  for d in 1:2 loop x := x + d; end for;
end Ita8;
//// model: Ita9
model Ita9
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; output Real v1; output Real v2; algorithm v1 := u; v2 := u + 1; end g;
  function h input Real u; algorithm assert(u > 0, "h"); end h;
  Real x;
algorithm
  for ab in 1:2 loop
    for ba in 1:2 loop
      for abc in 1:2 loop
        for cba in 1:2 loop
          x := ab + ba + abc + cba;
        end for;
      end for;
    end for;
  end for;
end Ita9;
