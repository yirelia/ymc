//// model: Ita12
model Ita12
  function f input Real u; output Real v; algorithm v := u + 1; end f;
  function g input Real u; output Real v1; output Real v2; algorithm v1 := u; v2 := u + 1; end g;
  function h input Real u; algorithm assert(u > 0, "h"); end h;
  Real x;
algorithm
  for i0 in 1:2 loop x := i0; end for;
  for i1 in 1:2 loop x := i1; end for;
  for i2 in 1:2 loop x := i2; end for;
  for i3 in 1:2 loop x := i3; end for;
  for i4 in 1:2 loop x := i4; end for;
  for i5 in 1:2 loop x := i5; end for;
  for i6 in 1:2 loop x := i6; end for;
  for i7 in 1:2 loop x := i7; end for;
  for i8 in 1:2 loop x := i8; end for;
  for i9 in 1:2 loop x := i9; end for;
  for i10 in 1:2 loop x := i10; end for;
  for i11 in 1:2 loop x := i11; end for;
  for i12 in 1:2 loop x := i12; end for;
  for i13 in 1:2 loop x := i13; end for;
  for i14 in 1:2 loop x := i14; end for;
end Ita12;
