  Real njzzK_2;
  Real z_3;
  parameter Real pk = 2;
  Real st(start = 1, fixed = true);
equation
  cLVF4Ve0_0 = time * time;
  iVN_1 = cLVF4Ve0_0 * cLVF4Ve0_0 + time;
  njzzK_2 = iVN_1 * iVN_1 + time;
  z_3 = f3(st, cLVF4Ve0_0, iVN_1);
  der(st) = -st * z_3;
end HshF3;

