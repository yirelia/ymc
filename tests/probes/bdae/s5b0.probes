//// model: HshW7
function g3
  input Real a;
  output Real p;
  output Real q;
  output Real r;
algorithm
  p := a;
  q := a * 2;
  r := a * 3;
  annotation(Inline = false);
end g3;
model HshW7
  discrete Real zz(start = 0, fixed = true), yy(start = 0, fixed = true), xx(start = 0, fixed = true);
  discrete Real ww(start = 0, fixed = true);
  Boolean c = time > 0.5;
equation
  when c then
    ww = 1;
    (zz, yy, xx) = g3(time);
  end when;
end HshW7;
