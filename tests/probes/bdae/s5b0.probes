//// model: HshW1
model HshW1
  discrete Real d5(start = 0, fixed = true);
  discrete Real d1(start = 0, fixed = true);
  discrete Real d4(start = 0, fixed = true);
  discrete Real d2(start = 0, fixed = true);
  discrete Real d3(start = 0, fixed = true);
  Boolean c = time > 0.5;
equation
  when c then
    d5 = 1;
    d1 = 2;
    d4 = 3;
    d2 = 4;
    d3 = 5;
  end when;
end HshW1;

//// model: HshW2
model HshW2
  Real st9(start = 1, fixed = true);
  Real st2(start = 1, fixed = true);
  Real st7(start = 1, fixed = true);
  Real st4(start = 1, fixed = true);
  Real st5(start = 1, fixed = true);
  Real st1(start = 1, fixed = true);
  Real st8(start = 1, fixed = true);
  Real st3(start = 1, fixed = true);
  Real st6(start = 1, fixed = true);
  Boolean c = time > 0.5;
equation
  der(st9) = -st9 * time;
  der(st2) = -st2 * time;
  der(st7) = -st7 * time;
  der(st4) = -st4 * time;
  der(st5) = -st5 * time;
  der(st1) = -st1 * time;
  der(st8) = -st8 * time;
  der(st3) = -st3 * time;
  der(st6) = -st6 * time;
  when c then
    reinit(st9, 1);
    reinit(st2, 2);
    reinit(st7, 3);
    reinit(st4, 4);
    reinit(st5, 5);
    reinit(st1, 6);
    reinit(st8, 7);
    reinit(st3, 8);
    reinit(st6, 9);
  end when;
end HshW2;

//// model: HshW3
model HshW3
  discrete Real zeta(start = 0, fixed = true);
  discrete Real alpha(start = 0, fixed = true);
  discrete Real mid(start = 0, fixed = true);
  Real qq(start = 1, fixed = true);
  Real aa(start = 1, fixed = true);
  Real mm(start = 1, fixed = true);
  Boolean c = time > 0.5;
equation
  der(qq) = -qq * time;
  der(aa) = -aa * time;
  der(mm) = -mm * time;
  when c then
    reinit(qq, 1);
    zeta = 1;
    reinit(aa, 2);
    alpha = 2;
    reinit(mm, 3);
    mid = 3;
  end when;
end HshW3;

//// model: HshW4
model HshW4
  discrete Real b1(start = 0, fixed = true);
  discrete Real a1(start = 0, fixed = true);
  discrete Real c1(start = 0, fixed = true);
  discrete Real d1(start = 0, fixed = true);
  Boolean c = time > 0.5;
equation
  when c then
    b1 = 1;
    a1 = 2;
    c1 = 3;
    d1 = 4;
  elsewhen time > 0.7 then
    d1 = 5;
    c1 = 6;
    a1 = 7;
    b1 = 8;
  end when;
end HshW4;

