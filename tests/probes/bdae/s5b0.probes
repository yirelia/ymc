//// model: HshI1
model HshI1
  Real a, b, c, d, e, g;
equation
  a = time * time;
  b = a * a + time;
  c = if a > 1 then b * a else b + time * a;
  d = if c > b then a * c else if c > a then b * c else c;
  e = if d > 0 and a > 0 then d * c * b else a;
  g = if e < d then 1.0 else e * a;
end HshI1;

//// model: HshP2
model HshP2
  Real p0x0;
  Real p1x0;
equation
  p0x0 = time * time;
  p1x0 = time * time;
end HshP2;

//// model: HshP3
model HshP3
  Real p0x0;
  Real p1x0;
  Real p1x1;
  Real p2x0;
  Real p2x1;
  Real p2x2;
  Real p2x3;
  Real p2x4;
  Real p2x5;
equation
  p2x3 = p2x2 * p2x1 + time;
  p2x1 = p2x0 * p2x0 + time;
  p1x0 = time * time;
  p2x2 = p2x1 * p2x1 + time;
  p2x5 = p2x4 * p2x2 + time;
  p2x4 = p2x3 * p2x2 + time;
  p2x0 = time * time;
  p1x1 = p1x0 * p1x0 + time;
  p0x0 = time * time;
end HshP3;

//// model: HshP5
model HshP5
