//// model: HshD1
model A
  Real t;
  Real uu;
end A;
model B
  A a1;
  A a2;
  Real v;
end B;
model HshD1
  A p;
  B q;
  B r;
  Real w;
equation
  p.t = time * time;
  p.uu = p.t * p.t + time;
  q.a1.t = p.uu * p.t + time;
  q.a1.uu = q.a1.t * p.uu + time;
  q.a2.t = q.a1.uu * q.a1.t + time;
  q.a2.uu = q.a2.t * q.a1.uu + time;
  q.v = q.a2.uu * q.a2.t + time;
  r.a1.t = q.v * q.a2.uu + time;
  r.a1.uu = r.a1.t * q.v + time;
  r.a2.t = r.a1.uu * r.a1.t + time;
  r.a2.uu = r.a2.t * r.a1.uu + time;
  r.v = r.a2.uu * r.a2.t + time;
  w = r.v * r.a2.uu + time;
end HshD1;

//// model: HshD2
model AB
  Real b;
  Real a;
end AB;
model HshD2
  AB a;
  AB b;
  Real ab;
  Real ba;
  Real aa;
  Real bb;
equation
  ab = time * time;
  ba = ab * ab + time;
  aa = ba * ab + time;
  bb = aa * ba + time;
  a.b = bb * aa + time;
  a.a = a.b * bb + time;
  b.b = a.a * a.b + time;
  b.a = b.b * a.a + time;
end HshD2;

//// model: HshD3
model S
  Real x(start = 1, fixed = true);
  Real y(start = 2, fixed = true);
equation
  der(x) = -x * y;
  der(y) = x * x - y;
end S;
model HshD3
  S s1;
  S s2;
  Real x(start = 3, fixed = true);
  Real alg1, alg2;
equation
  der(x) = alg1 * alg2;
  alg1 = s1.x * s2.y + time;
  alg2 = s2.x * alg1 + s1.y * x;
end HshD3;

