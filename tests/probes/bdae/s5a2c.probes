  input Real x;
  output Real y;
algorithm
  y := if x > 0.5 then x else -x;
end f;
model LeiB_ifx_nt_prod
  parameter Real p = 0.3;
  Real a, b;
equation
  a = 2 * f(-time);
  b = cos(time);
end LeiB_ifx_nt_prod;
//// model: LeiB_ifx_nt_neg
