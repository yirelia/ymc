equation
  m = f(time < 0.7);
end LeiT_bool_or_true;
//// model: LeiT_str_cat
function f
  input String s;
  output String t;
algorithm
  t := s + "x";
end f;
model LeiT_str_cat
  String m;
  discrete String s0(start = "a", fixed = true);
equation
  when sample(0, 1) then
    s0 = pre(s0) + "b";
  end when;
  m = f(s0);
end LeiT_str_cat;
