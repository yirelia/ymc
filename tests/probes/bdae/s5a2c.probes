//// model: LeiC_der
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_der
  Real s(start = 1, fixed = true);
  Real b;
equation
  b = time;
  der(s) = f(s) - f(time);
end LeiC_der;
//// model: LeiC_noevent
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_noevent
  Real s;
  Real b;
equation
  b = time;
  s = noEvent(if f(time) > 1 then f(time) else 0);
end LeiC_noevent;
//// model: LeiC_smooth
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_smooth
