//// model: LeiE_enum
type E = enumeration(a, b);
function f
  input E e;
  output Integer n;
algorithm
  n := Integer(e) + 1;
end f;
model LeiE_enum
  E e = if time > 0.5 then E.a else E.b;
  Integer n;
equation
  n = f(e);
end LeiE_enum;
