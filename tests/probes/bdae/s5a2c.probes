function f
  input Boolean c;
  output Real y;
algorithm
  y := if c then 1 else 2;
end f;
model LeiT_real_bool
  Real m;
equation
  m = f(time < 0.7) * time;
end LeiT_real_bool;
//// model: LeiC_when_cond
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_when_cond
  discrete Real d(start = 0, fixed = true);
  Real b;
equation
  b = time;
  when f(time) > 1 then
    d = pre(d) + 1;
  end when;
end LeiC_when_cond;
//// model: LeiC_when_body
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_when_body
  discrete Real d(start = 0, fixed = true);
  Real b;
equation
  b = time;
  when time > 0.5 then
    d = f(pre(d));
  end when;
end LeiC_when_body;
//// model: LeiC_elsewhen
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_elsewhen
  discrete Real d(start = 0, fixed = true);
  Real b;
equation
  b = time;
  when time > 0.5 then
    d = 1;
  elsewhen f(time) > 2 then
    d = f(pre(d));
  end when;
end LeiC_elsewhen;
//// model: LeiC_reinit
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_reinit
  Real s(start = 1, fixed = true);
  Real b;
equation
  b = time;
  der(s) = -f(s);
  when time > 0.5 then
    reinit(s, f(time));
  end when;
end LeiC_reinit;
//// model: LeiC_assert
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_assert
  Real s;
  Real b;
equation
  b = time;
  s = time;
  assert(f(s) < 10, "big");
end LeiC_assert;
//// model: LeiC_assert_msg
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_assert_msg
  Real s;
  Real b;
equation
  b = time;
  s = f(time);
  assert(s < 10, "big " + String(f(s)));
end LeiC_assert_msg;
//// model: LeiC_ifcond
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_ifcond
  Real s;
  Real b;
equation
  b = time;
  if f(time) > 1 then
    s = 1;
  else
    s = f(time);
  end if;
end LeiC_ifcond;
//// model: LeiC_ifexp
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_ifexp
  Real s;
  Real b;
equation
  b = time;
  s = if f(time) > 1 then f(2 * time) else 0;
end LeiC_ifexp;
//// model: LeiC_alg_assign
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_alg_assign
  Real s;
  Real b;
equation
  b = time;
algorithm
  s := f(time);
end LeiC_alg_assign;
//// model: LeiC_alg_if
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_alg_if
  Real s;
  Real b;
equation
  b = time;
algorithm
  if f(time) > 1 then
    s := f(time);
  else
    s := 0;
  end if;
end LeiC_alg_if;
//// model: LeiC_alg_while
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_alg_while
  Real s;
  Real b;
equation
  b = time;
algorithm
  s := 0;
  while s < f(time) loop
    s := s + 1;
  end while;
end LeiC_alg_while;
//// model: LeiC_alg_for
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_alg_for
  Real s;
  Real b;
equation
  b = time;
algorithm
  s := 0;
  for i in 1:3 loop
    s := s + f(i * time);
  end for;
end LeiC_alg_for;
//// model: LeiC_alg_when
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_alg_when
  discrete Real s(start = 0, fixed = true);
  Real b;
equation
  b = time;
algorithm
  when time > 0.5 then
    s := f(pre(s));
  end when;
end LeiC_alg_when;
//// model: LeiC_alg_assert
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_alg_assert
  Real s;
  Real b;
equation
  b = time;
algorithm
  s := time;
  assert(f(s) < 10, "big");
end LeiC_alg_assert;
