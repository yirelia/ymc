  input Integer n;
  output Integer m;
algorithm
  m := if n > 2 then n - 2 else 2 - n;
end f;
model LeiT_int_cond
  Integer k(start = 1, fixed = true);
  Integer m;
equation
  when sample(0, 0.1) then
    k = pre(k) + 1;
  end when;
  m = f(k);
end LeiT_int_cond;
