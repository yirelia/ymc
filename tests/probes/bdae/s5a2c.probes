model LeiE_output_ref
  Real a;
equation
  a = f(time);
end LeiE_output_ref;
//// model: LeiE_two_out
function g
  input Real x;
  output Real y1;
  output Real y2;
algorithm
  y1 := x;
  y2 := 2 * x;
end g;
function f
  input Real x;
  output Real y1;
  output Real y2;
algorithm
  (y1, y2) := g(x);
end f;
model LeiE_two_out
  Real a, b;
equation
  (a, b) = f(time);
end LeiE_two_out;
//// model: LeiE_multi_stmt
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
  y := y + 1;
end f;
model LeiE_multi_stmt
  Real a;
equation
  a = f(time);
end LeiE_multi_stmt;
//// model: LeiE_empty_body
function f
  input Real x;
  output Real y = 2 * x;
end f;
model LeiE_empty_body
  Real a;
equation
  a = f(time);
end LeiE_empty_body;
//// model: LeiE_array_in
function f
  input Real x[2];
  output Real y;
algorithm
  y := x[1] + x[2];
end f;
model LeiE_array_in
  Real a;
equation
  a = f({time, 2 * time});
end LeiE_array_in;
//// model: LeiE_impure
impure function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
end f;
model LeiE_impure
  Real a;
equation
  a = f(time);
end LeiE_impure;
//// model: LeiE_impure_inner_lit
impure function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
end f;
function f2
  input Real x;
  output Real y;
algorithm
  y := f(x);
end f2;
function g
  input Real x;
  input Real z;
  output Real y;
algorithm
  y := f(z) * x;
end g;
model LeiE_impure_inner_lit
  parameter Real p = 3;
  Real a, b;
equation
  a = f2(1.0);
  b = g(time, 2.0);
end LeiE_impure_inner_lit;
