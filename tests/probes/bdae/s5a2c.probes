  s = smooth(1, f(time));
end LeiC_smooth;
//// model: LeiC_pre
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_pre
  discrete Real d(start = 0, fixed = true);
  Real b;
equation
  b = time;
  when sample(0, 0.1) then
    d = f(pre(d)) + pre(d);
  end when;
end LeiC_pre;
//// model: LeiC_many
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiC_many
  Real s, u, v;
  Real b;
equation
  b = time;
  s = f(time);
  u = f(time) + f(s);
  v = f(u) * f(time);
end LeiC_many;
