//// set: s5a2c — S5a-2c：pre 模块 Early Inline（NBInline.main / inline :222-248、NBReplacements.replaceFunctions / applyFuncExp NBReplacements.mo:268-341、inlineRecordsTuplesArrays NBInline.mo:264-408，v1.25.0）。Lei 前缀，走 tools/bdae_sweep.py --probes s5a2c --stage earlyinline。LeiB：函数体形状 × 实参 × 位置；LeiL：protected 局部；LeiD：缺省、命名实参；LeiN：嵌套、递归、两遍映射；LeiT：Integer / Boolean / String；LeiC：语境（when、if 方程、算法、assert、reinit、初值、绑定）；LeiA：内联注解；LeiI：if 方程重造；LeiX：和 FunctionAlias 的互动；LeiS：化简形态；LeiE：omc 报错 / 走不到的形态。
//// model: LeiB_lin_t_rhs
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiB_lin_t_rhs
  parameter Real p = 0.3;
  Real a, b;
equation
  a = f(time);
  b = cos(time);
end LeiB_lin_t_rhs;
//// model: LeiB_lin_t_sum
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x + 1;
end f;
model LeiB_lin_t_sum
  parameter Real p = 0.3;
  Real a, b;
equation
  a = f(time) + time;
  b = cos(time);
end LeiB_lin_t_sum;
