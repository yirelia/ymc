//// model: LeiN_rec_sim
function fac
  input Integer n;
  output Integer r;
algorithm
  r := if n <= 1 then 1 else n * fac(n - 1);
end fac;
function rr
  input Real x;
  output Real y;
algorithm
  y := if x > 1 then rr(x - 1) + x else x;
end rr;
model LeiN_rec_sim
  Integer n = 4;
  Integer k(start = 1, fixed = true);
  Real a;
equation
  k = fac(n);
  a = rr(time);
end LeiN_rec_sim;
//// model: LeiN_rec_disc
function fac
  input Integer n;
  output Integer r;
algorithm
  r := if n <= 1 then 1 else n * fac(n - 1);
end fac;
function rr
  input Real x;
  output Real y;
algorithm
  y := if x > 1 then rr(x - 1) + x else x;
end rr;
model LeiN_rec_disc
  Integer n = 4;
  Integer k(start = 1, fixed = true);
  Real a;
equation
  when sample(0, 1) then
    k = fac(pre(k));
  end when;
  a = rr(time);
end LeiN_rec_disc;
//// model: LeiN_rec_init
function fac
  input Integer n;
  output Integer r;
algorithm
  r := if n <= 1 then 1 else n * fac(n - 1);
end fac;
function rr
  input Real x;
  output Real y;
algorithm
  y := if x > 1 then rr(x - 1) + x else x;
end rr;
model LeiN_rec_init
  Real a(start = 1);
equation
  der(a) = -a;
initial equation
  a = rr(time);
end LeiN_rec_init;
