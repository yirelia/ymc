//// model: LeiN_sim_f
function h
  input Real x;
  output Real y;
algorithm
  y := 3 * x;
end h;
function g
  input Real x;
  output Real y;
algorithm
  y := h(x) + 1;
end g;
function f
  input Real x;
  output Real y;
algorithm
  y := g(x) * 2;
end f;
model LeiN_sim_f
  Real a, b;
equation
  a = f(time);
  b = time;
end LeiN_sim_f;
//// model: LeiN_init_f
function h
  input Real x;
  output Real y;
algorithm
  y := 3 * x;
end h;
function g
  input Real x;
  output Real y;
algorithm
  y := h(x) + 1;
end g;
function f
  input Real x;
  output Real y;
algorithm
  y := g(x) * 2;
end f;
model LeiN_init_f
  Real a(start = 1);
  Real b;
equation
  der(a) = -a;
  b = time;
initial equation
  a = f(time);
end LeiN_init_f;
//// model: LeiN_disc_f
function h
  input Real x;
  output Real y;
algorithm
  y := 3 * x;
end h;
function g
  input Real x;
  output Real y;
algorithm
  y := h(x) + 1;
end g;
function f
  input Real x;
  output Real y;
algorithm
  y := g(x) * 2;
end f;
model LeiN_disc_f
  discrete Real d(start = 0, fixed = true);
  Real b;
equation
  when sample(0, 0.1) then
    d = f(pre(d));
  end when;
  b = time;
end LeiN_disc_f;
//// model: LeiN_ifeq_f
function h
  input Real x;
  output Real y;
algorithm
  y := 3 * x;
end h;
function g
  input Real x;
  output Real y;
algorithm
  y := h(x) + 1;
end g;
function f
  input Real x;
  output Real y;
algorithm
  y := g(x) * 2;
end f;
model LeiN_ifeq_f
  Real a, b;
equation
  if time > 0.5 then
    a = f(time);
  else
    a = 1;
  end if;
  b = time;
end LeiN_ifeq_f;
