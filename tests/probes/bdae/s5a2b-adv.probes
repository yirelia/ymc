//// set: s5a2b-adv — S5a-2b 评审时主代理手写的对抗形状（不来自 s5a2b 的生成器）。Fad：同一调用多处、嵌套、if / 关系 / 特殊内建里、整数布尔字符串结果、连续离散混排、用户函数各类（可内联、impure、外部、零实参、无输出）、lhs 上的调用、when / if / 算法 / assert 里、绑定方程和初值方程里、参数实参、枚举和时钟结果、跨 rehash、omc 报错的形态。比对走 tools/bdae_sweep.py --probes s5a2b-adv --stage functionalias。
//// model: FadC0
model FadC0
  function f1 input Real u; output Real v; algorithm v := u + 1; end f1;
  function f2 input Real u; output Real v; protected Real w; algorithm w := u * 2; v := w + 1; end f2;
  function f3 input Real u; input Real s = 2; output Real v; algorithm v := u; v := v * s; end f3;
  function fi input Real u; output Integer v; algorithm v := integer(u); v := v + 1; end fi;
  function fb input Real u; output Boolean v; algorithm v := u > 0; v := not v; end fb;
  function fs input Integer u; output String v; algorithm v := String(u); v := v + "x"; end fs;
  impure function fp input Real u; output Real v; algorithm v := u; v := v + 1; end fp;
  function fe input Real u; output Real v; external "C" v = cbrt(u); end fe;
  function fn0 output Real v; algorithm v := 1; v := v + 1; end fn0;
  function fz input Real u; algorithm assert(u > -100, "u"); end fz;
  parameter Real p = 2;
  parameter Integer n = 3;
  Real x(start = 1, fixed = true);
  Real y, z, w;
  Integer j, k;
  Boolean b;
  discrete Real d(start = 0, fixed = true);

equation
  der(x) = -x;
  y = sin(time);
  z = sin(time) + 1;
  w = 2 * sin(time);
  j = 0;
  k = 0;
  b = false;
  when time > 0.9 then d = time; end when;
end FadC0;
//// model: FadC1
