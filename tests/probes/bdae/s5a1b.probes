    outer Real y;
  equation
    when time > 1 then
      y = 1;
    end when;
  end M;
  inner Real y;
  M m[0];
equation
  y = 2;
end LwbZeroArr;
//// model: LwbAlgWhenOther
model LwbAlgWhenOther
  Real y;
  discrete Real z;
equation
  y = pre(z);
algorithm
  when time > 1 then
    z := 1;
  end when;
end LwbAlgWhenOther;
//// model: LwbAssertWhen
model LwbAssertWhen
  Real x;
equation
  x = time;
  when x > 1 then
    assert(x > 2, "m");
  end when;
end LwbAssertWhen;
//// model: LwbAssertWhenTrue
model LwbAssertWhenTrue
  Real x;
  discrete Real y;
equation
  x = time;
  when x > 1 then
    assert(true, "m");
    y = 1;
  end when;
end LwbAssertWhenTrue;
//// model: LwbIfWhen
model LwbIfWhen
  Real x;
  discrete Real y;
equation
  x = time;
  when x > 1 then
    if x > 3 then
      y = 1;
    else
      y = 2;
    end if;
  end when;
end LwbIfWhen;
//// model: LwbForWhen
model LwbForWhen
  Real x;
  discrete Real y[2];
equation
  x = time;
  when x > 1 then
    for i in 1:2 loop
      y[i] = i;
    end for;
  end when;
end LwbForWhen;
//// model: LwbNestedWhen
model LwbNestedWhen
  Real x;
  discrete Real y;
equation
  x = time;
  when x > 1 then
    when x > 2 then
      y = 1;
    end when;
  end when;
end LwbNestedWhen;
//// model: LwbTermTop
model LwbTermTop
  Real x;
equation
  x = time;
  terminate("a");
end LwbTermTop;
//// model: LwbTermIni
model LwbTermIni
  Real x;
initial equation
  terminate("a");
equation
  x = time;
end LwbTermIni;
//// model: LwbPrintTop
model LwbPrintTop
  Real x;
equation
  x = time;
  print("a");
end LwbPrintTop;
//// model: LwbPrintIni
model LwbPrintIni
  Real x;
initial equation
  print("a");
equation
  x = time;
end LwbPrintIni;
//// model: LwbIniWhen
model LwbIniWhen
  Real x;
  discrete Real y;
initial equation
  when time > 1 then
    y = 1;
  end when;
equation
  x = time;
end LwbIniWhen;
//// model: LwbConnAssert
model LwbConnAssert
  connector C
    Real v;
    flow Real i;
  end C;
  C c;
equation
  assert(c.v > 0, "x" + String(c.i));
end LwbConnAssert;
//// model: LwbTuple1
model LwbTuple1
  function f2
    input Real u;
    output Real a;
  algorithm
    a := u;
  end f2;
  Real a;
equation
  when time > 1 then
    (a) = f2(time);
  end when;
end LwbTuple1;
//// model: LwbCastLhs
model LwbCastLhs
  Integer n;
equation
  when time > 1 then
    n = 1.5;
  end when;
end LwbCastLhs;
//// model: LwbCastCond
model LwbCastCond
  Integer n;
  Real x;
equation
  x = time;
  when n > x then
    n = 1;
  end when;
end LwbCastCond;
//// model: LwbNoReturnFn
model LwbNoReturnFn
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x;
equation
  x = time;
  when x > 1 then
    h(x);
  end when;
end LwbNoReturnFn;
//// model: LwbNoReturnFn2
model LwbNoReturnFn2
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x;
  discrete Real y;
equation
  x = time;
  when x > 1 then
    y = 1;
    h(x);
  end when;
end LwbNoReturnFn2;
//// model: LwbEnumNested
model LwbEnumNested
  package P
    type E = enumeration(a, b);
  end P;
  P.E e(start = P.E.a);
equation
  when time > 1 then
    e = P.E.b;
  end when;
  assert(e == P.E.a, "m");
end LwbEnumNested;
//// model: LwbStrPar
model LwbStrPar
  parameter String m = "abc";
  constant String c = "def";
  Real x;
equation
  x = time;
  assert(x > 1, m);
  assert(x > 2, c);
  assert(x > 3, m + c);
  assert(x > 4, "z" + m);
end LwbStrPar;
//// model: LwbConstCond
model LwbConstCond
  constant Boolean c = true;
  parameter Boolean p = false;
  Real x;
equation
  x = time;
  assert(c, "m1");
  assert(p, "m2");
  assert(not c, "m3");
  assert(c and x > 1, "m4");
end LwbConstCond;
//// model: LwbConstWhen
model LwbConstWhen
  constant Boolean c = true;
  parameter Boolean p = false;
  Real x;
  discrete Real y, u;
equation
  x = time;
  when c then
    y = 1;
  end when;
  when p then
    u = 2;
  end when;
end LwbConstWhen;
//// model: LwbLoopWhen
model LwbLoopWhen
  Real x(start = 1, fixed = true);
  discrete Real y;
  Real z;
equation
  der(x) = y + z;
  z = x * 2;
  when x > 1 then
    y = pre(y) + z;
  end when;
end LwbLoopWhen;
//// model: LwbDerInWhen
model LwbDerInWhen
  Real x(start = 1, fixed = true);
  discrete Real y;
equation
  der(x) = 1;
  when der(x) > 1 then
    y = der(x);
  end when;
end LwbDerInWhen;
//// model: LwbPreOutside
model LwbPreOutside
  Real x;
  Real y;
  Real z;
equation
  x = time;
  when x > 1 then
    y = 1;
  end when;
  z = pre(y);
end LwbPreOutside;
//// model: LwbDiscScal
model LwbDiscScal
  Real x;
  discrete Real w;
  Real v;
  Integer n;
equation
  x = time;
  when x > 1 then
    w = 1;
  end when;
  w = pre(w);
  v = pre(w);
  when x > 2 then
    v = 1;
  end when;
  n = integer(x);
end LwbDiscScal;
//// model: LwbReinitSame
model LwbReinitSame
  Real y;
equation
  when time > 1 then
    y = 1;
    reinit(y, 0);
  end when;
end LwbReinitSame;
//// model: LwbInitialElse
model LwbInitialElse
  Real x;
  discrete Real y;
  Boolean b;
equation
  x = time;
  b = x > 1;
  when initial() then
    y = 1;
  elsewhen b then
    y = 2;
  elsewhen {initial(), b} then
    y = 3;
  end when;
end LwbInitialElse;
//// model: LwbNestPar
model LwbNestPar
  model M
    parameter Real p = 1;
    Real a(start = 1, fixed = true);
    Real b;
  equation
    der(a) = p;
    when a > p then
      b = p + a + 1;
      reinit(a, p);
    end when;
    assert(a > p, "a" + String(p));
  end M;
  M m(p = 2);
end LwbNestPar;
//// model: LwbA5Sum
model LwbA5Sum
  parameter Real a = 1, c = 2;
  discrete Real y;
equation
  when sum({a, c}) > time then
    y = 1;
  end when;
end LwbA5Sum;
//// model: LwbA5Vec
model LwbA5Vec
  Real v[2];
  discrete Real y;
equation
  v = {time, 2 * time};
  when {v[1] > 1, v[2] > 1} then
    y = 1;
  end when;
end LwbA5Vec;
//// model: LwbA5For
model LwbA5For
  discrete Real y;
equation
  when {time > i for i in 1:3} then
    y = 1;
  end when;
end LwbA5For;
//// model: LwbA5Bool
model LwbA5Bool
  Boolean b[2];
  discrete Real y;
equation
  b = {time > 1, time > 2};
  when b then
    y = 1;
  end when;
end LwbA5Bool;
//// model: LwbA5Rhs
model LwbA5Rhs
  discrete Real y;
equation
  when time > 1 then
    y = sum({time, 1});
  end when;
end LwbA5Rhs;
//// model: LwbA5Msg
model LwbA5Msg
  Real x;
equation
  x = time;
  assert(sum({x, 1}) > 0, "m");
end LwbA5Msg;
//// model: LwbA5Sub
model LwbA5Sub
  parameter Real v[2] = {1, 2};
  discrete Real y;
equation
  when {time > v[1], time > v[2]} then
    y = 1;
  end when;
end LwbA5Sub;
