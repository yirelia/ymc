//// model: LwbHNest
model LwbHNest
  model M
    Real a(start = 1, fixed = true);
    Real b;
    discrete Real d;
  equation
    der(a) = 1;
    when a > 1 then
      b = 1;
    end when;
    when a > 2 then
      d = 2;
      reinit(a, 0);
    end when;
    assert(a > 0, "m");
  end M;
  M m1, m2;
end LwbHNest;
//// model: LwbHDeep
model LwbHDeep
  model N
    Real c;
  equation
    when time > 1 then
      c = 1;
    end when;
  end N;
  model M
    N n;
    Real e;
  equation
    when n.c > 0 then
      e = n.c + 1;
    end when;
  end M;
  M m;
end LwbHDeep;
//// model: LwbHOutside
model LwbHOutside
  model M
    Real c;
  end M;
  M m;
  Real v;
equation
  when time > 1 then
    m.c = 1;
  end when;
  v = pre(m.c);
end LwbHOutside;
//// model: LwbHExt
model LwbHExt
  model A
    Real c;
  equation
    when time > 1 then
      c = 1;
    end when;
    assert(time < 5, "a");
  end A;
  model B
    extends A;
    Real d;
  equation
    when c > 0 then
      d = 1;
    end when;
  end B;
  extends B;
  Real e;
equation
  e = 2;
end LwbHExt;
//// model: LwbHConn
model LwbHConn
  connector C
    Real v;
    flow Real i;
  end C;
  C c1, c2;
equation
  connect(c1, c2);
  when time > 1 then
    c1.v = 1;
  end when;
end LwbHConn;
//// model: LwbHConnFlow
model LwbHConnFlow
  connector C
    Real v;
    flow Real i;
  end C;
  model M
    C c;
  equation
    when time > 1 then
      c.i = 1;
    end when;
  end M;
  M m;
end LwbHConnFlow;
//// model: LwbHConnPar
model LwbHConnPar
  connector C
    parameter Real p;
    Real v;
    flow Real i;
  end C;
  model M
    C c(p = 1);
  end M;
  model K
    C c(p = 2);
  end K;
  M m;
  K k;
equation
  connect(m.c, k.c);
  assert(time < 1, "x");
end LwbHConnPar;
