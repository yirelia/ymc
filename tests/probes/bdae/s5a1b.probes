  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x(start = 1, fixed = true);
equation
  der(x) = 1;
  when true then
    h(x + 0);
  elsewhen false then
    reinit(x, 11);
  elsewhen x > 3 then
    h(x + 2);
  end when;
end LwbE314l;
//// model: LwbE314v
model LwbE314v
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x(start = 1, fixed = true);
equation
  der(x) = 1;
  when {x > 1, x < 0} then
    h(x + 0);
  elsewhen {x > 2} then
    reinit(x, 11);
  elsewhen x > 3 then
    h(x + 2);
  end when;
end LwbE314v;
//// model: LwbE315p
model LwbE315p
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x(start = 1, fixed = true);
equation
  der(x) = 1;
  when x > 1 then
    h(x + 0);
  elsewhen x > 2 then
    reinit(x, 11);
  elsewhen x > 3 then
    reinit(x, 12);
    terminate("t2");
  end when;
end LwbE315p;
