//// set: s5a1b — S5a-1b：when / assert / reinit 的 lower 与 (After Lowering)。Lwb 前缀，走 tools/bdae_sweep.py --probes。LwbC*：条件形态 × 六种位置（赋值、reinit、elsewhen 前后的条件泄漏、split 第三段、assert）；LwbE*：elsewhen 链逐分支组合；LwbA* / LwbV*：赋值右边、声明 × 类型；LwbR*：reinit；LwbT*：terminate；LwbS* / LwbM*：assert 的条件、消息、级别；LwbX*：混排时的编号与入桶；LwbH* / LwbDropped*：层次、继承、inner / outer、被丢弃的分支；其余是单点形状。
//// model: LwbC000a
model LwbC000a
  function f
    input Real u;
    output Real v;
  algorithm
    v := u + 1;
  end f;
  function g
    input Real u;
    output Boolean v;
  algorithm
    v := u > 0;
  end g;
  type E = enumeration(a, b, c);
  parameter Real p = 0.5, q = 1.5, r = 2.5;
  parameter Integer k = 2;
  parameter Boolean t = true;
  Real x(start = 1, fixed = true), z(start = 2, fixed = true);
  Real w;
  Integer n(start = 0, fixed = true);
  Boolean b, c;
  E e(start = E.a, fixed = true);
  String s(start = "a");
  discrete Real d;
  discrete Real y;
equation
  der(x) = 1;
  der(z) = x;
  w = sin(time);
  b = x > 1.5;
  c = z > 0.5;
  when time > 100 then
    d = 0;
  end when;
  when x > 1 then
    y = 1;
  end when;
end LwbC000a;
//// model: LwbC000r
model LwbC000r
  function f
    input Real u;
    output Real v;
  algorithm
    v := u + 1;
  end f;
  function g
    input Real u;
    output Boolean v;
  algorithm
    v := u > 0;
  end g;
  type E = enumeration(a, b, c);
  parameter Real p = 0.5, q = 1.5, r = 2.5;
  parameter Integer k = 2;
  parameter Boolean t = true;
  Real x(start = 1, fixed = true), z(start = 2, fixed = true);
  Real w;
  Integer n(start = 0, fixed = true);
  Boolean b, c;
  E e(start = E.a, fixed = true);
  String s(start = "a");
  discrete Real d;
equation
  der(x) = 1;
  der(z) = x;
  w = sin(time);
  b = x > 1.5;
  c = z > 0.5;
  when time > 100 then
    d = 0;
  end when;
  when x > 1 then
    reinit(x, 0);
  end when;
end LwbC000r;
//// model: LwbC000l
model LwbC000l
  function f
    input Real u;
    output Real v;
  algorithm
    v := u + 1;
  end f;
  function g
    input Real u;
    output Boolean v;
  algorithm
    v := u > 0;
  end g;
  type E = enumeration(a, b, c);
  parameter Real p = 0.5, q = 1.5, r = 2.5;
  parameter Integer k = 2;
  parameter Boolean t = true;
  Real x(start = 1, fixed = true), z(start = 2, fixed = true);
  Real w;
  Integer n(start = 0, fixed = true);
  Boolean b, c;
  E e(start = E.a, fixed = true);
  String s(start = "a");
  discrete Real d;
  discrete Real y;
equation
  der(x) = 1;
  der(z) = x;
  w = sin(time);
  b = x > 1.5;
  c = z > 0.5;
  when time > 100 then
    d = 0;
  end when;
  when x > 1 then
    y = 1;
  elsewhen x > 9 then
    y = 2;
    reinit(x, 0);
  end when;
end LwbC000l;
