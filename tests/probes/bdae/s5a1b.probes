  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x(start = 1, fixed = true);
equation
  der(x) = 1;
  when true then
    reinit(x, 10);
    terminate("t0");
  elsewhen false then
    reinit(x, 11);
    terminate("t1");
  elsewhen x > 3 then
    reinit(x, 12);
  end when;
end LwbE366l;
//// model: LwbE366v
model LwbE366v
  function h
    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x(start = 1, fixed = true);
equation
  der(x) = 1;
  when {x > 1, x < 0} then
    reinit(x, 10);
    terminate("t0");
  elsewhen {x > 2} then
    reinit(x, 11);
    terminate("t1");
  elsewhen x > 3 then
    reinit(x, 12);
  end when;
end LwbE366v;
