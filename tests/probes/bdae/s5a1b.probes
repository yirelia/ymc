    input Real u;
  algorithm
    assert(u > 0, "h");
  end h;
  Real x(start = 1, fixed = true);
equation
  der(x) = 1;
  when x > 1 then
    h(x + 0);
  elsewhen x > 2 then
    h(x + 1);
  elsewhen x > 3 then
    reinit(x, 12);
    h(x + 2);
  end when;
end LwbE328p;
