//// model: LwbC003t
model LwbC003t
  function f
    input Real u;
    output Real v;
  algorithm
    v := u + 1;
  end f;
  function g
    input Real u;
    output Boolean v;
  algorithm
    v := u > 0;
  end g;
  type E = enumeration(a, b, c);
  parameter Real p = 0.5, q = 1.5, r = 2.5;
  parameter Integer k = 2;
  parameter Boolean t = true;
  Real x(start = 1, fixed = true), z(start = 2, fixed = true);
  Real w;
  Integer n(start = 0, fixed = true);
  Boolean b, c;
  E e(start = E.a, fixed = true);
  String s(start = "a");
  discrete Real d;
equation
  der(x) = 1;
  der(z) = x;
  w = sin(time);
  b = x > 1.5;
  c = z > 0.5;
  when time > 100 then
    d = 0;
  end when;
  when x > 9 then
    reinit(x, 1);
  elsewhen x <= 1 then
    terminate("a");
  elsewhen z > 9 then
    reinit(x, 2);
  end when;
end LwbC003t;
