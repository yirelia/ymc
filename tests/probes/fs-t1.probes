//// set: fs-t1 — 函数体里的数组切片：`:`、范围、end、下标数组；sum / 取负 / 乘；左侧切片
//// model: T10
model T10
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[3]; input Real q[:, :]; input Real g[2, 3]; input Integer k; output Real o; protected Real v[size(u, 1)]; Real v3[3]; Real v2[2]; Real s; algorithm s := 1; v := u; v3 := w; v2 := {1, 2}; v2 := u[1:2]; o := s; end f; Real y = f(x, x, m, m, 1);
end T10;
