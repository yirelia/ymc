//// model: C156
model C156
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Integer n = size(a, 1) + size(a.x, 1) + size(a.v, 2); Integer m = ndims(a.v);
end C156;
//// model: C157
model C157
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
