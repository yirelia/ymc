//// set: ca-c1 — 复合数组的元素引用（绑定 / sum / 等式右侧）：洞、切片、数组字段、多维、多层、越界、size
//// model: C10
model C10
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y = sum(a.x);
end C10;
//// model: C11
model C11
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y = sum(a[:].x);
end C11;
