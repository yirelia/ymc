//// model: C140
model C140
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  R r[2]; Real y[2] = r.s;
equation
  for i in 1:2 loop r[i].s = tt; r[i].t = {tt, i}; end for;
end C140;
//// model: C141
model C141
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  R r[2]; Real y[2, 2] = r.t;
equation
  for i in 1:2 loop r[i].s = tt; r[i].t = {tt, i}; end for;
end C141;
//// model: C142
model C142
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  R r[2]; Real y = sum(r.t) + sum(r[:].s);
equation
  for i in 1:2 loop r[i].s = tt; r[i].t = {tt, i}; end for;
end C142;
//// model: C143
model C143
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  parameter R p[2](s = {1, 2}, t = {{1, 2}, {3, 4}}); Real y = sum(p.s) * tt; parameter Real q[2] = p.s; parameter Real u[2, 2] = p.t;
end C143;
//// model: C144
model C144
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y; algorithm y := sum(a.x) + a[2].v[1];
end C144;
//// model: C145
model C145
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y[3]; algorithm y := a.x;
end C145;
//// model: C146
model C146
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y[3, 2]; algorithm y := a.v;
