//// model: C147
model C147
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3](x = {tt, 1, 2}); Real y = sum(a.x);
end C147;
//// model: C148
model C148
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y = max(a.x) + min(a[1:2].x) + product(a.k);
end C148;
//// model: C149
model C149
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  model B A q[2]; Real w = time; end B;
  record R Real s; Real t[2]; end R;
  Real tt = time;
  A a[3]; Real y = a[3].x * a[1].k;
end C149;
