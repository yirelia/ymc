//// model: CL21
package P
  type K = enumeration(Lin, H01, RMS);
end P;
model CL21
  model V
    parameter P.K k = P.K.Lin;
    Modelica.Blocks.Tables.CombiTable1Ds tab(final table = if k == P.K.Lin then Lin elseif k == P.K.H01 then H01 else RMS, final extrapolation = Modelica.Blocks.Types.Extrapolation.HoldLastPoint);
  protected
    constant Real Lin[:, 2] = [0, 1; 1, 0];
    constant Real H01[:, 2] = [0, 1; 0.5, 0.7; 1, 0];
    constant Real RMS[:, 2] = [0, 1; 0.2, 0.9; 0.6, 0.4; 1, 0];
  end V;
  V v(k = P.K.RMS);
equation
  v.tab.u = time;
end CL21;
//// model: CL22
package P
  type K = enumeration(A, B, C);
end P;
model CL22
  parameter P.K k = P.K.C;
  parameter Real t[:, :] = if k == P.K.A then Lin elseif k == P.K.B then H else R;
protected
  constant Real Lin[:, 2] = [0, 1; 1, 0];
  constant Real H[:, 2] = [0, 1; 0.5, 0.7; 1, 0];
  constant Real R[:, 2] = [0, 1; 0.2, 0.9; 1, 0];
end CL22;
