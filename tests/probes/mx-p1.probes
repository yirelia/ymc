package P
  type K = enumeration(A, B, C);
end P;
model CL23
  parameter P.K k = P.K.B;
  parameter Real t[:, :] = if k == P.K.A then Lin elseif k == P.K.B then H else R;
protected
  constant Real Lin[:, 2] = [0, 1; 1, 0];
  constant Real H[:, 2] = [0, 1; 0.5, 0.7; 1, 0];
  constant Real R[:, 2] = [0, 1; 0.2, 0.9; 1, 0];
end CL23;
//// model: CL24
model CL24
  parameter Boolean b1 = false;
  parameter Boolean b2 = true;
  parameter Real t[:] = if b1 then {1, 2} elseif b2 then {3, 4, 5} else {6, 7, 8};
  Real y = time;
end CL24;
//// model: CR1
model CR1
  connector Pl
    parameter Integer m = 1;
    Real v[m];
  end Pl;
  parameter Integer k = 1;
  parameter Integer j = 3 * k;
  parameter Boolean use = false;
  Pl p(final m = k) if use;
  Real y = j;
end CR1;
//// model: CR2
model CR2
  model Sub
    parameter Integer m = 1;
    Real v[m];
  end Sub;
  parameter Integer k = 2;
  parameter Integer j = 3 * k;
  Sub s(m = k) if false;
  Real y = j;
end CR2;
//// model: CR3
model CR3
  model Sub
    parameter Integer m = 1;
    Real v[m];
  end Sub;
  parameter Integer k = 2;
  parameter Integer j = 3 * k;
  Sub s(m = k) if true;
  Real y = j;
end CR3;
//// model: TB1
model TB1
  parameter Integer m = 3;
  Modelica.Electrical.Machines.Utilities.MultiTerminalBox terminalBox(m = m, terminalConnection = "Y");
end TB1;
//// model: TB2
model TB2
  function nsb
    input Integer m;
    output Integer n;
  algorithm
    n := if m == 3 then 1 else 2;
  end nsb;
  model Box
    parameter Integer m(min = 1) = 3 annotation(Evaluate = true);
    final parameter Integer mSystems = nsb(m);
    final parameter Integer mBasic = integer(m / mSystems);
  end Box;
  parameter Integer m = 3;
  Box terminalBox(m = m);
end TB2;
//// model: TB3
model TB3
  parameter Integer m = 3;
  Modelica.Electrical.Machines.Utilities.MultiTerminalBox terminalBox(m = m, terminalConnection = "D");
end TB3;
