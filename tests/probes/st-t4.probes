//// set: st-t4 — Evaluate 求值碰到声明在后的参数：值照用、绑定不存回（d.scp.m 照打 d.m）
//// model: T40
record CP
parameter Integer m;
parameter Real PRef = 0;
end CP;
record Data
parameter Integer m = 3;
parameter CP scp(final m = m);
end Data;
model Core
parameter CP cp(m = 5);
final parameter Integer m = cp.m annotation(Evaluate = true);
end Core;
model M
parameter CP scp;
Core core(final cp = scp);
end M;
model T40
M mm(scp = d.scp);
parameter Data d;
end T40;
