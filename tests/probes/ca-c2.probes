//// model: C225
model C225
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
  Integer n = integer(tt); Real z = a[n].x; algorithm y := {1, 2, 3}; s := 0;
end C225;
//// model: C226
model C226
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
  Integer n = integer(tt); Real z = a[n].v[1] + a[n + 1].k; algorithm y := {1, 2, 3}; s := 0;
end C226;
//// model: C227
model C227
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
  Integer n = integer(tt); Real z[2] = a[n].v; algorithm y := {1, 2, 3}; s := 0;
end C227;
//// model: C228
model C228
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
equation
  s = 0; for i in 1:3 loop y[i] = a[i].x; end for;
end C228;
//// model: C229
model C229
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
equation
  s = 0; y = {a[i].x for i in 1:3};
end C229;
//// model: C230
model C230
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
  algorithm y := a.x; s := 0; when tt > 1 then y := a.k; end when;
end C230;
