model C223
  model A Real x = time; parameter Real k = 1; Real v[2] = {time, 1}; end A;
  function f input Real u[:]; output Real s; algorithm s := sum(u); end f;
  Real tt = time;
  A a[3];
  Real y[3];
  Real s;
  Real z = max(a[i].x for i in 1:3); algorithm y := {1, 2, 3}; s := 0;
