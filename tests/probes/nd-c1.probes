//// set: nd-c1 — 推导式绑定：`:` 维、多迭代变量、参数 / 常量 / 连续变量
//// model: C10
model C10
  Real a = time;
  parameter String s1[:] = {String(i) for i in 1:3};
end C10;
//// model: C11
model C11
  Real a = time;
  parameter String s1[3] = {String(i) for i in 1:3};
end C11;
//// model: C12
model C12
  Real a = time;
  parameter String s2[:, :] = {String(i + j) for i in 1:3, j in 1:2};
end C12;
//// model: C13
model C13
  Real a = time;
  parameter String s2[2, 3] = {String(i + j) for i in 1:3, j in 1:2};
end C13;
//// model: C14
model C14
  Real a = time;
  parameter Integer s2[:, :] = {i + j for i in 1:3, j in 1:2};
end C14;
//// model: C15
model C15
  Real a = time;
  parameter Integer s2[2, 3] = {i + j for i in 1:3, j in 1:2};
end C15;
//// model: C16
model C16
  Real a = time;
  parameter Real s2[2, 3] = {i * j for i in 1:3, j in 1:2};
end C16;
//// model: C17
model C17
  Real a = time;
  constant Integer s2[:, :] = {i + j for i in 1:3, j in 1:2};
end C17;
//// model: C18
model C18
  Real a = time;
  constant Integer s2[2, 3] = {i + j for i in 1:3, j in 1:2};
end C18;
//// model: C19
model C19
  Real a = time;
  Real s2[2, 3] = {i * j * a for i in 1:3, j in 1:2};
end C19;
//// model: C110
model C110
  Real a = time;
  Real s2[:, :] = {i * j * a for i in 1:3, j in 1:2};
end C110;
//// model: C111
model C111
  Real a = time;
  parameter Integer n = 2; parameter Integer s[:] = {i * n for i in 1:3};
end C111;
//// model: C112
model C112
  Real a = time;
  parameter Integer n = 2; parameter Integer s[:] = {i for i in 1:n};
end C112;
//// model: C113
model C113
  Real a = time;
  parameter Integer n = 2; parameter Integer s[:, :] = {i * j for i in 1:n, j in 1:3};
end C113;
//// model: C114
model C114
  Real a = time;
  parameter Integer n = 2; parameter Real s[:] = {i * 1.5 for i in 1:n};
end C114;
//// model: C115
model C115
  Real a = time;
  parameter Real p[3] = {1, 2, 3}; parameter Real q[:, :] = {p[i] * p[j] for i, j};
end C115;
//// model: C116
model C116
  Real a = time;
  parameter Real p[3] = {1, 2, 3}; parameter Real q[3, 3] = {p[i] * p[j] for i, j};
end C116;
//// model: C117
model C117
  Real a = time;
  Real x[3] = {a, a, a}; Real q[:, :] = {x[i] * x[j] for i, j};
end C117;
