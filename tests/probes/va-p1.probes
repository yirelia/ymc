//// set: va-p1 — 记录数组：声明类型是带修饰的短类（SI.ComplexVoltage、`record S = R0(a(start = 3))`、`operator record CX = Complex(re(start = 1))`）每个元素照收短类修饰；记录数组作记录形参的实参照样向量化（`abs(v)` → `array(abs(v[$i1]) for $i1 in 1:2)`）；连接器数组的字段 `p.v` 作实参仍 SKIP
//// model: VA1
model VA1
  Modelica.Units.SI.ComplexVoltage v[2];
  Real a[2] = Modelica.ComplexMath.abs(v);
equation
  v[1] = Complex(time, 1);
  v[2] = Complex(1, time);
end VA1;
//// model: VA2
model VA2
  record R0
    Real a = 1;
    Real b = 2;
  end R0;
  record S = R0(a(start = 3), b(min = 0));
  S s[2];
equation
  s[1].a = time;
  s[2].a = 2 * time;
end VA2;
//// model: VA3
model VA3
  operator record CX = Complex(re(start = 1), im(nominal = 2));
  CX z[2];
  Real p[2] = Modelica.ComplexMath.real(z);
  Real q[2] = Modelica.ComplexMath.arg(z);
equation
  z[1] = Complex(time, 0);
  z[2] = Complex(0, time);
end VA3;
//// model: VA4
model VA4
  connector Pin
    Modelica.Units.SI.ComplexElectricPotential v;
    flow Modelica.Units.SI.ComplexCurrent i;
  end Pin;
  Pin p[3];
  Real s[3] = Modelica.ComplexMath.imag(p.v);
equation
  for k in 1:3 loop
    p[k].v = Complex(k * time, 0);
  end for;
end VA4;
