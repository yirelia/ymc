  replaceable model Y
    Real v = 1;
  end Y;
  model W
    Y y;
  end W;
end A;
model Z
  Real v = 3;
end Z;
model D
  Real r = 0;
  extends A;
  W w;
end D;
model R68fVVG05
  D d(redeclare model Y = Z);
end R68fVVG05;
//// model: R68fVVNXA
model A
  model B
    model C
      Real z = 1;
    end C;
    C c;
    Real x = 1;
  end B;
end A;
model R68fVVNXA
  model E
    extends B;
  end E;
  E e;
  extends A(B(C(z = 2)));
end R68fVVNXA;
//// model: R68fVVNXB
model A
  model B
    Real x = 1;
    Real y = 1;
  end B;
  model B2
    extends B;
  end B2;
  B2 b2;
end A;
model R68fVVNXB
  parameter Real q = 4;
  A a(B(x = 1, y = q));
end R68fVVNXB;
//// model: R68fVVNXC
model A
  model B
    model C
      Real z = 1;
    end C;
    C c;
    Real x = 1;
  end B;
  B b;
end A;
model M1
  extends A(B(x = 3));
end M1;
model R68fVVNXC
  M1 m(B(C(z = 2)));
end R68fVVNXC;
//// model: R68fVVNXD
model A
  model B
    Real x = 1;
  end B;
  model B2
    extends B;
  end B2;
  B2 b2;
  B b;
end A;
model R68fVVNXD
  A a(B(x = 6));
end R68fVVNXD;
//// model: R68fVVNXE
model A
  model B
    Real x = 1;
  end B;
  model B2
    extends B;
  end B2;
  B2 b2;
end A;
model R68fVVNXE
  constant Real q = 4;
  A a(B(x = q));
end R68fVVNXE;
//// model: R68fVVNXF
model A
  model B
    Real x = 1;
  end B;
  model B2
    extends B;
  end B2;
  B2 b2;
end A;
model R68fVVNXF
  A a(B(x = 2 * 3 - 1 / 4));
end R68fVVNXF;
