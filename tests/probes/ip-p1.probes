//// set: ip-p1 — 纯函数里"顶层"调 impure 函数 → omc 后标成 impure（checkPureCall，Function.foldExp 浅遍历）：无返回值调用 / 赋值右侧整个是调用 / for 体 / while 条件 / 局部与输入缺省的绑定 / 元组赋值（IP3 / IP6-IP8 / IPF / IPH / IPI）、传递且与声明先后无关（IP5 / IPC）；嵌在运算里（IP1 / IP2 / IP4 / IP9 / IPB）与被 Integer → Real 转型包住的（IPE）不算，被求值函数体里嵌着的 impure 调用照常求值；标了的不再常量折叠（`parameter Real p = f(1.0)` 照留）。常量绑定里顶层的 impure 调用 omc 照样求值（IPA / IPD）未做 SKIP
//// model: IP1
model IP1
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    y := g(x) + 1;
  end f;
  parameter Real p = f(1.0);
  Real a;
initial equation
  a = f(2.0);
equation
  when time > 0.5 then
    reinit(a, f(3.0));
  end when;
  der(a) = 0;
end IP1;
//// model: IP2
model IP2
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    y := g(x) + 1;
  end f;
  function h
    input Real x;
    output Real y;
  algorithm
    y := f(x) * 3;
  end h;
  parameter Real p = h(1.0);
  parameter Real q = f(1.0);
end IP2;
//// model: IP3
model IP3
  impure function g
    input Real x;
  algorithm
    assert(x > 0, "x");
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    g(x);
    y := x + 1;
  end f;
  parameter Real p = f(1.0);
end IP3;
//// model: IP4
model IP4
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    y := g(x) + 1;
  end f;
  Real a = f(time);
end IP4;
//// model: IP5
model IP5
  impure function g
    input Real x;
  algorithm
    assert(x > 0, "x");
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    g(x);
    y := x + 1;
  end f;
  function h
    input Real x;
    output Real y;
  algorithm
    y := f(x);
  end h;
  parameter Real p = h(1.0);
end IP5;
//// model: IP6
model IP6
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    y := g(x);
  end f;
  parameter Real p = f(1.0);
  Real a = f(time);
end IP6;
//// model: IP7
model IP7
  impure function g
    input Real x;
  algorithm
    assert(x > 0, "x");
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    for i in 1:2 loop
      g(x);
    end for;
    y := x + 1;
  end f;
  Real a = f(time);
end IP7;
//// model: IP8
model IP8
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    output Real y;
  protected
    Real r = g(x);
  algorithm
    y := r + 1;
  end f;
  parameter Real p = f(1.0);
end IP8;
//// model: IP9
model IP9
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    assert(g(x) > 0, "neg");
    y := if x > 0 then g(x) else 0;
  end f;
  parameter Real p = f(1.0);
end IP9;
//// model: IPA
model IPA
  impure function g
    input Real x;
  algorithm
    assert(x > 0, "x");
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    g(x);
    y := x + 1;
  end f;
  constant Real c = f(1.0);
  Real a = c * time;
end IPA;
//// model: IPB
model IPB
  impure function g
    input Real x;
  algorithm
    assert(x > 0, "x");
  end g;
  function f
    input Real x;
    output Real y;
  algorithm
    g(x);
    y := x + 1;
  end f;
  function h
    input Real x;
    output Real y;
  algorithm
    y := f(x) + 1;
  end h;
  parameter Real p = h(1.0);
  Real a = h(time);
end IPB;
//// model: IPC
model IPC
  function h
    input Real x;
    output Real y;
  algorithm
    y := f(x);
  end h;
  function f
    input Real x;
    output Real y;
  algorithm
    g(x);
    y := x + 1;
  end f;
  impure function g
    input Real x;
  algorithm
    assert(x > 0, "x");
  end g;
  parameter Real p = h(1.0);
end IPC;
//// model: IPD
model IPD
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  constant Real c = g(1.0);
  parameter Real p = g(1.0);
  Real a = g(1.0) * time;
end IPD;
//// model: IPE
model IPE
  impure function gi
    input Integer n;
    output Integer m;
  algorithm
    m := 2 * n;
  end gi;
  function f
    input Integer n;
    output Real y;
  algorithm
    y := gi(n);
  end f;
  parameter Real p = f(1);
end IPE;
//// model: IPF
model IPF
  impure function g2
    input Real x;
    output Real a;
    output Real b;
  algorithm
    a := x;
    b := 2 * x;
  end g2;
  function f
    input Real x;
    output Real y;
  protected
    Real a, b;
  algorithm
    (a, b) := g2(x);
    y := a + b;
  end f;
  parameter Real p = f(1.0);
end IPF;
//// model: IPH
model IPH
  impure function gb
    input Real x;
    output Boolean b;
  algorithm
    b := x > 10;
  end gb;
  function f
    input Real x;
    output Real y;
  algorithm
    y := x;
    while gb(y) loop
      y := y - 1;
    end while;
  end f;
  parameter Real p = f(1.0);
end IPH;
//// model: IPI
model IPI
  impure function g
    input Real x;
    output Real y;
  algorithm
    y := 2 * x;
  end g;
  function f
    input Real x;
    input Real z = g(1.0);
    output Real y;
  algorithm
    y := x + z;
  end f;
  parameter Real p = f(1.0);
end IPI;
