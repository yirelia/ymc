//// model: PKF6
package P
  package Util
    function sq
      input Real x;
      output Real y;
    algorithm
      y := x * x;
    end sq;
  end Util;
  partial package PM
    constant Integer nX = 1;
    constant Integer nXi = nX - 1;
    constant Real k = 2.5;
    function h
      input Real x;
      output Real y;
    algorithm
      y := x * nX;
    end h;
    function h2
      input Real x;
      output Real y;
    algorithm
      y := h(x) + nXi;
    end h2;
    function hu
      input Real x;
      output Real y;
    algorithm
      y := P.Util.sq(x) + k;
    end hu;
    package Sub
      constant Integer m = nX + 1;
    end Sub;
    record R
      Real T;
    end R;
    function mk
      input Real T;
      output R r;
    algorithm
      r.T := T;
    end mk;
  end PM;
  package W
    extends PM(nX = 3, k = 4.0);
  end W;
  package W2
    extends PM;
  end W2;
  model V
    replaceable package M = PM;
    parameter Real p = M.k;
    Real y = p * time;
  end V;
  model S
    replaceable package M = PM;
    V v(redeclare package M = M);
  end S;
end P;
model PKF6
  P.S s(redeclare package M = P.W);
end PKF6;
