//// model: B123
function h
input Integer k;
output Integer y[3];
algorithm
y := {k, 2 * k, 3 * k};
end h;
model B123
Integer k = integer(time);
Real x[3];
equation
x = h(k) * 1.5;
end B123;
//// model: B124
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model B124
Real x[3](each start = 0);
equation
der(x) = f(time);
end B124;
//// model: B125
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
