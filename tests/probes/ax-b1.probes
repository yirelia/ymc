end B113;
//// model: B114
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model B114
Real x[3];
equation
x = 2 ./ f(time);
end B114;
//// model: B115
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model B115
Real x[3];
equation
x = f(time) ./ f(2 * time);
end B115;
//// model: B116
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model B116
parameter Real a[3] = {1, 2, 3};
Real x[3];
equation
x = f(time) * f(time) * a;
end B116;
//// model: B117
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model B117
parameter Real a[3] = {1, 2, 3};
Real s;
equation
s = f(time) * a;
end B117;
//// model: B118
function f
input Real t;
output Real y[3];
algorithm
y := {t, 2 * t, 3 * t};
end f;
model B118
parameter Real a[3] = {1, 2, 3};
Real x[3];
equation
x = a .* f(time) + {1, 2, 3};
end B118;
//// model: B119
function f
input Real t;
