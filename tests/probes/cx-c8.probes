//// model: C818
model C818
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  package P constant Real c[3] = {1, 2, 3}; constant Integer k[2] = {2, 3}; end P; Real y = P.c[P.k[n]];
end C818;
//// model: C819
model C819
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  package P constant Real c[3] = {1, 2, 3}; end P; Real y = P.c[n] * 2 + P.c[2];
end C819;
