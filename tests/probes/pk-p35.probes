//// model: IMQ7
package IMQ7P
  impure function g
    input Real u;
    output Real a;
    output Real b;
  algorithm
    a := u;
    b := 2 * u;
  end g;
  function f
    input Real u;
    output Real y;
  algorithm
    y := 0;
    while g(u) > y loop
      y := y + 1;
    end while;
  end f;
end IMQ7P;
model IMQ7
  Real y = IMQ7P.f(time);
end IMQ7;
//// model: IMQ8
package IMQ8P
  impure function g
    input Real u;
    output Boolean a;
    output Real b;
  algorithm
    a := u > 0;
    b := 2 * u;
  end g;
  function f
    input Real u;
    output Real y;
  algorithm
    y := 0;
    if g(u) then
      y := 1;
    end if;
  end f;
end IMQ8P;
model IMQ8
  Real y = IMQ8P.f(time);
end IMQ8;
