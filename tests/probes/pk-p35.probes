//// model: ENP1
package ENP1P
  type L = enumeration('U', 'X', '0', '1');
  package T
    constant L X01Table[L] = {L.'X', L.'X', L.'0', L.'1'};
  end T;
  function f
    input L x;
    output L y;
  algorithm
    y := T.X01Table[x];
  end f;
end ENP1P;
model ENP1
  ENP1P.L e = if time > 0.5 then ENP1P.L.'1' else ENP1P.L.'U';
  ENP1P.L g = ENP1P.f(e);
end ENP1;
//// model: ENP2
package ENP2P
  type L = enumeration('U', 'X', '0', '1');
  package T
    constant L X01Table[L] = {L.'X', L.'X', L.'0', L.'1'};
  end T;
  function f
    input Integer n;
    input L x[n];
    output L y[n];
  algorithm
    for i in 1:n loop
      y[i] := T.X01Table[x[i]];
    end for;
  end f;
end ENP2P;
model ENP2
  ENP2P.L e[2] = {ENP2P.L.'1', if time > 0.5 then ENP2P.L.'1' else ENP2P.L.'U'};
  ENP2P.L g[2] = ENP2P.f(2, e);
end ENP2;
//// model: ENP3
package ENP3P
  type L = enumeration('U', 'X', '0', '1');
  package T
    constant L AndTable[L, L] = [L.'U', L.'U', L.'0', L.'U';
                                 L.'U', L.'X', L.'0', L.'X';
                                 L.'0', L.'0', L.'0', L.'0';
                                 L.'U', L.'X', L.'0', L.'1'];
  end T;
  function f
    input L a;
    input L b;
    output L y;
  algorithm
    y := T.AndTable[a, b];
  end f;
end ENP3P;
model ENP3
  ENP3P.L e = if time > 0.5 then ENP3P.L.'1' else ENP3P.L.'U';
  ENP3P.L g = ENP3P.f(e, ENP3P.L.'1');
end ENP3;
