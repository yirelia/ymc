//// model: ENF7
package ENF7P
  type E = enumeration(a, b, c);
  function f
    input Real u;
    output Integer y;
  protected
    E t = E.c;
  algorithm
    if u > 0 then
      t := E.a;
    end if;
    y := Integer(t);
  end f;
end ENF7P;
model ENF7
  Integer k = ENF7P.f(time);
end ENF7;
