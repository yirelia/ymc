//// model: ENP9
package ENP9P
  type L = enumeration('U', 'X', '0', '1');
  type S = enumeration(s1, s2);
  package T
    constant L StrengthMap[L, S] = [L.'U', L.'U'; L.'X', L.'X'; L.'0', L.'0'; L.'1', L.'U'];
  end T;
  model M
    parameter S strength = S.s1;
    input L x;
    output L y;
    L z[2];
  algorithm
    y := T.StrengthMap[x, strength];
    z := fill(T.StrengthMap[L.'X', strength], 2);
  end M;
end ENP9P;
model ENP9
  ENP9P.M m(x = if time > 0.5 then ENP9P.L.'1' else ENP9P.L.'U');
end ENP9;
