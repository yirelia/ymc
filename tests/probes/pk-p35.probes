package ENF35P
  type E = enumeration(a, b, c);
  function f
    input E x;
    output E y;
  algorithm
    y := if x == E.a then E.c else E.b;
  end f;
end ENF35P;
model ENF35
  ENF35P.E g = ENF35P.f(ENF35P.E.a);
  ENF35P.E h = ENF35P.f(ENF35P.E.c);
end ENF35;
//// model: ENF36
model ENF36
  type E = enumeration(a, b, c);
  function f
    input Integer x;
    output E y;
  algorithm
    y := if x > 0 then E.c else E.b;
  end f;
  E g = f(1);
end ENF36;
//// model: ENF37
package ENF37P
  type E = enumeration(a, b, c);
  function f
    input E x;
    output Integer y;
  algorithm
    y := Integer(x);
  end f;
end ENF37P;
model ENF37
  parameter ENF37P.E p = ENF37P.E.b;
  Real x[ENF37P.f(p)];
equation
  x = fill(time, size(x, 1));
end ENF37;
//// model: ENF38
package ENF38P
  type E = enumeration(a, b, c);
  function f
    input Integer i;
    output E y;
  algorithm
    y := if i == 1 then E.a elseif i == 2 then E.b else E.c;
  end f;
end ENF38P;
model ENF38
  constant ENF38P.E c = ENF38P.f(3);
  parameter ENF38P.E p = ENF38P.f(2);
  ENF38P.E v = ENF38P.f(1);
end ENF38;
//// model: ENF39
function ENF39f
  input Integer i;
  output StateSelect s;
algorithm
  s := if i > 0 then StateSelect.prefer else StateSelect.never;
end ENF39f;
model ENF39
  Real x(stateSelect = ENF39f(1));
equation
  der(x) = -x;
end ENF39;
