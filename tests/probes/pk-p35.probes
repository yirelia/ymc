//// model: ENF33
package ENF33P
  type L = enumeration('U', 'X', '0', '1');
  function f
    input Integer n;
    output L m[n, 2];
  algorithm
    for i in 1:n loop
      for j in 1:2 loop
        if i == j then
          m[i, j] := L.'1';
        else
          m[i, j] := L.'0';
        end if;
      end for;
    end for;
  end f;
end ENF33P;
model ENF33
  parameter Integer n = 2;
  ENF33P.L m[n, 2];
algorithm
  m := ENF33P.f(n);
end ENF33;
//// model: ENF34
package ENF34P
  type L = enumeration('U', 'X', '0', '1');
  function f
    input Integer n;
    output L m[integer(2 ^ n), 2];
    output Integer k;
  algorithm
    k := 0;
    for i in 1:(2 ^ n) loop
      k := k + integer(i);
      m[integer(i), 1] := L.'1';
      m[integer(i), 2] := L.'0';
    end for;
  end f;
end ENF34P;
model ENF34
  parameter Integer n = 1;
  ENF34P.L m[2, 2];
algorithm
  m := ENF34P.f(n);
end ENF34;
