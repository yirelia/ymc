//// model: ENF23
package ENF23P
  type E = enumeration(a, b, c);
  function f
    input E x;
    output Integer y;
  algorithm
    y := match_it(x);
  end f;
  function match_it
    input E x;
    output Integer y;
  algorithm
    if x == E.a then
      y := 10;
    elseif x == E.b then
      y := 20;
    else
      y := 30;
    end if;
  end match_it;
end ENF23P;
model ENF23
  ENF23P.E e = if time > 0.5 then ENF23P.E.b else ENF23P.E.a;
  Integer k = ENF23P.f(e);
end ENF23;
