//// model: ENP11
package ENP11P
  type L = enumeration('U', 'X', '0', '1');
  package T
    constant L X01Table[L] = {L.'X', L.'X', L.'0', L.'1'};
  end T;
  function f
    input Integer n;
    input L x[n];
    output Integer y;
  protected
    L b;
  algorithm
    y := 1;
    for i in 1:n loop
      b := T.X01Table[x[i]];
      if b == L.'1' then
        y := y + integer(2 ^ (i - 1));
      elseif b == L.'X' then
        y := 0;
        break;
      end if;
    end for;
  end f;
end ENP11P;
model ENP11
  ENP11P.L e[2] = {ENP11P.L.'1', if time > 0.5 then ENP11P.L.'1' else ENP11P.L.'U'};
  Integer g = ENP11P.f(2, e);
end ENP11;
