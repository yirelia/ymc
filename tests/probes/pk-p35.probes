//// set: pk-p35 — 函数 / 记录里的枚举（67a：MSL Digital.Examples.RAM 此前 SKIP "function body references non-local [T.X01Table]"、Utilities.Examples.readRealParameterModel 此前 SKIP "record constructor [Modelica.Utilities.Types.TokenValue]"，现都 PASS）。记录构造函数的枚举字段打字面量表 `input enumeration(RealToken, …) tokenType`、缺省打字面量全路径、字段的属性修饰不打（DAEDumpTpl.dumpType 的 T_ENUMERATION 支，DAEDumpTpl.tpl:329-331 v1.25.0；ENR1-ENR16）；函数体里枚举维的包常量表换成值、下标不求值地应用：函数局部的枚举下标留成 `{…}[x]` / `{…}[a, b]`、枚举字面量下标按序数取元素（NFExpression.applyIndexExpArray :1454-1478 / toInteger :1876-1885；ENP1-ENP45）；值路的下标按维的类型取，常量实参的枚举函数调用求值成字面量（ENP7、ENP21、ENP22、ENP25-ENP27、ENP43、ENF35、ENF40、ENF41、ENI14）；内建枚举 StateSelect / AssertionLevel 作函数变量 / 记录字段的类型、体里的字面量打书写名（ENF19、ENR14、ENB*）；多输出 impure 函数在赋值右侧 / 条件里取首输出（TUPLE_ELEMENT）不使调用者成 impure，元组赋值 / 无返回值调用 / 绑定里照旧（NFTyping.mo:3254-3276 → NFTypeCheck.mo:2562-2579；IMQ1-IMQ10，RAM 的 getMemory 体里 `data := Streams.readLine(…)`），赋值右侧的 Integer 首输出提 Real 时转型套在调用上 `/*Real*/(g(u))[1]`（IMQ14 / IMQ16；绑定 / 方程 / 运算数照旧先取后转 IMQ11-IMQ13 / IMQ15 / IMQ17）。基线 ACCEPTS-INVALID（一并修）：枚举维常量表 / 局部的 Integer 下标（typeSubscript → checkSubscriptType，NFTyping.mo:2104-2182；ENP17-ENP19、ENI4、ENI6、ENI8、ENI9、ENI12、ENI13、ENF31），字面量表不同的两个枚举类型互用（matchEnumerationTypes NFTypeCheck.mo:2171-2183 只比字面量表：函数赋值 / 实参 / 缺省 / 关系 / 方程 / 绑定 / if 两支 / 数组字面量 / 元组赋值 / 模型算法赋值 / 值路的实参与输出，ENQ1-ENQ5、ENQ9、ENQ11-ENQ15、ENQ18、ENQ22、ENQ23、ENQ25、ENQ28；记录构造函数 / 常量调用放开后随之补的：ENQ6、ENQ8 枚举值绑给 Integer、ENQ21；字面量表相同、类型名不同的照收 ENQ7 / ENQ19 / ENQ20 / ENQ24），用户的顶层类与 NFModelicaBuiltin.mo 的 97 个顶层元素重名（顶层作用域 = 内建程序 ++ 用户程序，CevalScriptBackend.mo:3593 → NFClassTree.addLocalElementConflict :1603-1626 "An element with name delay is already declared in this scope"；DUQ1-DUQ30，此前只认 6 个名字；注释掉的 SimulationResult 与文件里没有的名字照收 DUQ18 / DUQ19 / DUQ28）。基线静默错（一并修）：IMQ1 / IMQ6 / IMQ8 / IMQ9 / IMQ10 多输出 impure 调用误标 impure、IMQ10 / IMQ14 / IMQ16 转型位置。照旧 SKIP：函数变量的类型名维（ENF25-ENF28、ENF32）、`for e in E`（ENF16）、模型里声明的枚举（ENF17、ENF36）、枚举的短类别名（ENF18、ENR15）、构造调用的记录在模型里没有实例（ENR6、ENR9）、向量下标（ENP24）、Boolean 维（ENI7、ENP29）、Evaluate = false 参数作下标（ENM5）、结构代入后的常量调用（ENF34）
//// model: ENF1
package ENF1P
  type E = enumeration(a, b, c);
  function f
    input E x;
    output Integer y;
  algorithm
    y := if x == E.b then 1 else 2;
  end f;
end ENF1P;
model ENF1
  ENF1P.E e = if time > 0.5 then ENF1P.E.b else ENF1P.E.a;
  Integer k = ENF1P.f(e);
end ENF1;
//// model: ENF2
package ENF2P
  type E = enumeration(a, b, c);
  function f
    input E x;
    output Integer y;
  algorithm
    y := if x == E.b then 1 else 2;
  end f;
end ENF2P;
model ENF2
  Integer k = ENF2P.f(ENF2P.E.b);
end ENF2;
//// model: ENF3
package ENF3P
  type E = enumeration(a, b, c);
  function f
    input Integer n;
    input E x[n];
    output Integer y;
  algorithm
    y := 0;
    for i in 1:n loop
      if x[i] == E.c then
        y := y + i;
      end if;
    end for;
  end f;
end ENF3P;
model ENF3
  ENF3P.E e[2] = {ENF3P.E.c, if time > 0.5 then ENF3P.E.b else ENF3P.E.c};
  Integer k = ENF3P.f(2, e);
end ENF3;
