//// model: ENR1
package ENR1P
  type TT = enumeration(RealToken, IntegerToken, NoToken);
  record TV
    TT tokenType;
    Real real;
  end TV;
  function f
    input Real u;
    output TV t;
  algorithm
    t.real := u;
    t.tokenType := if u > 0 then TT.RealToken else TT.NoToken;
  end f;
  function g
    input Real u;
    output Real y;
  protected
    TV t;
  algorithm
    t := f(u);
    y := if t.tokenType == TT.RealToken then t.real else 0.0;
  end g;
end ENR1P;
model ENR1
  Real y = ENR1P.g(time);
end ENR1;
