//// model: ENF19
function ENF19f
  input StateSelect s;
  output Integer y;
algorithm
  y := if s == StateSelect.prefer then 1 else 0;
end ENF19f;
model ENF19
  parameter StateSelect s = StateSelect.prefer;
  Integer k = ENF19f(s);
end ENF19;
