//// set: ax-ut — 单测原文：AX1-AX3（各形态）+ 由 SKIP 改正向的 R1a / R1b / R2s / R2 / M
//// model: AX1
function f
  input Real t;
  output Real y[3];
algorithm
  y := {t, 2 * t, 3 * t};
end f;
model AX1
  parameter Real a[3] = {1, 2, 3};
  parameter Real m[3, 3] = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
  Real x[3], y[3], z[3], w[3], v[3], u[3], s;
equation
  x = {1, 2, 3} + f(time);
  y = 2 * f(time);
  z = m * f(time);
  w = f(time) + a / 2;
  v = f(time) .- 1;
  u = -f(time) + a;
  s = f(time) * a;
end AX1;
//// model: AX2
function f
  input Real t;
  output Real y[3];
algorithm
  y := {t, 2 * t, 3 * t};
end f;
function h
  input Integer k;
  output Integer y[3];
algorithm
  y := {k, 2 * k, 3 * k};
end h;
model AX2
  parameter Real a[3] = {1, 2, 3};
  Integer k = integer(time);
  Real x[3] = a + f(time);
  Real y[3] = h(k);
  Real z[3];
equation
  z = if time > 0.5 then 2 * f(time) else a;
end AX2;
//// model: AX3
function g
  input Real t[3];
  output Real y[3];
algorithm
  y := 2 * t;
end g;
model S
  input Real r[3] = {0, 0, 0};
end S;
model AX3
  Real p[2, 2] = {{1, 2}, {3, 4}} * time;
  Real r0[3] = {1, 2, 3} * time;
  S s[2](r = {r0 + g(vector([p[i, :]; 0])) for i in 1:2});
end AX3;
//// model: M
function F
  input Real a;
  input Real b;
  output Real c = a + b;
end F;
model M
  Real x[3] = {time, 1, 2};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real l[3] = 2 * F(x, 1);
end M;
//// model: R2
model R2
  parameter Real q[3] = 2 * linspace(1, 2, 3);
  parameter Real r[3] = -{i for i in 1:3};
  parameter Real p[3] = {i * 1.5 for i in 1:3} + q;
  Real t = sum(2 * {i * time for i in 1:2});
end R2;
//// model: R1a
model R1a
  Real x[3];
equation
  x = 2 * {i * time for i in 1:3};
end R1a;
//// model: R1b
model R1b
  Real y[3] = -{i * time for i in 1:3};
end R1b;
//// model: R2s
model R2s
  Real s = {i * time for i in 1:3} * {1, 2, 3};
end R2s;
