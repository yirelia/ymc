//// set: pk-p55r-adv — 68f 对抗评审探针（S0 次序、F7 / F1 / F2 / F6 组件修饰路线、CM / RICM、break、F4、R / P 组）与收窄 N1-N3 的顺查
//// model: R68fAK001
model R68fAK001
  Real x[2] = break;
end R68fAK001;
//// model: R68fAK002
model A
  Real x = 1;
end A;
model R68fAK002
  A a[2](each x = break);
end R68fAK002;
//// model: R68fAK003
model A
  Real x[2] = {1, 2};
end A;
model R68fAK003
  A a(x = break);
end R68fAK003;
//// model: R68fAK004
model A
  Real x = 1;
end A;
model R68fAK004
  A a[2](x = {break, 3});
end R68fAK004;
//// model: R68fAK005
model R68fAK005
  Real x = if time > 1 then break else 1;
end R68fAK005;
//// model: R68fAK006
model R68fAK006
  input Real u = break;
  output Real y = break;
end R68fAK006;
//// model: R68fAK007
connector C
  Real e = break;
  flow Real f = break;
end C;
model R68fAK007
  C c;
end R68fAK007;
//// model: R68fAK008
model R68fAK008
  discrete Real x = break;
end R68fAK008;
//// model: R68fAK009
model A
  Real x(start = 1) = 2;
end A;
model R68fAK009
  A a(x(start = break) = break);
end R68fAK009;
//// model: R68fAK010
model A
  Real x(start = 1, fixed = true);
end A;
model R68fAK010
  A a(x(fixed = break));
end R68fAK010;
//// model: R68fAK011
model A
  Real x(stateSelect = StateSelect.prefer);
equation
  der(x) = 1;
end A;
model R68fAK011
  A a(x(stateSelect = break));
end R68fAK011;
//// model: R68fAK012
model A
  Real x(min = 0, max = 10, nominal = 2, unit = "m", quantity = "Length");
end A;
model R68fAK012
  A a(x(min = break, max = break, nominal = break, unit = break, quantity = break));
end R68fAK012;
//// model: R68fAK013
type T = Real(start = 3, unit = "s");
model R68fAK013
  T x(start = break) = break;
end R68fAK013;
//// model: R68fAK014
model A
  Real x = 1;
end A;
model R68fAK014
  extends A(x = break);
end R68fAK014;
