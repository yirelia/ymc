end SGC45;
//// model: SGF1
model SGF1
  parameter Real q(each fixed = true) = 3;
  parameter Real p = q annotation(Evaluate = true);
  Real y = p * time;
end SGF1;
//// model: SGF2
model SGF2
  parameter Real q[2](each fixed = true) = {3, 4};
  parameter Real p = q[1] annotation(Evaluate = true);
  Real y = p * time;
end SGF2;
//// model: SGF3
model SGF3
  parameter Real p = q annotation(Evaluate = true);
  parameter Real q(each fixed = true) = 3;
  Real y = p * time;
end SGF3;
//// model: SGF4
model SGF4
  parameter Real q(each fixed = false) = 3;
  parameter Real p = q annotation(Evaluate = true);
  Real y = p * time;
end SGF4;
//// model: SGF5
model B
  parameter Real q = 3;
end B;
model SGF5
  B b(q(each fixed = true));
  parameter Real p = b.q annotation(Evaluate = true);
  Real y = p * time;
end SGF5;
//// model: SGF6
model SGF6
  parameter Real q(each fixed = true) = 3;
  Real x[integer(q)];
  Real y = q * time;
end SGF6;
//// model: SGF7
model SGF7
  parameter Real q(fixed = true, each min = 0) = 3;
  parameter Real p = q annotation(Evaluate = true);
  Real y = p * time;
end SGF7;
//// model: SGB1
model PT
  Real m_flow(start = 0);
equation
  der(m_flow) = 1;
end PT;
model PL
  parameter Integer md = 1;
end PL;
model BM
  extends PT(m_flow(stateSelect = if md == 1 then StateSelect.default else StateSelect.prefer));
  extends PL(md = 1);
end BM;
model AA
  extends BM;
end AA;
model SGB1
  AA a;
end SGB1;
//// model: SGB2
model PT
  Real m_flow(start = 0);
equation
  der(m_flow) = 1;
end PT;
model BM
  parameter StateSelect s = StateSelect.prefer;
  extends PT(m_flow(stateSelect = s));
end BM;
model AA
  extends BM;
end AA;
model SGB2
  AA a;
end SGB2;
//// model: SGB3
model PT
  Real m_flow(start = 0);
equation
  der(m_flow) = 1;
end PT;
model BM
  parameter StateSelect s = StateSelect.prefer;
  extends PT(m_flow(stateSelect = s));
end BM;
model AA
  extends BM;
end AA;
model SGB3
  AA a(m_flow(stateSelect = StateSelect.always));
end SGB3;
//// model: SGB4
model PT
  Real m_flow(start = 0);
equation
