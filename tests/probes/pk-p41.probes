//// model: SGE17
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
function drop
  input BP bp;
  input Real i;
  output Real v;
algorithm
  v := bp.V * i / bp.IL;
end drop;
model SGE17
  parameter Real b = 2;
  parameter BP bp(IL = 2 * b);
  Real y;
equation
  if drop(bp, 100) >= 0 then
    y = time;
  else
    y = 2 * time;
  end if;
end SGE17;
//// model: SGE18
