  Real y = p[1] * time;
end SGA11;
//// model: SGA12
model SGA12
  parameter Real p[2](fixed = {true, true}) = {1, 2} annotation(Evaluate = true);
  Real y = p[1] * time;
end SGA12;
//// model: SGA13
model SGA13
  parameter Real p[2](each fixed = true, start = {1, 2}) annotation(Evaluate = true);
  Real y = p[1] * time;
end SGA13;
//// model: SGA14
model SGA14
  parameter Real p[2](each fixed = false) annotation(Evaluate = true);
