end PT;
model BM
  parameter StateSelect s = StateSelect.prefer;
  extends PT(m_flow(stateSelect = s));
end BM;
model AA
  extends BM(m_flow(stateSelect = StateSelect.never));
end AA;
model SGB4
  AA a;
end SGB4;
