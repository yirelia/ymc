  Real y = m[1] * time;
initial equation
  n = {0, 1};
end SGA34;
//// model: SGA35
model SGA35
  parameter Real n[2](each fixed = false, start = {0, 1}) annotation(Evaluate = true);
  Real z[2];
equation
  for i in 1:2 loop
    z[i] = n[i] * time;
  end for;
initial equation
  n = {0, 1};
end SGA35;
//// model: SGA36
model SGA36
  parameter Real n[2](each fixed = false, start = {0, 1}) annotation(Evaluate = false);
  Real y = n[1] * time;
initial equation
  n = {0, 1};
end SGA36;
