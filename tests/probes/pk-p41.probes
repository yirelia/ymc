end f;
model SGF27
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real b[3], c[3], x[3];
equation
  b = {time, 2 * time, 3 * time};
  c = b;
  x = 2 * cross(r, f(b)) - cross(r, f(c));
end SGF27;
//// model: SGF29
function f
  input Real u[3];
  output Real v[3];
algorithm
  v := 2 * u;
end f;
model SGF29
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real b[3], c[3], x[3];
equation
  b = {time, 2 * time, 3 * time};
  c = b;
  x = -cross(r, f(b)) - cross(r, f(c));
end SGF29;
//// model: SGF31
function f
  input Real u[3];
  output Real v[3];
algorithm
