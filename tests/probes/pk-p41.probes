//// model: SGF11
model SGF11
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], c[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  c = a;
  e = a;
  y = e * (a + b + cross(r, c) - cross(r, b));
end SGF11;
//// model: SGF12
model SGF12
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real b[3], c[3], e[3];
  Real y;
equation
  b = {time, 2 * time, 3 * time};
  c = b;
  e = b;
  y = e * (cross(r, c) - cross(r, b));
end SGF12;
//// model: SGF13
model SGF13
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], c[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  c = a;
  e = a;
  y = e * (a + cross(r, c) - cross(r, b));
end SGF13;
//// model: SGF14
model SGF14
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * (a - cross(r, b));
end SGF14;
//// model: SGF15
model SGF15
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], c[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  c = a;
  e = a;
  y = (a + cross(r, c) - cross(r, b)) * e;
end SGF15;
//// model: SGF16
model SGF16
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], c[3], x[3];
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  c = a;
  x = a + cross(r, c) - cross(r, b);
end SGF16;
//// model: SGF17
function f
  input Real u[3];
  output Real v[3];
algorithm
  v := 2 * u;
end f;
model SGF17
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], c[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  c = a;
  e = a;
  y = e * (a + b + cross(r, c) - cross(r, f(b)));
end SGF17;
//// model: SGF18
model SGF18
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], c[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  c = a;
  e = a;
  y = e * (cross(r, c) + cross(r, b));
end SGF18;
//// model: SGF19
model SGF19
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * ({a[1], a[2], a[3]} - {b[1], b[2], b[3]});
end SGF19;
//// model: SGF20
model SGF20
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * ({a[1] + 1, a[2], a[3]} - {b[1] * 2, b[2], b[3]});
end SGF20;
//// model: SGF21
model SGF21
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * (cross(r, a) .- cross(r, b));
end SGF21;
//// model: SGF22
model SGF22
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * (2 * cross(r, a) - cross(r, b));
end SGF22;
//// model: SGF23
function f
  input Real u[3];
  output Real v[3];
algorithm
  v := 2 * u;
end f;
model SGF23
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * ({a[1], a[2], a[3]} - f(b));
end SGF23;
//// model: SGF24
function f
  input Real u[3];
  output Real v[3];
algorithm
  v := 2 * u;
end f;
model SGF24
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real b[3], c[3], x[3];
equation
  b = {time, 2 * time, 3 * time};
  c = b;
  x = cross(r, f(b)) - cross(r, f(c));
end SGF24;
//// model: SGF25
function f
  input Real u[3];
  output Real v[3];
algorithm
  v := 2 * u;
end f;
model SGF25
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], x[3];
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  x = a + cross(r, f(b));
end SGF25;
//// model: SGF26
function f
  input Real u[3];
  output Real v[3];
algorithm
  v := 2 * u;
end f;
model SGF26
  parameter Real r[3] = {0.1, 0.5, 0} annotation(Evaluate = true);
  Real a[3], b[3], e[3];
  Real y;
equation
  a = {time, 2 * time, 3 * time};
  b = a;
  e = a;
  y = e * ({a[1], a[2], a[3]} + cross(r, f(b)));
end SGF26;
//// model: SGF27
function f
  input Real u[3];
