end PT;
model BM
  extends PT(m_flow(stateSelect = s));
  parameter StateSelect s = StateSelect.prefer;
end BM;
model AA
  extends BM;
  Real z = m_flow;
end AA;
model SGB12
  AA a;
end SGB12;
//// model: SGB13
