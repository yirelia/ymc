//// model: SGE1
block K
  parameter Real q[:] = {1};
  final parameter Integer n = max([size(q, 1); 1]);
  Real y[n];
equation
  for i in 1:n loop
    y[i] = q[i] * time;
  end for;
end K;
model SGE1
  parameter Real w = 2;
  K k(q = {w});
end SGE1;
//// model: SGE2
record DD
  parameter Real a = 3;
  parameter Real wMax = a * 2;
end DD;
block K
  parameter Real q[:] = {1};
  final parameter Integer n = max([size(q, 1); 1]);
  Real y[n];
equation
  for i in 1:n loop
    y[i] = q[i] * time;
  end for;
end K;
model SGE2
  parameter DD dd;
  K k(q = {dd.wMax});
end SGE2;
//// model: SGE3
function f
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
end f;
record DD
  parameter Real a = 3;
  parameter Real wMax = f(a);
end DD;
block K
  parameter Real q[:] = {1};
  final parameter Integer n = max([size(q, 1); 1]);
  Real y[n];
equation
  for i in 1:n loop
    y[i] = q[i] * time;
  end for;
end K;
model SGE3
  parameter DD dd;
  K k(q = {dd.wMax});
end SGE3;
//// model: SGE4
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
function drop
  input BP bp;
  input Real i;
  output Real v;
algorithm
  v := bp.V * i / bp.IL;
end drop;
record DD
  parameter Real a = 3;
  parameter BP bp;
  parameter Real wMax = a - drop(bp, 100);
end DD;
block K
  parameter Real q[:] = {1};
  final parameter Integer n = max([size(q, 1); 1]);
  Real y[n];
equation
  for i in 1:n loop
    y[i] = q[i] * time;
  end for;
end K;
model SGE4
  parameter DD dd;
  K k(q = {dd.wMax});
end SGE4;
