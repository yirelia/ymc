  extends PT(m_flow(fixed = f));
end BM;
model AA
  extends BM;
end AA;
model SGB10
  AA a;
end SGB10;
//// model: SGB11
model PT
  Real m_flow(start = 0);
equation
  der(m_flow) = 1;
end PT;
model BM
  parameter StateSelect s = StateSelect.prefer;
  parameter StateSelect s2 = StateSelect.avoid;
  extends PT(m_flow(stateSelect = s));
end BM;
model AA
