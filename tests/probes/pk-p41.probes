end SGA14;
//// model: SGA15
type FT = Real(fixed = false);
model SGA15
  parameter FT p[2](start = {1, 2}) annotation(Evaluate = true);
  Real y = p[1] * time;
initial equation
  p = {1, 2};
end SGA15;
//// model: SGA16
type FT = Real(fixed = false);
model SGA16
  parameter FT p = 3 annotation(Evaluate = true);
  Real y = p * time;
end SGA16;
//// model: SGA17
model B
  parameter Real n[3](each fixed = false, start = {0, 0, 1});
  Real y = n[1] * time;
initial equation
  n = {0, 0, 1};
end B;
model SGA17
  B b annotation(Evaluate = true);
end SGA17;
//// model: SGA18
model B
  parameter Real n[3](start = {0, 0, 1}) annotation(Evaluate = true);
  Real y = n[1] * time;
end B;
model SGA18
  B b(n(each fixed = false));
initial equation
  b.n = {0, 0, 1};
end SGA18;
//// model: SGA19
model SGA19
  parameter Real n[3](each fixed = false, start = {0, 0, 1}) annotation(Evaluate = true);
