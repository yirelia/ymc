  Real y[3](each start = 0); algorithm when a > 1 then for i loop y[i] := pre(y[i]) + 1; end for; end when;
end I24;
//// model: I25
model I25
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  Real s; Integer k; algorithm s := 0; k := 0; while k < 2 loop for i loop s := s + x[i]; end for; k := k + 1; end while;
end I25;
//// model: I26
model I26
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  Real s; algorithm s := 0; for i loop if x[i] > 0 then s := s + 1; end if; end for;
end I26;
//// model: I27
model I27
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  Real s; algorithm s := 0; for i loop s := s + sum(m[i, j] for j in 1:3); end for;
end I27;
