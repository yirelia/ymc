//// model: PKK12
model PKK12
  partial model Base
    replaceable partial function f
      input Real x;
      input Real k = 1;
      output Real y;
    end f;
    Real z = f(time);
  end Base;
  model D
    extends Base;
    redeclare function extends f
      input Real m = 3;
    algorithm
      y := m * k * x;
    end f;
  end D;
  D d;
end PKK12;
//// model: PKK13
model PKK13
  function f
    input Real v[3];
    output Real y;
  protected
    Real m[3, 3] = [ones(3), v, fill(2.5, 3)];
  algorithm
    y := m[1, 1] + m[3, 2] + m[2, 3];
  end f;
  Real y[3] = {time, 2 * time, 3};
  Real z = f(y);
  Real m2[3, 2] = [ones(3), y];
  Real m3[3, 2] = [fill(2, 3, 1), y];
end PKK13;
//// model: PKK14
model PKK14
  function solve2
    input Real A[:, size(A, 1)];
    input Real b[size(A, 1)];
    output Real x[size(b, 1)];
  protected
    Real Awork[size(A, 1), size(A, 1)] = A;
  algorithm
    x := b / Awork[1, 1];
  end solve2;
  Real b[2] = {time, 1};
  Real x[2] = solve2({{2, 0}, {0, 2}}, b);
end PKK14;
//// model: PKK15
model PKK15
  model System
    parameter Real T_start = 300;
    parameter Real p_start = 1e5;
  end System;
  partial model TwoPort
    outer System system "System wide properties";
    Real m_flow = time;
  end TwoPort;
  partial model LumpedVolume
    outer System system "System properties";
    parameter Boolean use_T_start = true;
    parameter Real T_start = if use_T_start then system.T_start else 2 * p_start;
    parameter Real p_start = system.p_start;
    Real T(start = T_start);
  equation
    der(T) = -T + T_start;
  end LumpedVolume;
  model Pump
    extends TwoPort;
    extends LumpedVolume(final p_start = 2e5);
  end Pump;
  inner System system;
  Pump pump;
end PKK15;
//// model: PKK16
package P16
  partial package PM
    replaceable record ThermodynamicState
      Real p;
    end ThermodynamicState;
    replaceable partial function setState
      input Real p;
      output ThermodynamicState s;
    end setState;
  end PM;
  package W
    extends PM;
    redeclare record extends ThermodynamicState
      Real T;
    end ThermodynamicState;
    redeclare function extends setState
    algorithm
      s := ThermodynamicState(p = p, T = 300);
    end setState;
  end W;
  model Mon
    replaceable package Medium = PM;
    input Medium.ThermodynamicState state_in;
  end Mon;
  model Pump
    replaceable package Medium = PM;
    Mon monitoring(redeclare final package Medium = Medium, final state_in = Medium.setState(time));
  end Pump;
end P16;
model PKK16
  P16.Pump pump(redeclare package Medium = P16.W);
end PKK16;
//// model: PKK17
package P16
  partial package PM
    replaceable record ThermodynamicState
      Real p;
    end ThermodynamicState;
    replaceable partial function setState
      input Real p;
      output ThermodynamicState s;
    end setState;
  end PM;
  package W
    extends PM;
    redeclare record extends ThermodynamicState
      Real T;
    end ThermodynamicState;
    redeclare function extends setState
    algorithm
      s := ThermodynamicState(p = p, T = 300);
    end setState;
  end W;
  model Mon
    replaceable package Medium = PM;
    input Medium.ThermodynamicState state_in;
  end Mon;
  model Pump
    replaceable package Medium = PM;
    Medium.ThermodynamicState st;
    Mon monitoring(redeclare final package Medium = Medium, final state_in = Medium.setState(time));
  equation
    st = Medium.setState(2 * time);
  end Pump;
end P16;
model PKK17
  P16.Pump pump(redeclare package Medium = P16.W);
end PKK17;
