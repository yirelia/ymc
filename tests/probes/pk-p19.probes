//// model: PKK19
package P19
  partial package PM
    type FixedPhase = Integer(min = 0, max = 2);
    type Temp = Real(min = 0);
    replaceable record ThermodynamicState
      FixedPhase phase;
      Temp T;
    end ThermodynamicState;
    replaceable partial function setState
      input Real p;
      output ThermodynamicState s;
    end setState;
  end PM;
  package W
    extends PM(Temp(min = 273.15, start = 300));
    redeclare record extends ThermodynamicState
      Real p;
    end ThermodynamicState;
    redeclare function extends setState
    algorithm
      s := ThermodynamicState(phase = 1, T = 300, p = p);
    end setState;
  end W;
  model Mon
    replaceable package Medium = PM;
    input Medium.ThermodynamicState state_in;
  end Mon;
  model Pump
    replaceable package Medium = PM;
    Mon monitoring(redeclare final package Medium = Medium, final state_in = Medium.setState(time));
  end Pump;
end P19;
model PKK19
  P19.Pump pump(redeclare package Medium = P19.W);
end PKK19;
