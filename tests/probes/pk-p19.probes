//// set: pk-p19 — 组件 / extends 修饰里重声明的函数（短类带修饰、长形态、class extends、数组、嵌套）、fill 列标量化、形参维引用自己、去重后的 outer、按包实例的记录构造函数、input 记录实参不求值
//// model: PKK1
package P
  package Chars
    partial function baseFlow
      input Real V_flow;
      output Real head;
    end baseFlow;
    function quadraticFlow
      extends baseFlow;
      input Real V_flow_nominal[3];
      input Real head_nominal[3];
    algorithm
      head := head_nominal[1] + V_flow * (V_flow_nominal[2] - head_nominal[3]);
    end quadraticFlow;
  end Chars;
  partial model PartialPump
    replaceable function flowCharacteristic = Chars.baseFlow;
    Real V_flow = time;
    Real head;
  equation
    head = flowCharacteristic(V_flow);
  end PartialPump;
  model Pump
    extends PartialPump;
  end Pump;
end P;
model PKK1
  P.Pump pumps(redeclare function flowCharacteristic = P.Chars.quadraticFlow(V_flow_nominal = {0, 0.25, 0.5}, head_nominal = {100, 60, 0}));
end PKK1;
//// model: PKK2
package P
  package Chars
    partial function baseFlow
      input Real V_flow;
      output Real head;
    end baseFlow;
    function quadraticFlow
      extends baseFlow;
      input Real V_flow_nominal[3];
      input Real head_nominal[3];
    algorithm
      head := head_nominal[1] + V_flow * (V_flow_nominal[2] - head_nominal[3]);
    end quadraticFlow;
    function linearFlow
      extends baseFlow;
      input Real a = 2;
    algorithm
      head := a * V_flow;
    end linearFlow;
  end Chars;
  partial model PartialPump
    replaceable function flowCharacteristic = Chars.baseFlow;
    Real V_flow = time;
    Real head;
  equation
    head = flowCharacteristic(V_flow);
  end PartialPump;
  model Pump
    extends PartialPump;
  end Pump;
  model CPump
    parameter Real q = 1;
    parameter Real h = 3;
    extends PartialPump(redeclare replaceable function flowCharacteristic = Chars.quadraticFlow(V_flow_nominal = {0, q, 1.5 * q}, head_nominal = {2 * h, h, 0}));
  end CPump;
  model LPump
    extends PartialPump;
    redeclare function flowCharacteristic
      extends Chars.baseFlow;
    algorithm
      head := 3 * V_flow;
    end flowCharacteristic;
  end LPump;
  model ZPump
    extends PartialPump;
    Real y = time * flowCharacteristic(0);
  end ZPump;
  model M
    parameter Real k = 0.25;
    P.Pump pumps(redeclare function flowCharacteristic = P.Chars.quadraticFlow(V_flow_nominal = {0, k, 2 * k}, head_nominal = {100, 60, 0}));
  end M;
end P;
model PKK2
  P.Pump pumps(redeclare function flowCharacteristic = P.Chars.linearFlow);
end PKK2;
