//// set: lx-v3 — 同上：多层 extends 修饰（start / 绑定 / 嵌套）、函数、枚举、记录构造、数组常量、条件、组件实例 / 子模型、each start、维、连接器、constant
//// model: V30
package P
constant Real q = 1;
model A
Real x(start = 0);
end A;
model B
extends A(x(start = q));
end B;
end P;
model V30
parameter Real q = 3;
extends P.B;
end V30;
//// model: V31
package P
constant Real q = 1;
model A
parameter Real a = 0;
end A;
model B
extends A(a = q);
end B;
end P;
model V31
parameter Real q = 3;
extends P.B;
end V31;
//// model: V32
package P
constant Real q = 1;
model C
parameter Real c = 0;
end C;
model A
C cc;
end A;
model B
extends A(cc(c = q));
end B;
end P;
model V32
parameter Real q = 3;
extends P.B;
end V32;
//// model: V33
package P
function f
input Real x;
output Real y;
algorithm
y := 2 * x;
end f;
model B
parameter Real p = f(1);
end B;
end P;
model V33
function f
input Real x;
output Real y;
algorithm
y := 3 * x;
end f;
extends P.B;
end V33;
//// model: V34
package P
type E = enumeration(a, b);
model B
parameter E e = E.b;
end B;
end P;
model V34
type E = enumeration(x, y, z);
extends P.B;
end V34;
//// model: V35
package P
constant Real q = 1;
record Rec
Real x;
end Rec;
model B
parameter Rec r = Rec(q);
end B;
end P;
model V35
parameter Real q = 3;
extends P.B;
end V35;
//// model: V36
package P
