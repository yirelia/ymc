//// set: fs-t2 — 函数体切片：向量 / 矩阵积、Integer 切片、控制流、多维、下标向量变量、fill
//// model: T20
model T20
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[3]; input Real q[:, :]; input Real g[2, 3]; input Integer k; input Integer n[:]; input Integer n2[2]; input Integer idx[:]; input Integer idx2[2]; input Real g2[3, 2]; output Real o; protected Real v[size(u, 1)]; Real v3[3]; Real v2[2]; Real s; algorithm s := 1; v := u; v3 := w; v2 := {1, 2}; s := u[1:2] * w[2:3]; o := s; end f; Real y = f(x, x, m, m, 1, {1, 2}, {1, 2}, {1, 2, 3}, {1, 2}, {{1, 2}, {3, 4}, {5, 6}});
end T20;
