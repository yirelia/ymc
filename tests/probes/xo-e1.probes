//// set: xo-e1 — 外部对象变量：final 丢掉、protected、默认 / 命名构造实参、传给外部函数、子实例 / 记录里、别名、参数实参、input、注释、等式、包里的类
//// model: E10
class EO
extends ExternalObject;
function constructor
input Integer i = 1;
output EO o;
external "C" o = initEO(i);
end constructor;
function destructor
input EO o;
external "C" freeEO(o);
end destructor;
end EO;
model E10
final parameter EO e = EO(2);
end E10;
