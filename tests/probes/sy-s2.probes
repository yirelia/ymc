//// set: sy-s2 — 同步算子：sample / hold / noClock / previous
//// model: D0
model D0
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = sample(x);
end D0;
//// model: D1
model D1
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = sample(x, Clock(0.1));
end D1;
