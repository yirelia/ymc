//// set: md-m12 — constant 绑定引用 parameter 的其它语境：子实例、修饰、组件数组、记录、实例路径、迭代变量遮蔽、函数局部
//// model: M120
model M120
  model A parameter Integer n = 2; constant Real c[3] = {1, 2, 3}; constant Real q = c[n]; end A; A a;
end M120;
//// model: M121
model M121
  model A parameter Integer n = 2; constant Real q[n] = fill(1.5, n); end A; A a;
end M121;
//// model: M122
model M122
  model A parameter Integer n = 2; constant Integer q = size(fill(1.5, n), 1); end A; A a;
end M122;
//// model: M123
model M123
  model A constant Integer k = 1; end A; parameter Integer n = 2; A a(k = sum(1:n));
end M123;
//// model: M124
model M124
  model A constant Integer k = 1; end A; parameter Integer n = 2; A a(k = size(fill(1, n), 1));
end M124;
//// model: M125
model M125
  model A constant Integer k = 1; end A; parameter Integer n = 2; A a[2](k = fill(1, n));
end M125;
//// model: M126
model M126
  model A constant Integer k = 1; end A; parameter Integer n = 2; A a[2](each k = sum(1:n));
end M126;
//// model: M127
model M127
  model A constant Integer k = 1; end A; constant Integer n = 2; A a[2](k = fill(1, n));
end M127;
//// model: M128
model M128
  model A constant Real k[2] = {1, 2}; end A; parameter Integer n = 2; A a(k = fill(1.5, n));
end M128;
//// model: M129
model M129
  model A constant Real k[2] = {1, 2}; end A; parameter Integer n = 2; A a[2](k = fill(1.5, 2, n));
end M129;
//// model: M1210
model M1210
  model A constant Real k[2] = {1, 2}; end A; parameter Integer n = 2; A a[2](each k = fill(1.5, n));
end M1210;
//// model: M1211
model M1211
  record R Real x; end R; parameter Integer n = 2; constant R r(x = sum(1:n));
end M1211;
//// model: M1212
model M1212
  record R Real x; end R; parameter Integer n = 2; constant R r = R(sum(1:n));
end M1212;
//// model: M1213
model M1213
  record R Real x[2]; end R; parameter Integer n = 2; constant R r(x = fill(1.5, n));
end M1213;
//// model: M1214
model M1214
  model A parameter Integer n = 2; end A; A a; constant Real c[3] = {1, 2, 3}; constant Real q = c[a.n];
end M1214;
//// model: M1215
model M1215
  model A constant Integer n = 2; end A; A a; constant Real c[3] = {1, 2, 3}; constant Real q = c[a.n];
end M1215;
//// model: M1216
model M1216
  parameter Integer i = 2; constant Integer q = sum(i for i in 1:3);
end M1216;
//// model: M1217
model M1217
  parameter Integer i = 2; constant Integer q[3] = {i for i in 1:3};
end M1217;
//// model: M1218
model M1218
  type E = enumeration(a, b, c); parameter Integer n = 2; constant E es[3] = {E.a, E.b, E.c}; constant E e = es[n];
end M1218;
//// model: M1219
model M1219
  function f input Integer n; output Real y; protected constant Real c[3] = {1, 2, 3}; constant Real q = c[n]; algorithm y := q; end f; Real y = f(2) * time;
end M1219;
//// model: M1220
model M1220
  parameter Integer n = 2; constant Real c[3] = {1, 2, 3}; parameter Real q = c[n];
end M1220;
//// model: M1221
model M1221
  parameter Integer n = 2; constant Real c[3] = {1, 2, 3}; Real q = c[n] * time;
end M1221;
//// model: M1222
model M1222
  parameter Integer n = 2; constant Real c[3] = {1, 2, 3}; constant Real q(start = c[n]) = 1;
end M1222;
//// model: M1223
model M1223
  parameter Integer n = 2; constant Integer q = size(fill(1.5, 3), n - 1);
end M1223;
//// model: M1224
model M1224
  parameter Integer n = 2; constant Integer q = size(fill(1.5, n), size(fill(1, n), 1) - 1);
end M1224;
//// model: M1225
model M1225
  parameter Integer n = 2; parameter Real x[n] = {1, 2}; constant Real q = sum(x[i] for i in 1:size(x, 1));
end M1225;
//// model: M1226
model M1226
  parameter Integer n = 2; parameter Real x[n] = {1, 2}; constant Integer q = sum(i for i in 1:size(x, 1));
end M1226;
//// model: M1227
model M1227
  parameter Integer n = 2; constant Real q[2] = fill(1.5, size(fill(1, n), 1));
end M1227;
