//// model: PKN14
package PN14
  record State
    Real p;
    Real X[2];
  end State;
  function f
    input Real p;
    input Real X[:] = {0.01, 0.99};
    output State s;
  algorithm
    s := if size(X, 1) == 2 then State(p = p, X = X) else State(p = p, X = cat(1, X, {1 - sum(X)}));
  end f;
end PN14;
model PKN14
  PN14.State z = PN14.f(time, {0.2});
end PKN14;
//// model: PKN15
package PN15
  partial package PartialMedium
    constant String extraPropertiesNames[:] = fill("", 0);
    constant Integer nC = size(extraPropertiesNames, 1);
    constant Real C_nominal[nC] = fill(1.0e-6, nC);
    replaceable partial model BaseProperties
      Real p = time;
    end BaseProperties;
  end PartialMedium;
  package Air
    extends PartialMedium;
    redeclare model extends BaseProperties
    end BaseProperties;
  end Air;
  model Volume
    replaceable package Medium = PartialMedium;
    Medium.BaseProperties medium;
    Real C[Medium.nC] = fill(time, Medium.nC);
    parameter Real Cn[Medium.nC] = Medium.C_nominal;
  end Volume;
end PN15;
model PKN15
  package Medium = PN15.Air(extraPropertiesNames = {"CO2"}, C_nominal = {1.519E-3});
  PN15.Volume v(redeclare package Medium = Medium);
  Real n = Medium.nC * time;
end PKN15;
