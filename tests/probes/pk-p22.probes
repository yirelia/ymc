//// set: pk-p22 — 函数里归约迭代变量遮住同名局部、经包实例取记录常量的字段、记录常量的数组字段 / 字段修饰自引用、函数体里的 cat、带修饰的短类包
//// model: PKQ1
model PKQ1
  function f
    input Real T;
    input Integer n;
    output Real y;
  protected
    Integer i;
    Real a[4] = {1, 2, 3, 4};
  algorithm
    i := 2;
    y := T ^ 0.5 * sum(a[i] * T ^ (i - 1) for i in 1:4) + i + sum(a[i] for i in 1:n) + i;
  end f;
  Real y = f(time, 3);
end PKQ1;
//// model: PKQ2
model PKQ2
  function f
    input Real T;
    input Integer n;
    output Real y;
  protected
    Integer i;
    Real a[4] = {1, 2, 3, 4};
  algorithm
    i := 2;
    y := T ^ 0.5 * sum(a[i] * T ^ (i - 1) for i in 1:4) + i + sum(a[i] for i in 1:n) + i;
  end f;
  Real y = f(2.0, 3) * time;
  parameter Real p = f(3.0, 2);
end PKQ2;
//// model: PKQ5
package PQ5
  record DataRecord
    String name;
    Real MM;
  end DataRecord;
  package Data
    constant DataRecord H2O(name = "H2O", MM = 0.018);
    constant DataRecord Air(name = "Air", MM = 0.0289);
  end Data;
  package MoistAir
    constant DataRecord steam = Data.H2O;
    constant DataRecord dryair = Data.Air;
    constant Real MMX[2] = {steam.MM, dryair.MM};
    constant Integer Water = 1;
    constant Integer Air = 2;
    model BaseProperties
      Real Xi = 0.01 * time;
      Real MM;
    equation
      MM = 1 / (Xi / MMX[Water] + (1.0 - Xi) / MMX[Air]);
    end BaseProperties;
  end MoistAir;
end PQ5;
model PKQ5
  package Medium = PQ5.MoistAir;
  Medium.BaseProperties medium;
end PKQ5;
//// model: PKQ6
package PQ6
  package Common
    record DataRecord
      String name;
      Real MM;
    end DataRecord;
    package SingleGasesData
      constant DataRecord H2O(name = "H2O", MM = 0.018);
      constant DataRecord Air(name = "Air", MM = 0.0289);
    end SingleGasesData;
  end Common;
  partial package PartialMedium
    type Temperature = Real(min = 1);
    constant Integer nX = 2;
    replaceable partial model BaseProperties
      Real Xi = 0.01 * time;
      Real MM;
      Temperature T = 300;
    end BaseProperties;
  end PartialMedium;
  package MoistAir
    extends PartialMedium(Temperature(min = 190));
    constant Integer Water = 1;
    constant Integer Air = 2;
    constant Real k_mair = steam.MM / dryair.MM;
    constant Common.DataRecord dryair = Common.SingleGasesData.Air;
    constant Common.DataRecord steam = Common.SingleGasesData.H2O;
    constant Real MMX[2] = {steam.MM, dryair.MM};
    redeclare model extends BaseProperties
    equation
      MM = 1 / (Xi / MMX[Water] + (1.0 - Xi) / MMX[Air]) * k_mair;
    end BaseProperties;
  end MoistAir;
  model Volume
    replaceable package Medium = PartialMedium;
    Medium.BaseProperties medium;
  end Volume;
end PQ6;
model PKQ6
  PQ6.Volume v(redeclare package Medium = PQ6.MoistAir);
end PKQ6;
