//// set: imp — import
//// model: IC2
package P
  constant Real pi = 3;
end P;
model IC2
  import P.pi;
  Real x;
equation
  x = pi;
end IC2;
//// model: IC3
package P
  constant Real x = 1;
end P;
model IC3
  import P.x;
  import P.x;
  Real y = x;
end IC3;
//// model: IM1
package A
  constant Real PI = 3.14;
  constant Real e = 2.7;
  package B
    constant Real c = 3.0e8;
    function f
      input Real x;
      output Real y;
    algorithm
      y := 2 * x;
    end f;
  end B;
  model M
    Real z;
  end M;
  model N
    Real z;
  end N;
end A;
model IM1
  import A.PI;
  import my_e = A.e;
  import A.B.*;
  import Q = A.M;
  import Q = A.N;
  Real x = 3 * PI;
  Real x2 = my_e;
  Real x3 = c;
  Real x4 = f(time);
  parameter Real x5 = f(2);
end IM1;
