//// model: GF10
model M
  replaceable function f_der
    input Real x[2];
    input Real d;
    input Real dd;
    output Real y;
  algorithm
    y := x[2];
  end f_der;
  function f
    input Real x[2];
    input Real d;
    output Real y;
  algorithm
    y := x[1];
    annotation(derivative(noDerivative = x) = f_der);
  end f;
  Real u[2] = {time, 1};
  Real z = f(u, time);
end M;
model GF10
  M m(redeclare function f_der = g);
  function g
    input Real x[2];
    input Real d;
    input Real dd;
    output Real y;
  algorithm
    y := -x[2];
  end g;
end GF10;
