//// set: cmp-k2 — 数组构造子：数组字面量范围、带步长的范围、多迭代变量、嵌套、各种体
//// model: K20
model K20
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[3] = {x[i] for i in {1, 3, 4}};
end K20;
//// model: K21
model K21
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[2] = {x[i] for i in {3, 1}};
end K21;
//// model: K22
model K22
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[2] = {x[i] * 2 for i in {2, 2}};
end K22;
//// model: K23
model K23
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[1] = {x[i] for i in {4}};
end K23;
//// model: K24
model K24
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[2];
equation
  y = {x[i] for i in {1, 3}};
end K24;
//// model: K25
model K25
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y = sum(x[i] for i in {1, 3});
end K25;
