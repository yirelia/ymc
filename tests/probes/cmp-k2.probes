  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y = max(x[i] for i in {1, 3});
end K27;
//// model: K28
model K28
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[2]; algorithm y := {x[i] for i in {1, 3}};
end K28;
