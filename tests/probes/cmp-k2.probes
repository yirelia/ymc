//// model: K220
model K220
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[1, 2] = {{x[i] * x[j] for j in 1:2} for i in 1:1};
end K220;
//// model: K221
model K221
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[4];
equation
  for k in 1:2 loop y[2 * k - 1:2 * k] = {x[i] for i in 1:2}; end for;
end K221;
//// model: K222
model K222
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[2];
equation
  for k in 1:2 loop y[k:k] = {x[i] * k for i in 1:1}; end for;
end K222;
//// model: K223
model K223
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[1];
equation
  when a > 1 then y = {x[i] for i in 2:2}; end when;
end K223;
//// model: K224
model K224
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real x[4] = {a, b, c, a}; Real y[1];
equation
  if p then y = {x[i] for i in 2:2}; else y = {0}; end if; Boolean p = a > 1;
end K224;
