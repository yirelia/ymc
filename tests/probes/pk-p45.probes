//// model: IFD12
model IFD12
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x;
equation
  x = f(if b then 1.0 else g(-1.0)) * time;
end IFD12;
//// model: IFD13
model IFD13
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x(start = if b then f(1.0) else g(-1.0));
equation
  der(x) = -x;
end IFD13;
//// model: IFD14
model IFD14
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function h input Real x; output Real y; algorithm y := if x > 0 then x else g(-1.0); end h;
  Real x = h(time);
end IFD14;
//// model: IFD15
model IFD15
  impure function g input Real x; output Real y; algorithm y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  parameter Real d = if b then f(1.0) else g(-1.0);
end IFD15;
