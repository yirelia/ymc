//// model: IFD212
model IFD212
  model S
    parameter Integer ind(fixed = false);
    Real c[2];
    Real y;
  initial algorithm
    ind := -1;
    for i in 1:2 loop
      if i == 2 then ind := i; end if;
    end for;
  equation
    c = {time, 2*time};
    y = c[ind];
  end S;
  S s1, s2;
end IFD212;
