//// model: IFD219
model IFD219
  parameter Integer ind(fixed = false);
  Real c[2];
  Real y;
initial algorithm
  ind := 1;
equation
  c = {time, 2*time};
  y = c[ind];
  when time > 1 then
    reinit(c[1], 0);
  end when;
end IFD219;
