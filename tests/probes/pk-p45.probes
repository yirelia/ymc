//// model: IFD5
model IFD5
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Real d = if b then f(1.0) else g(-1.0);
  parameter Boolean b = true;
  Real x;
equation
  if b then x = time; else x = 2*time; end if;
end IFD5;
//// model: IFD6
model IFD6
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Real d = if b then f(1.0) else g(-1.0);
  constant Boolean b = true;
end IFD6;
