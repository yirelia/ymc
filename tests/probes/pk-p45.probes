model IFD121
  Integer k[2] = {1, 2};
  Real y[3, 2];
equation
  y = fill(k, 3);
end IFD121;
//// model: IFD122
model IFD122
  Real x[2] = {time, 2*time};
  Real y[3, 2];
equation
  y = fill(x + {1, 1}, 3);
end IFD122;
//// model: IFD123
model IFD123
  Real x[2] = {time, 2*time};
  Real y[2, 3, 2];
equation
  y = fill(fill(x, 3), 2);
end IFD123;
//// model: IFD124
model IFD124
  Real x[2] = {time, 2*time};
  Real y[3, 2];
equation
  y = ones(3, 2) .* fill(x, 3);
end IFD124;
//// model: IFD125
model IFD125
  parameter Real p[2] = {1, 2};
  Real y[3, 2](start = fill(p, 3));
equation
  der(y) = -y;
end IFD125;
//// model: IFD130
model IFD130
  Real x[2] = {time, 2*time};
  Real y[3, 2];
equation
  for i in 1:3 loop
    y[i, :] = (fill(x, 3))[i, :];
  end for;
end IFD130;
//// model: IFD131
model IFD131
  function f input Real u[:, :]; output Real v = sum(u); algorithm end f;
  Real x[2] = {time, 2*time};
  Real s;
equation
  s = f(fill(x, 2));
end IFD131;
//// model: IFD132
model IFD132
  Real x[2] = {time, 2*time};
  Integer n = size(fill(x, 3), 1);
end IFD132;
//// model: IFD133
model IFD133
  parameter Real p[2] = {1, 2} annotation(Evaluate = true);
  Real y[3, 2];
equation
  y = fill(p, 3);
end IFD133;
