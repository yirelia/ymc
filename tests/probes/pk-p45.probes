model IFD17
  function g input Real x; output Real y; algorithm y := 3*x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  parameter Real d = if b then f(1.0) else g(-1.0);
end IFD17;
//// model: IFD18
model IFD18
  model A
    function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
    function f input Real x; output Real y; algorithm y := 2*x; end f;
    parameter Boolean b = false;
    parameter Real d = if b then f(1.0) else g(-1.0);
  end A;
  A a(b = true) annotation(Evaluate = true);
end IFD18;
//// model: IFD19
model IFD19
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = false annotation(Evaluate = true);
  parameter Boolean c = true annotation(Evaluate = true);
