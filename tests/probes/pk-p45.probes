model IFD16
  function g input Real x; output Real y; external "C" y = sin(x); end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  parameter Real d = if b then f(1.0) else g(-1.0);
end IFD16;
