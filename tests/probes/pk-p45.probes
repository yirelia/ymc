//// model: IFD8
model IFD8
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Real d = if b1 then (if b2 then f(1.0) else g(-1.0)) else g(-2.0);
  parameter Boolean b1 = true annotation(Evaluate = true);
  parameter Boolean b2 = true annotation(Evaluate = true);
end IFD8;
