//// model: IFD118
model IFD118
  parameter Boolean b = true;
  Real x[2] = {time, 2*time};
  Real y[3, 2];
equation
  if b then
    y = fill(x, 3);
  else
    y = fill(-x, 3);
  end if;
end IFD118;
//// model: IFD120
model IFD120
  Real x[2] = {time, 2*time};
  Real y[3, 2];
equation
  y = fill(-x, 3);
end IFD120;
