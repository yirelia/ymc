//// model: IFD26
model IFD26
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  record R Real a; end R;
  parameter Boolean b = true annotation(Evaluate = true);
  parameter R r = if b then R(f(1.0)) else R(g(-1.0));
end IFD26;
//// model: IFD27
model IFD27
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  parameter Real a[2] = if b then {f(1.0), 2} else {g(-1.0), 3};
end IFD27;
//// model: IFD28
model IFD28
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x;
equation
  x = sin(if b then f(1.0) else g(-1.0)) * time;
end IFD28;
//// model: IFD29
model IFD29
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x[2];
equation
  for i in 1:2 loop
    x[i] = if b then f(i) else g(-i);
  end for;
end IFD29;
//// model: IFD30
model IFD30
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x;
algorithm
  x := if b then f(1.0) else g(-1.0);
end IFD30;
//// model: IFD31
model IFD31
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  parameter Boolean p = true;
  Real x;
equation
  if p then
    x = if b then f(1.0) else g(-1.0);
  else
    x = 0;
  end if;
end IFD31;
