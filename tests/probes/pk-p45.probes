  parameter Boolean b = true annotation(Evaluate = true);
  parameter Real d = if b then f(1.0) else g(-1.0);
  Real z = g(time);
end IFD35;
//// model: IFD36
model IFD36
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  parameter Integer n = 2 annotation(Evaluate = true);
  parameter Boolean p = true;
  parameter Real d = if p then g(-n) else 1.0;
end IFD36;
//// model: IFD37
model IFD37
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x;
initial equation
  x = if b then f(1.0) else g(-1.0);
equation
  der(x) = -x;
end IFD37;
//// model: IFD38
model IFD38
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x;
equation
  when time > (if b then f(1.0) else g(-1.0)) then
    x = pre(x) + 1;
  end when;
end IFD38;
//// model: IFD39
model IFD39
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  parameter Boolean b = true annotation(Evaluate = true);
  Real x;
equation
  x = if b then f(1.0) else g(-1.0) + time;
  assert(x > (if b then 0.0 else g(-2.0)), "msg");
end IFD39;
//// model: IFD40
model IFD40
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  model A
    parameter Boolean b = false annotation(Evaluate = true);
    parameter Real d = 1;
  end A;
  A a(b = true, d = if a.b then f(1.0) else g(-1.0));
end IFD40;
