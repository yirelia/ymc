end IFD43;
//// model: IFD44
model IFD44
  function g input Real x; output Real y; algorithm assert(x > 0, "neg"); y := x; end g;
  function f input Real x; output Real y; algorithm y := 2*x; end f;
  type E = enumeration(a, b);
  parameter E e = E.a annotation(Evaluate = true);
  parameter Real d = if e == E.a then f(1.0) else g(-1.0);
end IFD44;
