//// set: arrattr-split — 属性的按元素切分
//// model: S0
model S0
  parameter Real p[3] = {1, 2, 3};
  Real a[3](start = 2*p);
end S0;
//// model: S1
model S1
  parameter Real p[3] = {1, 2, 3};
  Real b[3](start = p + {1, 1, 1});
end S1;
//// model: S10
model S10
  parameter Real p[3] = {1, 2, 3};
  Real k[2](start = {i * 2 for i in 1:2});
end S10;
//// model: S2
model S2
  parameter Real p[3] = {1, 2, 3};
  Real c[3](start = -p);
end S2;
//// model: S3
model S3
  parameter Real p[3] = {1, 2, 3};
  Real d[2,2](start = [1, 2; 3, 4]);
end S3;
//// model: S4
model S4
  parameter Real p[3] = {1, 2, 3};
  Real e[3](start = fill(1, 3));
end S4;
//// model: S5
model S5
  parameter Real p[3] = {1, 2, 3};
  Real f[3](start = {p[1], 2, 3});
end S5;
//// model: S6
model S6
  parameter Real p[3] = {1, 2, 3};
  Real g[2](start = {sin(1), 2});
end S6;
//// model: S7
model S7
  parameter Real p[3] = {1, 2, 3};
  Real h[3](min = {1, 2, 3}, max = {4, 5, 6}, each fixed = true);
end S7;
//// model: S8
model S8
  parameter Real p[3] = {1, 2, 3};
  Real i[3](start = 1:3);
end S8;
//// model: S9
model S9
  parameter Real p[3] = {1, 2, 3};
  Real j[3](start = zeros(3));
end S9;
