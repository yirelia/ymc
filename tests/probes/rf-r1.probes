//// set: rf-r1 — extends 修饰里的重声明形态：constrainedby、条件、维、前缀合并与冲突、final、多层、先被 extends 修饰改过
//// model: R10
model A
parameter Real p = 1;
end A;
model B
extends A;
parameter Real q = 2;
end B;
model M
parameter Real o = 5;
replaceable A a(p = o) constrainedby A(p = 7);
end M;
model R10
extends M(redeclare B a(q = 3));
end R10;
