//// model: R114
model A
parameter Real p = 1;
Real y;
end A;
model B
extends A;
parameter Real z = 2;
equation
y = z * time;
end B;
model M
Real w = time;
replaceable output A a(final p = w);
end M;
model R114
extends M(redeclare final B a(final z = 0));
end R114;
//// model: R115
model A
parameter Real p = 1;
end A;
model B
