//// model: R118
connector P
Real e;
flow Real f;
end P;
connector P2
extends P;
Real g;
end P2;
model M
replaceable P p;
end M;
model R118
extends M(redeclare P2 p);
equation
p.g = time;
p.e = 1;
end R118;
