//// model: C1322
model C1322
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y; algorithm for i in 1:2 loop y := sum({i, i * 2, i * 3}); end for;
end C1322;
//// model: C1323
model C1323
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y; algorithm for i in 1:2 loop y := sum(fill(i, 3)); end for;
end C1323;
//// model: C1324
model C1324
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y; algorithm for i in 1:2 loop y := max(i, 3) + min(i * 2, 1); end for;
end C1324;
