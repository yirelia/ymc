//// model: C136
model C136
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2] = {sum(x[j] * i for j in 1:3) * tt for i in 1:2};
end C136;
//// model: C137
model C137
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2] = {sum(x[j] for j in 1:i) * tt for i in 1:2};
end C137;
//// model: C138
model C138
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2, 2] = {{sum(i * j * l for l in 1:2) * tt for i in 1:2} for j in 1:2};
end C138;
//// model: C139
model C139
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y; algorithm for i in 1:2 loop for j in 1:n loop y := y + sum(i * l for l in 1:3) + sum(j * l for l in 1:3) + sum(i * j * l for l in 1:3); end for; end for;
end C139;
//// model: C1310
model C1310
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y; algorithm y := 0; for i in 1:2 loop y := y + sum(sum(i * j * l for l in 1:2) for j in 1:2); end for;
end C1310;
//// model: C1311
model C1311
