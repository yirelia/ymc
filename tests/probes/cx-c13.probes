//// set: cx-c13 — 外层迭代变量的变率（范围是常量 / 参数 / 运行时量）与归约的展开 / 保留
//// model: C130
model C130
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2]; algorithm for i in 1:n loop y[1] := sum(i * j for j in 1:3); end for;
end C130;
//// model: C131
model C131
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2]; algorithm for i in 1:p loop y[i] := sum(i * j for j in 1:3); end for;
end C131;
//// model: C132
model C132
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y = max(sum(i * j for j in 1:3) * tt for i in 1:2);
end C132;
