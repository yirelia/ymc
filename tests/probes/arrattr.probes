//// model: SL1
model SL1
  Real x[3] = {1, 2, 3};
  Real y[2] = x[2:3];
  Real z[2,3];
  Real w[3] = z[1, :];
  Real v[2] = z[:, 2];
  Real u[2];
  parameter Real p[3] = {1, 2, 3};
  parameter Real q[2] = p[{1, 3}];
  Real s = sum(x[1:2]);
equation
  z[1, :] = {1, 2, 3};
  z[2, :] = x;
  u[1:2] = x[2:3] .* 2;
end SL1;
//// model: SL2
model SL2
  Real x[3] = {1, 2, 3};
  Real y[2] = x[2:3];
  Real z[2,3];
  Real w[3] = z[1, :];
  Real v[2] = z[:, 2];
  Real u[2];
  parameter Real p[3] = {1, 2, 3};
  parameter Real q[2] = p[{1, 3}];
equation
  z[1, :] = {1, 2, 3};
  z[2, :] = x;
  u[1:2] = x[2:3] .* 2;
end SL2;
//// model: YmcArrAttr1
model A
  Real x[2](start = {1, 2});
end A;
model YmcArrAttr1
  parameter Real p[3] = {1, 2, 3};
  parameter Integer ni[2] = {1, 2};
  Real a[3](start = 2*p);
  Real b[3](start = p + {1, 1, 1});
  Real c[2](min = -{1, 2});
  Real d[2,2](start = [1, 2; 3, 4]);
  Real h[3](min = {1, 2, 3}, max = {4, 5, 6}, each fixed = true);
  Real r[2](start = ni);
  A a1(x(start = {3, 4}));
  A g[2](each x(start = {6, 7}));
  A h2[2](x(start = {{1, 2}, {3, 4}}));
  Real w[2](each start);
  Real z[:](start = {1, 2});
  parameter Real pf[2](each fixed = false, start = {1, 2});
end YmcArrAttr1;
