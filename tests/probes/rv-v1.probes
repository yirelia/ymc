algorithm
r := R(1);
end g;
model V31
parameter R r = g();
end V31;
//// model: V32
record R
Real x "the x";
end R;
function g
output R r;
algorithm
r := R(1);
end g;
model V32
R r = g();
end V32;
//// model: V40
record R
parameter Real a = 1;
final parameter Real b = 2 * a;
end R;
model V40
parameter R r2 = R(a = 5);
end V40;
//// model: V41
record R
parameter Integer a = 1;
end R;
model V41
parameter R r = R(3) annotation(Evaluate = true);
Real y = r.a;
end V41;
//// model: V42
record B
parameter Real x[2] = zeros(2);
end B;
record M
parameter B b;
end M;
record P
parameter M m = M();
end P;
model V42
parameter P p;
Real y = p.m.b.x[1] * time;
end V42;
//// model: V43
record B
Real x;
end B;
record M
B b;
Real c;
end M;
function g
output M m;
algorithm
m := M(B(1), 2);
end g;
model V43
parameter M m = g();
end V43;
