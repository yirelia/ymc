//// set: rt-t3 — final 修饰的记录引用绑定到字段次序不同的另一个记录类型（标量记录：照常拆）
//// model: T30
package C
record NV
parameter Real a = 1;
parameter Real b;
end NV;
end C;
package H
record NV
parameter Real b;
parameter Real a = 1;
end NV;
end H;
model M
parameter C.NV nv;
end M;
model T30
parameter H.NV h(b = 2);
M m(final nv = h);
end T30;
//// model: T31
package C
record NV
parameter Real a = 1;
parameter Real b;
end NV;
end C;
package H
record NV
parameter Real a = 1;
parameter Real b;
end NV;
end H;
model M
parameter C.NV nv;
end M;
model T31
parameter H.NV h(b = 2);
M m(final nv = h);
end T31;
//// model: T32
package C
record NV
parameter Real a = 1;
parameter Real b;
end NV;
end C;
package H
record NV
parameter Real b;
parameter Real a = 1;
end NV;
end H;
model M
parameter C.NV nv;
end M;
model T32
parameter Real k = 3;
parameter H.NV h(b = k);
M m(final nv = h);
end T32;
//// model: T33
package C
record NV
Real a;
Real b;
end NV;
end C;
package H
record NV
Real b;
Real a;
end NV;
end H;
model M
C.NV nv;
end M;
model T33
H.NV h(a = time, b = 2*time);
M m(final nv = h);
end T33;
