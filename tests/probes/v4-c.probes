end H;
model C1
  parameter Real q[3] = {1, 2, 3};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real b[3] = if time > 1 then F(x, 1) else x;
end C1;
