//// set: io-ref — 复合 outer 的引用：绑定 / 方程 / 嵌套两层 `d.c.b.a.x` / 两个使用者 / inner 是派生类 / 不相干的类（拒）/ 数组元素 / 记录 / 最近的 inner / 参数与 Evaluate / if 条件 / der / pre / 算法段 / 缺 inner（SKIP）/ outer 带修饰（拒）/ 经实例调函数（SKIP）
//// model: I10
model A
Real x;
end A;
model B
outer A a;
Real y;
equation
y = a.x;
end B;
model I10
inner A a(x = 1.0);
B b;
end I10;
//// model: I11
model A
parameter Real p = 2;
Real x;
end A;
model B
outer A a;
Real y = a.p * time;
end B;
model I11
inner A a;
B b;
equation
a.x = 1;
end I11;
//// model: I12
model A
Real x;
end A;
model B
outer A a;
end B;
model C
B b;
inner A a(x = 1.0);
end C;
model D
C c;
Real y;
equation
y = c.b.a.x;
end D;
model I12
D d;
Real z;
equation
z = d.c.b.a.x;
end I12;
//// model: I13
model A
Real x;
equation
x = time;
end A;
model B
outer A a;
Real y = a.x;
end B;
model I13
inner A a;
B b1;
B b2;
end I13;
//// model: I14
model A
Real x;
end A;
model A2
extends A;
Real z;
end A2;
model B
outer A a;
Real y = a.x;
end B;
model I14
inner A2 a(x = 1, z = 2);
B b;
end I14;
//// model: I15
model A
Real x;
end A;
model C2
