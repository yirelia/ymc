//// set: fs-t3 — 函数体：Integer 数组进 Real 的转型、fill / zeros / ones 的展开、各种积
//// model: T30
model T30
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[3]; input Real q[:, :]; input Real g[2, 3]; input Integer k; input Integer n[:]; input Integer n2[2]; input Real g2[3, 2]; output Real o; protected Real v[size(u, 1)]; Real v3[3]; Real v2[2]; Real s; Real gg[2, 3]; Real g22[2, 2]; Real g33[3, 3]; algorithm s := 1; v := u; v3 := w; v2 := {1, 2}; v2 := n2 + w[1:2]; o := s; end f; Real y = f(x, x, m, m, 1, {1, 2, 3}, {1, 2}, {{1, 2}, {3, 4}, {5, 6}});
end T30;
