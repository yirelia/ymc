  connect(c.frame_a, b.frame_b);
  connect(c.frame_a, v.frame_a);
  connect(v.frame_a, v.frame_b);
  connect(b_.frame_a, K.frame_c);
  connect(b_.frame_a, b.frame_b);
  connect(K.frame_a, v.frame_a);
  connect(B2.frame_b, Y.frame_a);
  connect(a.frame_b, K.frame_c);
  connect(v.frame_b, p_2.frame_a);
  connect(b.frame_a, b.frame_b);
  connect(K.frame_a, v.frame_a);
  connect(b.frame_a, B2.frame_b);
  connect(v.frame_c, a.frame_b);
  connect(v.frame_b, v.frame_c);
  connect(B2.frame_b, b.frame_a);
  connect(b.frame_a, c.frame_a);
  connect(v.frame_b, Y.frame_a);
  connect(v.frame_c, b.frame_a);
