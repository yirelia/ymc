model ProbeRand4
  L.B q_;
  L.W a;
  L.B Y;
  L.J b;
  L.J b_;
  L.T v;
  L.W B2;
  L.J c;
  L.P p_2(p = 5);
  L.T K;
equation
  connect(K.frame_c, v.frame_c);
  connect(p_2.frame_a, b_.frame_a);
  connect(v.frame_a, b.frame_b);
  connect(K.frame_a, b.frame_a);
  connect(v.frame_b, b.frame_a);
  connect(v.frame_c, K.frame_c);
  connect(v.frame_a, b.frame_b);
  connect(K.frame_b, b.frame_a);
