model ProbeRand1
  L.T Z1;
  L.P m(p = 5);
  L.B v;
  L.J a;
  L.W x1;
  L.T b_;
  L.P q_(p = 5);
  L.P Y(p = 1);
  L.P p_2(p = 0);
  L.J k9;
equation
  connect(b_.frame_b, a.frame_a);
  connect(b_.frame_b, p_2.frame_a);
  connect(k9.frame_b, b_.frame_b);
  connect(k9.frame_a, a.frame_a);
end ProbeRand1;
