model ProbeRand2
  L.W m;
  L.B Z1;
  L.T c;
  L.J x2;
  L.J v;
  L.T n;
  L.J aa;
equation
  connect(c.frame_b, n.frame_b);
  connect(v.frame_b, x2.frame_a);
  connect(c.frame_a, n.frame_b);
  connect(m.frame_b, n.frame_a);
  connect(n.frame_b, c.frame_b);
  connect(c.frame_a, n.frame_c);
  connect(v.frame_a, c.frame_b);
  connect(c.frame_a, c.frame_c);
  connect(aa.frame_b, n.frame_a);
  connect(x2.frame_a, c.frame_a);
  connect(aa.frame_b, n.frame_c);
  connect(c.frame_a, v.frame_a);
  connect(m.frame_b, n.frame_a);
  connect(c.frame_c, x2.frame_a);
  connect(x2.frame_b, n.frame_c);
  connect(x2.frame_b, Z1.frame_a);
  connect(x2.frame_b, n.frame_a);
  connect(n.frame_b, x2.frame_a);
  connect(v.frame_a, aa.frame_b);
  connect(Z1.frame_a, n.frame_a);
end ProbeRand2;
