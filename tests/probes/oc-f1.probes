//// set: oc-f1 — 超定连接图的随机模型（与 omc 差分核实过的 1040 个里取 60 个）：世界 / 潜在根 / 关节 / 三端关节 / 重复连接
//// model: ProbeRand0
package L
  record Orientation
    Real T[2];
    Real w;
    function equalityConstraint
      input Orientation R1;
      input Orientation R2;
      output Real residue[1];
    algorithm
      residue := {R1.T[1]*R2.T[2] - R1.T[2]*R2.T[1]};
    end equalityConstraint;
  end Orientation;
  connector Frame
    Real r;
    Orientation R;
    flow Real f;
  end Frame;
  model W
    Frame frame_b;
    Boolean wr;
  equation
    Connections.root(frame_b.R);
    wr = Connections.isRoot(frame_b.R);
  end W;
  model P
    parameter Integer p = 0;
    Frame frame_a;
    Boolean isR;
  equation
    Connections.potentialRoot(frame_a.R, p);
    isR = Connections.isRoot(frame_a.R);
  end P;
  model J
    Frame frame_a;
    Frame frame_b;
    Boolean ra;
    Boolean rb;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    ra = Connections.rooted(frame_a.R);
    rb = Connections.rooted(frame_b.R);
  end J;
  model T
    Frame frame_a;
    Frame frame_b;
    Frame frame_c;
    Boolean ra;
    Boolean rb;
    Boolean rc;
  equation
    Connections.branch(frame_a.R, frame_b.R);
    Connections.branch(frame_a.R, frame_c.R);
    ra = Connections.rooted(frame_a.R);
    rb = Connections.rooted(frame_b.R);
    rc = Connections.rooted(frame_c.R);
  end T;
  model B
    Frame frame_a;
  end B;
end L;

model ProbeRand0
  L.J n;
  L.J v;
  L.T b_;
  L.B b;
  L.J k9;
  L.J a;
  L.W B2;
  L.J c;
  L.T ab;
  L.B Z1;
equation
  connect(n.frame_a, v.frame_a);
  connect(a.frame_a, b_.frame_a);
  connect(b_.frame_b, Z1.frame_a);
  connect(ab.frame_a, b_.frame_a);
  connect(k9.frame_b, b_.frame_b);
  connect(a.frame_a, B2.frame_b);
  connect(n.frame_a, ab.frame_c);
  connect(b_.frame_a, n.frame_a);
  connect(n.frame_b, b_.frame_a);
  connect(ab.frame_b, ab.frame_c);
  connect(ab.frame_b, k9.frame_b);
  connect(B2.frame_b, n.frame_b);
  connect(Z1.frame_a, ab.frame_a);
  connect(k9.frame_a, n.frame_a);
  connect(Z1.frame_a, ab.frame_b);
  connect(Z1.frame_a, k9.frame_a);
  connect(c.frame_b, b_.frame_a);
end ProbeRand0;
