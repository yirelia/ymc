//// set: sy-s3 — 同步算子：backSample / shiftSample / subSample / superSample / interval / firstTick
//// model: E0
model E0
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = backSample(x, 2);
end E0;
//// model: E1
model E1
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = backSample(x, 2, 4);
end E1;
//// model: E2
model E2
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = backSample(1.0, 2, 4);
end E2;
//// model: E3
model E3
  parameter Integer n = 2;
