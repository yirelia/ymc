//// model: E20
model E20
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = shiftSample(x, shiftCounter = n, resolution = 4);
end E20;
//// model: E21
model E21
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  y = shiftSample(x, 1, 2) + backSample(x, 1, 2);
end E21;
//// model: E22
model E22
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y[2];
equation
  y = shiftSample(z, n);
end E22;
//// model: E23
model E23
  parameter Integer n = 2;
