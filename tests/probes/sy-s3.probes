//// model: E54
model E54
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = 2 * interval(x) + 1;
end E54;
//// model: E55
model E55
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  y = previous(y) + interval();
end E55;
//// model: E56
model E56
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  y = previous(y) + interval(y);
end E56;
//// model: E57
model E57
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Boolean y = firstTick();
end E57;
//// model: E58
model E58
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Boolean y = firstTick(x);
end E58;
//// model: E59
model E59
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Boolean y = firstTick(z);
end E59;
//// model: E60
model E60
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  y = if firstTick() then 0 else previous(y) + 1;
end E60;
//// model: E61
model E61
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  if firstTick() then y = 0; else y = previous(y) + 1; end if;
end E61;
//// model: E62
model E62
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  if firstTick(x) then y = 0; else y = 1; end if;
end E62;
