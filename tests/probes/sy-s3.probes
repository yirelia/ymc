  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  parameter Integer m = n; Real y = shiftSample(x, n); parameter Integer m2 = n;
end E24;
