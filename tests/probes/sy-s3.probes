  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y[2] = superSample({1, 2});
end E41;
//// model: E42
model E42
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  y = superSample(subSample(x, 2), 2);
end E42;
//// model: E43
model E43
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y[2];
equation
  y = superSample(z, 2);
end E43;
//// model: E44
model E44
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when subSample(Clock(0.1), 2) then y = 1; end when;
end E44;
//// model: E45
model E45
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when superSample(Clock(0.1), n) then y = 1; end when;
end E45;
//// model: E46
model E46
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when subSample(Clock(0.1)) then y = 1; end when;
end E46;
//// model: E47
model E47
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when shiftSample(Clock(0.1), 1, 2) then y = 1; end when;
end E47;
//// model: E48
model E48
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y;
equation
  when backSample(Clock(0.1), 1) then y = 1; end when;
end E48;
//// model: E49
model E49
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = sample(x, subSample(Clock(0.1), 2));
end E49;
//// model: E50
model E50
  parameter Integer n = 2;
  parameter Real p = 0.5;
  parameter Boolean pb = true;
  Real x = time;
  Real z[2] = {time, 1};
  Integer k;
  Boolean b = time > 0.5;
  Real y = interval();
end E50;
