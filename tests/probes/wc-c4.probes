//// model: C40
model C40
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean p = a > 1;
  Boolean q = b > 1;
  Integer k = integer(a);
  Boolean v[2] = {a > 2, b > 2};
  parameter Boolean pb = true;
  parameter Real pr = 1;
  function fr input Real x; output Real y; algorithm y := 2 * x; end fr; function fb input Real x; output Boolean y; algorithm y := x > 1; end fb; function fbd input Boolean x; output Boolean y; algorithm y := not x; end fbd; type E = enumeration(one, two); E e = if p then E.one else E.two; String s = if p then "x" else "y"; Real y;
equation
  when not terminal() then y = a; end when;
end C40;
