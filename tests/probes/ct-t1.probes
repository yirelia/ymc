//// set: ct-t1 — 参数数组 if 绑定逐元素摊开后不收拢（`if b then 1.0 else 1.0`、`if b then true else false`）、矩阵里的推导式列（BooleanTable 的 `[table[1], 1.0; table, {mod(i + 1, 2.0) for i in 1:n}]`）、子组件修饰里 + 条件参数向前引用、写出来的内层 if 照常收拢、选中支引用条件参数（SKIP）
//// model: CT1
model CT1
  parameter Real table[:] = {0, 1};
  parameter Boolean startValue = false;
  final parameter Integer n = size(table, 1);
  parameter Real t2[:, 2] = if n > 0 then if startValue then [table[1], 1.0; table, {mod(i + 1, 2.0) for i in 1:n}] else [table[1], 0.0; table, {mod(i, 2.0) for i in 1:n}] else if startValue then [0.0, 1.0] else [0.0, 0.0];
  Real y = t2[2, 2] * time;
end CT1;
//// model: CT2
model CT2
  parameter Boolean b = true;
  parameter Real p[2] = if b then {1, 2} else {1, 3};
  parameter Boolean q[2] = if b then {true, false} else {false, false};
  Real x[2] = if b then {time, 2} else {time, 3};
end CT2;
//// model: CT3
model Tab
  parameter Real table[:, :] = fill(0.0, 0, 2);
  Real y = table[1, 2] * time;
end Tab;
block BT
  parameter Real table[:] = {0, 1};
  parameter Boolean startValue = false;
  Tab combiTimeTable(final table = if n > 0 then if startValue then [table[1], 1.0; table, {mod(i + 1, 2.0) for i in 1:n}] else [table[1], 0.0; table, {mod(i, 2.0) for i in 1:n}] else if startValue then [0.0, 1.0] else [0.0, 0.0]);
protected
  final parameter Integer n = size(table, 1);
end BT;
model CT3
  BT bt(table = {0, 1, 3});
end CT3;
//// model: CT4
model CT4
  parameter Integer n = 2;
  parameter Real m[2, 2] = [{1, 2}, {i * 2 for i in 1:n}];
  parameter Boolean c1 = true;
  parameter Boolean c2 = false;
  parameter Real p[2] = if c1 then {if c2 then 1 else 1, 2} else {3, 4};
  parameter Boolean bq[2] = if c1 then {c2, true} else {true, true};
end CT4;
//// model: CT5
model CT5
  parameter Integer n = 3;
  Real b2x[:] = if n == 3 then {1.5} else fill(n, 2);
  parameter Real q[:] = if n == 3 then {2.5, n} else {1.0};
end CT5;
