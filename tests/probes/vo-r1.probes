//// set: vo-r1 — 记录整体绑定链上的 Evaluate：引用链三层求值 / 四层不求、构造实参、字段修饰链、无绑定记录
//// model: R10
record R
parameter Integer a;
end R;
model R10
parameter R r(a = 1);
parameter Integer p = r.a annotation(Evaluate = true);
Real y = p;
end R10;
