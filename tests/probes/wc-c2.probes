//// set: wc-c2 — when 语句的条件形态（同 c1 的条件）
//// model: C20
model C20
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean p = a > 1;
  Boolean q = b > 1;
  Integer k = integer(a);
  Boolean v[2] = {a > 2, b > 2};
  parameter Boolean pb = true;
  parameter Real pr = 1;
  Real y; algorithm when a > 1 then y := a; end when;
end C20;
