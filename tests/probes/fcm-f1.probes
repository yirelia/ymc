//// set: fcm-f1 — 函数形参 / 局部 / 输出的字符串注释，各种函数形态
//// model: F10
model F10
  Real a = time;
  Real b = 2 * time;
  function f "fn comment" input Real x "the x"; input Real w = 1 "with default"; output Real y "the y"; protected Real z = 2 "local"; constant Real k = 3 "konst"; algorithm y := x * z * w * k "stmt comment"; end f; Real y = f(a) "binding";
end F10;
//// model: F11
model F11
  Real a = time;
  Real b = 2 * time;
  function f input Real x "say \"hi\""; output Real y "back\slash"; algorithm y := x; end f; Real y = f(a);
end F11;
//// model: F12
model F12
  Real a = time;
  Real b = 2 * time;
  function f "say \"hi\" fn" input Real x; output Real y; algorithm y := x; end f; Real y = f(a);
end F12;
//// model: F13
model F13
  Real a = time;
  Real b = 2 * time;
  function f input Real x[:] "vec"; output Real y "sum"; algorithm y := sum(x); end f; Real y = f({a, b});
end F13;
//// model: F14
model F14
  Real a = time;
  Real b = 2 * time;
  function f input Real x "in"; output Real y "o1"; output Real z "o2"; algorithm y := x; z := 2 * x; end f; Real y; Real z;
equation
  (y, z) = f(a);
end F14;
//// model: F15
model F15
  Real a = time;
  Real b = 2 * time;
  function f input Real x "in"; output Real y "out"; external "C" y = sin(x); end f; Real y = f(a);
end F15;
//// model: F16
model F16
  Real a = time;
  Real b = 2 * time;
  function f input Real x "in" annotation(Dialog(group = "g")); output Real y "out"; algorithm y := x; end f; Real y = f(a);
end F16;
//// model: F17
model F17
  Real a = time;
  Real b = 2 * time;
  function f input Real x annotation(Dialog(group = "g")); output Real y; algorithm y := x; end f; Real y = f(a);
end F17;
//// model: F18
model F18
  Real a = time;
  Real b = 2 * time;
  record R "rec comment" Real p "field p"; Real q = 2 "field q"; end R; function f input R r "the r"; output Real y "out"; algorithm y := r.p + r.q; end f; R r(p = a); Real y = f(r);
end F18;
//// model: F19
model F19
  Real a = time;
  Real b = 2 * time;
  record R "rec comment" Real p "field p"; Real q = 2 "field q"; end R; R r = R(a, b); Real y = r.p;
end F19;
//// model: BASE
model BASE
  Real a = time;
  Real b = 2 * time;
end BASE;
//// model: F110
model F110
  Real a = time;
  Real b = 2 * time;
  record R Real p "field p"; end R; function f input Real x; output R r "result"; algorithm r.p := x; end f; R r = f(a);
end F110;
//// model: F111
model F111
  Real a = time;
  Real b = 2 * time;
  function f input Real x "in"; output Real y "out"; protected Real t[2] "tmp arr"; Integer n = 2 "count"; algorithm t := {x, x}; y := sum(t) * n; end f; Real y = f(a);
end F111;
//// model: F112
model F112
  Real a = time;
  Real b = 2 * time;
  function f input Real x ""; output Real y; algorithm y := x; end f; Real y = f(a);
end F112;
//// model: F113
model F113
  Real a = time;
  Real b = 2 * time;
  function f input Real x "multi" + "part"; output Real y; algorithm y := x; end f; Real y = f(a);
end F113;
//// model: F114
model F114
  Real a = time;
  Real b = 2 * time;
  impure function f "imp" input Real x "in"; output Real y "out"; algorithm y := x; end f; Real y = f(a);
end F114;
//// model: F115
model F115
  Real a = time;
  Real b = 2 * time;
  function g input Real x "gx"; output Real y "gy"; algorithm y := 2 * x; end g; function f = g "alias comment"; Real y = f(a);
end F115;
//// model: F116
model F116
  Real a = time;
  Real b = 2 * time;
  function g input Real x "gx"; output Real y "gy"; algorithm y := 2 * x; end g; function f extends g; end f; Real y = f(a);
end F116;
//// model: F117
model F117
  Real a = time;
  Real b = 2 * time;
  function g input Real x "gx"; output Real y "gy"; end g; function f extends g(x "new x"); algorithm y := 2 * x; end f; Real y = f(a);
end F117;
//// model: F118
model F118
  Real a = time;
  Real b = 2 * time;
  function f input Real x(unit = "m") "with attr"; output Real y(unit = "s") "out attr"; algorithm y := x; end f; Real y = f(a);
end F118;
//// model: F119
model F119
  Real a = time;
  Real b = 2 * time;
  function f input Real x "used twice"; output Real y; algorithm y := x; end f; Real y = f(a) + f(b);
end F119;
//// model: F120
model F120
  Real a = time;
  Real b = 2 * time;
  function f input Real x "in"; output Real y "out"; algorithm for i in 1:2 loop y := x * i "loop stmt"; end for; if x > 0 then y := 1 "if stmt"; end if; end f; Real y = f(a);
end F120;
