//// set: ax-d1 — vector 作函数实参：矩阵构造 / 数组字面量实参压成向量字面量，引用实参 omc 留 `vector(x)`（SKIP）
//// model: D10
function g
input Real t[3];
output Real y;
algorithm
y := t[1] + t[2];
end g;
model D10
parameter Real a[2] = {1, 2};
parameter Real m[3, 1] = {{1}, {2}, {3}};
parameter Real a3[3] = {1, 2, 3};
Real y;
equation
y = g(vector([a; 0]));
end D10;
