//// set: arrattr-split-m1 — 切分（续）
//// model: S0
model S0
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real x, y;
end S0;
//// model: S1
model S1
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real a[2];
end S1;
//// model: S10
model S10
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real s = [2];
end S10;
//// model: S11
model S11
  parameter Real p[2,2] = [1, 2; 3, 4];
  m4 = [x, 1; 2, y];
end S11;
//// model: S2
model S2
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real m[2,2] = [1, 2; 3, 4];
end S2;
//// model: S3
model S3
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real m2[2,2] = [x, y; y, x];
end S3;
//// model: S4
model S4
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real v[1,3] = [1, 2, 3];
end S4;
//// model: S5
model S5
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real c[3,1] = [1; 2; 3];
end S5;
//// model: S6
model S6
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real m3[2,2] = [a, a];
end S6;
//// model: S7
model S7
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real m4[2,2];
end S7;
//// model: S8
model S8
  parameter Real p[2,2] = [1, 2; 3, 4];
  Real m5[2,2] = [1, 2.5; x, 4];
end S8;
//// model: S9
model S9
  parameter Real p[2,2] = [1, 2; 3, 4];
  Integer k[2,2] = [1, 2; 3, 4];
end S9;
