//// model: PXS161
model PXS161
  parameter Integer n = 2;
  discrete Real z1(start = 0, fixed = true), z2(start = 0, fixed = true);
equation
  when sample(0, 1) then
    ({z1, z2})[n] = 1;
    z1 = 2;
  end when;
end PXS161;
//// model: PXS162
model PXS162
  parameter Integer n = 2;
  Real x1(start = 1, fixed = true), x2(start = 1, fixed = true);
equation
  der(x1) = -1;
  der(x2) = -1;
  when x2 < 0 then
    reinit(({x1, x2})[n], 1);
  end when;
end PXS162;
//// model: PXS163
model PXS163
  discrete Integer k[2](each start = 1, each fixed = true);
  Integer z;
equation
  when sample(0, 1) then
    k = pre(k) + {1, 2};
  end when;
  z = pre((k)[1]);
end PXS163;
//// model: PXS164
model PXS164
