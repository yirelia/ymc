  der(x1) = 1;
end PXS165;
//// model: PXS166
model PXS166
  parameter Integer n = 2;
  discrete Integer k1(start = 1, fixed = true), k2(start = 2, fixed = true);
  Boolean c;
equation
  when sample(0, 1) then
    k1 = pre(k1) + 1;
    k2 = pre(k2) + 1;
  end when;
  c = change(({k1, k2})[n]);
end PXS166;
