model PXS231
  parameter Integer n = 2;
  Real y = ({4, 5, 6} * 2)[n] * time;
end PXS231;
//// model: PXS232
model PXS232
  parameter Integer n = 2;
  Real y = (cat(1, {4, 5}, {6}))[n] * time;
end PXS232;
//// model: PXS233
model PXS233
  parameter Integer n = 2;
  Real y = (ones(3))[n] * time;
end PXS233;
//// model: PXS234
model PXS234
  parameter Integer n = 2;
  Real y = (zeros(3))[n] + time;
end PXS234;
//// model: PXS235
model PXS235
  parameter Integer n = 2;
  Real y = ({4, 5, 6})[n] * time;
  Real z = ({4, 5, 6})[2] * time;
end PXS235;
//// model: PXS236
model PXS236
  parameter Integer n = 2;
  parameter Integer p = 1;
  Real y = ({4, 5, 6})[n] * time + p;
end PXS236;
//// model: PXS237
model PXS237
  parameter Integer n = 1;
  discrete Integer k(start = 0, fixed = true);
  discrete Real z[3](each start = 0, each fixed = true);
equation
  when sample(0, 1) then
    k = 1 - pre(k);
    z[n + k] = 1;
  end when;
end PXS237;
//// model: PXS238
model PXS238
  parameter Integer n = 2;
  discrete Real z[3](each start = 0, each fixed = true);
equation
  when sample(0, 1) then
    z[n] = 1;
  end when;
end PXS238;
//// model: PXS239
model PXS239
  parameter Integer n = 2 annotation(Evaluate = false);
  discrete Real z[3](each start = 0, each fixed = true);
equation
  when sample(0, 1) then
    z[n] = 1;
  end when;
end PXS239;
//// model: PXS240
model PXS240
  parameter Integer n = 2;
  discrete Real z[3](each start = 0, each fixed = true);
algorithm
  when sample(0, 1) then
    z[n] := 1;
  end when;
end PXS240;
//// model: PXS241
model PXS241
  parameter Integer n = 2;
  Real x[3] = {1, 2, 3} * time;
  Real y[2];
equation
  y = x[1:n];
end PXS241;
//// model: PXS242
model PXS242
  parameter Integer n = 2;
  Real x[3] = {1, 2, 3} * time;
  Real y[2] = x[n - 1:n];
end PXS242;
//// model: PXS243
model PXS243
  parameter Integer n = 2;
  discrete Integer k(start = 1, fixed = true);
  Real x[3] = {1, 2, 3} * time;
  Real y = x[k + n];
equation
  when sample(0, 1) then
    k = 1 - pre(k);
  end when;
end PXS243;
//// model: PXS244
model PXS244
  parameter Integer n = 1;
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when x[n + 1] > 2 then
    reinit(x[n], 0);
  end when;
end PXS244;
//// model: PXS245
model PXS245
  constant Integer c = 2;
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when time > 0.5 then
    reinit(x[c], 0);
  end when;
end PXS245;
//// model: PXS246
model PXS246
  parameter Integer n = 2 annotation(Evaluate = true);
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when time > 0.5 then
    reinit(x[n], 0);
  end when;
end PXS246;
//// model: PXS247
model PXS247
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  for i in 1:3 loop
    when time > 0.5 then
      reinit(x[i], 0);
    end when;
  end for;
end PXS247;
//// model: PXS248
model PXS248
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when time > 0.5 then
    reinit(x[end], 0);
  end when;
end PXS248;
//// model: PXS249
model PXS249
  parameter Integer n = 2;
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when time > 0.5 then
    reinit(x[n - 1], 0);
  end when;
end PXS249;
//// model: PXS250
model PXS250
  parameter Integer n = 2;
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when time > 0.5 then
    reinit(x[n], x[n] + 1);
  end when;
end PXS250;
//// model: PXS251
model PXS251
  Real x[3](each start = 1, each fixed = true);
equation
  der(x) = {1, 2, 3};
  when time > 0.5 then
    reinit(x[1 + 1], 0);
  end when;
end PXS251;
//// model: PXS252
record PXS252R
  Real v(start = 1, fixed = true);
end PXS252R;
model PXS252
  parameter Integer n = 2;
  PXS252R r[2];
equation
  der(r[1].v) = 1;
  der(r[2].v) = 1;
  when time > 0.5 then
    reinit(r[n].v, 0);
  end when;
end PXS252;
//// model: PXS253
model PXS253
  type E = enumeration(one, two, three);
  parameter Integer n = 2;
  Real y[E](each start = 1, each fixed = true);
equation
  for i in E loop
    der(y[i]) = n;
  end for;
  when time > 0.5 then
    reinit(y[E.two], 0);
  end when;
end PXS253;
//// model: PXS254
model PXS254
  Real y[Boolean](each start = 1, each fixed = true);
equation
  der(y[false]) = 1;
  der(y[true]) = 2;
  when time > 0.5 then
    reinit(y[true], 0);
  end when;
end PXS254;
//// model: PXS261
model PXS261
  constant Integer c = ({1, 2, 3})[2];
  Real y = c * time;
end PXS261;
//// model: PXS262
model PXS262
  parameter Integer n = 2;
  constant Integer c = ({1, 2, 3})[n];
  Real y = c * time;
end PXS262;
//// model: PXS263
model PXS263
  Real x[({1, 2, 3})[2]] = ones(2) * time;
end PXS263;
//// model: PXS264
model PXS264
  parameter Integer n = 2;
  Real x[({1, 2, 3})[n] + 1] = ones(3) * time;
end PXS264;
//// model: PXS265
model PXS265
  parameter Integer n = 2;
  parameter Integer m = ({1, 2, 3})[n] annotation(Evaluate = true);
  Real y = m * time;
end PXS265;
//// model: PXS266
model PXS266
  parameter Integer m = ({1, 2, 3})[2] annotation(Evaluate = true);
  Real y = m * time;
end PXS266;
//// model: PXS267
function PXS267F
  input Integer k;
  output Real y;
algorithm
  y := ({4, 5, 6})[k] * 2;
end PXS267F;
model PXS267
  parameter Real p = PXS267F(2);
  Real y = p * time;
end PXS267;
//// model: PXS268
function PXS268F
  input Integer k;
  output Real y;
algorithm
  y := ({4, 5, 6})[k] * 2;
end PXS268F;
model PXS268
  constant Real c = PXS268F(2);
  Real y = c * time;
end PXS268;
//// model: PXS269
function PXS269F
  input Integer k;
  output Integer y;
algorithm
  y := ({1, 2, 3})[k];
end PXS269F;
model PXS269
  Real x[PXS269F(2)] = ones(2) * time;
end PXS269;
//// model: PXS270
model PXS270
  parameter Integer n = 2;
  Real y;
equation
  if ({true, false, true})[n] then
    y = 1;
  else
    y = 2;
  end if;
end PXS270;
//// model: PXS271
model PXS271
  parameter Integer n = 2;
  Real y[3];
equation
  for i in 1:({1, 2, 3})[n] loop
    y[i] = i * time;
  end for;
  y[3] = 0;
end PXS271;
//// model: PXS272
model PXS272
  parameter Integer n = 3;
  Real z = time if ({true, false, true})[n];
end PXS272;
//// model: PXS273
model PXS273
  parameter Integer n = 2;
  Real y(fixed = ({true, false})[n], start = 1);
equation
  der(y) = 1;
end PXS273;
//// model: PXS274
model PXS274
  parameter Integer n = 2;
  Real y = sum(({1, 2, 3})[i] for i in 1:n) * time;
end PXS274;
//// model: PXS275
model PXS275
  parameter Integer n = 2;
  parameter Real p = ([1, 2; 3, 4])[n, 1];
  Real y = p * time;
end PXS275;
//// model: PXS276
model PXS276
  parameter Integer n = 2;
  Real x[([1, 2; 3, 4])[n, 1]] = ones(3) * time;
end PXS276;
//// model: PXS277
model PXS277
  parameter Integer n = 2;
  constant Real c[3] = {1, 2, 3};
  Real x[integer(({1, 2, 3})[n] * 1.0)] = ones(2) * time;
end PXS277;
//// model: PXS278
model PXS278
  parameter Integer n = 2 annotation(Evaluate = false);
  Real x[({1, 2, 3})[n]] = ones(2) * time;
end PXS278;
//// model: PXS279
model PXS279
  parameter Integer n = 2;
  Real x[({i for i in 1:3})[n]] = ones(2) * time;
end PXS279;
//// model: PXS280
model PXS280
  parameter Integer n = 2;
  Real x[3] = {1, 2, 3} * time;
  Real y = x[({1, 2, 3})[n]];
end PXS280;
//// model: PXS281
model PXS281
  parameter Integer n = 2;
  constant Real c[3] = {1, 2, 3};
  Real y = c[({1, 2, 3})[n]] * time;
end PXS281;
//// model: PXS282
model PXS282
  parameter Integer n = 2;
  Real y = ({4, 5, 6})[({1, 2, 3})[n]] * time;
end PXS282;
//// model: PXS283
function PXS283F
  input Integer k;
  output Real y;
algorithm
  y := ({4, 5, 6})[k] * 2;
end PXS283F;
model PXS283
  parameter Integer n = 2;
  Real y = PXS283F(n) * time;
end PXS283;
//// model: PXS284
function PXS284F
  input Integer k;
  output Real y;
algorithm
  y := ({4, 5, 6})[k] * 2;
end PXS284F;
model PXS284
  Real y = PXS284F(2) * time;
end PXS284;
