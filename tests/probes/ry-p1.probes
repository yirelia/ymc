//// set: ry-p1 — 记录数组续（及组件声明修饰里的成员重声明）：整体绑定是推导式 / fill（MSL ComplexMISO 的 `uInternal = {if useConjugateInput[k] then conj(u[k]) else u[k] for k in 1:nin}`、Sum 的 `k = fill(Complex(1, 0), nin)`）逐元素取；向量 * 向量精确匹配到形参是记录数组的 `Complex.'*'.scalarProduct`；元素级 `.*` 不找精确匹配、逐元素；展开的连接器数组字段（`p.v`）作运算数；组件声明修饰里的 `redeclare each final SI.Current re`（MSL 多相传感器；只收不引用名字的，RY8 / RY9 引用外层参数的照旧 SKIP，RY11 改 protected 成员 omc 报错）
//// model: RY1
model RY1
  Modelica.ComplexBlocks.ComplexMath.Sum s(nin = 2, useConjugateInput = {false, true});
equation
  s.u[1] = Complex(time, 1);
  s.u[2] = Complex(1, time);
end RY1;
//// model: RY2
model RY2
  Complex a[2], b[2];
  Complex c = a * b;
  Complex d = {a[1], a[2]} * b;
equation
  a[1] = Complex(time, 1);
  a[2] = Complex(2, time);
  b[1] = Complex(1, 2);
  b[2] = Complex(3, time);
end RY2;
//// model: RY3
model RY3
  Complex a[2], b[2];
  Complex c[2] = a .* b;
equation
  a[1] = Complex(time, 1);
  a[2] = Complex(2, time);
  b[1] = Complex(1, 2);
  b[2] = Complex(3, time);
end RY3;
//// model: RY4
model RY4
  connector Pin
    Modelica.Units.SI.ComplexElectricPotential v;
    flow Modelica.Units.SI.ComplexCurrent i;
  end Pin;
  Pin p[3], n[3];
  Modelica.Units.SI.ComplexVoltage v[3];
equation
  v = p.v - n.v;
  for k in 1:3 loop
    p[k].v = Complex(k * time, 0);
    n[k].v = Complex(0, k);
  end for;
end RY4;
//// model: RY5
model RY5
  Modelica.ComplexBlocks.Interfaces.ComplexOutput i[2](redeclare each final Modelica.Units.SI.Current re, redeclare each final Modelica.Units.SI.Current im);
  Modelica.ComplexBlocks.Interfaces.ComplexOutput v(redeclare Modelica.Units.SI.Voltage re, redeclare Modelica.Units.SI.Voltage im);
equation
  i[1] = Complex(time, 0);
  i[2] = Complex(0, time);
  v = Complex(1, time);
end RY5;
//// model: RY6
model RY6
  parameter Integer n = 3;
  parameter Boolean c[n] = {true, false, true};
  Complex u[n];
  Complex w[n] = {if c[k] then Modelica.ComplexMath.conj(u[k]) else u[k] for k in 1:n};
  parameter Complex g[n] = fill(Complex(2, 1), n);
  Complex y = g * w;
equation
  for k in 1:n loop
    u[k] = Complex(k * time, 1);
  end for;
end RY6;
//// model: RY7
model RY7
  record R
    Real x;
    Real y;
  end R;
  parameter Integer n = 2;
  R r[n] = {R(k * time, k) for k in 1:n};
  R s[3] = fill(R(1, 2), 3);
end RY7;
//// model: RY8
model A8
  replaceable Real x;
  parameter Real q = 1;
end A8;
model RY8
  parameter Real p = 2;
  A8 a(redeclare Real x = p);
end RY8;
//// model: RY9
model A9
  Real x[:];
  parameter Integer n = 1;
end A9;
model RY9
  parameter Integer n = 3;
  A9 a(redeclare Real x[n]);
end RY9;
//// model: RY10
record R10
  replaceable Real re;
  replaceable Real im;
end R10;
model RY10
  type Cur = Real(quantity = "Current", unit = "A");
  R10 r[2](redeclare each Cur re, redeclare each final Cur im);
  R10 s(redeclare Cur re);
end RY10;
//// model: RY11
model M11
  protected replaceable Real x;
end M11;
model RY11
  M11 m(redeclare Real x = 2.0);
end RY11;
