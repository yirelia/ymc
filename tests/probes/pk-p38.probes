//// model: VKW19
model VKW19
  parameter Real k = 0 annotation(Evaluate = true);
  Real x[3] = {1, 2, 3} * time;
  Real y[3];
equation
  y = x + {k * x[i] for i in 1:3} + {{k * x[i] * x[j] for j in 1:3} for i in 1:3} * x;
