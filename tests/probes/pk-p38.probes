end VKB17;
//// model: VKB18
model VKB18
  parameter Integer n = 3 annotation(Evaluate = true);
  Real x[3] = {1, 2, 3} * time;
  Real y = x[n - 1];
end VKB18;
//// model: VKB19
model VKB19
  parameter Integer n = 3 annotation(Evaluate = true);
