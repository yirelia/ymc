equation
  s = sum(semiLinear(port.m_flow, inStream(port.Xi_outflow), Xi));
  port.Xi_outflow = Xi;
end VKU8C;
model VKU8
  VKU8C a, b, c;
equation
  connect(a.port, b.port);
