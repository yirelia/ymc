//// model: VKW7
model VKW7
  parameter Real k = 1 annotation(Evaluate = true);
  Real x[3] = {1, 2, 3} * time;
  Real y[3];
equation
  y = x + {k * x[i] * time for i in 1:3};
end VKW7;
//// model: VKW8
model VKW8
  parameter Boolean use_k = true;
  parameter Real k = 0 annotation(Evaluate = true);
  Real x[3] = {1, 2, 3} * time;
  Real y[3];
equation
  if use_k then
    y = x + {k * x[i] * (time - x[i]) for i in 1:3};
  else
    y = x;
  end if;
end VKW8;
//// model: VKW9
model VKW9
  Real x[3] = {1, 2, 3} * time;
