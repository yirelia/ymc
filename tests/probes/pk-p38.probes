//// model: VKU10
connector VKU10P
  flow Real m_flow;
  stream Real Xi_outflow[2];
  Real p;
end VKU10P;
model VKU10C
  VKU10P port;
  Real Xi[2] = {time, 2 * time};
  Real mXi[2];
initial equation
  mXi = semiLinear(port.m_flow, inStream(port.Xi_outflow), Xi);
equation
  der(mXi) = Xi;
  port.Xi_outflow = Xi;
end VKU10C;
model VKU10
  VKU10C a, b, c;
equation
  connect(a.port, b.port);
