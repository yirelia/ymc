//// model: VKQ15
model VKQ15
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
initial equation
  y = Modelica.ComplexMath.fromPolar(r, phi);
equation
  der(y[1].re) = 1;
  der(y[2].re) = 1;
  der(y[3].re) = 1;
  der(y[1].im) = 1;
  der(y[2].im) = 1;
  der(y[3].im) = 1;
