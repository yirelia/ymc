//// set: pk-p38 — 向量化调用整体保留时的实参形态（67d：MSL QuasiStatic IMC_Conveyor 此前 SKIP "qualified function call [vectorized argument form]"、Fluid BranchingDynamicPipes 此前 SKIP "vectorized call argument [homotopy]"，现都 PASS）：omc 把向量化调用定型成数组构造（NFCall.vectorizeCall :2851-2907 v1.25.0），实参按 Expression.applySubscript 取下标（NFExpression.mo:1256-1297），化简时体照常化简（simplifyArrayConstructor 的 else 支，NFSimplifyExp.mo:583-637）——fill / ones / zeros 实参取成填充值（simplifyFill :524-536 + simplifySubscriptedExp :1346-1379；VKF / pk-p36 VRA）、实参全成字面量的纯调用求值、函数不打（simplifyCall :166-219，homotopy / 外部函数照留；VKL / VKB / VKS）、含数组调用的运算式实参整个取下标 `(array(…) * p)[$i1]`（makeSubscriptedExp :1685-1719；VKA / VKH / VKG5，MSL 管道流动模型的 homotopy）、推导式 / 嵌套向量化调用实参的迭代变量换成 `(1:3)[$i1]`（applyIndexSubscriptArrayConstructor :1631-1651；VKN / VKC；参数数组摊分 / 属性里逐元素求值时下标先化简（Subscript.simplify NFSubscript.mo:881-891）、里层函数照打——收函数在标量化之前 NFInst.mo:219 / :231：pk-p27 VQ9、VKN27-VKN37）、if 实参两支各取下标（applySubscriptIf :1653-1683；VKI）、返回记录的向量化调用在等式一侧整体保留（VKQ，pk-p36 VRC1 / VRC2，MSL VfController 的 `y = fromPolar(fill(amplitude, m), …)`）、实参含流算子的随连接方程求值整个展开（NFConnectEquations.mo:164-166 / :789-808 → ExpandExp.expandArrayConstructor2 NFExpandExp.mo:471-507；VKT / VKU，MSL DynamicPipe 的 `-semiLinear(port_b.m_flow, inStream(port_b.Xi_outflow), mediums[n].Xi)`）。基线静默错（一并修）：向量化调用的体不化简（VKL2 / VKL7 / VKL9-VKL14 / VKP15 / VKB1 / VKB2 / VKB5-VKB7 / VKB11 / VKB13 / VKB14 / VKS4 / VKS8 / VKS13 / VKS14 / VKU3 / VKU4）、只向量化一个元素的 external "C" 内建等价函数被折成数值（VKS16）、书写的推导式代入结构参数后不再化简（VKW2 / VKW6-VKW8 / VKW10 / VKW12-VKW19 / VKW21 / VKW25 / VKW27-VKW29 / VKW31-VKW34；MSL PartialHeatTransfer 的 `use_k` 支）、代入结构参数后取下标式的标量下标不化简（VKB19 `({4, 5, 6})[n - 1]`，Subscript.simplify NFSubscript.mo:881-891）；VKL15 此前 FAIL、现 SKIP（ymc 求不出 String 结果）。照旧 SKIP：逐元素展开处（参数摊分 / 属性 / sum）嵌着同名迭代变量的（VKH19 / VKH21 / VKA7 / VKA8 / VKA23）、记录数组的绑定（pk-p36 VRC9）、嵌套的记录调用（VKQ20）、算法里的记录（VKQ7）、范围 / cat / 返回数组的调用实参（VKR / VKG1-VKG4 / VKG6 / VKG7 / VKG10-VKG12 / VKH6）、常量数组实参（VKS5 / VKS6）、函数体里的（VKP9）、多维 / 一元素的嵌套实参（VKN14 / VKN25）、Integer 运算式实参（VKA16）、if 的字面量 / 运算支（VKI6 / VKI10）、when 里的数组调用（VKL8 / VKW23）、多输出（VKS15）、数组值的 fill（VKF8）、参数绑定里的 homotopy（VKH20）、常量数组绑定里的嵌套调用（VKN38）、ymc 求不出的常量调用（VKS12 / VKL15 / VKQ13）
//// model: VKF1
function VKF1G
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
end VKF1G;
model VKF1
  parameter Real p = 2;
  Real y[3];
equation
  y = VKF1G(fill(p, 3));
end VKF1;
//// model: VKF2
function VKF2G
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
end VKF2G;
model VKF2
  Real x[2] = {time, 2 * time};
  Real y[3];
equation
  y = VKF2G(fill(x[1], 3));
end VKF2;
//// model: VKF3
function VKF3G
  input Real x;
  output Real y;
algorithm
  y := 2 * x;
end VKF3G;
model VKF3
  Real y[3];
equation
  y = VKF3G(fill(2 * time, 3));
end VKF3;
