  port.Xi_outflow = Xi;
end VKU7C;
model VKU7
  VKU7C a, b, c;
equation
  connect(a.port, b.port);
  connect(a.port, c.port);
  a.port.m_flow = time;
  b.port.m_flow = 2 * time;
  a.port.p = 1;
end VKU7;
