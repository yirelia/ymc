end VKU5;
//// model: VKU6
connector VKU6P
  flow Real m_flow;
  stream Real Xi_outflow[2];
  Real p;
end VKU6P;
model VKU6C
  VKU6P port;
  Real Xi[2] = {time, 2 * time};
  Real mXi[2] = semiLinear(port.m_flow, inStream(port.Xi_outflow), Xi);
equation
  port.Xi_outflow = Xi;
end VKU6C;
model VKU6
  VKU6C a, b, c;
equation
  connect(a.port, b.port);
  connect(a.port, c.port);
  a.port.m_flow = time;
  b.port.m_flow = 2 * time;
  a.port.p = 1;
end VKU6;
