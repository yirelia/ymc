//// model: VKT1
connector VKT1P
  flow Real m_flow;
  stream Real Xi_outflow[1];
  Real p;
end VKT1P;
model VKT1C
  VKT1P port;
  Real Xi[1] = {time};
  Real mXi[1];
equation
  mXi = -semiLinear(port.m_flow, inStream(port.Xi_outflow), Xi);
  port.Xi_outflow = Xi;
end VKT1C;
model VKT1
  VKT1C a, b, c;
equation
  connect(a.port, b.port);
  connect(a.port, c.port);
  a.port.m_flow = time;
  b.port.m_flow = 2 * time;
  a.port.p = 1;
end VKT1;
