equation
  mXi = semiLinear(port.m_flow, inStream(port.Xi_outflow), fill(1, 2));
  port.Xi_outflow = Xi;
end VKU9C;
model VKU9
  VKU9C a, b, c;
equation
  connect(a.port, b.port);
