//// model: C58
model C58
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y = m[n] * {1, 2, 3};
end C58;
//// model: C59
model C59
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[3] = if n > 1 then m[n] else m[1];
end C59;
//// model: C510
model C510
  constant Real x[5] = {1, 2, 3, 4, 5};
