//// model: C524
model C524
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[3] = fill(1.5, 3); constant Real w[3] = z; Real y = w[n];
end C524;
//// model: C525
model C525
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[3] = 2 * fill(1.5, 3); Real y = z[n];
end C525;
//// model: C526
model C526
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[2, 3] = {fill(1.5, 3), {1, 2, 3}}; Real y = z[1, n];
end C526;
