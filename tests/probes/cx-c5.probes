//// model: C528
model C528
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[3] = fill(1.5, 3); Real y = z[n] + z[n + 1];
end C528;
//// model: C529
model C529
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[3] = fill(1.5, 3); Real y; algorithm for i in 1:3 loop y := y + z[i]; end for;
end C529;
//// model: C530
model C530
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[3] = fill(1.5, 3); Real y = sum(z[i] * tt for i in 1:n);
end C530;
//// model: C531
model C531
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  constant Real z[3] = fill(tt * 0 + 1.5, 3); Real y = z[n];
end C531;
