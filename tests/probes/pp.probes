//// set: pp — 表达式打印的括号规则：算符两两组合
//// model: PP1
model PP1
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean r1 = a < b + c;
  Boolean r2 = a + b < c;
  Boolean r3 = a < b - c;
  Boolean r4 = a - b < c;
  Boolean r5 = (a < b) == (b < c);
  Boolean r6 = a < b and b < c;
  Boolean r7 = not a < b;
  Boolean r8 = a < (if b > c then b else c);
  Boolean r9 = a * b < c * (a + b);
  Real y1 = a - (b - c);
  Real y2 = a - (b + c);
  Real y3 = a + (b - c);
  Real y4 = a / (b * c);
  Real y5 = a * (b / c);
  Real y6 = a / (b / c);
  Real y7 = a ^ (b ^ c);
  Real y8 = (a ^ b) ^ c;
  Real y9 = -(a + b);
  Real y10 = a * (-b);
  Real y11 = -a * b;
  Real y12 = a - (-b);
  Real y13 = a ^ (-b);
  Real y14 = (-a) ^ b;
  Real y15 = a * (b * c);
  Real y16 = a + (b + c);
  Real y17 = (a + b) * c;
  Real y18 = a - b - c;
  Real y19 = a / b / c;
  Real y20 = a / b * c;
  Real y21 = a * b / c;
  Real y22 = -a ^ 2;
  Real y23 = (a * b) ^ 2;
  Real y24 = 2 ^ (a * b);
  Real y25 = a + b * c ^ 2;
end PP1;
//// model: PP2
model PP2
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean p = time > 1;
  Boolean q = time > 2;
  Boolean r = time > 3;
  Boolean l1 = p and (q and r);
  Boolean l2 = (p and q) and r;
  Boolean l3 = p or (q or r);
  Boolean l4 = p and (q or r);
  Boolean l5 = (p and q) or r;
  Boolean l6 = p or q and r;
  Boolean l7 = not (p and q);
  Boolean l8 = not p and q;
  Boolean l9 = not (not p);
  Boolean l10 = (not p) or q;
  Boolean l11 = p and not q;
  Boolean l12 = not (a < b);
  Boolean l13 = not a < b;
  Boolean l14 = (a < b) and (b < c);
  Boolean l15 = a < b or b < c and c < a;
  Boolean l16 = (a < b or b < c) and c < a;
  Boolean l17 = p == (q or r);
  Boolean l18 = (p == q) or r;
  Boolean l19 = p <> (q and r);
  Boolean l20 = a + b > c - a;
  Boolean l21 = a * b > c / a;
  Boolean l22 = -a < b;
  Boolean l23 = a < -b;
  Boolean l24 = a ^ 2 < b ^ 2 + c;
  Boolean l25 = (if p then a else b) < c;
  Boolean l26 = a < (if p then b else c);
  Boolean l27 = if p then q else r;
  Boolean l28 = (if p then q else r) and q;
  Boolean l29 = p and (if q then r else p);
  Real y1 = if p then a + b else a - b;
  Real y2 = (if p then a else b) + c;
  Real y3 = c + (if p then a else b);
  Real y4 = -(if p then a else b);
  Real y5 = (if p then a else b) ^ 2;
  Real y6 = 2 ^ (if p then a else b);
  Real y7 = if p then (if q then a else b) else c;
  Real y8 = if (if p then q else r) then a else b;
  Real y9 = a + (b + c) + (a - b) - (a + c);
  Real y10 = a * (b * c) * (a / b) / (a * c);
  Real y11 = a - b + c;
  Real y12 = a - (b + c) - (b - c);
  Real y13 = -(-a);
  Real y14 = -(a - b);
  Real y15 = -(a * b);
  Real y16 = -a + b;
  Real y21 = (a + b) ^ (b - c);
  Real y23 = (a / b) ^ c;
  Real y24 = a / b ^ c;
  Real y25 = abs(a - b) * (c + a);
  Real y26 = (a + b) / (c + a);
  Real y27 = a / (b / (c / a));
  Real y28 = ((a / b) / c) / a;
  Real y29 = a - (b - (c - a));
  Real y30 = -1 * a;
  Real y31 = a * (-1);
  Real y32 = a + (-1);
  Real y33 = a - (-1);
  Real y34 = (-1) ^ 2 * a;
  Real y35 = a ^ (-1);
  Real y36 = (-a) * (-b);
end PP2;
