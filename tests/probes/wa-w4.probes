//// set: wa-w4 — 带步长的切片：步长 / 终点照写
//// model: W40
model W40
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Real w[4] = {a, b, c, a};
  Real y[2] = w[1:2:4];
end W40;
