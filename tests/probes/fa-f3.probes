  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  v := u .* (if a > 0 then u else 2 * u);
  o := 0;
end h;
model F335
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F335;
