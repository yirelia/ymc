//// model: F348
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  while s < 1 loop v := 2 * u; s := s + 1; end while;
  o := 0;
end h;
model F348
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F348;
//// model: F349
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  for i in 1:2 loop v := 2 * u; end for;
  o := 0;
end h;
model F349
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F349;
//// model: F350
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  if a > 0 then v := 2 * u; else v := u .* u; end if;
  o := 0;
end h;
model F350
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F350;
