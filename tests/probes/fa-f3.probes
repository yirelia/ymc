//// set: fa-f3 — 函数体里的数组运算：取负改写、类型错、恒等元、控制流里的语句
//// model: F30
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  v := u .- 2;
  o := 0;
end h;
model F30
  Real x[3] = {time, 1, 2};
  Real y = h(x, x, time, {x, x}, {1, 2, 3}, 2);
end F30;
//// model: F31
function h
  input Real u[:];
  input Real w[3];
  input Real a;
  input Real M[:, :];
  input Integer n[:];
  input Integer k;
  output Real o;
protected
  Real v[size(u, 1)];
  Real v3[3];
  Real s;
  Real vm[size(M, 1), size(M, 2)];
  Integer ni[size(n, 1)];
  Integer n3[3];
  Real v2[size(u, 1)];
algorithm
  v := u .- (a + 1);
  o := 0;
end h;
model F31
