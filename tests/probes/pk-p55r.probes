//// model: R68fSA2
model A
  record R
    Real x = 1;
    Real y = 2;
  end R;
  function f
    input R r;
    output Real z;
  algorithm
    z := r.x + r.y * time;
  end f;
end A;
model R68fSA2
  R r;
  Real w = f(r);
  extends A;
end R68fSA2;
