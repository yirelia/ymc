//// set: io-conn — 经复合 outer 的 connect：outer 连接器本身 / 两个使用者 / inner 在数组元素里 / 根上也连 / 两端都经 outer / 连接器数组元素 / for 里连；短类型 / 短类连接器的 outer；内层 inner 遮住外层；for 迭代变量当下标
//// model: I60
connector P
Real v;
flow Real i;
end P;
model B
outer P p;
P q;
equation
connect(p, q);
end B;
model I60
inner P p;
B b;
end I60;
//// model: I61
connector P
Real v;
flow Real i;
end P;
model A
P p;
end A;
model B
outer A a;
P q;
equation
connect(q, a.p);
end B;
model I61
inner A a;
B b1;
B b2;
end I61;
//// model: I62
connector P
Real v;
flow Real i;
end P;
model A
P p;
end A;
model B
outer A a;
P q;
equation
connect(a.p, q);
end B;
model C
inner A a;
B b;
end C;
model I62
C c[2];
end I62;
//// model: I63
connector P
Real v;
flow Real i;
end P;
model A
P p;
end A;
model B
outer A a;
P q;
equation
connect(a.p, q);
end B;
model I63
inner A a;
B b;
P r;
equation
connect(a.p, r);
end I63;
//// model: I64
connector P
Real v;
flow Real i;
end P;
model A
P p;
P p2;
end A;
model B
outer A a;
equation
connect(a.p, a.p2);
end B;
model I64
inner A a;
B b;
end I64;
//// model: I65
connector P
Real v;
flow Real i;
end P;
model A
P p[2];
end A;
model B
outer A a;
P q;
equation
connect(a.p[1], q);
end B;
model I65
inner A a;
B b;
end I65;
//// model: I66
type MyReal = Real;
model B
outer MyReal x;
Real y = x;
end B;
model I66
inner MyReal x = 1;
B b;
end I66;
//// model: I67
connector RealInput = input Real;
model B
outer RealInput u;
Real y = u;
end B;
model I67
inner RealInput u;
B b;
equation
u = time;
end I67;
//// model: I68
model A
Real x;
end A;
model B
outer A a;
Real y = a.x;
end B;
model C
inner A a(x = 2);
B b;
end C;
model I68
inner A a(x = 1);
B b;
C c;
end I68;
//// model: I69
model A
Real x[3];
end A;
model B
outer A a;
Real y[3];
equation
for i in 1:3 loop
y[i] = a.x[i];
end for;
end B;
model I69
inner A a(x = {1, 2, 3});
B b;
end I69;
//// model: I610
connector P
Real v;
flow Real i;
end P;
model A
P p;
end A;
model B
outer A a;
P q[2];
equation
for k in 1:2 loop
connect(a.p, q[k]);
end for;
end B;
model I610
inner A a;
B b;
end I610;
