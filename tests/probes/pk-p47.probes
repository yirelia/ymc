  type T2 = T1[2](start = {{4, 5, 6}, {7, 8, 9}});
  T2 x[2];
end TDM16;
//// model: TDM17
model TDM17
  type T = Real[3](start = {1, 2, 3});
  T x[2];
equation
  x = {{1, 2, 3}, {4, 5, 6}};
end TDM17;
//// model: TDM18
