end TDM27;
//// model: TDM28
model TDM28
  function f
    input Real u;
    output Real y[3] = {u, 2 * u, 3 * u};
  end f;
  type T = Real[3](start = f(1));
  T x[2];
end TDM28;
//// model: TDM29
model TDM29
  type T = Real[3](start = {1, 2, 3});
  input T x[2];
end TDM29;
//// model: TDM30
model TDM30
  type T = Real[3](start = {1, 2, 3});
  T x[2];
  Real z[2, 3](start = {{1, 2, 3}, {1, 2, 3}});
end TDM30;
//// model: TDM31
model TDM31
  record R
    Real x;
  end R;
  record RA = R[3](x = {1, 2, 3});
  RA r;
end TDM31;
//// model: TDM32
model TDM32
  record R
    Real x;
  end R;
  record RA = R[3](x = {1, 2, 3});
  RA r[2];
end TDM32;
//// model: TDM33
model TDM33
  model M
    Real x;
  end M;
  model MA = M[3](x(start = {1, 2, 3}));
  MA m[2];
end TDM33;
//// model: TDM34
model TDM34
  model M
    Real x;
  end M;
  model MA = M[3](x(start = {1, 2, 3}));
  MA m;
end TDM34;
//// model: TDM35
model TDM35
  record R
    Real x;
  end R;
  record RA = R[3](each x = 1);
  RA r[2];
end TDM35;
//// model: TDM36
model TDM36
  type E = enumeration(a, b);
  type T = E[2](start = {E.a, E.b});
  T x[2];
end TDM36;
//// model: TDM37
model TDM37
  type T = Real[3](start = {1, 2, 3});
  function f
    input Real u;
    output Real y[2, 3] = {{u, u, u}, {u, u, u}};
  end f;
  parameter T x[2] = f(time);
end TDM37;
//// model: TDM38
model TDM38
  type T = Real[3](start = {1, 2, 3});
  function f
    input Real u;
    output Real y[2, 3] = {{u, u, u}, {u, u, u}};
  end f;
  parameter Real p = 1;
  parameter T x[2] = f(p);
end TDM38;
//// model: TDM39
