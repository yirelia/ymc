  outer T x[2];
end TDM88;
//// model: TDM89
model TDM89
  type T = Real[3](start = {1, 2, 3});
  model A
    outer T x[2];
    Real y = x[1, 1];
  end A;
  inner T x[2];
  A a;
end TDM89;
//// model: TDM90
model TDM90
  type T = Real[3](start = {1, 2, 3});
  model A
    parameter Integer n = 1;
    T x[n];
  end A;
  A a(n = 2);
end TDM90;
//// model: TDM91
model TDM91
  type T = Real[3](start = {1, 2, 3});
  function f
    input Real u;
    output Real y;
  protected
    T z[2];
  algorithm
    z := fill(u, 2, 3);
    y := sum(z);
  end f;
  Real y = f(time);
end TDM91;
//// model: TDM92
model TDM92
  type T = Real[3](start = {1, 2, 3});
  function f
    input T u[2];
    output Real y;
  algorithm
    y := sum(u);
  end f;
  Real y = f(fill(time, 2, 3));
end TDM92;
//// model: TDM93
model TDM93
  type T = Real[3](start = {1, 2, 3});
  record R
    T y[2];
    Real z;
  end R;
  R r = R(fill(time, 2, 3), 1);
end TDM93;
//// model: TDM94
model TDM94
  type T = Real[3](start = {1, 2, 3});
  record R
    T y[2];
  end R;
  parameter R r = R({{1, 2, 3}, {4, 5, 6}});
  Real x = r.y[1, 2];
end TDM94;
//// model: TDM95
model TDM95
  type T = Real[3](start = {1, 2, 3});
  function f
    input Real u;
    output T y[2];
  algorithm
    y := fill(u, 2, 3);
  end f;
  Real y[2, 3] = f(time);
end TDM95;
//// model: TDN1
model TDN1
  model A
    replaceable type T = Real[2];
    T x;
  end A;
  A a1;
  A a2(redeclare type T = Real[3]);
end TDN1;
//// model: TDN2
package TDN2P
  constant Integer n = 3;
end TDN2P;
model TDN2
  package P2 = TDN2P(n = 1);
  Real x[P2.n];
end TDN2;
//// model: TDN3
model TDN3
  parameter Integer n = 3;
  type T = Real[n];
  T x;
end TDN3;
