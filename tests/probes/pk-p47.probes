//// set: pk-p47 — 67m：testsuite 里类型带维的派生类型（arrays/Array5 / Array6、modification/UsertypeArrayMod、arrays/UnknownDimensionMod、enums/DerivedEnumDim、scodeinst/TypeDim3 / TypeDim4）及兄弟写法。TDM1-TDM95：类型带维的修饰落到还有别的维的组件上（`type T = Real[3](start = {1, 2, 3}); T x[2]`、`T1[4] z[5]`、`type T2 = T1[2]`）——修饰带 SPLIT_PROXY(origin = 那层类型, parent = 组件)，parent 比 origin 多出的前几维用 fill 补（expandProxySubscripts，NFTyping.mo:1579-1644 v1.25.0），元素取值的末尾几维；参数引用 / 算术 / 调用 / 推导式 / 矩阵 / 枚举 / Boolean / fixed / nominal、组件修饰盖过、each、记录字段、连接器、模型数组里、重声明、空数组、不标量化的整个参数数组（fill 化简成字面量整个打，TDM38 / TDM39）；复合组件的数组短类（TDM32）照旧 SKIP，函数变量上的属性修饰（TDM91 / TDM92 / TDM95）照旧 SKIP。TDN1-TDN93：短类的非字面量维（`type Reals = Real[n]`、`Real[E]`、`Real[:]`）在短类定义处解析（expandClassDerived 的 RAW_DIM(d, InstNode.parent(node))，NFInst.mo:1054）——同一个类里、两处找到同一项（顶层 / 包里的类名、包常量）原样，限定声明类型 `P.T` / `P2.T`（P2 = P(n = 1)）改写成 `P.n` / `P2.n`；遮蔽（TDN41 / TDN64 / TDN85）、外层模型实例的参数 / 常量（TDN62 / TDN63 / TDN69 / TDN88）、import / protected / 继承来的类型（TDN30 / TDN49 / TDN53 / TDN4 / TDN28 / TDN91）→ SKIP；`:` 前面还有维的 1.25.0 按类型里的序号取绑定维（TDN10 / TDN58 omc 报错），TDN57 照旧 SKIP。TDN1 / UTD4：同一声明经重声明换成不同维的类型，此前按声明缓存合成元素取错维（静默错）。UTD1-UTD8 为单测同构。基线 PASS 12 / FAIL 2 / SKIP 151 / BOTH-REJECT 15 → PASS 133 / SKIP 32 / BOTH-REJECT 15，无 FAIL
//// model: TDM1
model TDM1
  type T = Real[3](start = {1, 2, 3});
  T x[2];
end TDM1;
//// model: TDM2
model TDM2
  parameter Real p[3] = {1, 2, 3};
  type T = Real[3](start = p);
  T x[2];
end TDM2;
//// model: TDM3
model TDM3
  type T = Real[3](each start = 1);
  T x[2];
end TDM3;
//// model: TDM4
model TDM4
  type T = Real[3](start = {1, 2, 3});
  T x[2](start = {{4, 5, 6}, {7, 8, 9}});
end TDM4;
//// model: TDM5
model TDM5
  type T = Real[3](start = {1, 2, 3});
  T x[2](each start = {4, 5, 6});
end TDM5;
//// model: TDM6
model TDM6
  type T = Real[3](start = {1, 2, 3});
  parameter T x[2](each fixed = false);
end TDM6;
//// model: TDM7
model TDM7
  type T1 = Real[3](start = {1, 2, 3});
  type T2 = T1[2];
  T2 x[4];
end TDM7;
//// model: TDM8
model TDM8
  parameter Real a = 2;
  type T = Real[3](start = {a, 2 * a, 3});
  T x[2];
end TDM8;
//// model: TDM9
model TDM9
  type T = Real[2, 3](start = [1, 2, 3; 4, 5, 6]);
  T x[2];
end TDM9;
//// model: TDM10
model TDM10
  type T = Real[3](start = fill(1.5, 3));
  T x[2];
end TDM10;
//// model: TDM11
model TDM11
  type T = Real[3](start = {1, 2, 3}, nominal = {4, 5, 6}, fixed = {true, false, true});
  T x[2];
end TDM11;
//// model: TDM12
model TDM12
  type T = Real[3](start = {1, 2, 3});
  model M
    T y[2];
  end M;
  M m[2];
end TDM12;
//// model: TDM13
model TDM13
  type T = Integer[3](start = {1, 2, 3});
  T x[2];
end TDM13;
