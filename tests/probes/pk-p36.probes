//// model: VRU1
operator record VRU1C "complex-like"
  Real re "real part";
  Real im "imaginary part";
  encapsulated operator 'constructor'
    function fromReal "from reals"
      import VRU1C;
      input Real re "re in";
      input Real im = 0 "im in";
      output VRU1C result(re = re, im = im) "result";
    algorithm
      annotation(Inline = true);
    end fromReal;
  end 'constructor';
  encapsulated operator '*'
    function multiply "product"
      import VRU1C;
      input VRU1C c1;
      input VRU1C c2;
      output VRU1C c3;
    algorithm
      c3 := VRU1C(c1.re * c2.re - c1.im * c2.im, c1.re * c2.im + c1.im * c2.re);
    end multiply;
  end '*';
end VRU1C;
function VRU1F "from polar"
  input Real len;
  input Real phi;
  output VRU1C c;
algorithm
  c := VRU1C(len * cos(phi), len * sin(phi));
end VRU1F;
model VRU1
  VRU1C u = VRU1C(time, 2);
  VRU1C y[3];
equation
  y = u * VRU1F(fill(1, 3), {1, 2, 3});
end VRU1;
