//// set: pk-p36 — 返回记录的向量化调用作重载运算符的运算数（67b：MSL QuasiStatic SMPM_MTPA / SMPM_CurrentSource / SMR_CurrentSource 此前 SKIP "qualified function call [….singleToMultiPhase.u]"，现都 PASS——SingleToPolyphase 的 `y = u*fromPolar(fill(1, m), -symmetricOrientation(m))`）：omc 把向量化调用定型成数组构造（NFCall.vectorizeCall :2851-2907 v1.25.0），重载运算符没有精确匹配时数组支随即展开、逐元素化简（matchOverloadedBinaryOperator :257-336 → checkOverloadedBinaryArrayMul / ScalarArray / ArrayScalar / AddSub / Div / EW :417-767 → ExpandExp.expandArrayConstructor2，NFExpandExp.mo:471-507），实参全成字面量的元素求值成记录式、函数不打（VRC4 / VRC12 / VRC13 / VRC15 / VRC17 / VRC32 / VRC34 / VRC38 / VRC53 / VRC54 / VRC56 / VRC57 / VRC62 / VRC63 / VRC95 / VRC96 / VRC98 / VRC99 / VRC106 / VRC118 / VRC120 / VRC130 / VRC144 / VRC146 / VRC147 / VRC149 / VRC150、VRU1 / VRU3 / VRU8），否则逐元素留调用（VRC3 / VRC5 / VRC6 / VRC14 / VRC19 / VRC21 / VRC23 / VRC24 / VRC26 / VRC27 / VRC29-VRC31 / VRC35 / VRC37 / VRC42 / VRC44-VRC48 / VRC50 / VRC60 / VRC61 / VRC64 / VRC65 / VRC68 / VRC70 / VRC97 / VRC102-VRC104 / VRC108-VRC111 / VRC113-VRC115 / VRC119 / VRC127-VRC129 / VRC131 / VRC132 / VRC134 / VRC136 / VRC138-VRC142 / VRC148 / VRC153、VRU2）；实参 fill / ones / zeros 照 simplifySubscriptedExp 取元素（NFSimplifyExp.mo:1346-1379），实参整个是会成字面量的数组调用（或其取负）先求值、整体取负不护零（`{-0.0, …}`；VRC12 / VRC13 / VRC17 / VRC48 / VRC50 / VRC53 / VRC54 / VRC56 / VRC95 / VRC96 / VRC99 / VRC120 / VRC147 / VRC150，不纯的照旧 SKIP VRC152）。基线 ACCEPTS-INVALID（一并修）：记录的元素级运算配 Integer / Real（checkOverloadedBinaryArrayEW 的 matchExpressions，NFTypeCheck.mo:751-760；VRC80-VRC83 / VRC88 / VRC90 / VRU5 / VRU6 / VRU10 / VRU11）、标量在前的元素级运算（结果类型取标量的 setArrayElementType(type1, ty) :840；VRC71 / VRC72 / VRC74-VRC76 / VRU4 / VRU9，标量语境里 omc 留着数组值的 VRC77-VRC79 → SKIP）。照旧 SKIP：整个等式一侧 / 绑定里留整体的向量化记录调用（VRC1 / VRC2 / VRC8 / VRC9 / VRC11 / VRC16 / VRC18 / VRU7，MSL IMC_Conveyor 的 VfController）、参数数组绑定（VRC10 / VRC39）、精确匹配到 scalarProduct（VRC28 / VRC135）、函数体里（VRC121-VRC124）、实参是别的形态的数组调用 / 下标数组切片 / 取负字面量（VRC49 / VRC51 / VRC52 / VRC58 / VRC59 / VRC100 / VRC101 / VRC116 / VRC133 / VRC143）、记录常量 / 记录式参与的常量运算（VRC105 / VRC107 / VRC125）；对照（基线就 PASS）：显式数组字面量 / 逐元素 for / 记录数组的元素级与数组在前的运算（VRC20 / VRC73 / VRC84-VRC87 / VRC89 / VRC91-VRC94 / VRC137 / VRU12），实数向量化调用的 fill / 取负 / 嵌套数组调用实参（VRA / VRB / VRD，照旧 SKIP 或 PASS）
//// model: VRC1
model VRC1
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC1;
//// model: VRC2
model VRC2
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi);
end VRC2;
//// model: VRC3
model VRC3
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(r, phi);
end VRC3;
//// model: VRC4
model VRC4
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC4;
//// model: VRC5
model VRC5
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) * u;
end VRC5;
//// model: VRC6
model VRC6
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) + z;
end VRC6;
//// model: VRC7
model VRC7
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = -Modelica.ComplexMath.fromPolar(r, phi);
end VRC7;
//// model: VRC8
model VRC8
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = Modelica.ComplexMath.conj(z);
end VRC8;
//// model: VRC9
model VRC9
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3] = Modelica.ComplexMath.fromPolar(r, phi);
end VRC9;
//// model: VRC10
model VRC10
  parameter Complex y[3] = Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC10;
//// model: VRC11
model VRC11
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(1, phi);
end VRC11;
//// model: VRC12
model VRC12
  parameter Integer m = 3 annotation(Evaluate = true);
  Complex u = Complex(time, 2);
  Complex y[m];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, m), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m));
end VRC12;
//// model: VRC13
model VRC13
  parameter Integer m = 3;
  Complex u = Complex(time, 2);
  Complex y[m];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, m), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m));
end VRC13;
//// model: VRC14
model VRC14
  parameter Real phi0[3] = {1, 2, 3};
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), phi0);
end VRC14;
//// model: VRC15
model VRC15
  Modelica.ComplexBlocks.Interfaces.ComplexInput u = Complex(time, 2);
  Modelica.ComplexBlocks.Interfaces.ComplexOutput y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC15;
//// model: VRC16
model VRC16
  parameter Integer m = 3 annotation(Evaluate = true);
  Real amplitude = time;
  parameter Real orientation[m] = -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m);
  parameter Real BasePhase = 0;
  Complex y[m];
equation
  y = Modelica.ComplexMath.fromPolar(fill(amplitude, m), orientation + fill(BasePhase - Modelica.Constants.pi/2, m));
end VRC16;
//// model: VRC17
model VRC17
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
end VRC17;
//// model: VRC18
model VRC18
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(fill(1, 3), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
end VRC18;
//// model: VRC19
model VRC19
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), phi);
end VRC19;
//// model: VRC20
model VRC20
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * {Modelica.ComplexMath.fromPolar(1, 1), Modelica.ComplexMath.fromPolar(1, 2), Modelica.ComplexMath.fromPolar(1, 3)};
end VRC20;
//// model: VRC21
model VRC21
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) / u;
end VRC21;
//// model: VRC22
model VRC22
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u / Modelica.ComplexMath.fromPolar(r, phi);
end VRC22;
//// model: VRC23
model VRC23
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z - Modelica.ComplexMath.fromPolar(r, phi);
end VRC23;
//// model: VRC24
model VRC24
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) .* z;
end VRC24;
//// model: VRC25
model VRC25
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u .* Modelica.ComplexMath.fromPolar(r, phi);
end VRC25;
//// model: VRC26
model VRC26
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = 2 * Modelica.ComplexMath.fromPolar(r, phi);
end VRC26;
//// model: VRC27
model VRC27
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) * 2.5;
end VRC27;
//// model: VRC28
model VRC28
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y;
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) * z;
end VRC28;
//// model: VRC29
model VRC29
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) + Modelica.ComplexMath.fromPolar(phi, r);
end VRC29;
//// model: VRC30
model VRC30
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.conj(z);
end VRC30;
//// model: VRC31
function VRC31F
  input Real a;
  input Real b;
  output Complex c;
algorithm
  c := Complex(a + b, a - b);
end VRC31F;
model VRC31
  Real r[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC31F(r, 2);
end VRC31;
//// model: VRC32
function VRC32F
  input Real a;
  input Real b = 3;
  output Complex c;
algorithm
  c := Complex(a + b, a - b);
end VRC32F;
model VRC32
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC32F({1, 2, 3});
end VRC32;
//// model: VRC33
record VRC33R
  Real a;
  Real b;
end VRC33R;
function VRC33F
  input Real x;
  output VRC33R r;
algorithm
  r := VRC33R(x, 2 * x);
end VRC33F;
model VRC33
  Real x[2] = {time, 2 * time};
  VRC33R u = VRC33R(1, 2);
  VRC33R y[2];
equation
  y = u * VRC33F(x);
end VRC33;
//// model: VRC34
model VRC34
  Complex u = Complex(time, 2);
  Complex y[1];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 1), {2});
end VRC34;
//// model: VRC35
model VRC35
  Real phi[1] = {time};
  Complex u = Complex(time, 2);
  Complex y[1];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 1), phi);
end VRC35;
//// model: VRC36
model VRC36
  Real r[2, 2] = {{1, 2}, {3, 4}} * time;
  Complex u = Complex(time, 2);
  Complex y[2, 2];
equation
  y = u * Modelica.ComplexMath.fromPolar(r, r);
end VRC36;
//// model: VRC37
model VRC37
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3] = u * Modelica.ComplexMath.fromPolar(r, phi);
end VRC37;
//// model: VRC38
model VRC38
  Complex u = Complex(time, 2);
  Complex y[3] = u * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC38;
//// model: VRC39
model VRC39
  parameter Complex u = Complex(1, 2);
  parameter Complex y[3] = u * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC39;
//// model: VRC40
model VRC40
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
algorithm
  y := u * Modelica.ComplexMath.fromPolar(r, phi);
end VRC40;
//// model: VRC41
model VRC41
  Real r[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[2, 3];
equation
  for i in 1:2 loop
    y[i, :] = u * Modelica.ComplexMath.fromPolar(r, {1, 2, 3} * i);
  end for;
end VRC41;
//// model: VRC42
model VRC42
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex v = Complex(2, time);
  Complex y[3];
equation
  y = v * (u * Modelica.ComplexMath.fromPolar(r, phi));
end VRC42;
//// model: VRC43
model VRC43
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Real a[3];
equation
  a = Modelica.ComplexMath.abs(u * Modelica.ComplexMath.fromPolar(r, phi));
end VRC43;
//// model: VRC44
model VRC44
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(2 * r, -phi);
end VRC44;
//// model: VRC45
model VRC45
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(ones(3), phi);
end VRC45;
//// model: VRC46
model VRC46
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(zeros(3), phi);
end VRC46;
//// model: VRC47
model VRC47
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(time, 3), phi);
end VRC47;
//// model: VRC48
model VRC48
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3), phi);
end VRC48;
//// model: VRC49
model VRC49
  parameter Integer m = 3;
  Real phi[m] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[m];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(2, m), phi - Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m));
end VRC49;
//// model: VRC50
model VRC50
  Real r[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(r, -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
end VRC50;
//// model: VRC51
function VRC51G
  input Real x[:];
  output Real y[size(x, 1)];
algorithm
  y := 2 * x;
end VRC51G;
model VRC51
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), -VRC51G(phi));
end VRC51;
//// model: VRC52
function VRC52G
  input Real x[:];
  output Real y[size(x, 1)];
algorithm
  y := 2 * x;
end VRC52G;
model VRC52
  parameter Real p[3] = {1, 2, 3};
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), VRC52G(p));
end VRC52;
