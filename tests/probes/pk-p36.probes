end VRC64;
//// model: VRC65
model VRC65
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.exp(z);
end VRC65;
//// model: VRC66
model VRC66
  Complex u = Complex(time, 2);
  Complex y[3];
equation
