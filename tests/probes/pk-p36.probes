//// model: VRC71
model VRC71
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u .* {Complex(1, 2), Complex(3, 4), Complex(5, 6)};
end VRC71;
//// model: VRC72
model VRC72
  Complex u = Complex(time, 2);
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = u .* z;
end VRC72;
//// model: VRC73
model VRC73
  Complex u = Complex(time, 2);
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z .* u;
end VRC73;
//// model: VRC74
model VRC74
  Complex u = Complex(time, 2);
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = u .+ z;
end VRC74;
//// model: VRC75
model VRC75
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = 2 .* z;
end VRC75;
//// model: VRC76
model VRC76
  Complex u = Complex(time, 2);
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3] = u .* z;
end VRC76;
//// model: VRC77
model VRC77
  Complex u = Complex(time, 2);
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex s;
equation
  s = u .* z;
end VRC77;
//// model: VRC78
model VRC78
  Complex u = Complex(time, 2);
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Real a;
equation
  a = Modelica.ComplexMath.abs(u .* z);
end VRC78;
//// model: VRC79
model VRC79
  Complex u = Complex(time, 2);
  Complex z[1] = {Complex(time, 1)};
  Complex s;
equation
  s = u .* z;
end VRC79;
//// model: VRC80
model VRC80
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z .* 2;
end VRC80;
//// model: VRC81
model VRC81
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z ./ 2.0;
end VRC81;
//// model: VRC82
model VRC82
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z .* {1, 2, 3};
end VRC82;
//// model: VRC83
model VRC83
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = {1, 2, 3} .* z;
end VRC83;
//// model: VRC84
model VRC84
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = z ./ u;
end VRC84;
//// model: VRC85
model VRC85
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex w[3] = {Complex(1, time), Complex(time, 2), Complex(3, time)};
  Complex y[3];
equation
  y = z .* w;
end VRC85;
//// model: VRC86
model VRC86
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z * 2;
end VRC86;
//// model: VRC87
model VRC87
  Complex z[3] = {Complex(time, 1), Complex(2, time), Complex(time, time)};
  Complex y[3];
equation
  y = z / 2;
end VRC87;
//// model: VRC88
model VRC88
  Complex u = Complex(time, 2);
  Complex y;
equation
  y = u .* 2;
end VRC88;
//// model: VRC89
model VRC89
  Complex u = Complex(time, 2);
  Complex v = Complex(1, time);
  Complex y;
equation
  y = u .* v;
end VRC89;
//// model: VRC90
model VRC90
  Complex u = Complex(time, 2);
  Complex y;
equation
  y = 2.0 ./ u;
end VRC90;
//// model: VRC91
model VRC91
  Complex u = Complex(time, 2);
  Complex v = Complex(1, time);
  Complex y;
equation
  y = u .- v;
end VRC91;
//// model: VRC92
model VRC92
  Complex u = Complex(time, 2);
  Modelica.Units.SI.ComplexVoltage v = Complex(1, time);
  Complex y;
equation
  y = u .+ v;
end VRC92;
//// model: VRC93
model VRC93
  Modelica.Units.SI.ComplexVoltage z[2] = {Complex(time, 1), Complex(2, time)};
  Modelica.Units.SI.ComplexCurrent w[2] = {Complex(1, time), Complex(time, 2)};
  Complex y[2];
equation
  y = z .* w;
end VRC93;
//// model: VRC94
function VRC94G
  input Real x[3];
  output Complex c;
algorithm
  c := Complex(x[1] + x[2], x[3]);
end VRC94G;
model VRC94
  Complex u = Complex(time, 2);
  Complex y;
equation
  y = u * VRC94G(-Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
end VRC94;
//// model: VRC95
package VRC95P
  block B
    parameter Integer m = 3 annotation(Evaluate = true);
    Modelica.ComplexBlocks.Interfaces.ComplexInput u;
    Modelica.ComplexBlocks.Interfaces.ComplexOutput y[m];
  equation
    y = u * Modelica.ComplexMath.fromPolar(fill(1, m), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m));
  end B;
end VRC95P;
model VRC95
  parameter Integer n = 3 annotation(Evaluate = true);
  VRC95P.B b(final m = n);
equation
  b.u = Complex(time, 1);
end VRC95;
//// model: VRC96
package VRC96P
  block B
    parameter Integer m = 3;
    Modelica.ComplexBlocks.Interfaces.ComplexInput u;
    Modelica.ComplexBlocks.Interfaces.ComplexOutput y[m];
  equation
    y = u * Modelica.ComplexMath.fromPolar(fill(1, m), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m));
  end B;
end VRC96P;
model VRC96
  VRC96P.B b1(m = 2);
  VRC96P.B b2(m = 5);
equation
  b1.u = Complex(time, 1);
  b2.u = Complex(1, time);
end VRC96;
//// model: VRC97
model VRC97
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex v = Complex(2, time);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(r, phi) * v;
end VRC97;
//// model: VRC98
function VRC98G
  input Integer n;
  output Integer k[n];
algorithm
  k := {i for i in 1:n};
end VRC98G;
model VRC98
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(VRC98G(3), {0, 0, 0});
end VRC98;
//// model: VRC99
model VRC99
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(-Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
end VRC99;
//// model: VRC100
model VRC100
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), -(Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3)));
end VRC100;
//// model: VRC101
model VRC101
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), 2 * Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
end VRC101;
//// model: VRC102
model VRC102
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
  Boolean b = time > 0.5;
equation
  if b then
    y = u * Modelica.ComplexMath.fromPolar(r, phi);
  else
    y = u * Modelica.ComplexMath.fromPolar(phi, r);
  end if;
end VRC102;
//// model: VRC103
model VRC103
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  u * Modelica.ComplexMath.fromPolar(r, phi) = y;
end VRC103;
//// model: VRC104
model VRC104
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = Modelica.ComplexMath.j * Modelica.ComplexMath.fromPolar(r, phi);
end VRC104;
//// model: VRC105
model VRC105
  constant Complex c = Complex(1, 2);
  Complex y[3];
equation
  y = c * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC105;
//// model: VRC106
model VRC106
  parameter Complex c = Complex(1, 2);
  Complex y[3];
equation
  y = c * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC106;
//// model: VRC107
model VRC107
  Complex y[3];
equation
  y = Complex(1, 2) * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
end VRC107;
//// model: VRC108
function VRC108G
  input Complex c;
  input Real x;
  output Complex d;
algorithm
  d := Complex(c.re * x, c.im);
end VRC108G;
model VRC108
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC108G(u, phi);
end VRC108;
//// model: VRC109
model VRC109
  Complex z[4] = {Complex(time, 1), Complex(2, time), Complex(time, time), Complex(1, 1)};
  Complex u = Complex(time, 2);
  Complex y[2];
equation
  y = u * Modelica.ComplexMath.conj(z[2:3]);
end VRC109;
//// model: VRC110
model VRC110
  Complex z[2, 3] = {{Complex(time, 1), Complex(2, time), Complex(time, time)}, {Complex(1, time), Complex(time, 2), Complex(3, 3)}};
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.conj(z[2, :]);
end VRC110;
//// model: VRC111
model VRC111
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  when time > 0.5 then
    y = u * Modelica.ComplexMath.fromPolar(r, phi);
  end when;
end VRC111;
//// model: VRC112
model VRC112
  parameter Real p = Modelica.ComplexMath.real((Complex(1, 2) * Modelica.ComplexMath.fromPolar({1, 1}, {1, 2}))[2]);
end VRC112;
//// model: VRC113
model VRC113
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Real y;
equation
  y = Modelica.ComplexMath.real((u * Modelica.ComplexMath.fromPolar(r, phi))[2]);
end VRC113;
//// model: VRC114
package VRC114P
  model B
    Real phi[3] = {4, 5, 6} * time;
    Complex u = Complex(time, 2);
    Complex y[3];
  end B;
end VRC114P;
model VRC114
  VRC114P.B b(y = b.u * Modelica.ComplexMath.fromPolar(fill(1, 3), b.phi));
end VRC114;
//// model: VRC115
model VRC115
  parameter Integer m = 3;
  Real r[m] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[m];
equation
  y = u * Modelica.ComplexMath.fromPolar(r, fill(Modelica.Constants.pi / m, m));
end VRC115;
//// model: VRC116
model VRC116
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3) .* {1, 1, 1});
end VRC116;
//// model: VRC117
function VRC117F
  input Real x;
  output Complex c;
algorithm
  assert(x < 2.5, "too big");
  c := Complex(x, 0);
end VRC117F;
model VRC117
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC117F({1, 2, 3});
end VRC117;
//// model: VRC118
function VRC118F
  input Real x;
  output Complex c;
algorithm
  c := Complex(x, 0);
end VRC118F;
model VRC118
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC118F({1, 2, 3});
end VRC118;
//// model: VRC119
function VRC119F
  input Real x;
  output Complex c;
algorithm
  c := Complex(x, 0);
end VRC119F;
model VRC119
  Real r[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC119F(r);
end VRC119;
//// model: VRC120
model VRC120
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3)) * u;
end VRC120;
//// model: VRC121
function VRC121F
  input Real x;
  output Real y;
protected
  Complex u = Complex(x, 2);
  Complex c[3];
algorithm
  c := u * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
  y := c[2].re + c[3].im;
end VRC121F;
model VRC121
  Real y = VRC121F(time);
end VRC121;
//// model: VRC122
function VRC122F
  input Real x;
  output Real y;
protected
  Complex u = Complex(x, 2);
  Complex c[3];
algorithm
  c := u * Modelica.ComplexMath.fromPolar(fill(1, 3), {1, 2, 3});
  y := c[2].re + c[3].im;
end VRC122F;
model VRC122
  Real y = VRC122F(1.5);
end VRC122;
//// model: VRC123
function VRC123F
  input Real r[3];
  input Real phi[3];
  input Complex u;
  output Complex c[3];
algorithm
  c := u * Modelica.ComplexMath.fromPolar(r, phi);
end VRC123F;
model VRC123
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = VRC123F(r, phi, u);
end VRC123;
//// model: VRC124
function VRC124F
  input Real x;
  output Real y;
protected
  Complex c[3];
algorithm
  c := Complex(x, 1) * Modelica.ComplexMath.fromPolar(fill(1, 3), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(3));
  y := c[1].re + c[2].im;
end VRC124F;
model VRC124
  parameter Real p = VRC124F(2);
  Real y = VRC124F(time);
end VRC124;
//// model: VRC125
model VRC125
  parameter Real p = Modelica.ComplexMath.real(Complex(1, 2) * Modelica.ComplexMath.fromPolar(1, 2));
end VRC125;
//// model: VRC126
model VRC126
  Real r[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Real y[3];
equation
  y = Modelica.ComplexMath.real(u * Modelica.ComplexMath.fromPolar(r, {1, 2, 3}));
end VRC126;
//// model: VRC127
model VRC127
  parameter Real len = 2;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(len, {1, 2, 3});
end VRC127;
//// model: VRC128
model VRC128
  parameter Real p = 2;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(p, 3), {1, 2, 3});
end VRC128;
//// model: VRC129
model VRC129
  parameter Integer m = 3;
  Real phi[m] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[m];
equation
  y = u * Modelica.ComplexMath.fromPolar(ones(m), phi);
end VRC129;
//// model: VRC130
operator record VRC130C "complex-like"
  Real re "real part";
  Real im "imaginary part";
  encapsulated operator 'constructor'
    function fromReal "from reals"
      import VRC130C;
      input Real re "re in";
      input Real im = 0 "im in";
      output VRC130C result(re = re, im = im) "result";
    algorithm
      annotation(Inline = true);
    end fromReal;
  end 'constructor';
  encapsulated operator '*'
    function multiply "product"
      import VRC130C;
      input VRC130C c1;
      input VRC130C c2;
      output VRC130C c3;
    algorithm
      c3 := VRC130C(c1.re * c2.re - c1.im * c2.im, c1.re * c2.im + c1.im * c2.re);
    end multiply;
  end '*';
end VRC130C;
connector VRC130CI = input VRC130C "in";
connector VRC130CO = output VRC130C "out";
function VRC130F "from polar"
  input Real len;
  input Real phi;
  output VRC130C c;
algorithm
  c := VRC130C(len * cos(phi), len * sin(phi));
end VRC130F;
model VRC130
  VRC130CI u;
  VRC130CO y[2];
equation
  u = VRC130C(time, 1);
  y = u * VRC130F(fill(2, 2), {1, 2});
end VRC130;
//// model: VRC131
function VRC131F
  input Real a;
  input Real b;
  input Real c;
  output Complex z;
algorithm
  z := Complex(a * b, c);
end VRC131F;
model VRC131
  parameter Real k = 3;
  Real x[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * VRC131F(x, 2, k);
end VRC131;
//// model: VRC132
model VRC132
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[2];
equation
  y = u * Modelica.ComplexMath.fromPolar(r[1:2], phi[2:3]);
end VRC132;
//// model: VRC133
model VRC133
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[2];
equation
  y = u * Modelica.ComplexMath.fromPolar(r[{1, 3}], phi[1:2]);
end VRC133;
//// model: VRC134
model VRC134
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) + {Complex(1, 2), Complex(3, 4), Complex(5, 6)};
end VRC134;
//// model: VRC135
model VRC135
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex y;
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) * Modelica.ComplexMath.fromPolar(phi, r);
end VRC135;
//// model: VRC136
model VRC136
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  parameter Complex u = Complex(1, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(r, phi);
end VRC136;
//// model: VRC137
model VRC137
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  for i in 1:3 loop
    y[i] = u * Modelica.ComplexMath.fromPolar(r[i], phi[i]);
  end for;
end VRC137;
//// model: VRC138
model VRC138
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(phi = phi, len = r);
end VRC138;
//// model: VRC139
model VRC139
  Integer k[3] = {1, 2, 3} * integer(time);
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(k, phi);
end VRC139;
//// model: VRC140
model VRC140
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), phi) + u * Modelica.ComplexMath.fromPolar(fill(2, 3), {1, 2, 3});
end VRC140;
//// model: VRC141
model VRC141
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), phi) - Modelica.ComplexMath.fromPolar(phi, fill(-1, 3)) * u;
end VRC141;
//// model: VRC142
model VRC142
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), -phi);
end VRC142;
//// model: VRC143
model VRC143
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), -{0.0, 1.0, 2.0});
end VRC143;
//// model: VRC144
model VRC144
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 3), {-0.0, 1.0, 2.0});
end VRC144;
//// model: VRC145
model VRC145
  Complex u = Complex(time, 2);
  Complex y[0];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, 0), zeros(0));
end VRC145;
//// model: VRC146
function VRC146F
  input Integer k;
  output Complex c;
algorithm
  c := Complex(k, 2 * k);
end VRC146F;
model VRC146
  Complex u = Complex(time, 2);
  Complex y[3];
equation
