end VRC146;
//// model: VRC147
package VRC147P
  constant Integer m = 3;
end VRC147P;
model VRC147
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Modelica.ComplexMath.fromPolar(fill(1, VRC147P.m), -Modelica.Electrical.Polyphase.Functions.symmetricOrientation(VRC147P.m));
end VRC147;
//// model: VRC148
model VRC148
  function fp = Modelica.ComplexMath.fromPolar;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * fp(fill(1, 3), phi);
end VRC148;
//// model: VRC149
model VRC149
  import Modelica.ComplexMath.fromPolar;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * fromPolar(fill(1, 3), {1, 2, 3});
end VRC149;
//// model: VRC150
model VRC150
  constant Integer m = 3;
  Complex u = Complex(time, 2);
  Complex y[m];
equation
