end VRC66;
//// model: VRC67
model VRC67
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u ^ Modelica.ComplexMath.fromPolar(r, phi);
end VRC67;
//// model: VRC68
model VRC68
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) .^ u;
end VRC68;
//// model: VRC69
model VRC69
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) + u;
end VRC69;
//// model: VRC70
model VRC70
  Real r[3] = {1, 2, 3} * time;
  Real phi[3] = {4, 5, 6} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = Modelica.ComplexMath.fromPolar(r, phi) .+ u;
