//// model: VRC63
model VRC63
  Complex u = Complex(time, 2);
  Complex y[3];
equation
  y = u * Complex.'constructor'.fromReal({1, 2, 3}, 0);
end VRC63;
//// model: VRC64
model VRC64
  Real r[3] = {1, 2, 3} * time;
  Complex u = Complex(time, 2);
  Complex y[3];
equation
