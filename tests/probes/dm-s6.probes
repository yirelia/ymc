//// set: dm-s6 — Integer / Real 混合的范围（for 语句、函数体）
//// model: S60
model S60
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := 1; for i in 1:n loop y := y * i; end for; end f; Real y = f(t);
end S60;
//// model: S61
model S61
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := 1; for i in 1:0.5:n loop y := y * i; end for; end f; Real y = f(t);
end S61;
//// model: S62
model S62
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := 1; for i in 1:2:n loop y := y * i; end for; end f; Real y = f(t);
end S62;
//// model: S63
model S63
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Integer n; output Real y; algorithm y := 1; for i in 1:n loop y := y * i; end for; end f; Real y = f(integer(t));
end S63;
//// model: S64
model S64
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := 1; for i in n:3 loop y := y * i; end for; end f; Real y = f(t);
end S64;
//// model: S65
model S65
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Integer k; input Real n; output Real y; algorithm y := 1; for i in k:n loop y := y * i; end for; end f; Real y = f(1, t);
end S65;
//// model: S66
model S66
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Integer k; input Real n; output Real y; algorithm y := 1; for i in 1:k:n loop y := y * i; end for; end f; Real y = f(1, t);
end S66;
//// model: S67
model S67
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Integer k; input Real n; output Real y; algorithm y := 1; for i in k + 1:n loop y := y * i; end for; end f; Real y = f(1, t);
end S67;
//// model: S68
model S68
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := 1; for i in 1.0:n loop y := y * i; end for; end f; Real y = f(t);
end S68;
//// model: S69
model S69
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := 1; for i in 1:3 loop y := y * i * n; end for; end f; Real y = f(t);
end S69;
//// model: BASE
model BASE
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
end BASE;
//// model: S610
model S610
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; algorithm y := sum(i for i in 1:n); end f; Real y = f(t);
end S610;
//// model: S611
model S611
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; protected Real v[:] = 1:n; algorithm y := sum(v); end f; Real y = f(t);
end S611;
//// model: S612
model S612
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  function f input Real n; output Real y; protected Integer k; algorithm y := 1; k := 0; for i in 1:n loop k := k + 1; end for; y := k; end f; Real y = f(t);
end S612;
//// model: S613
model S613
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y; algorithm y := 0; for i in 1:t loop y := y + i; end for;
end S613;
//// model: S614
model S614
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y; algorithm y := 0; for i in 1:2.5 loop y := y + i; end for;
end S614;
//// model: S615
model S615
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y; algorithm y := 0; for i in 1:0.5:2 loop y := y + i; end for;
end S615;
//// model: S616
model S616
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y; algorithm y := 0; for i in 1.5:3 loop y := y + i; end for;
end S616;
//// model: S617
model S617
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y; algorithm y := 0; for i in 1:3 loop y := y + i; end for;
end S617;
//// model: S618
model S618
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[2];
equation
  for i in 1:2.5 loop y[integer(i)] = i * t; end for;
end S618;
//// model: S619
model S619
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[2] = 1:2.5;
end S619;
//// model: S620
model S620
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y[3] = 1:0.5:2;
end S620;
//// model: S621
model S621
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y = sum(i for i in 1:2.5);
end S621;
//// model: S622
model S622
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Real y = sum(i * t for i in 1:2.5);
end S622;
//// model: S623
model S623
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Real p = 2.5; Real y; algorithm y := 0; for i in 1:p loop y := y + i; end for;
end S623;
//// model: S624
model S624
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer n = 2; Real y; algorithm y := 0; for i in 1:n loop y := y + i * t; end for;
end S624;
//// model: S625
model S625
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  parameter Integer n = 2; Real y; algorithm y := 0; for i in 1.0:n loop y := y + i * t; end for;
end S625;
//// model: S626
model S626
  Real x[3] = {time, 1, 2};
  Real m[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real t = time;
  Integer k = integer(t); Real y; algorithm y := 0; for i in k:2.5 loop y := y + i; end for;
end S626;
