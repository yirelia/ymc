//// set: sz-s2 — size / ndims：非常量维号、for / when / if 里、函数体里的 size(u) 与 ndims
//// model: S20
model S20
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Integer k[2];
equation
  for i in 1:2 loop k[i] = size(m, i); end for;
end S20;
//// model: S21
model S21
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Integer k[2]; algorithm for i in 1:2 loop k[i] := size(m, i); end for;
end S21;
//// model: S22
model S22
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Integer d = 1; Integer k;
equation
  k = size(m, d);
end S22;
//// model: S23
model S23
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Integer d = 1; Integer k; algorithm k := size(m, d);
end S23;
