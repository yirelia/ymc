//// model: S239
model S239
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; output Integer n; algorithm n := ndims(u) + ndims(u[1]); end f; Integer k = f(m);
end S239;
