  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; output Integer n[2]; algorithm n := size(u) + {1, 1}; end f; Integer k[2] = f(m);
