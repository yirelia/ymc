//// model: S212
model S212
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y = if size(x, 1) > 2 then a else b;
end S212;
//// model: S213
model S213
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y;
equation
  if size(x, 1) > 2 then y = a; else y = b; end if;
end S213;
//// model: S214
model S214
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y;
equation
  when size(x, 1) > 2 then y = a; end when;
end S214;
//// model: S215
model S215
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  Real y = sum(size(m));
end S215;
//// model: S216
model S216
