//// model: S226
model S226
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; output Integer n; algorithm n := size(u, 1) * size(u, 2); end f; Integer k = f(m);
end S226;
//// model: S227
model S227
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; output Integer n; algorithm n := sum(size(u)); end f; Integer k = f(m);
end S227;
//// model: S228
model S228
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; output Integer n; algorithm n := scalar(size(u[1])); end f; Integer k = f(m);
end S228;
//// model: S229
model S229
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:, :]; input Integer d; output Integer n; algorithm n := size(u, d); end f; Integer k = f(m, 1);
end S229;
//// model: S230
model S230
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:]; output Real v[size(u, 1)]; algorithm v := zeros(size(u, 1)); end f; Real y[3] = f(x);
end S230;
//// model: S231
model S231
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:]; output Integer n[1]; protected Real w[3]; algorithm n := size(w); end f; Integer k[1] = f(x);
end S231;
//// model: S232
model S232
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:]; output Integer n; protected Real w[3]; algorithm n := size(w, 1) + size(u, 1); end f; Integer k = f(x);
end S232;
//// model: S233
model S233
  Real a = time;
  Real b = 2 * time;
  Real x[3] = {a, b, a};
  Real m[2, 3] = {{a, b, a}, {b, a, b}};
  function f input Real u[:]; output Integer n; algorithm n := size({u, u}, 1); end f; Integer k = f(x);
end S233;
