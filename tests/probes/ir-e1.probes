//// model: E120
model E120
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  type E = enumeration(one, two, three); Real y[E, 2];
equation
  for i, j loop y[i, j] = a * j; end for;
end E120;
//// model: E121
model E121
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  type E = enumeration(one, two, three); Real y[E]; Real z[3];
equation
  for i loop y[i] = a; end for; algorithm for i loop z[i] := y[i]; end for;
end E121;
//// model: E122
model E122
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  type E = enumeration(one, two, three); Real y[E]; Real z[3];
equation
  for i loop y[i] = a; end for; algorithm for i loop z[Integer(i)] := y[i]; end for;
end E122;
