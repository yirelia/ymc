//// set: fc-c3 — 函数体归约补充：min / max 字面量范围、空范围、单元素、步长、Integer 体、if 体、下标式
//// model: C30
function f
input Real x[2];
output Real y;
algorithm
y := max(x[i] for i in 1:2);
end f;
model C30
Real z = f({time, 2});
end C30;
//// model: C31
function f
input Real x[2];
output Real y;
algorithm
y := sum(x[i] for i in 1:0);
end f;
model C31
Real z = f({time, 2});
end C31;
//// model: C32
function f
input Real x[2];
output Real y;
algorithm
y := sum(x[i] for i in 2:2);
end f;
model C32
Real z = f({time, 2});
end C32;
//// model: C33
function f
input Real a;
output Real o[2];
algorithm
o := {a * i for i in 1:2:3};
end f;
model C33
Real z[2] = f(time);
end C33;
//// model: C34
function f
input Real x[:, :];
output Real y;
algorithm
y := 0;
for k in 1:size(x, 1) loop
y := y + sum(x[k, j] for j in 1:size(x, 2));
end for;
end f;
model C34
Real z = f({{time, 2}});
end C34;
//// model: C35
function f
input Integer m;
output Integer y;
algorithm
y := product(i for i in 1:3) + m;
end f;
model C35
Integer k = f(integer(time));
end C35;
//// model: C36
function f
input Real x[:];
output Real y;
algorithm
y := sum(if x[i] > 0 then x[i] else 0 for i in 1:size(x, 1));
end f;
model C36
Real z = f({time, -2});
end C36;
//// model: C37
function f
input Real x[3];
output Real y;
algorithm
y := sum(x[i] * x[4 - i] for i in 1:3);
end f;
model C37
Real z = f({time, 2, 3});
end C37;
//// model: C38
function f
input Real a;
output Real o[1];
algorithm
o := {a * i for i in 2:2};
end f;
model C38
Real z[1] = f(time);
end C38;
//// model: C39
function f
input Real x[:];
output Real y;
protected
Real w[size(x, 1)];
algorithm
w := {2 * x[i] for i in 1:size(x, 1)};
y := sum(w);
end f;
model C39
Real z = f({time, 2});
end C39;
//// model: C310
function f
input Real x[:];
output Real y;
algorithm
y := sum(x[i] for i in 1:size(x, 1)) / size(x, 1);
end f;
model C310
Real z = f({time, 2});
end C310;
//// model: C311
function f
input Integer n;
output Real y[n];
algorithm
y := {sin(i * 0.5) for i in 1:n};
end f;
model C311
Real z[2] = f(2) * time;
end C311;
