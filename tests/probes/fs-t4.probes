//// set: fs-t4 — 函数体里的数组 if 表达式：分支转型、逐元素展开
//// model: T40
model T40
  Real a = time;
  Real x[3] = {a, 2 * a, 3 * a};
  Real m[2, 3] = {{a, a, a}, {a, a, a}};
  function f input Real u[:]; input Real w[3]; input Real q[:, :]; input Real g[2, 3]; input Integer k; input Integer n[:]; input Integer n2[2]; input Real g2[3, 2]; output Real o; protected Real v[size(u, 1)]; Real v3[3]; Real v2[2]; Real s; Real gg[2, 3]; Real g22[2, 2]; Real g33[3, 3]; Integer nn[2]; Boolean bb[2]; algorithm s := 1; v := u; v3 := w; v2 := {1, 2}; v2 := if k > 0 then w[1:2] else n2; o := s; end f; Real y = f(x, x, m, m, 1, {1, 2, 3}, {1, 2}, {{1, 2}, {3, 4}, {5, 6}});
end T40;
