end RO5_;
//// model: S1
model S1
  Real x = time;
  Integer n = 3;
  Boolean b = true;
  parameter Real p = 1.5;
  String s1 = String(x);
  String s2 = String(n);
  String s3 = String(b);
  String s4 = String(p, significantDigits = 3);
  String s5 = String(n, minimumLength = 4, leftJustified = false);
  String s6 = String(2.5);
  String s7 = String(x, format = "6.2f");
end S1;
//// model: S2
type E = enumeration(one, two);
model S2
  String a = String(1/3);
  String b = String(1e10);
  String c = String(1e-7);
  String d = String(100.0);
  String e = String(3, minimumLength = 4);
  String f = String(3, minimumLength = 4, leftJustified = false);
  String g = String(true, minimumLength = 6);
  String h = String(2.5, significantDigits = 2);
  String i = String(2.5, format = "6.2f");
  String j = String(E.two);
  String k = String(-0.5);
  String l = String(123456789.0);
end S2;
//// model: S3
type E = enumeration(one, two);
model S3
  String a = String(1/3);
  String d = String(100.0);
  String e = String(3, minimumLength = 4);
  String f = String(3, minimumLength = 4, leftJustified = false);
  String g = String(true, minimumLength = 6);
  String h = String(2.5, significantDigits = 2);
  String i = String(2.5, format = "6.2f");
  String j = String(E.two);
  String k = String(-0.5);
end S3;
//// model: SE1
model SE1
  Integer n;
  Real y = ({1, 2 ,3})[n];
end SE1;
//// model: SE2
model SE2
  Real x[:] = {1, 2, 3};
  Integer n;
  Real z = (x)[n];
end SE2;
//// model: SE3
model SE3
  discrete Integer n(start = 1);
  Real x[3] = {1, 2, 3} "c x";
  parameter Real p[2] = {4, 5} "c p";
  Real y = ({1, 2, 3})[n];
  Real z = ({1, 2, 3})[2];
  Real m[2, 3];
  Real u = m[1, n];
  Real v = x[n + 1];
equation
  m = {{1, 2, 3}, {4, 5, 6}};
  when time > 1 then
    n = 2;
  end when;
end SE3;
//// model: SEL1
model SEL1
  parameter Integer n = 2;
  parameter Boolean pt = true;
  parameter Boolean pf = false;
  Real x[3] = {time, 1, 2};
  Real a1[2] = if pt then {1, 2} else {3, 4, 5};
  Real a4[:] = if n == 2 then x else {1, 2};
  Real b5[:, :] = if n == 2 then ones(n, 3) else ones(n, n);
  Real y[3];
equation
  y = if pf then {1, 2} else x;
end SEL1;
//// model: SR1
function F
  input Real a;
  input Real b;
  output Real c = a + b;
end F;
model SR1
  parameter Real q[3] = {1, 2, 3};
  Real x[3] = {time, 1, 2};
  Real s1 = sum({1, 2, time});
  Real s3 = product({2, 3, time});
  Real s4 = sum({i for i in 1:3});
  Real s5 = sum({i * 1.0 for i in 1:3});
  Real s7 = sum({F(1, 2), F(2, 2)});
  parameter Real s12 = sum({1, 2, q[1]});
  Integer s13 = sum({1, 2, 3});
  Real s15 = sum({x[1], 0, x[2]});
  Real s20 = sum({1, 2} .* {3, 4});
  Real s27 = sum(linspace(0, 1, 3));
  Real m2 = max({i for i in 1:3});
  Real m5 = max(linspace(0, 1, 3));
  Real m6 = max(sin({1, 2, 3}));
  Real m9 = max({F(1, 2), F(2, 2)});
  Real m20 = sum(-x);
  Real bt = sum(sin({1, 2, 3}));
  Real bj[3] = sin({1, 2, 3});
end SR1;
//// model: T
model T
  Real w[2, 3] = {{i * j for j in 1:3} for i in 1:2};
end T;
//// model: TM1
model TM1
  parameter Integer m = 2;
  parameter Integer n = m;
  Real x[n];
  Real y = m;
end TM1;
//// model: T_RM1
record R
  Real x = 1;
  Real y = 2;
end R;
model RM1
  R a;
  R b(x(start = 3)) = a;
  R d(y(min = 0)) = R(4, 5);
  R e(x(start = 3), y(fixed = true)) = R(y = 6, x = 7);
  R c(x = 5) = a;
end RM1;
//// model: T_RO5
record R1
  Real x;
  Real y;
end R1;
record R2
  Real y;
  Real x;
end R2;
record R3
  Real x;
  Real y;
end R3;
model RO5
  R1 r1;
  R3 r3 = r1;
  R3 r4;
equation
  r1 = r4;
end RO5;
//// model: UP1
model UP1
  parameter Real p(start = 2);
  Real x = p;
  parameter Integer n(start = 3, fixed = true);
  parameter Real q;
end UP1;
//// model: UP2
model UP2
  parameter Real p(start = 2);
  Real x = p;
end UP2;
//// model: UP3
model UP3
  parameter Real p[2](start = {1, 2});
  parameter Real q[2](each start = 3);
  parameter Real r(start = 4, fixed = true);
  parameter Real s(start = 5, fixed = false);
  parameter Real k = 6;
  parameter Real t(start = k);
end UP3;
//// model: UP4
type T = Real(start = 1);
model UP4
  parameter T p;
end UP4;
//// model: V1
model V1
  Real a[3] = {time, 1, 2};
  Real b[3];
  Real c[3] = sin(a);
  Real d[2,3];
  Real e[2,3];
equation
  b = sin(a);
  d = {{time, 1, 2}, {3, 4, 5}};
  e = cos(d) + sin(d);
end V1;
//// model: V2
model V2
  function F
    input Real a;
    input Real b;
    output Real c = a + b;
  end F;
  Real b[3] = {time, 1, 2};
  Real c[3];
  Real d[3];
  Real g[3] = F(b, 2);
equation
  c = F(1, b);
  d = {F(b[i], i) for i in 1:3};
end V2;
//// model: V3
model V3
  parameter Real q[3] = {1, 2, 3};
  parameter Real p[3] = sin(q);
  Real x[3] = {time, 1, 2};
  Real s = sum(sin(x));
  Real w[2,3] = {{time, 1, 2}, {3, 4, 5}};
  Real v[2,3] = cos(w);
  Integer k[3] = {1, 2, 3};
  Real u[3] = sin(k);
  Real m[3] = sin({1, 2, time});
  Real n[3] = abs(x);
  Real d[3] = der(x);
  Real e[3] = exp(2 * x);
  Real f[3] = sin(x[1:3]);
  Real g[2] = sin(x[2:3]);
  Real h[3] = sin(w[1, :]);
end V3;
//// model: VS1
model VS1
  Real x[3] = {1, 2, 3};
  discrete Integer n(start = 1);
  Real y = x[n];
  Real z;
  Real m[2, 3];
  Real u = m[1, n];
  Real v = x[n + 1];
equation
  z = x[n] + 1;
  m = {{1, 2, 3}, {4, 5, 6}};
  when time > 1 then
    n = 2;
  end when;
end VS1;
//// model: VT1
function F
  input Real a;
  input Real b;
  output Real c = a + b;
end F;
function G
  input Real a[3];
  output Real c = a[1];
end G;
model VT1
  parameter Real q[3] = {1, 2, 3};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real a[3] = F(x, 2);
  Real c = sum(F(x, 1));
  parameter Real d[3] = F(q, 1);
  Real e = G(F(x, 1));
  Real g[3] = F({1, 2, time}, 2);
  Real n[2, 3] = F(w, 1);
  Real p[3] = F(k, 1);
  Real v[3] = F(w[1, :], 1);
  Real ac[3] = atan2(x, x);
  Real ah[3] = abs(k);
  Real aj[3] = sin(q);
  Real t[3](start = {i for i in 1:3});
  Real u[3];
equation
  u = array(F(x[i], i) for i in 1:3);
end VT1;
//// model: XR1
record R
  Real x;
  Real y;
end R;
model XR1
  R r[2](x = {1, 2}, y = {3, 4});
  Real a[2] = r.x;
  parameter R p[2](x = {1, 2}, y = {3, 4});
  parameter Real b[2] = p.x;
  Real c = sum(r.y);
  Real d[2];
equation
  d = r.y;
end XR1;
//// model: XR2
model A
  Real x;
end A;
model XR2
  A a[3, 2](x = {{1, 2}, {3, 4}, {5, 6}});
  Real y[2] = a[1].x;
  Real z[3, 2] = a.x;
  parameter Integer k = 2;
  Real w[2] = a[k].x;
end XR2;
//// model: XR3
model A
  Real x;
end A;
model XR3
  A a[3, 2](x = {{1, 2}, {3, 4}, {5, 6}});
  parameter Integer k = 2;
  Real v = a[k, 1].x;
end XR3;
