//// set: dk-p1 — 变量 / 参数数组的枚举维上的运行时下标照写（`ResetMap[reset]`、`w[pre(reset)]`）；`Integer(pre(x))`、运行时 if 式的 Integer() 照写
//// model: IE1
type L = enumeration(U, X, Z, O);
model IE1
  parameter Boolean p = true;
  discrete L x(start = L.U, fixed = true);
  discrete L z(start = L.O, fixed = true);
  Real a, b, c;
equation
  when time > 0.5 then
    x = L.Z;
    z = pre(x);
  end when;
  a = Integer(pre(x));
  b = Integer(if time > 0.2 then x else z);
  c = Integer(if p then x else z);
end IE1;
//// model: PR1
type L = enumeration(U, X, Z, O);
model PR1
  parameter Integer ResetMap[L] = {1, 4, 3, 2};
  discrete L reset(start = L.U, fixed = true);
  Integer flag;
  Real w[L];
  Real v;
algorithm
  when time > 0.5 then
    reset := L.Z;
  end when;
  flag := ResetMap[reset];
equation
  w = {time, 2 * time, 3 * time, 4 * time};
  v = w[reset] + w[pre(reset)];
end PR1;
