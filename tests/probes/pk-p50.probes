//// model: XQc23
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
record R
  Real a;
end R;
package P
  constant R r = R(1);
  constant Real c = 2;
  constant Real e[:] = {1, 2};
  constant Integer n = size(e, 1);
end P;
model XQc23
  constant Real k[2] = {myasin(1.0), 2 * myasin(1.0)};
  parameter Real p = 2 annotation(Evaluate = q);
  parameter Boolean q = time > 1;
  Real x;
equation
  x = P.r + 1;
end XQc23;
//// model: XPs1
package P
  constant Real x = 1;
  model XPs1
    Real y = P.x;
  end XPs1;
equation
  assert(true, "");
end P;
//// model: XPs2
package P
  constant Real x = 1;
  model M
    Real y = P.x;
  end M;
equation
  assert(true, "");
end P;
model XPs2
  P.M m;
end XPs2;
