//// model: XI1
package B
  connector IO = output Integer;
  connector II = input Integer;
  connector RO = output Real;
  connector RI = input Real;
  block A
    IO y(start = 0, fixed = true);
  equation
    when sample(0, 1) then
      y = pre(y) + 1;
    end when;
  end A;
  block C
    .B.II u;
    .B.RO y;
  equation
    y = u;
  end C;
end B;
model XI1
  B.A a;
  B.C c;
equation
  connect(a.y, c.u);
end XI1;
