//// model: XOv1
operator record C
  Real a;
  encapsulated operator function '=='
    import C;
    input C x;
    input C y;
    output Boolean r = x.a == y.a;
  end '==';
end C;
model XOv1
  C a;
  Boolean t = a == a;
end XOv1;
//// model: XOv2
operator record C
  Real a;
  encapsulated operator function '+'
    import C;
    input C x;
    input C y;
    output Integer r = 1;
  end '+';
end C;
model XOv2
  C a;
  Integer t = a + a;
end XOv2;
