//// model: XWa1
connector K
  Real d;
  Integer n;
end K;
model XWa1
  K c[2];
  Real y(start = 0, fixed = true);
equation
  c.n = {1, 2};
  when sample(0, 1) then
    c.d = fill(y, 2);
  end when;
  y = time;
end XWa1;
//// model: XWa2
connector K
  Real d;
  Integer n;
end K;
model XWa2
  parameter Integer nu = 1;
  K c[nu];
  Real y;
equation
  y = time;
  c.n = fill(2, nu);
  when sample(0, 1) then
    c.d = fill(y, nu);
  end when;
end XWa2;
