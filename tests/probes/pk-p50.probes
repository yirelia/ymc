//// model: XQc19
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
record R
  Real a;
end R;
package P
  constant R r = R(1);
  constant Real c = 2;
  constant Real e[:] = {1, 2};
  constant Integer n = size(e, 1);
end P;
model XQc19
  constant Real k[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real w[2] = -k;
  Real x;
equation
  x = P.r + 1;
end XQc19;
