    (c.d) = {1, 2};
  end when;
end XWa11;
//// model: XWa12
connector K
  Real d;
  Integer n;
end K;
model XWa12
  K c[2];
  Real z = c[1].d;
equation
  c.n = {1, 2};
  when sample(0, 1) then
    c.d = {pre(c[1].d) + 1, 2};
  end when;
end XWa12;
//// model: XWb1
connector K
  Real d;
  Integer n;
end K;
model XWb1
  parameter Integer nu = 0;
  K c[nu];
  Integer m;
equation
  m = if nu == 1 then c[1].n + 2 else 2;
end XWb1;
//// model: XWb2
connector K
  Real d;
  Integer n;
end K;
model XWb2
  parameter Integer nu = 2;
  K c[nu];
  Integer m;
equation
  m = if nu == 1 then c[3].n + 2 else 2;
end XWb2;
//// model: XWb3
connector K
  Real d;
  Integer n;
end K;
model XWb3
  parameter Integer nu = 0;
  K c[nu];
  Integer m;
equation
  when initial() then
    m = if nu == 1 then c[1].n + 2 else 2;
  end when;
end XWb3;
//// model: XWb4
connector K
  Real d;
  Integer n;
end K;
model XWb4
  parameter Integer nu = 0;
  Real x[nu];
  Real m;
equation
  m = if nu == 1 then x[1] else 2;
end XWb4;
//// model: XWb5
connector K
  Real d;
  Integer n;
end K;
model XWb5
  parameter Integer nu = 0;
  K c[nu];
  Integer m = if nu == 1 then c[1].n else 2;
end XWb5;
//// model: XWb6
connector K
  Real d;
  Integer n;
end K;
model XWb6
  parameter Integer nu = 0;
  K c[nu];
  Integer m;
equation
  m = if nu > 0 then c[1].n else if nu == 0 then 3 else c[2].n;
end XWb6;
//// model: XWb7
connector K
  Real d;
  Integer n;
end K;
model XWb7
  parameter Integer nu = 0;
  parameter Boolean b = false;
  K c[nu];
  Integer m;
equation
  m = if b then c[1].n else 2;
end XWb7;
//// model: XWb8
connector K
  Real d;
  Integer n;
end K;
model XWb8
  parameter Integer nu = 0;
  K c[nu];
  Real p = 1;
  Integer m;
equation
  m = if p > 2 then c[1].n else 2;
end XWb8;
//// model: XWb9
connector K
  Real d;
  Integer n;
end K;
model XWb9
  parameter Integer nu = 1;
  K c[nu];
  Integer m;
equation
  m = if nu == 1 then c[1].n + 2 else 2;
  c.n = {1};
end XWb9;
//// model: XWb10
connector K
  Real d;
  Integer n;
end K;
model XWb10
  parameter Integer nu = 1;
  K c[nu];
  Integer m;
equation
  m = if nu <> 1 then c[2].n + 2 else 2;
  c.n = {1};
end XWb10;
//// model: XWb11
connector K
  Real d;
  Integer n;
end K;
model XWb11
  parameter Integer nu = 0;
  K c[nu + 1];
  Integer m;
  parameter Integer k = nu;
equation
  m = if k == 1 then c[2].n + 2 else 2;
  c.n = {1};
end XWb11;
//// model: XWb12
connector K
  Real d;
  Integer n;
end K;
model XWb12
  parameter Integer nu = 0;
  K c[nu];
  Integer m[2];
equation
  for i in 1:2 loop
    m[i] = if nu == i then c[i].n else i;
  end for;
end XWb12;
//// model: XY1
model XY1
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  (a, b) = spatialDistribution(in0, in1, x, v);
end XY1;
