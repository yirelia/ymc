end XQc12;
//// model: XQc13
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
function ff
  input Real u;
  output Real y;
external "C" y = foo(u);
end ff;
package P
  constant Real c = ff(1.0);
  constant Real d[2] = {ff(1.0), 2};
end P;
model XQc13
  constant Real k[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real w[2] = -k;
  Real x = P.c + 1;
end XQc13;
//// model: XQc14
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
function ff
  input Real u;
  output Real y;
external "C" y = foo(u);
end ff;
package P
  constant Real c = ff(1.0);
  constant Real d[2] = {ff(1.0), 2};
end P;
model XQc14
  constant Real k[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real w[2] = -k;
  Real x = 1 + 2 * P.c;
end XQc14;
