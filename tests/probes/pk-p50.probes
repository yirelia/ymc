  function g
    input Real u;
    output Real v = u;
  end g;
  constant Real x = 1;
  package Q
    constant Real z = 1;
  end Q;
end P;
model XPi19
  import P.*;
  Real y = x;
end XPi19;
//// model: XPi20
partial package P
  function g
    input Real u;
    output Real v = u;
  end g;
  constant Real x = 1;
  package Q
    constant Real z = 1;
  end Q;
end P;
model XPi20
  import P.Q.z;
  Real y = z;
end XPi20;
//// model: XPi21
partial package P
  function g
    input Real u;
    output Real v = u;
  end g;
  constant Real x = 1;
  package Q
    constant Real z = 1;
  end Q;
end P;
model XPi21
  import A = P;
  Real y = A.x;
end XPi21;
//// model: XPi22
partial package P
  function g
    input Real u;
    output Real v = u;
  end g;
  constant Real x = 1;
  package Q
    constant Real z = 1;
  end Q;
end P;
model XPi22
  import A = P.Q;
  Real y = A.z;
end XPi22;
//// model: XQc1
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc1
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2] = c + {1, 2};
end XQc1;
//// model: XQc2
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc2
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2] = {1, 2} + c;
end XQc2;
//// model: XQc3
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc3
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2] = -c;
end XQc3;
//// model: XQc4
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc4
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real y = sum(c);
end XQc4;
//// model: XQc5
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc5
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2] = c .* c;
end XQc5;
//// model: XQc6
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc6
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  parameter Real p[2] = c * 2;
end XQc6;
//// model: XQc7
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc7
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2];
equation
  x = 2 * c;
end XQc7;
//// model: XQc8
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc8
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2] = if time > 1 then c else {1, 2};
end XQc8;
//// model: XQc9
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
model XQc9
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
  Real x[2] = {c[1], 1} + c;
end XQc9;
//// model: XQc10
function myasin
  input Real u;
  output Real y;
external "C" y = asin(u);
end myasin;
package P
  constant Real c[2] = {myasin(1.0), 2 * myasin(1.0)};
end P;
model XQc10
  Real x[2] = P.c + {1, 2};
end XQc10;
//// model: XQc11
function myasin
  input Real u;
