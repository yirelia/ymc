//// model: OBAstd_g
operator record C1
  Real re;
  Real im;

  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';

end C1;
function g
  input C1 c;
  output Real y = c.re + c.im;
end g;
function gt
  input C1 c;
  input Real t;
  output Real y = c.re * t;
end gt;
function ge
  input C1 c;
  output Real y;
external "C" y = ext1(c);
end ge;
impure function gi
  input C1 c;
  output Real y = c.re;
end gi;
function gf
  input Real t;
  output Real y;
protected
  C1 u = C1(3.0, 4.0);
  C1 w = C1(t);
algorithm
  w := C1(5.0);
  y := u.re * w.im * t;
end gf;
function gg
  input Real t;
  output C1 y = C1(t, 3.0);
  output C1 z = C1(4.0);
end gg;
model OBAstd_g
  Real x = g(C1(time));
end OBAstd_g;
