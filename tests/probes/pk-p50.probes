model XY14
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  a = spatialDistribution(in0, in1, x, v);
  b = 1;
end XY14;
//// model: XY15
model XY15
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  (a, b) = spatialDistribution(in0, in1, x);
end XY15;
//// model: XY16
model XY16
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  (a, b) = spatialDistribution(in0, in1, x, 1);
end XY16;
//// model: XY17
model XY17
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  (a, b) = spatialDistribution(in0, in1, x, v, {time, 1.0}, {0.0, 0.0});
end XY17;
//// model: XY18
model XY18
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  (a, b) = spatialDistribution(in0, in1, x, v, wrong = {0.0, 1.0});
end XY18;
//// model: XY19
model XY19
  Real in0 = time;
  Real in1 = 2 * time;
  Real a;
  Real b;
  Real x = time;
  Boolean v = true;
equation
  (a, b) = spatialDistribution(in0, in1, x, v, {0.0, 1.0}, {0.0, 0.0}, 3);
end XY19;
//// model: XY20
model XY20
  parameter Real p[2] = {0, 1};
  Real in0 = time;
  Real a;
  Real b;
equation
  (a, b) = spatialDistribution(in0, in0, time, true, initialPoints = p);
end XY20;
//// model: XY21
model XY21
  Real in0 = time;
  Real a;
  Real b;
algorithm
  (a, b) := spatialDistribution(in0, in0, time, true);
end XY21;
//// model: XY22
model XY22
  Integer in0 = 1;
  Real a;
  Real b;
equation
  (a, b) = spatialDistribution(in0, in0, time, true);
end XY22;
//// model: XY23
model XY23
  model M
    input Real u;
    Real a;
    Real b;
  equation
    (a, b) = spatialDistribution(u, u, time, true);
  end M;
  M m1(u = time);
  M m2(u = 2 * time);
end XY23;
//// model: XY24
model XY24
  Real in0 = time;
  Real a[2];
equation
  (a[1], a[2]) = spatialDistribution(in0, in0, time, true);
end XY24;
//// model: XY25
model XY25
  Real in0 = time;
  Real a;
  Real b;
equation
  when time > 1 then
    (a, b) = spatialDistribution(in0, in0, time, true);
  end when;
end XY25;
//// model: XY26
function f
  input Real u;
  output Real a;
  output Real b;
algorithm
  (a, b) := spatialDistribution(u, u, u, true);
end f;
model XY26
  Real a;
  Real b;
equation
  (a, b) = f(time);
end XY26;
