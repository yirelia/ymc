//// model: XWc1
connector K
  Real d;
  Integer n;
end K;
model XWc1
  parameter Integer nu = 0;
  K c[nu];
  Real m = if nu == 1 then c[1].d else 2;
end XWc1;
//// model: XWc2
connector K
  Real d;
  Integer n;
end K;
model XWc2
  parameter Integer nu = 0;
  Real x[nu];
  Real m = if nu == 1 then sum(x) else 2;
end XWc2;
//// model: XWc3
connector K
  Real d;
  Integer n;
end K;
model XWc3
  parameter Integer nu = 2;
  K c[nu];
  Real m = if nu == 3 then c[3].d else c[2].d;
equation
  c.n = {1, 2};
  c.d = {1, 2};
end XWc3;
//// model: XWc4
connector K
  Real d;
  Integer n;
end K;
model XWc4
  parameter Integer nu = 0;
  K c[nu];
  Real m;
equation
  m = if nu == 1 then c[nu].d else 2;
end XWc4;
//// model: XWc5
connector K
  Real d;
  Integer n;
end K;
model XWc5
  parameter Integer nu = 0;
  K c[nu];
  Real m;
equation
  m = if nu == 1 then c[1].d else if nu == 0 then 3 else c[1].d;
end XWc5;
//// model: XWc6
connector K
  Real d;
  Integer n;
end K;
model XWc6
  parameter Integer nu = 0;
  K c[nu];
  parameter Real p = if nu == 1 then c[1].d else 2;
end XWc6;
//// model: XWc7
connector K
  Real d;
  Integer n;
end K;
model XWc7
  parameter Integer nu = 0;
  K c[nu];
  Boolean t = true;
  Real m;
equation
  m = if nu == 1 and t then c[1].d else 2;
end XWc7;
//// model: XWc8
connector K
  Real d;
  Integer n;
end K;
model XWc8
  parameter Integer nu = 0;
  K c[nu];
  Real m;
equation
  if nu == 1 then
    m = c[1].d;
  else
    m = 2;
  end if;
end XWc8;
