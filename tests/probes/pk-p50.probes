//// model: QXM1
operator record C
  Real re;
  encapsulated operator 'constructor'
    function fromReal
      import C;
      input Real re;
      output C r(re = re);
    algorithm
    end fromReal;
  end 'constructor';
  encapsulated operator function '+'
    import C;
    input C a;
    input C b;
    output C c;
  algorithm
    c := C(a.re + b.re);
  end '+';
  encapsulated operator function '0'
    import C;
    output C c;
  algorithm
    c := C(0);
  end '0';
end C;
model QXM1
  C a[3] = {C(time), C(time), C(time)};
  C b;
equation
  b = sum(a[i] for i in 1:3);
end QXM1;
