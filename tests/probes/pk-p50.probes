//// model: XN1
operator record C
  Real a;
  encapsulated operator function 'not'
    import C;
    input C c;
    output C r;
  algorithm
    r := C(-c.a);
  end 'not';
  encapsulated operator function 'String'
    import C;
    input C c;
    input String n = "j";
    input Integer d = 6;
    output String s = n;
  algorithm
    s := s + String(c.a, significantDigits = d);
  end 'String';
  encapsulated operator '-'
    function neg
      import C;
      input C c[:];
      output C r[size(c, 1)];
    algorithm
      for i in 1:size(c, 1) loop
        r[i] := C(-c[i].a);
      end for;
    end neg;
  end '-';
end C;
model XN1
  C a;
  C b = not a;
end XN1;
