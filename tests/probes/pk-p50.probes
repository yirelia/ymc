//// set: pk-p50 — 68b 跨作用域引用与函数调用的名字解析：构造函数输出绑定里的自调用（OB / OC / OBA / OBB，patchOperatorRecordConstructorBinding）、external "C" 内建等价函数的常量求值（XE / XEx）、constrainedby 修饰（QXC）、继承来的组件函数（XF）、class extends 短类基类（XD）、'not' / 'String' 重载与数组一元（XN / XOp / XOf / XOa）、重载运算符调用的变率（XV / XOv）、函数自引用（XOs）、无绑定包常量（QCS / XU）、包常量记录 / 模型的值（QXR / XS）、包和函数里的 getInstanceName（XG）、外部对象转传（QXO）、前导点短类连接器（XI）、when 里的复合数组段与结构条件死分支（XW）、记录短类的构造（XPa / XPb / XPd）、spatialDistribution（XY）、记录元素的 sum（QXM）、穿过的类按限定词核查类体（XPk / XPu / XPn / XPm / XPr / XPi / XPs）、SKIP 之后的常量引用（XQc）。
//// model: OB1
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end C1;
model OB1
  C1 c = C1(time);
end OB1;
//// model: OB2
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end C1;
model OB2
  C1 c = C1(1.0);
end OB2;
//// model: OB3
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end C1;
model OB3
  constant C1 c = C1(1.0, 2.0);
  Real x = c.re;
end OB3;
//// model: OB4
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end C1;
model OB4
  parameter Real p = 2;
  C1 c = C1(p);
  C1 d[2] = {C1(p), C1(time, p)};
end OB4;
//// model: OB5
function f
  input Real x;
  output Real y = f(x);
algorithm
end f;
model OB5
  Real z = f(time);
end OB5;
//// model: OB6
function f
  input Real x;
  output Real y = if x > 0 then f(x - 1) else 0.0;
algorithm
end f;
model OB6
  Real z = f(time);
end OB6;
//// model: OB7
function f
  input Real x;
  output Real y;
protected
  Real w = if x > 0 then f(x - 1) else 1.0;
algorithm
  y := w;
end f;
model OB7
  Real z = f(time);
end OB7;
//// model: OB8
function f
  input Real x;
  input Real w = f(1.0);
  output Real y = x + w;
end f;
model OB8
  Real z = f(time);
end OB8;
//// model: OB9
function f
  input Real x;
  output Real y = g(x);
end f;
function g
  input Real x;
  output Real y = f(x);
end g;
model OB9
  Real z = f(time);
end OB9;
//// model: OB10
function f
  input Integer n;
  output Real y[f2(n)];
algorithm
  y := fill(1.0, n);
end f;
function f2
  input Integer n;
  output Integer m = n;
end f2;
model OB10
  Real z[2] = f(2);
end OB10;
//// model: OB11
function f
  input Integer n;
  output Integer y[f(1)[1]];
algorithm
  y := fill(1, n);
end f;
model OB11
  Integer z[1] = f(1);
end OB11;
//// model: OB12
function f
  input Real x;
  output Real y = if x > 0 then f(x - 1) else 7.0;
algorithm
end f;
model OB12
  constant Real k = f(2);
  Real z = f(2);
  Real w = k;
end OB12;
//// model: OB13
record R
  Real a;
end R;
function f
  input Real x;
  output R r = R(f(x).a);
end f;
model OB13
  R z = f(time);
end OB13;
//// model: OB14
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re = re + 1, im = im);
    algorithm
    end fromReal;
  end 'constructor';
end C1;
model OB14
  C1 c = C1(time, 2);
end OB14;
//// model: OB15
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result = C1(re, 0.0);
    algorithm
      result := C1(re, im);
    end fromReal;
  end 'constructor';
end C1;
model OB15
  C1 c = C1(time);
end OB15;
//// model: OB16
operator record C1
  Real re;
  Real im;
  encapsulated operator 'constructor'
    function fromReal
      import C1;
      input Real re;
      input Real im = 0.0;
      output C1 result;
    protected
      C1 t = C1(re, im);
    algorithm
      result := t;
    end fromReal;
  end 'constructor';
end C1;
model OB16
  C1 c = C1(time);
end OB16;
