//// model: XOp1
operator record C
  Real a;
  encapsulated operator 'constructor'
    function fromR
      import C;
      input Real a;
      output C r(a = a);
    algorithm
    end fromR;
  end 'constructor';
  encapsulated operator function '0'
    import C;
    output C c;
  algorithm
    c := C(0);
  end '0';
  encapsulated operator function '+'
    import C;
    input C x;
    input C y;
    output C z;
  algorithm
    z := C(x.a + y.a);
  end '+';
  encapsulated operator '-'
    function neg
      import C;
      input C c;
      output C r;
    algorithm
      r := C(-c.a);
    end neg;
    function negA
      import C;
      input C c[:];
      output C r[size(c, 1)];
    algorithm
      r := c;
    end negA;
  end '-';
  encapsulated operator function 'not'
    import C;
    input C c;
    output C r;
  algorithm
    r := C(-c.a);
  end 'not';
  encapsulated operator function 'and'
    import C;
    input C x;
    input C y;
    output Boolean r = x.a > y.a;
  end 'and';
  encapsulated operator function 'or'
    import C;
    input C x;
    input C y;
    output C r = x;
  end 'or';
  encapsulated operator function 'String'
    import C;
    input C c;
    input String n = "j";
    output String s = n;
  end 'String';
end C;
model XOp1
  C a = C.'0'();
end XOp1;
