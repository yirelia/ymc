//// model: QXO1
package P
  class Ext
    extends ExternalObject;
    function constructor
      input Integer n = 1;
      output Ext e;
      external "C" e = mk(n);
    end constructor;
    function destructor
      input Ext e;
      external "C" rm(e);
    end destructor;
  end Ext;
  class Ext2
    extends ExternalObject;
    function constructor
      output Ext2 e;
      external "C" e = mk2();
    end constructor;
    function destructor
      input Ext2 e;
      external "C" rm2(e);
    end destructor;
  end Ext2;
  function rd
    input Ext e;
    output Real v;
    external "C" v = ff(e);
  end rd;
  function wrap
    input Ext e;
    input Real t;
    output Real v;
  algorithm
    v := rd(e) + t;
  end wrap;
  function wrap2
    input Ext e;
