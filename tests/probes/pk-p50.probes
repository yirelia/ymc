equation
  c.n = {{1, 2}, {3, 4}};
  when sample(0, 1) then
    c.d = zeros(2, 2);
  end when;
end XWa8;
//// model: XWa9
connector K
  Real d;
  Integer n;
end K;
model XWa9
  K c[2];
equation
