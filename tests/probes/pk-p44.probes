//// model: SBK36
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
function drop
  input BP bp;
  input Real i;
  output Real v;
algorithm
  v := bp.V * i / bp.IL;
end drop;
model SBK36
  parameter Real c = 2;
  parameter Real wMax = 3 - drop(bp, 100);
  parameter BP bp(IL = 2 * c);
  Real y;
equation
  if wMax > 2 then
    y = time;
  else
    y = 2 * time;
  end if;
end SBK36;
