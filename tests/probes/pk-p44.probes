//// model: SBK80
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
model SBK80
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter BP bpa(IL = 3, V = 2 * c);
  parameter BP bps[2] = {bpa, BP(IL = 3, V = 3 * c)};
  Real y[n];
  final parameter Integer n = if bps[2].IL > 2 then 1 else 2;
equation
  y = fill(time, n);
end SBK80;
//// model: SBK81
record BP
