//// model: SBK70
package SBK70P
  record CD
    parameter Integer nRC = 1;
    parameter Real rd[nRC] = fill(0, nRC);
    parameter Real k = 1;
  end CD;
  record SD
    parameter Integer Ns;
    parameter CD c1;
    parameter CD cd[Ns] = {c1 for i in 1:Ns};
  end SD;
end SBK70P;
model SBK70
  parameter Real q = 2;
  parameter Real p = 2 * q;
  parameter SBK70P.CD a(nRC = 2, rd = {1, 2}, k = 2 * p);
  parameter SBK70P.SD s(Ns = 1, c1 = a);
  parameter SBK70P.SD s2 = s;
end SBK70;
