//// model: SBK22
type E = enumeration(a, b, c);
record BP
  parameter Integer k = 1;
  parameter Boolean f = false;
  parameter E e = E.a;
  parameter String s = "x";
  parameter Real IL = 1;
end BP;
model SBK22
  parameter Integer m = 2;
  parameter Boolean g = true;
  parameter BP bp(k = m + 1, f = not g, e = if g then E.b else E.c, IL = m * 1.5);
  parameter BP bp2 = bp;
  Real y[n];
  final parameter Integer n = if bp2.k > 2 then 1 else 2;
  Real z[n2];
  final parameter Integer n2 = if bp2.f or bp2.e == E.c then 1 else 2;
equation
  y = fill(time, n);
  z = fill(time, n2);
end SBK22;
//// model: SBK23
