//// model: SBK74
package SBK74P
  record CD
    parameter Integer nRC = 1;
    parameter Real rd[nRC] = fill(0, nRC);
    parameter Real k = 1;
  end CD;
  record SD
    parameter Integer Ns;
    parameter CD c1;
    parameter CD c2;
    parameter CD cd[Ns] = {if i == 1 then c2 else c1 for i in 1:Ns};
  end SD;
end SBK74P;
model SBK74
  parameter Real q = 2;
  parameter Real p = 2 * q;
  parameter SBK74P.CD a(nRC = 2, rd = {1, 2}, k = 2 * p);
  parameter SBK74P.CD b(nRC = 2, rd = {5, 6}, k = 3 * p);
  parameter SBK74P.SD s(Ns = 2, c1 = a, c2 = b);
end SBK74;
//// model: SBK75
package SBK75P
  record CD
    parameter Integer nRC = 1;
    parameter Real k = 1;
  end CD;
  function f
    input CD c;
    output Integer n;
  algorithm
    n := c.nRC;
  end f;
end SBK75P;
model SBK75
  parameter Real q = 2;
  parameter Real p = 2 * q;
  parameter SBK75P.CD a(nRC = 2, k = 2 * p);
  parameter SBK75P.CD cds[2] = {a, a};
  Real y[SBK75P.f(cds[1])] = fill(time, 2);
end SBK75;
//// model: SBK76
package SBK76P
  record CD
    parameter Boolean u = true;
    parameter Real T[:] = {1, 2};
    final parameter Real Ti[:] = if u then {1, 2} else T;
    parameter Integer nRC = 1;
    parameter Real rd[nRC] = fill(0, nRC);
  end CD;
  record SD
    parameter Integer Ns;
    parameter CD c1;
    parameter CD c2;
    parameter CD cd[Ns] = {if i == 1 then c2 else c1 for i in 1:Ns};
  end SD;
end SBK76P;
model SBK76
  parameter SBK76P.CD a(u = false, T = {3, 4, 5}, nRC = 2, rd = {1, 2});
  parameter SBK76P.CD b(u = false, T = {6, 7, 8}, nRC = 2, rd = {5, 6});
  parameter SBK76P.SD s(Ns = 2, c1 = a, c2 = b);
end SBK76;
//// model: SBK77
package SBK77P
