//// model: SBK9
package SBK9P
  record CD
    parameter Real T[:, 2] = [0, 1; 1, 1];
    parameter Integer n = 1;
    parameter Real r[n] = fill(0, n);
  end CD;
  record SD
    parameter CD c;
  end SD;
end SBK9P;
model SBK9
