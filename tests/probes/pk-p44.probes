//// model: SBK69
package SBK69P
  record CD
    parameter Boolean u = true;
    parameter Real T[:] = {1, 2};
    final parameter Real Ti[:] = if u then {1, 2} else T;
    parameter Integer n = 1;
  end CD;
  function f
    input CD c;
    output Integer k;
  algorithm
    k := c.n;
  end f;
end SBK69P;
model SBK69
  parameter SBK69P.CD a(u = false, T = {3, 4, 5}, n = 2);
