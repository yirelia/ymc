  parameter Real c = 2 * d;
  parameter Real d = 1;
  Real y[2];
equation
  y = fill(time, m);
end SBK51;
//// model: SBK52
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
model SBK52
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter BP bp(IL = 2 * c);
  parameter BP bp2 = bp;
  Real y[2];
equation
  y = fill(time, if bp2.IL > 2 then 2 else 2);
end SBK52;
//// model: SBK53
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
model SBK53
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter BP bp(IL = 2 * c);
  parameter BP bp2 = bp;
  Real y[2] = fill(time, integer(bp2.IL) - 2);
end SBK53;
//// model: SBK54
model SBK54
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter Integer m = integer(c);
  parameter Real z[2] = if m > 1 then {1, 2} else {1};
end SBK54;
//// model: SBK55
model SBK55
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter Integer m = integer(c);
  Real z[2];
equation
  z = if m > 1 then {time, 2} else {1};
end SBK55;
//// model: SBK56
model SBK56
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter Integer m = integer(c);
  Real y[2] = {time, time};
  Real z = size(y, m - 1);
end SBK56;
//// model: SBK57
model SBK57
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter Integer m = integer(c);
  Real x[:] = fill(time, m);
end SBK57;
//// model: SBK58
model SBK58
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter Integer m = integer(c);
  Real x = time if m > 1;
end SBK58;
//// model: SBK59
model SBK59
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter Integer m = integer(c);
  Real y[2];
equation
  y = cat(m - 1, {time}, {time});
end SBK59;
//// model: SBK60
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
model SBK60
  parameter Real d = 1;
  parameter Real c = 2 * d;
  parameter BP bp(IL = 2 * c);
  parameter BP bp2 = bp;
  Real y[2];
algorithm
  y := fill(time, integer(bp2.IL) - 2);
end SBK60;
//// model: SBK61
model SBK61
  parameter Integer m = 2;
  Real y[2];
  Real z[2];
algorithm
  y := fill(time, 2);
  z := fill(time, m);
end SBK61;
//// model: SBK62
package SBK62P
  record CD
    parameter Real T[:] = {1, 2};
    parameter Integer n = 1;
    parameter Real r[n] = fill(0, n);
  end CD;
  record BSD
    replaceable parameter CD c;
  end BSD;
  record SD
    extends BSD(redeclare CD c);
  end SD;
end SBK62P;
model SBK62
  parameter SBK62P.CD a(T = {1, 2, 3}, n = 2, r = {1, 2});
  parameter SBK62P.SD s(c = a);
  parameter SBK62P.SD s2 = s;
end SBK62;
//// model: SBK63
package SBK63P
  record CD
    parameter Real k = 1;
    parameter Real m = 2 * k;
  end CD;
  record BSD
    replaceable parameter CD c;
  end BSD;
  record SD
    extends BSD(redeclare CD c);
  end SD;
end SBK63P;
model SBK63
  parameter SBK63P.CD a(k = 3);
  parameter SBK63P.SD s(c = a);
  parameter SBK63P.SD s2 = s;
  Real y[integer(s2.c.m)] = fill(time, integer(s2.c.m));
end SBK63;
//// model: SBK64
package SBK64P
  record CD
    parameter Real T[:] = {1, 2};
    parameter Real k = 1;
  end CD;
  record BSD
    replaceable parameter CD c;
  end BSD;
  record SD
    extends BSD(redeclare CD c);
  end SD;
  model St
    replaceable parameter BSD sd;
  end St;
end SBK64P;
model SBK64
  parameter SBK64P.CD a(T = {1, 2, 3}, k = 2);
  parameter SBK64P.SD s(c = a);
  SBK64P.St st(redeclare SBK64P.SD sd = s);
end SBK64;
//// model: SBK65
package SBK65P
