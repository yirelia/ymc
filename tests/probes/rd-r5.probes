//// set: rd-r5 — 归约式与 min / max：其它语境
//// model: E0
model E0
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y[2];
equation
  for j in 1:2 loop y[j] = sum(x[i] * j for i in 1:3); end for;
end E0;
//// model: E1
model E1
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y[2];
equation
  for j in 1:2 loop y[j] = max(x[i] * j for i in 1:3); end for;
end E1;
//// model: E2
model E2
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y[2];
equation
  for j in 1:2 loop y[j] = sum(x[i] for i in 1:j); end for;
end E2;
//// model: E3
model E3
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y[2];
equation
  for j in 1:2 loop y[j] = max(x[i] for i in 1:j + 1); end for;
end E3;
//// model: E4
model E4
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y;
equation
  when t > 1 then y = max(pre(k[i]) for i in 1:3); end when;
end E4;
//// model: E5
model E5
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y;
equation
  if t > 1 then y = sum(x[i] for i in 1:2); else y = max(x[i] for i in 2:3); end if;
end E5;
//// model: E6
model E6
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  parameter Real q[3] = {1, 2, 3}; parameter Real p = sum(q[i] for i in 1:n); Real y = p;
end E6;
