//// model: Q218
model Q218
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real z[k[2]]; Real y = x[k[1]] + k[2];
end Q218;
//// model: Q219
model Q219
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real z[k[2]]; Real y = sum(x[i] for i in k);
