//// set: ap-p2 — 参数数组：归约范围、整体引用、代入后的 assert
//// model: Q20
model Q20
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y = max(x[i] for i in k);
end Q20;
//// model: Q21
model Q21
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y = sum(x[i] for i in k[1:2]);
end Q21;
//// model: Q22
model Q22
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y = sum(x[i] for i in {k[2], 3});
end Q22;
//// model: Q23
model Q23
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer n = 2; Real y = sum(x[i] for i in {n, 3});
end Q23;
//// model: Q24
model Q24
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer n = 2; Real y = max(x[i] for i in {n, 3});
end Q24;
//// model: Q25
model Q25
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer n = 2; parameter Integer m = n; Real y = sum(x[i] for i in {n, 3}); parameter Integer m2 = n;
end Q25;
//// model: Q26
model Q26
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Real q[2] = {1, 2}; Real y = sum(v * t for v in q);
end Q26;
//// model: Q27
model Q27
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Real q[2] = {1, 2}; Real y = max(v * t for v in q);
end Q27;
//// model: Q28
model Q28
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Real q[2] = {1, 2}; Real y = sum(q[i] * t for i in 1:2);
end Q28;
//// model: Q29
model Q29
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Real q[2] = {1, 2}; Real y = sum(q) * t;
end Q29;
