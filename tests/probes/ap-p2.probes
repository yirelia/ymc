//// model: Q220
model Q220
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real z[k[2]]; Integer y = size(k, 1);
end Q220;
//// model: Q221
model Q221
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[3] = {1, 2, 3}; Real z[k[2]]; Integer y[2] = k[1:2];
end Q221;
//// model: Q222
model Q222
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Boolean b[2] = {true, false}; Real y; Boolean c[2] = b;
equation
  if b[1] then y = 1; else y = 2; end if;
end Q222;
//// model: Q223
model Q223
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Boolean b[2] = {true, false}; Real y; Boolean c = b[1] and b[2];
equation
  if b[1] then y = 1; else y = 2; end if;
end Q223;
//// model: Q224
model Q224
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y;
equation
  y = x[k[1]]; assert(k[2] > 0, "m");
end Q224;
//// model: Q225
model Q225
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  parameter Integer k[2] = {1, 2}; Real y; algorithm y := x[k[1]] + k[2];
equation
  t = t;
end Q225;
