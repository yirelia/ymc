//// model: T4
model T4
  parameter Integer n = 2;
  parameter Real A[3, 3] = {{1, 0, 0}, {0, 2, 0}, {0, 0, 3}};
  Boolean b[2] = {time > 1, true};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real y[3];
  Real m[2, 2];
equation
