model AS1X31 Real y(start := 2) = 1; end AS1X31;
//// model: AS1X32

function e
  input Real x;
  output Real y;
external "C" y = sin(x);
end e;
partial function PF
  input Real x;
  output Real y;
end PF;
function f
  input Real x;
  input Real a;
  output Real y = a * x;
end f;
function f0
  input Real x;
  output Real y = 2 * x;
end f0;
function g
  input PF h;
  input Real u;
  output Real y = h(u);
end g;
model AS1X32
  Real y = e(time);
end AS1X32;
