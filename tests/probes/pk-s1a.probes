//// model: AS1X27
model AS1X27 Real x[2](start = {1, 2}); equation der(x) = -x; end AS1X27;
//// model: AS1X28
model AS1X28 Real x(start = 1); equation der(x) = -x; end AS1X28;
//// model: AS1X29
model AS1X29 Real x; equation assert(x > 0, "neg"); x = time; end AS1X29;
//// model: AS1X30

