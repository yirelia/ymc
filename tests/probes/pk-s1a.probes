end AS1X07;
//// model: AS1X08
model A Real x; end A; model AS1X08 A a(redeclare Real[2] x); end AS1X08;
//// model: AS1X09

partial function PF
  input Real x;
  output Real y;
end PF;
function f
  input Real x;
  input Real a;
  output Real y = a * x;
end f;
function f0
  input Real x;
  output Real y = 2 * x;
end f0;
function g
  input PF h;
  input Real u;
  output Real y = h(u);
end g;
model AS1X09
  Real y = 1;
  annotation(__X = function f(a = 1));
end AS1X09;
//// model: AS1X10

model A
  Real x[2];
  Real y;
end A;
model AS1X10
  A a(x(start = {1, 2}));
end AS1X10;
//// model: AS1X11

model A
  Real x[2];
  Real y;
end A;
model AS1X11
  A a(x(each start = 1));
end AS1X11;
