//// set: pk-s1a — s1fix 对抗评审（评审代理手写，均已核 omc 1.25.0）：A 本桶新加的语法层拒绝（修饰里 redeclare / replaceable / redeclare each|final|replaceable 的组件类型后带维 Modelica.g:956-958/768；注解修饰值里的部分函数应用 Modelica.g:1527-1536），9bd9f02 上是 ACCEPTS-INVALID；B 合法对照（下标形状的合法修饰、名后带维的 redeclare、短类带维、类体 replaceable 带维、注解里函数实参的部分应用、第 1 行整份模型、:= 修饰）；C 下标修饰（组件 / 短类 / 注解 / constrainedby / redeclare 内 / 短类 extends）与非实参位置的部分应用，两边都拒；D 9bd9f02 就有的 ACCEPTS-INVALID：修饰名前导点 `A a(.y = 1)`（Modelica.g:902-908 element_modification 用 name_path2，无 DOT）、外部函数调用的命名实参 / 带点函数名（Modelica.g:488-489 funcname=IDENT LPAR expression_list）、引号名里 `\` 后跟非 QCHAR（BaseModelica_Lexer.g:389-405 非法转义只吃反斜杠）、实数字面量溢出 1e999（Modelica.g:1780 Overflow）、指数不完整的实数 `1e` / `1.5e+`（omc 词法错 Lexer got '1e'，ymc 当 1.0 / 1.5 收）。
//// model: AS1X01

model AR
  replaceable Real x[2];
  replaceable type T = Real;
end AR;
model AS1X01
  AR a(redeclare Real[2] x);
end AS1X01;
//// model: AS1X02

model AR
  replaceable Real x[2];
  replaceable type T = Real;
end AR;
model AS1X02
  extends AR(redeclare Real[2] x);
end AS1X02;
