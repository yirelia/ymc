//// model: AS1X20

partial function PF
  input Real x;
  output Real y;
end PF;
function f
  input Real x;
  input Real a;
  output Real y = a * x;
end f;
function f0
  input Real x;
  output Real y = 2 * x;
end f0;
function g
  input PF h;
  input Real u;
  output Real y = h(u);
end g;
model AS1X20
  Real y = 1;
  annotation(__X(z = g(function f(a = 1), 1)));
end AS1X20;
