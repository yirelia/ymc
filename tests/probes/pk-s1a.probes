//// model: AS1X43

partial function PF
  input Real x;
  output Real y;
end PF;
function f
  input Real x;
  input Real a;
  output Real y = a * x;
end f;
function f0
  input Real x;
  output Real y = 2 * x;
end f0;
function g
  input PF h;
  input Real u;
  output Real y = h(u);
end g;
model AS1X43
  Real y = g(if time > 1 then function f(a = 1) else function f(a = 2), time);
end AS1X43;
//// model: AS1X44

partial function PF
  input Real x;
  output Real y;
end PF;
function f
  input Real x;
  input Real a;
  output Real y = a * x;
end f;
function f0
  input Real x;
  output Real y = 2 * x;
end f0;
function g
  input PF h;
  input Real u;
  output Real y = h(u);
end g;
model AS1X44
  Real y;
equation
  y = if function f0() then 1 else 2;
end AS1X44;
