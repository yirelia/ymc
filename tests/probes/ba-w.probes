//// model: W18
model W18
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real r1[3] = if x[1] > 1 then x else x .* x;
end W18;
//// model: W19
model W19
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
equation
  y = if time > 1 then x else -x;
end W19;
//// model: W2
model W2
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real p3[:] = if time > 1 then x else 2 * x;
end W2;
//// model: W20
model W20
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
equation
  y = if b[1] then 2 * x else x + x;
end W20;
//// model: W21
model W21
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
equation
  der(y) = if time > 1 then x else -y;
end W21;
//// model: W22
model W22
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
equation
  y = (if time > 1 then x else 2 * x) + x;
end W22;
//// model: W23
model W23
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
equation
  y = if time > 1 then sin(x) else x;
end W23;
//// model: W24
model W24
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
equation
  v = if time > 1 then b else b2;
end W24;
//// model: W25
model W25
  parameter Integer n = 2;
