//// set: ba-w — 数组 if 表达式
//// model: AT1
model AT1
  parameter Integer n = 2;
  Real r2(start = if n == 2 then 1 else 4);
  Real r3[2](start = {1, 2});
  Real r4[2](each start = if n == 2 then 1 else 4);
end AT1;
//// model: BASE
model BASE
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Boolean v[2];
  Real y[3];
end BASE;
//// model: W0
model W0
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real p1[3] = if time > 1 then x else k;
end W0;
//// model: W1
model W1
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real p2[3] = if time > 1 then {1, 2, 3} else k;
end W1;
//// model: W10
model W10
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real q2[3] = 2 * (if time > 1 then x else {1, 2, 3});
end W10;
//// model: W11
model W11
  parameter Integer n = 2;
  parameter Real q[3] = {1, 2, 3};
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer k[3] = {1, 2, 3};
  Real w[2, 3] = {{time, 1, 2}, {3, 4, 5}};
  Real q3 = (if time > 1 then x else 2 * x) * x;
end W11;
//// model: W12
model W12
