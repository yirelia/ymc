//// set: lx-v2 — 同上：多层继承（中间类在别的包）、类重声明（SKIP）、属性 / start / 嵌套组件修饰、维与 fill
//// model: V20
package P
constant Real q = 1;
model A
parameter Real p = q;
end A;
end P;
package Q
constant Real q = 2;
model B
extends P.A;
end B;
end Q;
model V20
parameter Real q = 3;
extends Q.B;
end V20;
//// model: V21
package P
constant Real q = 1;
model A
parameter Real p = q;
end A;
end P;
package Q
constant Real q = 2;
model B
extends P.A;
parameter Real r = q;
end B;
end Q;
model V21
parameter Real q = 3;
extends Q.B;
end V21;
//// model: V22
package P
constant Real q = 1;
model A
replaceable package M = P;
parameter Real p = M.q;
end A;
end P;
package P2
constant Real q = 5;
end P2;
model V22
extends P.A(redeclare package M = P2);
end V22;
