//// model: M113
model M113
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
equation
  initialState(s1); transition(s1, s2, c); transition(s2, s1, not c);
end M113;
//// model: M114
model M114
  block St
    output Real d;
