//// set: sm-m1 — 状态机算子：initialState / transition / activeState / ticksInState / timeInState 的各种实参与位置
//// model: M10
model M10
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
equation
  initialState(s1);
end M10;
