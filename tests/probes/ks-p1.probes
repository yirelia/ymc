//// set: ks-p1 — 常量数组在符号下标后跟 `:`（等式 / if 分支 / 绑定里逐元素；算法里整条留着 omc 内部错 → SKIP）；常量矩阵逐元素的声明注释
//// model: CSL1
model CSL1
  constant Boolean fire[3, 2] = [true, false; false, true; true, true];
  Integer k(start = 0, fixed = true);
  Boolean b[2];
equation
  when sample(0, 0.1) then
    k = mod(pre(k) + 1, 3);
  end when;
  b = fire[k + 1, :];
end CSL1;
//// model: CSL2
model CSL2
  constant Boolean fire[3, 2] = [true, false; false, true; true, true];
  Integer k(start = 0, fixed = true);
  Boolean b[2];
equation
  when sample(0, 0.1) then
    k = mod(pre(k) + 1, 3);
  end when;
  if k == 0 then
    b = fill(true, 2);
  else
    b = fire[k, :];
  end if;
end CSL2;
//// model: CSL3
model CSL3
  constant Real T[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  Integer k(start = 1, fixed = true);
  Real c[3] = T[k, :] * time;
equation
  when sample(0, 0.1) then
    k = 3 - pre(k);
  end when;
end CSL3;
//// model: CSL4
model CSL4
  constant Real T[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  Integer k(start = 1, fixed = true);
  Real y[3];
algorithm
  when sample(0, 0.1) then
    k := 3 - pre(k);
  end when;
  y := T[k, :];
end CSL4;
//// model: CM1
model CM1
  constant Integer m = 3;
  constant Boolean fire[2, m] = [true, false, false; false, true, true] "Switching patterns";
  constant Real r[2, 2] = [1, 2; 3, 4] "Matrix";
  constant Real v[2] = {1, 2} "Vector";
  parameter Real p[2, 2] = [1, 2; 3, 4] "Param matrix";
  Real y = time;
end CM1;
