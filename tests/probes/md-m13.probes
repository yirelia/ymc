//// set: md-m13 — 归约实参里的参数值（`f(sum(p))` 不求值）、下标 / 范围里的结构参数、记录的函数 / 构造绑定
//// model: M130
model M130
  function f input Real u; output Real y; algorithm y := 2 * u; end f;
  record R Real x; end R;
  function g input Real u; output R r; algorithm r := R(u); end g;
  constant Real c[3] = {1, 2, 3};
  parameter Integer n = 2;
  parameter Real p[2] = {1, 2};
  Real y = f(c[n]) * time;
end M130;
//// model: M131
model M131
  function f input Real u; output Real y; algorithm y := 2 * u; end f;
  record R Real x; end R;
  function g input Real u; output R r; algorithm r := R(u); end g;
  constant Real c[3] = {1, 2, 3};
  parameter Integer n = 2;
  parameter Real p[2] = {1, 2};
  Real y = f(sum(1:n)) * time;
end M131;
//// model: M132
model M132
  function f input Real u; output Real y; algorithm y := 2 * u; end f;
