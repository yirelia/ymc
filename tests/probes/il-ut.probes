//// set: il-ut — 继承来的类 / 函数 / 常量 / 短类型的查找（单测原文）：`ILU1.a.f`；外层实例上被改过的常量被嵌套类读到 SKIP（ILU2）
//// model: ILU1
model ILU1
  model Base
    model B
      Real x = 1;
    end B;
    function f
      input Real x;
      output Real y;
    algorithm
      y := 2 * x;
    end f;
    constant Real k = 3;
    type T = Real(unit = "m");
  end Base;
  model A
    extends Base;
    B b;
    Real y = f(time) + k;
    T z = time;
  end A;
  A a;
end ILU1;
//// model: ILU2
model ILU2
  model A
    constant Integer n = 1;
    model B
      Real x[n] = fill(1, n);
    end B;
    B b;
  end A;
  A a(n = 3);
end ILU2;
