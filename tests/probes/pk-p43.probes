//// model: EAM15
record EAM15_R
  Real a;
  Real b;
end EAM15_R;
connector EAM15_RC = output EAM15_R;
expandable connector EAM15_B
  EAM15_R r[2];
end EAM15_B;
model EAM15
  EAM15_B b;
  EAM15_RC y[2];
equation
  connect(y, b.r);
  y[1] = EAM15_R(time, 1);
  y[2] = EAM15_R(2 * time, 2);
end EAM15;
