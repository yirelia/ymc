//// model: RCV1
package RCV1P
  record RD
    parameter Real R;
  end RD;
  record CD
    parameter Boolean u = true;
    parameter Real T[:, 2] = [0, 1; 1, 1];
    final parameter Real Ti[:, 2] = if u then [0, 1; 1, 1] else T;
    parameter Integer nRC = 1;
    parameter RD rd[nRC] = {RD(R = 0)};
  end CD;
  record SD
    parameter Integer Ns;
    parameter CD c1;
    parameter CD cd[Ns] = {c1 for k in 1:Ns};
  end SD;
end RCV1P;
model RCV1
  parameter RCV1P.CD a(u = false, T = [0, 0.5; 0.5, 0.7; 1, 1]);
  parameter RCV1P.SD s(Ns = 1, c1 = a);
end RCV1;
