  b.v = {time, 2 * time};
end EAM37;
//// model: EAM38
connector EAM38_RO = output Real;
expandable connector EAM38_B
  parameter Integer n = 1;
  Real v[n];
end EAM38_B;
model EAM38_M
  parameter Integer n = 1;
  EAM38_B b(n = n);
  EAM38_RO y[n];
equation
