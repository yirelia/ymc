end RCV9;
//// model: RCV10
package RCV10P
  record CD
    parameter Boolean u = true;
    parameter Real T[:, 2] = [0, 1; 1, 1];
    final parameter Real Ti[:, 2] = if u then [0, 1; 1, 1] else T;
    parameter Integer nRC = 1;
    parameter Real rd[nRC] = {0};
  end CD;
  record SD
    parameter Integer Ns;
    parameter CD c1;
    parameter CD cd[2] = {c1, c1};
  end SD;
end RCV10P;
model RCV10
  parameter RCV10P.CD a(u = false, T = [0, 0.5; 0.5, 0.7; 1, 1]);
  parameter RCV10P.SD s(Ns = 1, c1 = a);
end RCV10;
//// model: RCV11
package RCV11P
  record CD
    parameter Boolean u = true;
    parameter Real T[:, 2] = [0, 1; 1, 1];
    final parameter Real Ti[:, 2] = if u then [0, 1; 1, 1] else T;
    parameter Integer nRC = 1;
    parameter Real rd[nRC] = {0};
  end CD;
  record SD
    parameter Integer Ns;
    parameter CD c1;
    parameter CD cd[Ns] = {c1 for k in 1:Ns};
  end SD;
end RCV11P;
model RCV11
  parameter RCV11P.CD a(u = false, T = [0, 0.5; 0.5, 0.7; 1, 1], nRC = 2, rd = {1, 2});
