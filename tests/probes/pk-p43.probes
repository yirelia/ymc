//// set: pk-p43 — 67i：MSL Batteries CCCV_Stack / CCCV_StackRC 卡在 expandable 连接器的数组成员上，及其兄弟写法。EAM：expandable 里声明的数组成员（potentially present，`Real v[n]`）作 connect 端：makeConnectors 把 cref 展开成逐元素连接器（ExpandExp.expand → Connector.fromExp，NFConnections.mo:207-233 v1.25.0），各元素 cty 带 POTENTIALLY_PRESENT（fromFacedCref，NFConnector.mo:74-95）→ 逐元素的未声明连接、父 = ComponentRef.rest（NFExpandableConnectors.mo:262）；markComponentPresent 标整个组件节点（:330-351）→ 只连一个元素整个数组也留下（EAM3 / EAM18 / EAM40）；整体 / 切片 / 二维 / for / 组件数组 / 从里从外 / 多处连 / Integer / Boolean / input 前缀 / 带绑定（挪成方程 EAM30 / EAM42）/ 带属性；E–E 连接按增广后类型拆，数组成员行主序摊开（splitImpl 的 ARRAY 支，NFConnector.mo:359-360；EAM14 / EAM25-27 / EAM55 / EAM59 / EAM60）；复合元素的数组成员 omc 内部错（EAM9 / EAM15，BOTH-REJECT）；数组型虚元素（EAM20）、虚成员取自声明的数组成员（EAM28，omc 打标量虚变量却连 `b2.v[1]`）、参差实例（EAM56）照旧 SKIP。没连上的 pp 参数被删（Variable.isPresent，NFFlatten.mo:2394-2395），作结构参数（维 `v[n]`）时引用照样代成值（EAM46 `z = 2.0`、EAM52 `time > 2.0`、EAM47 别名 `final parameter Integer m = 2`；此前 SKIP structural parameter）。EAN：嵌套 expandable 数组（MSL StackBus 的 `CellBus cellBus[Ns, Np]`）：E–E 连接配对整个数组 cref、不再往下配（getExpandableConnectorsInConnector 只认 COMPLEX，NFExpandableConnectors.mo:217-231），拆分时数组段的维挂到递归出的叶上（EAN4 = CCCV_Stack 缩影、EAN7-EAN25：参数维、二维、两层嵌套、三个总线链、嵌套数组里的数组成员、虚成员 EAN8 / EAN24 / EAN25 照 omc 引不存在的 `s1.c[2].x`）；只一边连上（EAN3）/ 一边数组一边标量（EAN17）omc 报错。RCV：越过连接后 CCCV_StackRC 露出的、与连接无关的静默错（基线照样 FAIL）：记录数组的整体绑定不是逐元素字面量（推导式 / fill / 记录数组 cref）、元素字段的维读兄弟字段（`rd[nRC]`，MSL TransientData 的 `rcData[nRC]`）→ omc 定型这个维时把父的整个绑定求值（makeRecordFieldBindingFromParent，NFCeval.mo:673-713），引到的整个记录各字段求得的值存回绑定（evalComponentBinding，NFCeval.mo:362-389；`a.Ti[1,1] = 0.0`、`a.u` 不 final）——存回未做 → SKIP（RCV1 / RCV2 / RCV8 / RCV9 / RCV11），逐元素字面量 `{c1, c1}` 照常（RCV10）。
//// model: EAM1
connector EAM1_RO = output Real;
expandable connector EAM1_B
  parameter Integer n = 1;
  Real v[n];
end EAM1_B;
block EAM1_G
  EAM1_RO y = time;
end EAM1_G;
model EAM1
  parameter Integer n = 2;
  EAM1_B b(n = n);
  EAM1_G g[n];
equation
  connect(g.y, b.v);
end EAM1;
//// model: EAM2
connector EAM2_RO = output Real;
expandable connector EAM2_B
  Real v[2];
end EAM2_B;
model EAM2
  EAM2_B b;
  EAM2_RO y[2];
equation
  connect(y, b.v);
  y = {time, 2 * time};
end EAM2;
//// model: EAM3
connector EAM3_RO = output Real;
expandable connector EAM3_B
  Real v[2];
end EAM3_B;
model EAM3
  EAM3_B b;
  EAM3_RO y;
equation
  connect(y, b.v[1]);
  y = time;
end EAM3;
//// model: EAM4
connector EAM4_RO = output Real;
