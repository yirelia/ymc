//// model: EAM52
connector EAM52_RO = output Real;
connector EAM52_IO = output Integer;
expandable connector EAM52_B
  parameter Integer n = 2;
  Real v[n];
end EAM52_B;
model EAM52
  EAM52_B b;
  EAM52_RO y[2];
equation
  connect(y, b.v);
  y = {time, 2 * time};
  when time > b.n then
    reinit(y[1], 0);
  end when;
end EAM52;
