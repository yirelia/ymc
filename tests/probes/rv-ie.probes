//// set: rv-ie — 记录构造缺省里两支长短不一的 if 式 / 切片 `a[1:end-1]`：单独出现 1.25.0 都接受（两者同在的 scodeinst IfExpression13 1.25.0 拒、在账）；函数输入缺省同理
//// model: I10
function g
input Boolean c = false;
input Real a[3] = if c then {1.0} else {1.0, 2.0, 3.0};
output Real y;
algorithm
y := a[1];
end g;
model I10
Real y = g();
end I10;
//// model: I11
record R
constant Boolean cond = false;
