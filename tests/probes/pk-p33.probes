//// model: SXB7
package SXB7P
  connector C
    Real p;
    flow Real m_flow(min = 0);
    stream Real X[2];
  end C;
  connector D
    Real p;
    flow Real m_flow(max = 0);
    stream Real X[2];
  end D;
  model V
    C a;
    D b;
    Real ya[2];
    Real yb[2];
  equation
    ya = a.m_flow * actualStream(a.X);
    yb = b.m_flow * actualStream(b.X);
    a.X = {0.3, 0.7};
    b.X = {0.4, 0.6};
  end V;
  model S
    C c;
    D d;
  equation
    c.X = {0.1, 0.9};
    d.X = {0.2, 0.8};
  end S;
end SXB7P;
model SXB7
  SXB7P.S s;
  SXB7P.V v;
equation
  connect(s.c, v.a);
  connect(s.d, v.b);
end SXB7;
