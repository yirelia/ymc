  connect(v1.a, v3.a);
end SXB8;
//// model: SXB9
package SXB9P
  package M1
    constant Integer nX = 2;
  end M1;
  package M2
    constant Integer nX = 3;
  end M2;
  connector C
    replaceable package Medium = M1;
    Real p;
    flow Real m_flow;
    stream Real X[Medium.nX];
  end C;
  model V
    replaceable package Medium = M1;
    C a(redeclare package Medium = Medium);
    Real y[Medium.nX];
  equation
    y = inStream(a.X);
    a.X = fill(0.5, Medium.nX);
  end V;
end SXB9P;
model SXB9
  SXB9P.V v1(redeclare package Medium = SXB9P.M2);
  SXB9P.V v2(redeclare package Medium = SXB9P.M2);
  SXB9P.V w;
equation
  connect(v1.a, v2.a);
end SXB9;
