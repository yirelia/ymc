package SXB15P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    parameter Boolean b = true;
    C a;
    Real y[2];
  equation
    if b then
      y = inStream(a.X);
    else
      y = a.X;
    end if;
    a.X = {0.3, 0.7};
  end V;
end SXB15P;
model SXB15
  SXB15P.V v1, v2;
equation
