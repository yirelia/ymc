//// model: SXB12
package SXB12P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real w[2] = a.m_flow * actualStream(a.X);
    Real z[2] = 2 * inStream(a.X);
    Real u[2] = {a.m_flow * actualStream(a.X[1]), a.m_flow * actualStream(a.X[2])};
  equation
    a.X = {0.3, 0.7};
  end V;
end SXB12P;
model SXB12
  SXB12P.V v1, v2;
equation
  connect(v1.a, v2.a);
end SXB12;
