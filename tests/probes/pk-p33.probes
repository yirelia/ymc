//// model: SXB16
package SXB16P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real s1;
    Real s2;
  equation
    s1 = sum(inStream(a.X));
    s2 = sum(a.m_flow * actualStream(a.X));
    a.X = {0.3, 0.7};
  end V;
end SXB16P;
model SXB16
  SXB16P.V v1, v2;
equation
  connect(v1.a, v2.a);
end SXB16;
//// model: SXB17
package SXB17P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real y[2];
    Real w[2];
  equation
    y = {inStream(a.X[i]) for i in 1:2};
    w = {a.m_flow * actualStream(a.X[i]) for i in 1:2};
