//// model: SXF2
package SXF2P
  package Medium
    constant Integer nXi = 1;
    constant Integer nC = 1;
  end Medium;
  connector FluidPort
    replaceable package Medium = SXF2P.Medium;
    flow Real m_flow(min = if allowFlowReversal then -1e60 else 0);
    Real p;
    stream Real h_outflow;
    stream Real Xi_outflow[Medium.nXi];
    stream Real C_outflow[Medium.nC];
    parameter Boolean allowFlowReversal = true;
  end FluidPort;
  model Transport
    replaceable package Medium = SXF2P.Medium;
    FluidPort port_a(redeclare package Medium = Medium);
    FluidPort port_b(redeclare package Medium = Medium);
  equation
    port_a.m_flow + port_b.m_flow = 0;
    port_a.p - port_b.p = port_a.m_flow;
    port_a.h_outflow = inStream(port_b.h_outflow);
    port_b.h_outflow = inStream(port_a.h_outflow);
    port_a.Xi_outflow = inStream(port_b.Xi_outflow);
    port_b.Xi_outflow = inStream(port_a.Xi_outflow);
    port_a.C_outflow = inStream(port_b.C_outflow);
    port_b.C_outflow = inStream(port_a.C_outflow);
  end Transport;
  model Source
    replaceable package Medium = SXF2P.Medium;
    parameter Integer nPorts = 1;
    FluidPort ports[nPorts](redeclare each package Medium = Medium);
    Real Xi[Medium.nXi] = {0.01};
    Real C[Medium.nC] = {1e-3};
  equation
    for i in 1:nPorts loop
      ports[i].p = 1e5;
      ports[i].h_outflow = 1;
      ports[i].Xi_outflow = Xi;
      ports[i].C_outflow = C;
    end for;
  end Source;
  model Volume
    replaceable package Medium = SXF2P.Medium;
    parameter Integer nPorts = 2;
    FluidPort ports[nPorts](redeclare each package Medium = Medium);
    Real mXi[nPorts, Medium.nXi];
    Real mC[nPorts, Medium.nC];
    Real H[nPorts];
  equation
    for i in 1:nPorts loop
      H[i] = ports[i].m_flow * actualStream(ports[i].h_outflow);
      mXi[i, :] = ports[i].m_flow * actualStream(ports[i].Xi_outflow);
      mC[i, :] = ports[i].m_flow * actualStream(ports[i].C_outflow);
      ports[i].p = 1e5;
      ports[i].h_outflow = 2;
      ports[i].Xi_outflow = {0.02};
      ports[i].C_outflow = {2e-3};
    end for;
  end Volume;
  model Sensor
    replaceable package Medium = SXF2P.Medium;
    FluidPort port(redeclare package Medium = Medium);
    Real CVec[Medium.nC];
    Real C;
  equation
    CVec = inStream(port.C_outflow);
    C = CVec[1];
    port.m_flow = 0;
    port.h_outflow = 0;
    port.Xi_outflow = {0.01};
    port.C_outflow = zeros(Medium.nC);
  end Sensor;
end SXF2P;
model SXF2
  SXF2P.Source src(nPorts = 1);
  SXF2P.Transport t;
  SXF2P.Volume vol(nPorts = 2);
  SXF2P.Sensor sen;
equation
  connect(src.ports[1], t.port_a);
  connect(t.port_b, vol.ports[1]);
  connect(t.port_b, sen.port);
end SXF2;
