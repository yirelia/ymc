//// model: SXB1
package SXB1P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model V
    C ports[2];
    Real y[2, 2];
    Real w[2, 2];
  equation
    for i in 1:2 loop
      y[i, :] = inStream(ports[i].X);
      w[i, :] = ports[i].m_flow * actualStream(ports[i].X);
      ports[i].X = {0.3, 0.7};
      ports[i].h = 1;
    end for;
  end V;
  model S
    C c;
  equation
    c.p = 1;
    c.h = 2;
    c.X = {0.1, 0.9};
  end S;
end SXB1P;
model SXB1
  SXB1P.S s1, s2;
  SXB1P.V v;
equation
  connect(s1.c, v.ports[1]);
  connect(s2.c, v.ports[2]);
end SXB1;
