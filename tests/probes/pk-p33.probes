//// set: pk-p33 — 非空的 stream 数组成员（66y，MSL Fluid MoistAir 的 `Xi_outflow[nXi]`、trace substance 的 `C_outflow[nC]`；BranchingDynamicPipes / RoomCO2 / RoomCO2WithControls 此前 SKIP "stream connector"）：变量逐元素发射（须在恰有一个 flow 的连接器里，associatedFlowCref，NFConnectEquations.mo:1102-1122 v1.25.0），连接集逐元素摊（splitImpl 的 ARRAY 支，NFConnector.mo:359-362）——两 inside / 一内一外 / 两 outside / 三路 / 连接器数组 / 嵌套连接器 / 继承的连接器 / 模型数组 / 二维 / 类型维 / 枚举维 / 空与非空混合 / 属性（SXA1-SXA12、SXB1、SXB2、SXB6-SXB8、SXB10、SXB11、SXB19-SXB22、SXC3、SXC4、SXC9-SXC12、SXD12、SXD13、SXE3-SXE5、SXE11）；inStream / actualStream 的数组实参定型时展开成元素调用（typeActualInStreamCall2 的 ARRAY 支，NFBuiltinCall.mo:2052-2100）：等式 / for / 初始方程 / when / if 方程 / if 表达式 / Var 数组绑定 `v.z = {…}` / 函数实参 `{…}` / 修饰绑定 / 记录函数 / 归约 / 推导式 / 算术（SXA5-SXA7、SXB12、SXB13、SXB15-SXB17、SXC1、SXC6、SXC14、SXD4、SXD5、SXD8、SXD10、SXE9、SXE10、SXE12）；`cref * actualStream(a.X)` 不包 smooth、不换位（evaluateActualStreamMul 只认 BINARY 的直接运算数是 CALL，NFConnectEquations.mo:172-182；SXA4、SXA8、SXA9、SXB18、SXC8、SXC13、SXD9、SXD11），书写的 `a.m_flow * actualStream(a.X[1])` 照旧包 smooth（SXA4 / SXA6 / SXE10）；维取本实例已发射的元素（连接器参数维随实例修饰 SXC5 / SXD1 / SXD3 / SXF1、重声明的包 SXD2、绑定写在连接器声明前 SXB28、第二遍 SXB27）；MSL 形 FluidPort / 两端口 / 源 / 容器 / 传感器（SXF2）。照旧 SKIP：实参是连接器数组整体 / 切片 / 二维取行（SXB3-SXB5，ExpandExp.expandCref 一般形未做）、算法段（SXB14，omc 不求值照留调用）、向量化内建 abs / semiLinear（SXC2 / SXD7）、子连接器数组的连接（SXE6）、expandable（SXE7）、关联 flow 在外层连接器（SXE8）、stream 不在连接器里（SXB25）、同一模型两实例取不同重声明包（SXB9，与 stream 无关的旧限制）；两边拒：两个 / 没有 flow（SXB23 / SXB24）、成员维不符（SXB26）、参数绑定 inStream（SXE1 / SXE2）。isNoFlow 的结构标记（基线静默错）：Structural.markExp 标的是组件节点（NFStructural.mo:246-326），组件数组 / 参数数组的元素共用一个节点——只连 ports[1]，没连的 ports[2] 的参数一样 final、属性跟着折（SXG1-SXG6、SXH1、SXH2、SXH4、SXH5、SXH7、SXH8、SXH10，基线 FAIL / SKIP）；Evaluate = false 的参数不标不求（NON_STRUCTURAL_PARAMETER，isNoFlow，NFConnectEquations.mo:934-972；SXH3 / SXH9，基线 FAIL）；参数连接集的集首是 Evaluate = false 的出等式不出断言（generatePotentialEquations :211；SXI1、SXI5-SXI9，基线 FAIL），集首是普通参数照旧断言（SXI4）；连接器参数的绑定不是字面量照旧 SKIP（SXH6）；标量绑定 / der / assert 里的元素调用（SXJ1 / SXJ2）。smooth / noEvent 整体保留的数组实参里有逐元素运算（`k * xa`、`-xa`、`m * actualStream(a.X)`）：omc 化简末尾展开成数组字面量（simplifyBinary / simplifyUnary 的 ExpandExp.expand，NFSimplifyExp.mo:941-943 / :1135-1137），ymc 不展开 → SKIP（SXJ4，SXK1 / SXK2 / SXK7 基线静默错）；if 支里已展开的（SXK4）、裸 cref（SXK5）照旧 PASS；min / max 的数组实参（SXJ3）、noEvent 整个 stream 数组（SXJ5）、数组字面量 / 矩阵积实参（SXK3 / SXK6）照旧 SKIP
//// model: SXA1
package SXA1P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model M
    C a, b;
  equation
    a.m_flow + b.m_flow = 0;
    a.p = b.p;
    a.h = inStream(b.h);
    b.h = inStream(a.h);
    a.X = inStream(b.X);
    b.X = inStream(a.X);
  end M;
  model S
    C c;
    parameter Real X0[2] = {0.1, 0.9};
  equation
    c.p = 1;
    c.h = 2;
    c.X = X0;
  end S;
end SXA1P;
model SXA1
  SXA1P.S s1, s2;
  SXA1P.M m;
equation
  connect(s1.c, m.a);
  connect(m.b, s2.c);
end SXA1;
//// model: SXA2
package SXA2P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model M
    C a, b;
  equation
    a.m_flow + b.m_flow = 0;
    a.p = b.p;
    a.h = inStream(b.h);
    b.h = inStream(a.h);
    a.X = inStream(b.X);
    b.X = inStream(a.X);
  end M;
end SXA2P;
model SXA2
  SXA2P.C c;
  SXA2P.M m;
equation
  connect(c, m.a);
end SXA2;
//// model: SXA3
package SXA3P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model M
    C a, b;
  equation
    a.m_flow + b.m_flow = 0;
    a.p = b.p;
    a.h = inStream(b.h);
    b.h = inStream(a.h);
    a.X = inStream(b.X);
    b.X = inStream(a.X);
  end M;
  model S
    C c;
  equation
    c.p = 1;
    c.h = 2;
    c.X = {0.1, 0.9};
  end S;
end SXA3P;
model SXA3
  SXA3P.S s1;
  SXA3P.M m1, m2;
equation
  connect(s1.c, m1.a);
  connect(s1.c, m2.a);
end SXA3;
//// model: SXA4
package SXA4P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model V
    C a;
    Real H;
    Real mX[2];
    Real mX1;
    Real mX2;
  equation
    H = a.m_flow * actualStream(a.h);
    mX = a.m_flow * actualStream(a.X);
    mX1 = a.m_flow * actualStream(a.X[1]);
    mX2 = actualStream(a.X[2]) * a.m_flow;
    a.h = 1;
    a.X = {0.2, 0.8};
  end V;
  model S
    C c;
  equation
    c.p = 1;
    c.h = 2;
    c.X = {0.1, 0.9};
  end S;
end SXA4P;
model SXA4
  SXA4P.S s;
  SXA4P.V v;
equation
  connect(s.c, v.a);
end SXA4;
//// model: SXA5
package SXA5P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  function f
    input Real p;
    input Real h;
    input Real X[:];
    output Real y;
  algorithm
    y := p + h + sum(X);
  end f;
  model V
    C a;
    Real d;
    Real z[2] = inStream(a.X);
    Real w[2] = actualStream(a.X);
  equation
    d = f(a.p, inStream(a.h), inStream(a.X));
    a.h = 1;
    a.X = {0.2, 0.8};
  end V;
  model S
    C c;
  equation
    c.p = 1;
    c.h = 2;
    c.X = {0.1, 0.9};
  end S;
end SXA5P;
model SXA5
  SXA5P.S s;
  SXA5P.V v;
equation
  connect(s.c, v.a);
end SXA5;
//// model: SXA6
package SXA6P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model V
    C a;
    Real y[2];
    Real w[2];
  equation
    for i in 1:2 loop
      y[i] = inStream(a.X[i]);
      w[i] = a.m_flow * actualStream(a.X[i]);
    end for;
    a.h = 1;
    a.X = {0.2, 0.8};
  end V;
  model S
    C c;
  equation
    c.p = 1;
    c.h = 2;
    c.X = {0.1, 0.9};
  end S;
end SXA6P;
model SXA6
  SXA6P.S s;
  SXA6P.V v;
equation
  connect(s.c, v.a);
end SXA6;
