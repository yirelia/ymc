    flow Real f;
    R r;
  end C;
  model M
    C c;
  end M;
end SXI8P;
model SXI8
  SXI8P.M a, b;
equation
  connect(a.c, b.c);
end SXI8;
//// model: SXI9
package SXI9P
  connector C
    Real p;
    flow Real f;
    parameter Real k = 1 annotation(Evaluate = false);
  end C;
  model M
    C c;
  end M;
end SXI9P;
model SXI9
  SXI9P.M a, b;
  SXI9P.C c;
equation
  connect(a.c, b.c);
  connect(c, a.c);
end SXI9;
//// model: SXJ1
package SXJ1P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real d = sum(inStream(a.X));
    Real e = a.m_flow * actualStream(a.X[1]);
    Real f = inStream(a.X) * {1, 2};
  equation
    a.X = {0.3, 0.7};
  end V;
end SXJ1P;
model SXJ1
  SXJ1P.V v1, v2;
equation
  connect(v1.a, v2.a);
end SXJ1;
//// model: SXJ2
package SXJ2P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real y[2](each start = 0);
  equation
    der(y) = inStream(a.X) - y;
    assert(inStream(a.X[1]) >= 0, "neg");
    a.X = {0.3, 0.7};
  end V;
end SXJ2P;
model SXJ2
  SXJ2P.V v1, v2, v3;
equation
  connect(v1.a, v2.a);
  connect(v1.a, v3.a);
end SXJ2;
//// model: SXJ3
package SXJ3P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real g = max(actualStream(a.X));
  equation
    a.X = {0.3, 0.7};
  end V;
end SXJ3P;
model SXJ3
  SXJ3P.V v1, v2;
equation
  connect(v1.a, v2.a);
end SXJ3;
//// model: SXJ4
package SXJ4P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real z[2];
  equation
    z = smooth(0, a.m_flow * actualStream(a.X));
    a.X = {0.3, 0.7};
  end V;
end SXJ4P;
model SXJ4
  SXJ4P.V v1, v2;
equation
  connect(v1.a, v2.a);
end SXJ4;
//// model: SXJ5
package SXJ5P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    C a;
    Real y[2];
  equation
    y = noEvent(actualStream(a.X));
    a.X = {0.3, 0.7};
  end V;
end SXJ5P;
model SXJ5
  SXJ5P.V v1, v2;
equation
  connect(v1.a, v2.a);
end SXJ5;
//// model: SXK1
model SXK1
  Real k = time;
  Real x = 2 * time;
  Real y = 3 * time;
  Real z[2];
  Real w[2];
  Real u[2];
equation
  z = smooth(0, k * {x, y});
  w = k * {x, y};
  u = noEvent(k * {x, y});
end SXK1;
//// model: SXK2
model SXK2
  Real k = time;
  Real xa[2] = {2 * time, 3 * time};
  Real z[2];
  Real u[2];
  Real s[2];
  Real r[2];
equation
  z = smooth(0, k * xa);
  u = noEvent(k * xa);
  s = smooth(0, xa);
  r = smooth(0, -xa);
end SXK2;
//// model: SXK3
model SXK3
  Real x = time;
  Real y = 2 * time;
  Real z[2];
  Real u[2];
  Real v[2];
equation
  z = smooth(0, {x, y});
  u = smooth(0, -{x, y});
  v = smooth(0, {x, y} + {y, x});
end SXK3;
//// model: SXK4
model SXK4
  parameter Boolean c = true;
  Real xa[2] = {2 * time, 3 * time};
  Real z[2];
equation
  z = smooth(0, if time > 0.5 then xa else -xa);
end SXK4;
//// model: SXK5
model SXK5
  Real xa[2] = {2 * time, 3 * time};
  Real z[2];
  Real s;
equation
  z = noEvent(xa);
  s = noEvent(xa[1] * 2) + smooth(0, sum(xa * 2));
end SXK5;
//// model: SXK6
model SXK6
  Real A[2, 2] = {{1, 2}, {3, 4}} * time;
  Real xa[2] = {2 * time, 3 * time};
  Real z[2];
equation
  z = smooth(0, A * xa);
end SXK6;
//// model: SXK7
model SXK7
  Real xa[2] = {2 * time, 3 * time};
  Real r[2];
equation
  r = noEvent(-xa);
end SXK7;
