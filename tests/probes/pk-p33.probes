//// model: SXB18
package SXB18P
  connector C
    Real p;
    flow Real m_flow;
    stream Real h;
    stream Real X[2];
  end C;
  model V
    C a;
    C b;
    Real w1[2];
    Real w2[2];
    Real w3[2];
    Real w4[2];
    Real h1;
    Real h2;
  equation
    w1 = actualStream(a.X) * a.m_flow;
    w2 = actualStream(a.X) / a.m_flow;
    w3 = b.m_flow * actualStream(a.X);
    w4 = -a.m_flow * actualStream(a.X);
    h1 = b.m_flow * actualStream(a.h);
    h2 = actualStream(a.h) * b.m_flow;
    a.X = {0.3, 0.7};
    a.h = 1;
    b.X = {0.4, 0.6};
    b.h = 2;
  end V;
end SXB18P;
