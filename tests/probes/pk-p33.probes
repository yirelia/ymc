//// model: SXB6
package SXB6P
  connector C
    Real p;
    flow Real m_flow;
    stream Real X[2];
  end C;
  model V
    parameter Integer n = 2;
    C ports[2];
    Real y[2];
  equation
    y = inStream(ports[n].X);
    for i in 1:2 loop
      ports[i].X = {0.3, 0.7};
    end for;
