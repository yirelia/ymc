//// set: ba-p — pre / change 的实参规则
//// model: P0
model P0
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a1[:] = {false, true};
end P0;
//// model: P1
model P1
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a2[:] = not b;
end P1;
//// model: P10
model P10
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean c2[:] = false:false;
end P10;
//// model: P11
model P11
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c3[:] = x;
end P11;
//// model: P12
model P12
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c4[:] = 2 * x;
end P12;
//// model: P13
model P13
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c5[:] = x[2:3];
end P13;
//// model: P14
model P14
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c6[:] = {i * time for i in 1:n};
end P14;
//// model: P15
model P15
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c7[:] = sin(x);
end P15;
//// model: P16
model P16
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c8[size(x, 1)] = x;
end P16;
//// model: P17
model P17
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real c9[:] = if time > 1 then x else 2 * x;
end P17;
//// model: P18
model P18
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real d1[:] = if n == 2 then {1, 2} else {3};
end P18;
//// model: P19
model P19
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real d2[:, :] = if n == 3 then ones(n, 2) else ones(n, n);
end P19;
//// model: P2
model P2
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a3[:] = b and b2;
end P2;
//// model: P20
model P20
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real d3[max(n, 3)];
end P20;
//// model: P21
model P21
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real d4[max({n, 3})];
end P21;
//// model: P22
model P22
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer d5[:] = 3:5;
end P22;
//// model: P23
model P23
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real d6[d5[end]];
end P23;
//// model: P24
model P24
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean d7[:] = edge(b);
end P24;
//// model: P25
model P25
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean d8[:] = {x[i] > 1 for i in 1:3};
end P25;
//// model: P26
model P26
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  String d9[:] = {String(i) for i in 1:3};
end P26;
//// model: P27
model P27
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e1[:] = cat(1, x, x);
end P27;
//// model: P28
model P28
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e2[:] = linspace(0, 1, n + 1);
end P28;
//// model: P29
model P29
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e3[:] = fill(time, n);
end P29;
//// model: P3
model P3
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a4[:] = b or b2;
end P3;
//// model: P30
model P30
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Integer e4[:] = {i for i in 1:n};
end P30;
//// model: P31
model P31
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e5[:, :] = {{time, 1}, {2, 3}};
end P31;
//// model: P32
model P32
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e6[:, 2] = {{time, 1}, {2, 3}};
end P32;
//// model: P33
model P33
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e7[:] = -x;
end P33;
//// model: P34
model P34
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e8[:] = x .* x;
end P34;
//// model: P35
model P35
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Real e9[:] = x + {1, 2, 3};
end P35;
//// model: P4
model P4
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a5[:] = {false, false, true, true} or {true, false, true, false};
end P4;
//// model: P5
model P5
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a6[:] = false:true;
end P5;
//// model: P6
model P6
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a7[2] = b and {true, true};
end P6;
//// model: P7
model P7
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a8[2] = not {true, false};
end P7;
//// model: P8
model P8
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean a9[2] = not b;
end P8;
//// model: P9
model P9
  parameter Integer n = 2;
  Boolean b[2] = {time > 1, true};
  Boolean b2[2] = {true, time > 2};
  Real x[3] = {time, 1, 2};
  Boolean c1[:] = true:false;
