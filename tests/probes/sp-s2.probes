//// set: sp-s2 — 同上：两对不同维、维不符（都拒）、二维 / 成员带维、Bus 里的 Plug 数组、stream / 空数组（SKIP）、链式、pin 整体对 Pin 数组、切片、300 元素
//// model: S20
connector Pin
Real v;
flow Real i;
end Pin;
connector Plug
parameter Integer m = 3;
Pin pin[m];
end Plug;
model S20
Plug p(m = 2);
Plug n(m = 2);
Plug q(m = 3);
Plug r(m = 3);
equation
connect(p, n);
connect(q, r);
end S20;
