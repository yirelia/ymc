//// set: wc-c1 — when 方程的条件形态：关系 / 逻辑 / 内建调用 / initial / sample / 条件向量
//// model: C10
model C10
  Real a = time;
  Real b = 2 * time;
  Real c = 3 * time;
  Boolean p = a > 1;
  Boolean q = b > 1;
  Integer k = integer(a);
  Boolean v[2] = {a > 2, b > 2};
  parameter Boolean pb = true;
  parameter Real pr = 1;
  Real y;
equation
  when a > 1 then y = a; end when;
end C10;
