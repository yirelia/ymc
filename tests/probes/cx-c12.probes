//// model: C1215
model C1215
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2] = {sum(i * j for j in 1:3) * tt for i in 1:2};
end C1215;
//// model: C1216
model C1216
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2];
equation
  for i in 1:2 loop y[i] = sum(i * j for j in 1:3) * tt; end for;
end C1216;
//// model: C1217
model C1217
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2]; algorithm for i in 1:2 loop y[i] := sum({i, 2 * i, 3});  end for;
end C1217;
//// model: C1218
model C1218
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2]; algorithm for i in 1:2 loop y[i] := sum(x[j] for j in i:3); end for;
end C1218;
//// model: C1219
model C1219
  constant Real x[5] = {1, 2, 3, 4, 5};
  constant Real m[2, 3] = {{1, 2, 3}, {4, 5, 6}};
  constant Integer k[3] = {3, 1, 2};
  parameter Integer p = 2;
  Integer n = integer(time) + 1;
  Real tt = time;
  Real y[2]; algorithm for i in 1:2 loop y[i] := sum(k[j] * i for j in 1:3); end for;
end C1219;
