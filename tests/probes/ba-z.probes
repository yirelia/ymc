//// set: ba-z — 数组 if 按结构参数选支
//// model: BASE
model BASE
  parameter Integer n = 2;
  parameter Integer n2 = 2 * n;
  parameter Boolean pt = true;
  parameter Boolean pf = false;
  parameter Boolean pu(fixed = false);
  parameter Boolean pd = pt;
  parameter Boolean pe = true annotation(Evaluate = false);
  parameter Real q[3] = {1, 2, 3};
  Real x[3] = {time, 1, 2};
  Real y[3];
end BASE;
