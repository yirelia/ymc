//// model: HRE1
package HRE1P
  record R
    parameter Real x = 1;
    parameter Boolean b = false;
  end R;
  model T
    parameter Boolean b;
    Real y;
  equation
    if b then
      y = 1;
    else
      y = 2;
    end if;
  end T;
end HRE1P;
model HRE1
  parameter HRE1P.R ra(b = true);
  parameter HRE1P.R rr[2] = {ra, ra};
  HRE1P.T t(final b = rr[1].b);
end HRE1;
