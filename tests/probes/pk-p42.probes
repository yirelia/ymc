  parameter HRK1P.MD md;
  HRK1P.M m(Va = md.Va, Ia = md.Ia, bp = md.bp);
  parameter Real q[:] = {md.Vi};
  final parameter Integer n = max([size(q, 1); 1]);
  Real y[n] = fill(time, n);
end HRK1;
//// model: HRK2
package HRK2P
  record BP
    parameter Real V = 0;
    parameter Real IL = 1;
  end BP;
  function drop
    input BP bp;
    input Real i;
    output Real v;
  algorithm
    v := bp.V * i / bp.IL;
  end drop;
  record MD
    parameter Real Va = 100;
    parameter Real Ia = 100;
    parameter BP bp(V = 0, IL = 0.01 * Ia);
    parameter Real Vi = Va - drop(bp, Ia);
  end MD;
  model B
    parameter BP bp;
    Real y = bp.V * time;
  end B;
  model M
    parameter Real Va = 100;
    parameter Real Ia = 100;
    parameter BP bp;
    final parameter Real Vi = Va - drop(bp, Ia);
    B b(final bp = bp);
    Real z = drop(bp, time);
  end M;
end HRK2P;
model HRK2
  parameter HRK2P.MD md;
  HRK2P.M m(Va = md.Va, Ia = md.Ia, bp = md.bp);
  Real y[if md.Vi > 50 then 1 else 2] = fill(time, if md.Vi > 50 then 1 else 2);
end HRK2;
