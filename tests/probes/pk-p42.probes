//// model: HRF1
record BP
  parameter Real V = 0;
  parameter Real IL = 1;
end BP;
function drop
  input BP bp;
  input Real i;
  output Real v;
algorithm
  v := bp.V * i / bp.IL;
end drop;
model HRF1
  parameter BP bp(V = 1, IL = 4);
  parameter Real wMax = 3 - drop(bp, 100);
  parameter Real q[:] = {wMax};
  final parameter Integer n = max([size(q, 1); 1]);
  Real y[n] = fill(time, n);
end HRF1;
