//// model: HRA13
package HRA13P
  record R
    Real a;
    Real b;
  end R;
  function g
    input Real x;
    output R r;
    output Real y;
  algorithm
    r.a := x;
    r.b := 2 * x;
    y := 3 * x;
  end g;
end HRA13P;
model HRA13
  HRA13P.R r;
  Real y;
algorithm
  (r, y) := HRA13P.g(time);
end HRA13;
//// model: HRA14
package HRA14P
  record R
    Real a;
    Real b;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r.a := x;
    r.b := 2 * x;
  end f;
  function h
    input Real x;
    output Real y;
  protected
    R r;
  algorithm
    r := f(x);
    y := r.a + r.b;
  end h;
end HRA14P;
model HRA14
  Real y;
algorithm
  y := HRA14P.h(time);
end HRA14;
