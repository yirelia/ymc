//// model: HSB1
model HSB1
  parameter Real d = 1;
  parameter Real c = d + 1;
  parameter Real b = c + 1;
  Real y;
equation
  if b > 2 then
    y = time;
  else
    y = 2 * time;
  end if;
end HSB1;
