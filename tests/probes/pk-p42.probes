//// model: HCX3
package HCX3P
  partial package PM
    replaceable record State
      Real p;
    end State;
    replaceable partial function setState
      input Real p;
      input Real T;
      output State s;
    end setState;
  end PM;
  package M
    extends PM;
    redeclare record extends State
      Real T;
    end State;
    redeclare function extends setState
    algorithm
      s := State(p = p, T = T);
    end setState;
  end M;
end HCX3P;
model HCX3
  parameter HCX3P.M.State s = HCX3P.M.setState(1, 2);
  Real y = s.T * time;
end HCX3;
