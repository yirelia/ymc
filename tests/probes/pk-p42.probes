//// model: HCX1
package HCX1P
  partial package PM
    replaceable record State
      Real p = 1;
    end State;
  end PM;
  package M
    extends PM;
    redeclare record extends State
      Real T = 2;
    end State;
  end M;
end HCX1P;
model HCX1
  parameter HCX1P.M.State s;
  Real y = s.p * time;
end HCX1;
//// model: HCX2
package HCX2P
  partial package PM
    replaceable record State
      Real p = 1;
    end State;
  end PM;
  package M
    extends PM;
    redeclare record extends State
      Real T = 2;
    end State;
  end M;
end HCX2P;
