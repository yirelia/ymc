//// model: HRE17
package HRE17P
  record R
    parameter Real x = 1;
    parameter Boolean b = false;
  end R;
  function mk
    input Boolean b;
    output R r[2];
  algorithm
    r[1] := R(x = 1, b = b);
    r[2] := R(x = 2, b = not b);
  end mk;
  model T
    parameter Boolean b;
    Real y;
  equation
    if b then
      y = 1;
    else
      y = 2;
    end if;
  end T;
end HRE17P;
model HRE17
  parameter HRE17P.R rr[2] = HRE17P.mk(true);
  HRE17P.T t(final b = rr[1].b);
end HRE17;
