//// set: pk-p9 — Medium 包常量：class extends 修饰里的 stateSelect、空切片、`:` 维常量的 size、String / Boolean 数组常量、空数组常量
//// model: PKS1
package P
  partial package PM
    constant Boolean ph_explicit = false;
    replaceable partial model BaseProperties
      Real p;
      Real h;
      parameter Boolean preferredMediumStates = false;
    end BaseProperties;
  end PM;
  package W
    extends PM(ph_explicit = true);
    redeclare model extends BaseProperties(
      h(stateSelect = if ph_explicit and preferredMediumStates then StateSelect.prefer else StateSelect.default))
    equation
      p = 1;
      h = time;
    end BaseProperties;
  end W;
  model V
    replaceable package M = PM;
    M.BaseProperties medium(preferredMediumStates = true);
  end V;
end P;
model PKS1
  P.V v(redeclare package M = P.W);
end PKS1;
//// model: PKS3
package P
  partial package PM
    constant Integer nX = 2;
    constant Integer nXi = nX - 1;
    constant Real reference_X[nX] = fill(1 / nX, nX);
    replaceable partial model BaseProperties
      Real X[nX](start = reference_X);
      Real Xi[nXi](start = reference_X[1:nXi]);
    end BaseProperties;
  end PM;
  package W
    extends PM(nX = 1);
    redeclare model extends BaseProperties
    equation
      X = {1};
    end BaseProperties;
  end W;
  model V
    replaceable package M = PM;
    M.BaseProperties medium;
  end V;
end P;
model PKS3
  P.V v(redeclare package M = P.W);
end PKS3;
//// model: PKS4
package P
  partial package PM
    constant Integer nX = 2;
    constant Integer nXi = nX - 1;
    constant Real reference_X[nX] = fill(1 / nX, nX);
    replaceable partial model BaseProperties
      Real X[nX](start = reference_X);
      Real Xi[nXi](start = reference_X[1:nXi]);
    end BaseProperties;
  end PM;
  package W
    extends PM(nX = 3);
