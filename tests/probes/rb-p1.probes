//// model: IN1
package IN1P
  record R
    Real x "field x";
    Real y "field y";
  end R;
  function f1 "single assignment of a record constructor -> inlinable"
    input Real a;
    output R r;
  algorithm
    r := R(x = a, y = 2 * a);
  end f1;
  function f2 "two statements -> not inlinable"
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.y := 2 * a;
  end f2;
  function f3 "single statement but a protected local -> not inlinable"
    input Real a;
    output R r;
  protected
    Real t = 2 * a;
  algorithm
    r := R(x = a, y = t);
  end f3;
  function f4 "default input"
    input Real a;
    input Real b = 3;
    output R r;
  algorithm
    r := R(a, b);
  end f4;
end IN1P;
model IN1
  parameter Real p = 1;
  final parameter IN1P.R r = IN1P.f4(p);
end IN1;
