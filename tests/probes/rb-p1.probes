//// model: FN1
package FN1P
  record In
    Real a "a";
    Real b[2] "b";
  end In;
  record Out
    In i "inner";
    Real z "z";
  end Out;
  function mk
    input Real p;
    output Out o;
  algorithm
    o := Out(i = In(a = p, b = {1, p}), z = 3);
  end mk;
  function mk2
    input Real p;
    output Out o;
  algorithm
    o.i := In(a = p, b = {1, p});
    o.z := 3;
  end mk2;
end FN1P;
model FN1
  parameter Real p = 2;
  final parameter FN1P.Out o = FN1P.Out(i = FN1P.In(a = p, b = {1, p}), z = 3);
end FN1;
//// model: FN2
package FN2P
  record In
    Real a "a";
    Real b[2] "b";
  end In;
  record Out
    In i "inner";
    Real z "z";
  end Out;
  function mk
    input Real p;
    output Out o;
  algorithm
    o := Out(i = In(a = p, b = {1, p}), z = 3);
  end mk;
  function mk2
    input Real p;
    output Out o;
  algorithm
    o.i := In(a = p, b = {1, p});
    o.z := 3;
  end mk2;
end FN2P;
