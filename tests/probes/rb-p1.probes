//// model: IN9
package IN9P
  record Ori
    Real T[2, 2] "T";
    Real w[2] "w";
  end Ori;
  function inv "inlinable, reads fields of an input record"
    input Ori R;
    output Ori Ri;
  algorithm
    Ri := Ori(T = transpose(R.T), w = -R.w);
  end inv;
  function mk "not inlinable"
    input Real a;
    output Ori R;
  algorithm
    R.T := [cos(a), sin(a); -sin(a), cos(a)];
    R.w := {a, 0};
  end mk;
end IN9P;
model IN9
  parameter Real p = 0.5;
  parameter IN9P.Ori R1 = IN9P.mk(p);
  final parameter IN9P.Ori R2 = IN9P.inv(R1);
end IN9;
