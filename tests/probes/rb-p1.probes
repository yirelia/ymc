//// model: FD1
package FD1P
  type AngularVelocity = Real(final quantity = "AngularVelocity", final unit = "rad/s");
  record RM
    Real T[2, 2] "T comment";
    AngularVelocity w[2] "w comment";
    Real s(min = 0, nominal = 2) = 1 "s comment";
  end RM;
  function h "array-valued, not inlinable"
    input Real a;
    output Real T[2, 2];
  protected
    Real c;
  algorithm
    c := cos(a);
    T := [c, 0; 0, c];
  end h;
  function mkm "inlinable record function"
    input Real a;
    output RM m;
  algorithm
    m := RM(T = [cos(a), sin(a); -sin(a), cos(a)], w = {a, 0}, s = a);
  end mkm;
  function mkm2 "not inlinable record function"
    input Real a;
    output RM m;
  algorithm
    m.T := [cos(a), sin(a); -sin(a), cos(a)];
    m.w := {a, 0};
    m.s := a;
  end mkm2;
end FD1P;
model FD1
  parameter Real p = 0.5;
  final parameter FD1P.RM r = FD1P.RM(T = [cos(p), sin(p); -sin(p), cos(p)], w = {p, 0}, s = 2);
end FD1;
