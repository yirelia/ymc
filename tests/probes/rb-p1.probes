//// set: rb-p1 — 记录类型组件带整体绑定（研究子任务 rp62r：116 个探针 + SPEC 16 条规则，去掉 omc 崩溃的 IN8 与要装 MSL 的 MS*）：构造调用 / 记录引用 / if 选支、final 参数记录的强制内联与放弃（多条语句、有局部、调用处顶层实参是内建调用）、tryEvalExp 成字面量与写回、求不出挪成初始方程（数组字段 fixed = false）、结构参数实参求值、Evaluate = false / external（SKIP）。单测取 BR6 / IA2 / SE1 / BR8 / FD4 / BR5
//// model: BR1
package BR1P
  record R
    Real x "field x";
    Real y "field y";
  end R;
  function f1 "single assignment of a record constructor -> inlinable"
    input Real a;
    output R r;
  algorithm
    r := R(x = a, y = 2 * a);
  end f1;
  function f2 "two statements -> not inlinable"
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.y := 2 * a;
  end f2;
  function f3 "single statement but a protected local -> not inlinable"
    input Real a;
    output R r;
  protected
    Real t = 2 * a;
  algorithm
    r := R(x = a, y = t);
  end f3;
end BR1P;
model BR1
  parameter BR1P.R r = BR1P.R(1, 2);
end BR1;
