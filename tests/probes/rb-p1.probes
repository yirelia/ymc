//// model: IN13
package IN13P
  record R
    Real x "field x";
    Real y "field y";
  end R;
  function f1 "single assignment of a record constructor -> inlinable"
    input Real a;
    output R r;
  algorithm
    r := R(x = a, y = 2 * a);
  end f1;
  function f2 "two statements -> not inlinable"
    input Real a;
    output R r;
  algorithm
    r.x := a;
    r.y := 2 * a;
  end f2;
  function f3 "single statement but a protected local -> not inlinable"
    input Real a;
    output R r;
  protected
    Real t = 2 * a;
  algorithm
    r := R(x = a, y = t);
  end f3;
  function f11 "body calls inlinable f1 with a builtin-call argument"
    input Real a;
    output R r;
  algorithm
    r := f1(cos(a));
  end f11;
end IN13P;
model IN13
  parameter Real p = 1;
  final parameter IN13P.R r = IN13P.f11(p);
end IN13;
