    input Real w0[2];
    output Orientation R;
  algorithm
    R := Orientation(T = [cos(angle), sin(angle); -sin(angle), cos(angle)], w = w0);
  end mk;
  function g1
    input Real a;
    output Real b;
  algorithm
    b := 2 * a;
  end g1;
  function g2
    input Real a;
    output Real b;
  protected
    Real t;
  algorithm
    t := 2 * a;
    b := t + 1;
  end g2;
end IA13P;
model IA13
  parameter Real a0 = 0.1;
  parameter Real wv[2] = {1, 2};
  final parameter IA13P.Orientation R = IA13P.mk(a0, {sin(a0), 0});
end IA13;
//// model: IN10
package IN10P
  record Ori
    Real T[2, 2] "T";
    Real w[2] "w";
  end Ori;
  function inv "inlinable, reads fields of an input record"
    input Ori R;
    output Ori Ri;
  algorithm
    Ri := Ori(T = transpose(R.T), w = -R.w);
  end inv;
  function mk "not inlinable"
    input Real a;
    output Ori R;
  algorithm
    R.T := [cos(a), sin(a); -sin(a), cos(a)];
    R.w := {a, 0};
  end mk;
end IN10P;
model IN10
  parameter Real p(fixed = false, start = 0.5);
  final parameter IN10P.Ori R2 = IN10P.inv(IN10P.mk(p));
initial equation
  p = 0.5;
end IN10;
