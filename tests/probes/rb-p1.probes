//// model: IA1
package IA1P
  record Orientation
    Real T[2, 2];
    Real w[2];
  end Orientation;
  function mk
    input Real angle;
    input Real w0[2];
    output Orientation R;
  algorithm
    R := Orientation(T = [cos(angle), sin(angle); -sin(angle), cos(angle)], w = w0);
  end mk;
  function g1
    input Real a;
    output Real b;
  algorithm
    b := 2 * a;
  end g1;
  function g2
    input Real a;
    output Real b;
  protected
    Real t;
  algorithm
    t := 2 * a;
    b := t + 1;
  end g2;
end IA1P;
model IA1
  parameter Real a0 = 0.1;
  parameter Real wv[2] = {1, 2};
  final parameter IA1P.Orientation R = IA1P.mk(a0, {0, 0});
end IA1;
