//// model: IA10
package IA10P
  record Orientation
    Real T[2, 2];
    Real w[2];
  end Orientation;
  function mk
    input Real angle;
    input Real w0[2];
    output Orientation R;
  algorithm
    R := Orientation(T = [cos(angle), sin(angle); -sin(angle), cos(angle)], w = w0);
  end mk;
  function g1
    input Real a;
    output Real b;
  algorithm
    b := 2 * a;
  end g1;
  function g2
    input Real a;
    output Real b;
  protected
    Real t;
  algorithm
    t := 2 * a;
    b := t + 1;
  end g2;
  function gext
    input Real a;
    output Real b;
  external "C" b = gext_impl(a);
  end gext;
end IA10P;
model IA10
  parameter Real a0 = 0.1;
  parameter Real wv[2] = {1, 2};
  final parameter IA10P.Orientation R = IA10P.mk(IA10P.gext(a0), {0, 0});
end IA10;
