//// set: rd-r4 — min / max：数组实参的形态
//// model: D0
model D0
  type E = enumeration(one, two, three);
  parameter Integer n = 3;
  Real x[3] = {time, 1, 2};
  Real t = time;
  Integer k[3] = {1, 2, integer(time)};
  Boolean bb[2] = {time > 1, true};
  E ee[2] = {E.one, E.three};
  Real y = max({{t}});
end D0;
