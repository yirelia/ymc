//// model: Q77
model Q77
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = t;
equation
  if bb[1] then assert(t > 0, "m"); elseif bb[2] then assert(true, "n"); else assert(t > 1, "o"); end if;
end Q77;
