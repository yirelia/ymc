//// model: Q721
model Q721
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = t;
equation
  for i in 1:2 loop if bb[i] then else assert(t > i, "n"); end if; end for;
end Q721;
