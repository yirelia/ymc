//// set: ap-p7 — 体为空的 if 分支
//// model: Q70
model Q70
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = t;
equation
  if bb[1] then else assert(bb[2], "n"); end if;
end Q70;
//// model: Q71
model Q71
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y = t;
equation
  if bb[1] then assert(bb[2], "m"); else assert(bb[2], "n"); end if;
end Q71;
