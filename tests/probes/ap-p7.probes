//// model: Q710
model Q710
  Real x[3] = {time, 1, 2};
  Real t = time;
  Boolean bb[2] = {time > 1, true};
  Real y;
equation
  if bb[1] then assert(true, "m"); y = 1; else y = 2; end if;
end Q710;
