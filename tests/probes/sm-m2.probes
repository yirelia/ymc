//// set: sm-m2 — 状态机算子：状态实参的种类（记录 / 连接器 / 实例数组 / 嵌套实例）、具名实参、类型错、当表达式用
//// model: M20
model M20
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  record R Real x; end R; R r;
equation
  initialState(r);
end M20;
//// model: M21
model M21
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  connector C Real p; flow Real f; end C; C cc;
equation
  initialState(cc);
end M21;
//// model: M22
model M22
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  model W St w1; St w2; end W; W w;
equation
  initialState(w.w1); transition(w.w1, w.w2, c);
end M22;
//// model: M23
model M23
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  model W St w1; St w2; end W; W w; Boolean a = activeState(w.w1);
end M23;
//// model: M24
model M24
  block St
    output Real d;
  end St;
  model Em
  end Em;
