//// model: M230
model M230
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  Real y;
equation
  when ticksInState() > 3 then y = timeInState(); end when;
end M230;
