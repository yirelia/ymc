//// model: M210
model M210
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  St sa[2];
equation
  for k in 1:2 loop transition(sa[k], sa[3 - k], i > k); end for; initialState(sa[1]);
end M210;
//// model: M211
model M211
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
  St sa[2]; Boolean a[2];
equation
  for k in 1:2 loop a[k] = activeState(sa[k]); end for;
end M211;
//// model: M212
model M212
  block St
    output Real d;
  end St;
  model Em
  end Em;
  St s1;
  St s2;
  Em e1;
  Em e2;
  Boolean c = time > 1;
  Integer i(start = 0);
equation
